{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Tenon",
  "scopeName": "source.tenon",
  "patterns": [
    { "include": "#comments" },
    { "include": "#attributes" },
    { "include": "#strings" },
    { "include": "#numbers" },
    { "include": "#keywords" },
    { "include": "#types" },
    { "include": "#macros" },
    { "include": "#functions" },
    { "include": "#operators" }
  ],
  "repository": {
    "comments": {
      "patterns": [
        {
          "name": "comment.line.double-slash.tenon",
          "match": "//.*$"
        },
        {
          "name": "comment.block.tenon",
          "begin": "/\\*",
          "end": "\\*/"
        }
      ]
    },
    "attributes": {
      "patterns": [
        {
          "name": "meta.attribute.tenon",
          "match": "@[a-zA-Z_][a-zA-Z0-9_]*"
        }
      ]
    },
    "strings": {
      "patterns": [
        {
          "name": "string.quoted.triple.tenon",
          "begin": "\"\"\"",
          "end": "\"\"\"",
          "patterns": [
            {
              "name": "constant.character.escape.tenon",
              "match": "\\\\."
            }
          ]
        },
        {
          "name": "string.quoted.double.tenon",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            {
              "name": "constant.character.escape.tenon",
              "match": "\\\\."
            }
          ]
        }
      ]
    },
    "numbers": {
      "patterns": [
        {
          "name": "constant.numeric.hex.tenon",
          "match": "\\b0[xX][0-9a-fA-F_]+\\b"
        },
        {
          "name": "constant.numeric.binary.tenon",
          "match": "\\b0[bB][01_]+\\b"
        },
        {
          "name": "constant.numeric.float.tenon",
          "match": "\\b[0-9][0-9_]*\\.[0-9][0-9_]*([eE][+-]?[0-9_]+)?\\b"
        },
        {
          "name": "constant.numeric.integer.tenon",
          "match": "\\b[0-9][0-9_]*\\b"
        }
      ]
    },
    "keywords": {
      "patterns": [
        {
          "name": "keyword.control.tenon",
          "match": "\\b(if|else|match|while|for|in|return|break|continue|defer|await|assert|implements)\\b"
        },
        {
          "name": "keyword.declaration.tenon",
          "match": "\\b(fn|pure|comptime|macro|attr|record|enum|interface|impl|type|const|union|bitfield|import|as|extern|evolution|protocol|stream|view|subscriber|test|let|var|lemma|ghost)\\b"
        },
        {
          "name": "storage.modifier.tenon",
          "match": "\\b(pub|unsafe|inout|dyn|async)\\b"
        },
        {
          "name": "keyword.other.contract.tenon",
          "match": "\\b(where|requires|ensures|invariant|decreases|result|old|forall|exists)\\b"
        },
        {
          "name": "constant.language.tenon",
          "match": "\\b(true|false|None|Some|Ok|Err|self)\\b"
        }
      ]
    },
    "types": {
      "patterns": [
        {
          "name": "support.type.primitive.tenon",
          "match": "\\b(Int|Int8|Int16|Int32|Int64|UInt8|UInt16|UInt32|UInt64|Byte|ISize|USize|CInt|CUInt|CChar|CSize|CVoid|Float|Float32|Float64|Bool|Text|Bytes|BytesSlice|Unit|Any)\\b"
        },
        {
          "name": "support.type.simd.tenon",
          "match": "\\b(Float32x4|Float64x4|Int32x4|Int64x4|UInt8x16)\\b"
        },
        {
          "name": "support.type.container.tenon",
          "match": "\\b(List|Map|Option|Result|Store|Handle|Channel|Mutex|AtomicInt|Ptr|MutPtr|Thread)\\b"
        },
        {
          "name": "entity.name.type.tenon",
          "match": "\\b[A-Z][a-zA-Z0-9_]*\\b"
        }
      ]
    },
    "macros": {
      "patterns": [
        {
          "name": "entity.name.function.macro.tenon",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*!"
        }
      ]
    },
    "functions": {
      "patterns": [
        {
          "name": "entity.name.function.tenon",
          "match": "\\b[a-z_][a-zA-Z0-9_]*(?=\\s*[(\\[])"
        }
      ]
    },
    "operators": {
      "patterns": [
        {
          "name": "keyword.operator.tenon",
          "match": "(==|!=|<=|>=|&&|\\|\\||<<|>>|=>|->|\\?|[=+\\-*/%&|^!<>:])"
        }
      ]
    }
  }
}
