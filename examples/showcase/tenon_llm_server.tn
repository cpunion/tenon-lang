// examples/showcase/tenon_llm_server.tn
// Pure-Tenon Zero-Rust Single-Binary Production LLM Server & HA PD Router v11 (< 750 KiB, Apple Metal)!
//
// Tenon v11 Features:
//   - Zero Rust, Zero Tokio, Zero Python, Zero Docker — compiles via `tenon build` to a < 750 KiB native binary!
//   - Single-threaded OS `kqueue` Reactor (`std/net/reactor.tn`) multiplexing up to 8 concurrent LLM clients!
//   - Universal PagedAttention CB + Async Unretained-Ref Metal ICB Pipeline (`TENON_METAL_ICB=1`)!
//   - Hardware-Native 2-Phase FlashDecoding Split-KV (`4K-128K`, 4-Mode KV + SWA/Sink + Latent MLA)!
//   - Register-Direct `half4` AMX MoE Mega-Kernel v3 + 4-Mode PagedKV (`FP16`/`Q8_0`/`FP8_E4M3`/`Q4_0`)!
//   - Zero-Copy & Pipelined Disaggregated PD Transport:
//       * Layer-Wise Streaming Pipelined PD (`transport="layer"`, `TNKL` chunks -> `POST /v1/pd/layer`)
//       * POSIX SHM Zero-Copy (`transport="shm"` / `?transport=shm`, `tn_moe_kv_{export,import}_shm`)
//       * Raw Binary HTTP (`?format=binary` / `application/octet-stream`, 0% Base64/Hex overhead!)
//       * Production HA `TENON_PD_ROUTER=1` Gateway (Health Checks, Circuit Breaker, Auto-Failover, 503 Backpressure!)
//   - Real-Time SSE Client-Disconnect Cancellation (`tenon_stream_cancelled_total`) + Zero-Downtime Dynamic LoRA Hot-Swap (`/v1/lora/{load,unload,list}`)!
//   - Prometheus `GET /metrics` TTFT/TPOT Latency Histograms + v11 HW & HA Counters!
//   - Cross-platform Linux/NVIDIA CUDA counterpart: `examples/showcase/tenon_llm_server_cuda.tn`!
//
// Build & Run:
//   tenon build examples/showcase/tenon_llm_server.tn -o /tmp/tenon_llm_server
//   TENON_MODEL=/tmp/models/v6/Llama-3.2-1B-Instruct-Q4_0.gguf TENON_ADDR=127.0.0.1:28091 /tmp/tenon_llm_server
//   # Or 3-node Zero-Rust Production HA Disaggregated PD Cluster:
//   TENON_PD_ROUTER=1 TENON_ADDR=127.0.0.1:28095 TENON_PREFILL_WORKERS=127.0.0.1:28091 TENON_DECODE_WORKERS=127.0.0.1:28092 TENON_PD_TRANSPORT=layer /tmp/tenon_llm_server

import "std/core/types.tn"
import "std/os/io.tn"
import "std/text/text.tn"
import "std/text/builder.tn"
import "std/encoding/json.tn"
import "std/net/reactor.tn"
import "std/gpu/metal/moe_stream.tn"

const MAX_CB Int = 16
const MAX_RD Int = 64
const HIST_STRIDE Int = 512
const MAX_LORAS Int = 8

pure fn find_hdr_end(s Text) Int {
    let n = len(s)
    var i = 0
    while i + 3 < n {
        if byte_at(s, i) == 13 && byte_at(s, i + 1) == 10 && byte_at(s, i + 2) == 13 && byte_at(s, i + 3) == 10 {
            return i
        }
        i += 1
    }
    -1
}

pure fn to_lower_ascii(c Int) Int {
    if c >= 65 && c <= 90 { c + 32 } else { c }
}

pure fn str_contains_ci(hay Text, needle Text) Bool {
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0 { return true }
    if nn > hn { return false }
    var i = 0
    while i + nn <= hn {
        var j = 0
        var ok = true
        while j < nn {
            if to_lower_ascii(byte_at(hay, i + j)) != to_lower_ascii(byte_at(needle, j)) {
                ok = false
                j = nn
            } else {
                j += 1
            }
        }
        if ok { return true }
        i += 1
    }
    false
}

pure fn hdr_get_val(hdr Text, key_colon Text) Text {
    let hn = len(hdr)
    let kn = len(key_colon)
    var i = 0
    while i + kn <= hn {
        let at_line_start = i == 0 || byte_at(hdr, i - 1) == 10
        if at_line_start {
            var j = 0
            var ok = true
            while j < kn {
                if to_lower_ascii(byte_at(hdr, i + j)) != to_lower_ascii(byte_at(key_colon, j)) {
                    ok = false
                    j = kn
                } else {
                    j += 1
                }
            }
            if ok {
                var p = i + kn
                while p < hn && (byte_at(hdr, p) == 32 || byte_at(hdr, p) == 9) { p += 1 }
                var e = p
                while e < hn && byte_at(hdr, e) != 13 && byte_at(hdr, e) != 10 { e += 1 }
                return str_slice(hdr, p, e)
            }
        }
        i += 1
    }
    ""
}

pure fn parse_cl(hdr Text) Int {
    let v = hdr_get_val(hdr, "content-length:")
    parse_int_val(v, 0)
}

pure fn parse_int_val(s Text, fallback Int) Int {
    let n = len(s)
    if n == 0 { return fallback }
    var i = 0
    var neg = false
    if byte_at(s, 0) == 45 { neg = true; i = 1 }
    if i >= n { return fallback }
    var acc = 0
    while i < n {
        let c = byte_at(s, i)
        if c < 48 || c > 57 { return fallback }
        acc = acc * 10 + (c - 48)
        i += 1
    }
    if neg { 0 - acc } else { acc }
}

pure fn parse_pos_int(s Text, fallback Int) Int {
    let v = parse_int_val(s, 0)
    if v > 0 { v } else { fallback }
}

pure fn find_byte_from(s Text, ch Int, start Int) Int {
    let n = len(s)
    var i = start
    while i < n {
        if byte_at(s, i) == ch { return i }
        i += 1
    }
    -1
}

pure fn path_clean(full_path Text) Text {
    let q = find_byte_from(full_path, 63, 0)
    if q >= 0 { str_slice(full_path, 0, q) } else { full_path }
}

pure fn split_csv(s Text) List[Text] {
    var out List[Text] = []
    let n = len(s)
    var p = 0
    while p < n {
        let c = find_byte_from(s, 44, p)
        let e = if c >= 0 { c } else { n }
        if e > p {
            out = push(out, str_slice(s, p, e))
        }
        p = if c >= 0 { c + 1 } else { n }
    }
    out
}

pure fn fnv1a_prefix(s Text) Int {
    var h = 2166136261
    let n = if len(s) < 256 { len(s) } else { 256 }
    var i = 0
    while i < n {
        h = (h ^ byte_at(s, i)) * 16777619
        h = h & 2147483647
        i += 1
    }
    h
}

fn write_json_http(cfd Int, status Int, reason Text, body Text) {
    let resp = "HTTP/1.1 " ++ int_to_text(status) ++ " " ++ reason
        ++ "\r\nContent-Type: application/json\r\nAccess-Control-Allow-Origin: *\r\nContent-Length: "
        ++ int_to_text(len(body)) ++ "\r\nConnection: close\r\n\r\n" ++ body
    let _ = net_write_text(cfd, resp)
}

fn write_text_http(cfd Int, status Int, reason Text, ctype Text, body Text) {
    let resp = "HTTP/1.1 " ++ int_to_text(status) ++ " " ++ reason
        ++ "\r\nContent-Type: " ++ ctype ++ "\r\nAccess-Control-Allow-Origin: *\r\nContent-Length: "
        ++ int_to_text(len(body)) ++ "\r\nConnection: close\r\n\r\n" ++ body
    let _ = net_write_text(cfd, resp)
}

fn write_503_backpressure(cfd Int, msg Text) {
    let body = "{\"error\":{\"message\":\"" ++ msg ++ "\",\"type\":\"overloaded\"}}"
    let resp = "HTTP/1.1 503 Service Unavailable\r\nContent-Type: application/json\r\nRetry-After: 1\r\nAccess-Control-Allow-Origin: *\r\nContent-Length: "
        ++ int_to_text(len(body)) ++ "\r\nConnection: close\r\n\r\n" ++ body
    let _ = net_write_text(cfd, resp)
}

fn http_probe_health(addr Text) Bool {
    let fd = net_tcp_connect(addr)
    if fd < 0 { return false }
    let req = "GET /health HTTP/1.1\r\nHost: " ++ addr ++ "\r\nConnection: close\r\n\r\n"
    let wn = net_write_text(fd, req)
    if wn < 0 {
        let _ = net_close(fd)
        return false
    }
    let resp = net_read_text(fd, 256)
    let _ = net_close(fd)
    str_contains_ci(resp, " 200 ")
}

pure fn hex_nibble_char(v Int) Text {
    let lut = "0123456789abcdef"
    str_slice(lut, v & 15, (v & 15) + 1)
}

pure fn hex_char_val(c Int) Int {
    if c >= 48 && c <= 57 { return c - 48 }
    if c >= 97 && c <= 102 { return c - 87 }
    if c >= 65 && c <= 70 { return c - 55 }
    -1
}

fn words_to_hex(words List[Int], n_bytes Int) Text {
    var tb = TextBuilder.new()
    var i = 0
    while i < n_bytes {
        let w = words[i / 8]
        let sh = (i & 7) * 8
        let b = (w >> sh) & 255
        tb.push_str(hex_nibble_char(b >> 4))
        tb.push_str(hex_nibble_char(b & 15))
        i += 1
    }
    tb.finish()
}

fn words_to_raw_bytes(words List[Int], n_bytes Int) Text {
    let h = buf_new()
    var i = 0
    while i < n_bytes {
        let w = words[i / 8]
        let sh = (i & 7) * 8
        let b = (w >> sh) & 255
        let _ = buf_push_byte(h, b)
        i += 1
    }
    buf_finish(h)
}

fn hex_to_words(hex Text) List[Int] {
    let n_bytes = len(hex) / 2
    var words List[Int] = list_filled((n_bytes + 7) / 8, 0)
    var i = 0
    while i < n_bytes {
        let hi = hex_char_val(byte_at(hex, i * 2))
        let lo = hex_char_val(byte_at(hex, i * 2 + 1))
        if hi < 0 || lo < 0 { return [] }
        let b = (hi << 4) | lo
        let wi = i / 8
        let sh = (i & 7) * 8
        words[wi] = words[wi] | (b << sh)
        i += 1
    }
    words
}

// Tenon v10: Prometheus TTFT/TPOT Latency Histogram Helper
record LatencyHist {
    bounds List[Int],
    buckets List[Int],
    count Int,
    sum_us Int,
}

impl LatencyHist {
    pub fn new(bounds List[Int]) LatencyHist {
        LatencyHist {
            bounds = bounds,
            buckets = list_filled(len(bounds), 0),
            count = 0,
            sum_us = 0,
        }
    }

    pub fn observe(inout self, ms Float) {
        if ms < 0.0 { return }
        self.count = self.count + 1
        self.sum_us = self.sum_us + float_to_int(ms * 1000.0)
        let n = len(self.bounds)
        var i = 0
        while i < n {
            if ms <= int_to_float(self.bounds[i]) {
                self.buckets[i] = self.buckets[i] + 1
            }
            i += 1
        }
    }

    pub fn format_prom(self, metric Text, help Text) Text {
        var tb = TextBuilder.new()
        tb.push_str("# HELP " ++ metric ++ " " ++ help ++ "\n# TYPE " ++ metric ++ " histogram\n")
        let n = len(self.bounds)
        var i = 0
        while i < n {
            tb.push_str(metric ++ "_bucket{le=\"" ++ int_to_text(self.bounds[i]) ++ "\"} " ++ int_to_text(self.buckets[i]) ++ "\n")
            i += 1
        }
        tb.push_str(metric ++ "_bucket{le=\"+Inf\"} " ++ int_to_text(self.count) ++ "\n")
        tb.push_str(metric ++ "_sum " ++ float_to_text(int_to_float(self.sum_us) / 1000.0) ++ "\n")
        tb.push_str(metric ++ "_count " ++ int_to_text(self.count) ++ "\n")
        tb.finish()
    }
}

fn http_post_raw(addr Text, path Text, ctype Text, extra_hdr Text, body Text) Text {
    let fd = net_tcp_connect(addr)
    if fd < 0 { return "" }
    let hdr = "POST " ++ path ++ " HTTP/1.1\r\nHost: " ++ addr
        ++ "\r\nContent-Type: " ++ ctype
        ++ "\r\nContent-Length: " ++ int_to_text(len(body))
        ++ "\r\n" ++ extra_hdr ++ "Connection: close\r\n\r\n"
    let wn1 = net_write_text(fd, hdr)
    if wn1 < 0 {
        let _ = net_close(fd)
        return ""
    }
    if len(body) > 0 {
        let wn2 = net_write_text(fd, body)
        if wn2 < 0 {
            let _ = net_close(fd)
            return ""
        }
    }
    var tb = TextBuilder.new()
    var reading = true
    while reading {
        let chunk = net_read_text(fd, 65536)
        if len(chunk) > 0 {
            tb.push_str(chunk)
        } else {
            reading = false
        }
    }
    let _ = net_close(fd)
    tb.finish()
}

fn format_chat(arch Text, msgs JsonValue, extra_sys Text) Text {
    var tb = TextBuilder.new()
    let n = json_len(msgs)
    var i = 0
    if arch == "llama" {
        if len(extra_sys) > 0 {
            tb.push_str("<|start_header_id|>system<|end_header_id|>\n\n")
            tb.push_str(extra_sys)
            tb.push_str("<|eot_id|>")
        }
        while i < n {
            match json_at(msgs, i) {
                Some(m) => {
                    let role = match json_get_str(m, "role") { Some(r) => r, None => "user" }
                    let content = match json_get_str(m, "content") { Some(c) => c, None => "" }
                    tb.push_str("<|start_header_id|>")
                    tb.push_str(role)
                    tb.push_str("<|end_header_id|>\n\n")
                    tb.push_str(content)
                    tb.push_str("<|eot_id|>")
                }
                None => {}
            }
            i += 1
        }
        tb.push_str("<|start_header_id|>assistant<|end_header_id|>\n\n")
    } else if arch == "qwen3moe" || arch == "qwen2" || arch == "qwen3" || arch == "qwen35" || arch == "qwen3next" {
        if len(extra_sys) > 0 {
            tb.push_str("<|im_start|>system\n")
            tb.push_str(extra_sys)
            tb.push_str("<|im_end|>\n")
        }
        while i < n {
            match json_at(msgs, i) {
                Some(m) => {
                    let role = match json_get_str(m, "role") { Some(r) => r, None => "user" }
                    let content = match json_get_str(m, "content") { Some(c) => c, None => "" }
                    tb.push_str("<|im_start|>")
                    tb.push_str(role)
                    tb.push_str("\n")
                    tb.push_str(content)
                    tb.push_str("<|im_end|>\n")
                }
                None => {}
            }
            i += 1
        }
        tb.push_str("<|im_start|>assistant\n")
    } else if arch == "gemma3" || arch == "gemma2" || arch == "gemma" {
        var sys_p = if len(extra_sys) > 0 { extra_sys ++ "\n\n" } else { "" }
        while i < n {
            match json_at(msgs, i) {
                Some(m) => {
                    let role = match json_get_str(m, "role") { Some(r) => r, None => "user" }
                    let content = match json_get_str(m, "content") { Some(c) => c, None => "" }
                    if role == "system" {
                        sys_p = sys_p ++ content ++ "\n\n"
                    } else {
                        let gr = if role == "assistant" { "model" } else { "user" }
                        tb.push_str("<start_of_turn>")
                        tb.push_str(gr)
                        tb.push_str("\n")
                        if gr == "user" && len(sys_p) > 0 {
                            tb.push_str(sys_p)
                            sys_p = ""
                        }
                        tb.push_str(content)
                        tb.push_str("<end_of_turn>\n")
                    }
                }
                None => {}
            }
            i += 1
        }
        tb.push_str("<start_of_turn>model\n")
    } else if arch == "deepseek2" {
        if len(extra_sys) > 0 {
            tb.push_str(extra_sys)
            tb.push_str("\n\n")
        }
        while i < n {
            match json_at(msgs, i) {
                Some(m) => {
                    let role = match json_get_str(m, "role") { Some(r) => r, None => "user" }
                    let content = match json_get_str(m, "content") { Some(c) => c, None => "" }
                    if role == "system" {
                        tb.push_str(content)
                        tb.push_str("\n\n")
                    } else if role == "assistant" {
                        tb.push_str("Assistant: ")
                        tb.push_str(content)
                        tb.push_str("\n\n")
                    } else {
                        tb.push_str("User: ")
                        tb.push_str(content)
                        tb.push_str("\n\n")
                    }
                }
                None => {}
            }
            i += 1
        }
        tb.push_str("Assistant:")
    } else {
        if len(extra_sys) > 0 {
            tb.push_str("system: ")
            tb.push_str(extra_sys)
            tb.push_str("\n")
        }
        while i < n {
            match json_at(msgs, i) {
                Some(m) => {
                    let role = match json_get_str(m, "role") { Some(r) => r, None => "user" }
                    let content = match json_get_str(m, "content") { Some(c) => c, None => "" }
                    tb.push_str(role)
                    tb.push_str(": ")
                    tb.push_str(content)
                    tb.push_str("\n")
                }
                None => {}
            }
            i += 1
        }
        tb.push_str("assistant: ")
    }
    tb.finish()
}

fn is_stop_piece(tok Int, eos Int, piece Text) Bool {
    tok == eos || piece == "<|eot_id|>" || piece == "<|eom_id|>" || piece == "<|eoft_id|>" || piece == "<|end_of_text|>" || piece == "<|im_end|>" || piece == "<|endoftext|>" || piece == "<end_of_turn>" || piece == "</s>"
}

fn f32_bits_to_float(bits Int) Float {
    let sign = (bits >> 31) & 1
    let exp = (bits >> 23) & 255
    let frac = bits & 8388607
    if exp == 0 {
        return 0.0
    }
    var m = 1.0 + int_to_float(frac) / 8388608.0
    var e = exp - 127
    while e > 0 {
        m = m * 2.0
        e -= 1
    }
    while e < 0 {
        m = m * 0.5
        e += 1
    }
    if sign != 0 { 0.0 - m } else { m }
}

fn write_sse_piece(cfd Int, model_name Text, is_chat Bool, piece Text) Bool {
    var chunk = json_obj_new()
    var ch = json_obj_new()
    ch = json_obj_set(ch, "index", JInt(0))
    if is_chat {
        var delta = json_obj_new()
        delta = json_obj_set(delta, "content", JStr(piece))
        ch = json_obj_set(ch, "delta", delta)
        chunk = json_obj_set(chunk, "object", JStr("chat.completion.chunk"))
    } else {
        ch = json_obj_set(ch, "text", JStr(piece))
        chunk = json_obj_set(chunk, "object", JStr("text_completion"))
    }
    var chs = json_arr_new()
    chs = json_arr_push(chs, ch)
    chunk = json_obj_set(chunk, "model", JStr(model_name))
    chunk = json_obj_set(chunk, "choices", chs)
    let wn = net_write_text(cfd, "data: " ++ chunk.stringify() ++ "\n\n")
    wn >= 0
}

fn send_final_cb_response(
    cfd Int,
    model_name Text,
    is_chat Bool,
    want_stream Bool,
    gen_text Text,
    prompt_toks Int,
    cached_toks Int,
    gen_toks Int,
    slot_id Int,
    pf_ms Float,
    dec_ms Float,
    finish_reason Text
) {
    if want_stream {
        let _ = net_write_text(cfd, "data: [DONE]\n\n")
        let _ = net_close(cfd)
        return
    }
    var choice = json_obj_new()
    choice = json_obj_set(choice, "index", JInt(0))
    if is_chat {
        var msg = json_obj_new()
        msg = json_obj_set(msg, "role", JStr("assistant"))
        msg = json_obj_set(msg, "content", JStr(gen_text))
        choice = json_obj_set(choice, "message", msg)
    } else {
        choice = json_obj_set(choice, "text", JStr(gen_text))
    }
    choice = json_obj_set(choice, "finish_reason", JStr(finish_reason))
    var choices = json_arr_new()
    choices = json_arr_push(choices, choice)

    var pd = json_obj_new()
    pd = json_obj_set(pd, "cached_tokens", JInt(cached_toks))
    var usage = json_obj_new()
    usage = json_obj_set(usage, "prompt_tokens", JInt(prompt_toks))
    usage = json_obj_set(usage, "completion_tokens", JInt(gen_toks))
    usage = json_obj_set(usage, "total_tokens", JInt(prompt_toks + gen_toks))
    usage = json_obj_set(usage, "prompt_tokens_details", pd)

    var timings = json_obj_new()
    timings = json_obj_set(timings, "kv_slot", JInt(slot_id))
    timings = json_obj_set(timings, "cached_prefix_tokens", JInt(cached_toks))
    timings = json_obj_set(timings, "prefill_ms", JFloat(pf_ms))
    timings = json_obj_set(timings, "decode_ms", JFloat(dec_ms))

    var resp = json_obj_new()
    resp = json_obj_set(resp, "id", JStr("chatcmpl-tenon-native-v10"))
    resp = json_obj_set(resp, "object", JStr(if is_chat { "chat.completion" } else { "text_completion" }))
    resp = json_obj_set(resp, "model", JStr(model_name))
    resp = json_obj_set(resp, "choices", choices)
    resp = json_obj_set(resp, "usage", usage)
    resp = json_obj_set(resp, "timings", timings)
    write_json_http(cfd, 200, "OK", resp.stringify())
    let _ = net_close(cfd)
}

fn handle_embeddings(cfd Int, handle Int, model_name Text, body Text) {
    match JsonValue.parse(body) {
        Err(_) => {
            write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid json\"}")
        }
        Ok(jv) => {
            let txt = match json_get_str(jv, "input") { Some(s) => s, None => "hello" }
            let dm = unsafe { tn_moe_info(handle, 1) }
            let bos = unsafe { tn_moe_info(handle, 11) }
            var tok_buf List[Int] = list_filled(256, 0)
            let nt = unsafe { tn_moe_tokenize(handle, text_cstr_ptr(txt), list_data_ptr(tok_buf), 255) }
            let n_emb = if bos >= 0 { nt + 1 } else if nt > 0 { nt } else { 1 }
            var ids List[Int] = list_filled(n_emb, 0)
            if bos >= 0 {
                ids[0] = bos
                var ti = 0
                while ti < nt { ids[ti + 1] = tok_buf[ti]; ti += 1 }
            } else {
                var ti = 0
                while ti < nt { ids[ti] = tok_buf[ti]; ti += 1 }
            }
            var raw_f32 List[Int] = list_filled((dm + 1) / 2, 0)
            let got = unsafe { tn_moe_embed_text(handle, list_data_ptr(ids), n_emb, list_data_ptr(raw_f32), dm) }
            var emb_arr = json_arr_new()
            var di = 0
            while di < got {
                let word = raw_f32[di / 2]
                let bits = if (di & 1) == 0 { word & 4294967295 } else { (word >> 32) & 4294967295 }
                emb_arr = json_arr_push(emb_arr, JFloat(f32_bits_to_float(bits)))
                di += 1
            }
            var item = json_obj_new()
            item = json_obj_set(item, "object", JStr("embedding"))
            item = json_obj_set(item, "index", JInt(0))
            item = json_obj_set(item, "embedding", emb_arr)
            var data = json_arr_new()
            data = json_arr_push(data, item)
            var out = json_obj_new()
            out = json_obj_set(out, "object", JStr("list"))
            out = json_obj_set(out, "model", JStr(model_name))
            out = json_obj_set(out, "data", data)
            write_json_http(cfd, 200, "OK", out.stringify())
        }
    }
    let _ = net_close(cfd)
}

// Tenon v11: Layer-Wise Streaming (`TNKL`) + POSIX SHM + Raw Binary HTTP + Hex Fallback Disaggregated Prefill!
// Returns: >0 = bytes sent (positive), -1 = SHM success, -3 = Layer-Stream success, 0 = error
fn handle_pd_prefill(
    cfd Int,
    handle Int,
    arch Text,
    model_name Text,
    full_path Text,
    hdr Text,
    body Text,
    port Int,
    shm_seq Int,
    inout ttft_hist LatencyHist,
    inout out_layer_bytes Int
) Int {
    match JsonValue.parse(body) {
        Err(_) => {
            write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid json\"}")
            let _ = net_close(cfd)
            0
        }
        Ok(jv) => {
            let prompt = match json_get(jv, "messages") {
                Some(msgs) => format_chat(arch, msgs, "")
                None => match json_get_str(jv, "prompt") { Some(p) => p, None => "" }
            }
            if len(prompt) == 0 {
                write_json_http(cfd, 400, "Bad Request", "{\"error\":\"missing prompt\"}")
                let _ = net_close(cfd)
                return 0
            }
            let req_tr = match json_get_str(jv, "transport") { Some(s) => s, None => "" }
            let want_layer = req_tr == "layer" || str_contains_ci(full_path, "transport=layer")
            let want_shm = !want_layer && (req_tr == "shm" || str_contains_ci(full_path, "transport=shm"))
            let want_bin = !want_shm && !want_layer && (req_tr == "binary" || str_contains_ci(full_path, "format=binary") || str_contains_ci(hdr_get_val(hdr, "accept:"), "application/octet-stream"))

            let bos = unsafe { tn_moe_info(handle, 11) }
            var tok_buf List[Int] = list_filled(HIST_STRIDE, 0)
            let nt = unsafe { tn_moe_tokenize(handle, text_cstr_ptr(prompt), list_data_ptr(tok_buf), HIST_STRIDE - 2) }
            let n_prompt = if bos >= 0 { nt + 1 } else if nt > 0 { nt } else { 1 }
            var ids List[Int] = list_filled(n_prompt, 0)
            if bos >= 0 {
                ids[0] = bos
                var i = 0
                while i < nt { ids[i + 1] = tok_buf[i]; i += 1 }
            } else {
                var i = 0
                while i < nt { ids[i] = tok_buf[i]; i += 1 }
            }
            let pd_slot = 24
            let _ = unsafe { tn_moe_paged_seq_free(handle, pd_slot) }
            let t0 = moe_now_ms()
            let first_tok = unsafe { tn_moe_paged_prefill(handle, pd_slot, list_data_ptr(ids), n_prompt, 0) }
            let pf_ms = moe_now_ms() - t0
            ttft_hist.observe(pf_ms)
            let piece0 = unsafe { cstr_to_text(tn_moe_token_cstr(handle, first_tok)) }

            if want_layer {
                let n_layers = unsafe { tn_moe_info(handle, 0) }
                let lchunk = match json_get_int(jv, "layer_chunk") { Some(n) => if n > 0 { n } else { 4 }, None => 4 }
                let dec_worker = match json_get_str(jv, "decode_worker") { Some(s) => s, None => "" }
                let dst_slot = match json_get_int(jv, "slot") { Some(n) => n, None => 25 }
                var ls = 0
                var tot_bytes = 0
                var n_chunks = 0
                var push_ok = true
                while ls < n_layers && push_ok {
                    let rem_l = n_layers - ls
                    let lc = if rem_l < lchunk { rem_l } else { lchunk }
                    let need = unsafe { tn_moe_kv_layer_bytes(handle, pd_slot, n_prompt, ls, lc) }
                    if need <= 0 {
                        push_ok = false
                    } else {
                        var lbuf List[Int] = list_filled((need + 7) / 8, 0)
                        let wrote = unsafe { tn_moe_kv_export_layer(handle, pd_slot, n_prompt, ls, lc, list_data_ptr(lbuf), need) }
                        if wrote != need {
                            push_ok = false
                        } else {
                            tot_bytes += wrote
                            n_chunks += 1
                            if len(dec_worker) > 0 {
                                let raw_ch = words_to_raw_bytes(lbuf, wrote)
                                let ehdr = "X-Tenon-PD-Slot: " ++ int_to_text(dst_slot)
                                    ++ "\r\nX-Tenon-PD-Layer-Start: " ++ int_to_text(ls) ++ "\r\n"
                                let pr = http_post_raw(dec_worker, "/v1/pd/layer", "application/octet-stream", ehdr, raw_ch)
                                if !str_contains_ci(pr, " 200 ") {
                                    push_ok = false
                                }
                            }
                        }
                    }
                    ls += lc
                }
                let _ = unsafe { tn_moe_paged_seq_free(handle, pd_slot) }
                if !push_ok {
                    write_json_http(cfd, 502, "Bad Gateway", "{\"error\":\"layer-stream PD push failed\"}")
                    let _ = net_close(cfd)
                    return 0
                }
                out_layer_bytes = tot_bytes
                var out = json_obj_new()
                out = json_obj_set(out, "object", JStr("tenon.pd.prefill"))
                out = json_obj_set(out, "transport", JStr("layer"))
                out = json_obj_set(out, "model", JStr(model_name))
                out = json_obj_set(out, "slot", JInt(dst_slot))
                out = json_obj_set(out, "layers_streamed", JInt(n_layers))
                out = json_obj_set(out, "chunks", JInt(n_chunks))
                out = json_obj_set(out, "first_tok", JInt(first_tok))
                out = json_obj_set(out, "first_piece", JStr(piece0))
                out = json_obj_set(out, "prompt_tokens", JInt(n_prompt))
                out = json_obj_set(out, "kv_bytes", JInt(tot_bytes))
                out = json_obj_set(out, "prefill_ms", JFloat(pf_ms))
                write_json_http(cfd, 200, "OK", out.stringify())
                let _ = net_close(cfd)
                return -3
            }

            if want_shm {
                let shm_name = "/tnpd_" ++ int_to_text(port) ++ "_" ++ int_to_text(shm_seq)
                let wrote = unsafe { tn_moe_kv_export_shm(handle, pd_slot, n_prompt, text_cstr_ptr(shm_name)) }
                let _ = unsafe { tn_moe_paged_seq_free(handle, pd_slot) }
                if wrote <= 0 {
                    write_json_http(cfd, 500, "Internal Server Error", "{\"error\":\"kv shm export failed\"}")
                    let _ = net_close(cfd)
                    return 0
                }
                var out = json_obj_new()
                out = json_obj_set(out, "object", JStr("tenon.pd.prefill"))
                out = json_obj_set(out, "transport", JStr("shm"))
                out = json_obj_set(out, "model", JStr(model_name))
                out = json_obj_set(out, "shm_name", JStr(shm_name))
                out = json_obj_set(out, "first_tok", JInt(first_tok))
                out = json_obj_set(out, "first_piece", JStr(piece0))
                out = json_obj_set(out, "prompt_tokens", JInt(n_prompt))
                out = json_obj_set(out, "kv_bytes", JInt(wrote))
                out = json_obj_set(out, "prefill_ms", JFloat(pf_ms))
                write_json_http(cfd, 200, "OK", out.stringify())
                let _ = net_close(cfd)
                return -1
            }

            let kv_sz = unsafe { tn_moe_kv_slot_bytes(handle, pd_slot, n_prompt) }
            var blob List[Int] = list_filled((kv_sz + 7) / 8, 0)
            let wrote = unsafe { tn_moe_kv_export_slot(handle, pd_slot, n_prompt, list_data_ptr(blob), kv_sz) }
            let _ = unsafe { tn_moe_paged_seq_free(handle, pd_slot) }
            if wrote <= 0 {
                write_json_http(cfd, 500, "Internal Server Error", "{\"error\":\"kv export failed\"}")
                let _ = net_close(cfd)
                return 0
            }
            if want_bin {
                let raw = words_to_raw_bytes(blob, wrote)
                let resp_hdr = "HTTP/1.1 200 OK\r\nContent-Type: application/octet-stream\r\nAccess-Control-Allow-Origin: *"
                    ++ "\r\nX-Tenon-PD-Transport: binary\r\nX-Tenon-PD-Model: " ++ model_name
                    ++ "\r\nX-Tenon-PD-First-Tok: " ++ int_to_text(first_tok)
                    ++ "\r\nX-Tenon-PD-Prompt-Tokens: " ++ int_to_text(n_prompt)
                    ++ "\r\nX-Tenon-PD-KV-Bytes: " ++ int_to_text(wrote)
                    ++ "\r\nX-Tenon-PD-Prefill-Ms: " ++ float_to_text(pf_ms)
                    ++ "\r\nContent-Length: " ++ int_to_text(len(raw)) ++ "\r\nConnection: close\r\n\r\n"
                let _ = net_write_text(cfd, resp_hdr)
                let _ = net_write_text(cfd, raw)
                let _ = net_close(cfd)
                return wrote
            }
            let hex = words_to_hex(blob, wrote)
            var out = json_obj_new()
            out = json_obj_set(out, "object", JStr("tenon.pd.prefill"))
            out = json_obj_set(out, "transport", JStr("hex"))
            out = json_obj_set(out, "model", JStr(model_name))
            out = json_obj_set(out, "first_tok", JInt(first_tok))
            out = json_obj_set(out, "first_piece", JStr(piece0))
            out = json_obj_set(out, "prompt_tokens", JInt(n_prompt))
            out = json_obj_set(out, "kv_bytes", JInt(wrote))
            out = json_obj_set(out, "prefill_ms", JFloat(pf_ms))
            out = json_obj_set(out, "kv_blob_hex", JStr(hex))
            write_json_http(cfd, 200, "OK", out.stringify())
            let _ = net_close(cfd)
            1
        }
    }
}

// Tenon v11: Layer-Wise Streaming PD Chunk Ingest (`POST /v1/pd/layer`)
fn handle_pd_layer(cfd Int, handle Int, hdr Text, body Text) Int {
    if len(body) < 48 {
        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"truncated TNKL payload\"}")
        let _ = net_close(cfd)
        return 0
    }
    let slot = parse_pos_int(hdr_get_val(hdr, "x-tenon-pd-slot:"), 25)
    let ls = parse_int_val(hdr_get_val(hdr, "x-tenon-pd-layer-start:"), -1)
    if ls == 0 {
        let _ = unsafe { tn_moe_paged_seq_free(handle, slot) }
    }
    let imported = unsafe { tn_moe_kv_import_layer(handle, slot, text_cstr_ptr(body), len(body)) }
    if imported <= 0 {
        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid or corrupted TNKL layer chunk\"}")
        let _ = net_close(cfd)
        return 0
    }
    var out = json_obj_new()
    out = json_obj_set(out, "status", JStr("ok"))
    out = json_obj_set(out, "slot", JInt(slot))
    out = json_obj_set(out, "imported_tokens", JInt(imported))
    out = json_obj_set(out, "bytes", JInt(len(body)))
    write_json_http(cfd, 200, "OK", out.stringify())
    let _ = net_close(cfd)
    len(body)
}

// Returns: >0 = raw binary bytes imported, -1 = SHM imported, -2 = hex imported, -3 = layer_ready decoded, 0 = error
fn handle_pd_decode(
    cfd Int,
    handle Int,
    eos Int,
    model_name Text,
    hdr Text,
    body Text,
    inout tpot_hist LatencyHist
) Int {
    var pd_slot = 25
    let is_bin = str_contains_ci(hdr_get_val(hdr, "content-type:"), "application/octet-stream")
    var first_tok = 0
    var max_toks = 16
    var imported = 0
    var ret_code = 0

    if is_bin {
        first_tok = parse_int_val(hdr_get_val(hdr, "x-tenon-pd-first-tok:"), 0)
        max_toks = parse_pos_int(hdr_get_val(hdr, "x-tenon-pd-max-tokens:"), 16)
        imported = unsafe { tn_moe_kv_import_slot(handle, pd_slot, text_cstr_ptr(body), len(body)) }
        if imported <= 0 {
            write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid binary TNKV blob\"}")
            let _ = net_close(cfd)
            return 0
        }
        ret_code = len(body)
    } else {
        match JsonValue.parse(body) {
            Err(_) => {
                write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid json\"}")
                let _ = net_close(cfd)
                return 0
            }
            Ok(jv) => {
                first_tok = match json_get_int(jv, "first_tok") { Some(n) => n, None => 0 }
                max_toks = match json_get_int(jv, "max_tokens") { Some(n) => n, None => 16 }
                let layer_ready = match json_get_bool(jv, "layer_ready") { Some(b) => b, None => false }
                let shm_name = match json_get_str(jv, "shm_name") { Some(s) => s, None => "" }
                if layer_ready {
                    pd_slot = match json_get_int(jv, "slot") { Some(n) => n, None => 25 }
                    imported = match json_get_int(jv, "prompt_tokens") { Some(n) => if n > 0 { n } else { 1 }, None => 1 }
                    ret_code = -3
                } else if len(shm_name) > 0 {
                    imported = unsafe { tn_moe_kv_import_shm(handle, pd_slot, text_cstr_ptr(shm_name), 1) }
                    if imported <= 0 {
                        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid or missing POSIX SHM segment\"}")
                        let _ = net_close(cfd)
                        return 0
                    }
                    ret_code = -1
                } else {
                    let hex = match json_get_str(jv, "kv_blob_hex") { Some(s) => s, None => "" }
                    if len(hex) < 128 || (len(hex) & 1) != 0 {
                        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"missing shm_name, binary body, or kv_blob_hex\"}")
                        let _ = net_close(cfd)
                        return 0
                    }
                    let n_bytes = len(hex) / 2
                    let blob = hex_to_words(hex)
                    if len(blob) == 0 {
                        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"malformed hex\"}")
                        let _ = net_close(cfd)
                        return 0
                    }
                    imported = unsafe { tn_moe_kv_import_slot(handle, pd_slot, list_data_ptr(blob), n_bytes) }
                    if imported <= 0 {
                        write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid or corrupted TNKV blob\"}")
                        let _ = net_close(cfd)
                        return 0
                    }
                    ret_code = -2
                }
            }
        }
    }

    let t0 = moe_now_ms()
    var tb = TextBuilder.new()
    var gen = 0
    var cur = first_tok
    var pos = imported
    var ta List[Int] = list_filled(1, 0)
    var pa List[Int] = list_filled(1, 0)
    var sa List[Int] = list_filled(1, pd_slot)
    var oa List[Int] = list_filled(1, 0)
    var finish_reason = "length"
    while gen < max_toks {
        let piece = unsafe { cstr_to_text(tn_moe_token_cstr(handle, cur)) }
        if is_stop_piece(cur, eos, piece) {
            finish_reason = "stop"
            break
        }
        tb.push_str(piece)
        gen += 1
        if gen >= max_toks { break }
        ta[0] = cur
        pa[0] = pos
        let _ = unsafe { tn_moe_step_batch(handle, list_data_ptr(ta), list_data_ptr(pa), list_data_ptr(sa), 1, list_data_ptr(oa)) }
        cur = oa[0]
        pos += 1
    }
    let dec_ms = moe_now_ms() - t0
    if gen > 0 && dec_ms > 0.0 {
        let denom = if gen > 1 { gen - 1 } else { 1 }
        tpot_hist.observe(dec_ms / int_to_float(denom))
    }
    let _ = unsafe { tn_moe_paged_seq_free(handle, pd_slot) }
    send_final_cb_response(cfd, model_name, false, false, tb.finish(), imported, imported, gen, pd_slot, 0.0, dec_ms, finish_reason)
    ret_code
}

// =========================================================================
// Tenon v11: Production HA Pure-Tenon Zero-Rust Disaggregated PD Router!
// Prefix-Affinity + Layer-Stream/SHM/Binary + Health Checks + Circuit Breaker
// + Automatic Worker Failover + Queue Backpressure (HTTP 503)!
// =========================================================================
fn run_pd_router_mode(addr Text) Int {
    let pf_workers = split_csv(sys_env("TENON_PREFILL_WORKERS"))
    let dec_workers = split_csv(sys_env("TENON_DECODE_WORKERS"))
    if len(pf_workers) == 0 || len(dec_workers) == 0 {
        println("[tenon-pd-router-v11] error: TENON_PREFILL_WORKERS and TENON_DECODE_WORKERS must be set")
        return 1
    }
    let tr_env = sys_env("TENON_PD_TRANSPORT")
    let def_transport = if len(tr_env) > 0 { tr_env } else { "binary" }
    let max_queue = parse_pos_int(sys_env("TENON_MAX_QUEUE"), 64)

    let lfd = net_tcp_listen(addr)
    if lfd < 0 {
        println("[tenon-pd-router-v11] listen failed on [" ++ addr ++ "]")
        return 1
    }
    let port = net_tcp_local_port(lfd)
    let _ = net_set_nonblocking(lfd, true)
    let rfd = reactor_new()
    let _ = reactor_add(rfd, lfd, EVENT_READ, 0)

    println("[tenon-pd-router-v11] Production HA Pure-Tenon Zero-Rust PD Router v11 listening on http://" ++ addr
        ++ " (port=" ++ int_to_text(port) ++ ", transport=" ++ def_transport
        ++ ", max_queue=" ++ int_to_text(max_queue)
        ++ ", prefill_workers=" ++ int_to_text(len(pf_workers))
        ++ ", decode_workers=" ++ int_to_text(len(dec_workers)) ++ ")")

    var rd_fds List[Int] = list_filled(MAX_RD, -1)
    var rd_bufs List[Text] = list_filled(MAX_RD, "")
    var pf_unhealthy_until List[Float] = list_filled(len(pf_workers), 0.0)
    var pf_failures List[Int] = list_filled(len(pf_workers), 0)
    var dec_unhealthy_until List[Float] = list_filled(len(dec_workers), 0.0)
    var dec_failures List[Int] = list_filled(len(dec_workers), 0)
    var router_reqs = 0
    var shm_transfers = 0
    var layer_streams = 0
    var binary_bytes = 0
    var router_failovers = 0
    var router_backpressure = 0
    var dec_rr = 0
    var ttft_hist = LatencyHist.new([10, 25, 50, 100, 250, 500, 1000, 2500])
    var tpot_hist = LatencyHist.new([2, 5, 10, 20, 50, 100, 250])
    var running = true

    while running {
        let evs = reactor_wait(rfd, 25, 64)
        var ei = 0
        while ei < len(evs) {
            let tok = event_token(evs[ei])
            if tok == 0 {
                var accepting = true
                while accepting {
                    let cfd = net_tcp_accept(lfd)
                    if cfd >= 0 {
                        var free_rd = -1
                        var ri = 0
                        while ri < MAX_RD {
                            if rd_fds[ri] < 0 { free_rd = ri; ri = MAX_RD } else { ri += 1 }
                        }
                        if free_rd >= 0 {
                            let _ = net_set_nonblocking(cfd, true)
                            let _ = net_set_nodelay(cfd, true)
                            let _ = reactor_add(rfd, cfd, EVENT_READ, cfd)
                            rd_fds[free_rd] = cfd
                            rd_bufs[free_rd] = ""
                        } else {
                            router_backpressure += 1
                            write_503_backpressure(cfd, "PD router connection pool saturated")
                            let _ = net_close(cfd)
                        }
                    } else {
                        accepting = false
                    }
                }
            } else {
                var rslot = -1
                var ri = 0
                while ri < MAX_RD {
                    if rd_fds[ri] == tok { rslot = ri; ri = MAX_RD } else { ri += 1 }
                }
                if rslot >= 0 {
                    var closed = false
                    var reading = true
                    while reading {
                        let chunk = net_read_text(tok, 16384)
                        if len(chunk) > 0 {
                            rd_bufs[rslot] = rd_bufs[rslot] ++ chunk
                        } else {
                            if !net_last_would_block() { closed = true }
                            reading = false
                        }
                    }
                    let buf = rd_bufs[rslot]
                    let hend = find_hdr_end(buf)
                    if hend >= 0 {
                        let hdr = str_slice(buf, 0, hend)
                        let clen = parse_cl(hdr)
                        if len(buf) >= hend + 4 + clen {
                            let _ = reactor_del(rfd, tok)
                            let _ = net_set_nonblocking(tok, false)
                            rd_fds[rslot] = -1
                            rd_bufs[rslot] = ""

                            var sp1 = 0
                            while sp1 < hend && byte_at(buf, sp1) != 32 { sp1 += 1 }
                            var sp2 = sp1 + 1
                            while sp2 < hend && byte_at(buf, sp2) != 32 { sp2 += 1 }
                            let method = str_slice(buf, 0, sp1)
                            let full_path = str_slice(buf, sp1 + 1, sp2)
                            let path = path_clean(full_path)
                            let body = if clen > 0 && hend + 4 + clen <= len(buf) {
                                str_slice(buf, hend + 4, hend + 4 + clen)
                            } else {
                                ""
                            }

                            if method == "OPTIONS" {
                                let _ = net_write_text(tok, "HTTP/1.1 204 No Content\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: Content-Type, Authorization\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\nConnection: close\r\n\r\n")
                                let _ = net_close(tok)
                            } else if method == "POST" && path == "/shutdown" {
                                running = false
                                write_json_http(tok, 200, "OK", "{\"status\":\"shutting_down\"}")
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/health" {
                                let now_h = moe_now_ms()
                                var pwa = json_arr_new()
                                var pha = json_arr_new()
                                var wi = 0
                                while wi < len(pf_workers) {
                                    pwa = json_arr_push(pwa, JStr(pf_workers[wi]))
                                    var hobj = json_obj_new()
                                    hobj = json_obj_set(hobj, "addr", JStr(pf_workers[wi]))
                                    hobj = json_obj_set(hobj, "healthy", JBool(pf_unhealthy_until[wi] <= now_h))
                                    hobj = json_obj_set(hobj, "failures", JInt(pf_failures[wi]))
                                    pha = json_arr_push(pha, hobj)
                                    wi += 1
                                }
                                var dwa = json_arr_new()
                                var dha = json_arr_new()
                                wi = 0
                                while wi < len(dec_workers) {
                                    dwa = json_arr_push(dwa, JStr(dec_workers[wi]))
                                    var hobj = json_obj_new()
                                    hobj = json_obj_set(hobj, "addr", JStr(dec_workers[wi]))
                                    hobj = json_obj_set(hobj, "healthy", JBool(dec_unhealthy_until[wi] <= now_h))
                                    hobj = json_obj_set(hobj, "failures", JInt(dec_failures[wi]))
                                    dha = json_arr_push(dha, hobj)
                                    wi += 1
                                }
                                var obj = json_obj_new()
                                obj = json_obj_set(obj, "status", JStr("ok"))
                                obj = json_obj_set(obj, "engine", JStr("tenon-native-zero-rust-v11-pd-router"))
                                obj = json_obj_set(obj, "role", JStr("pd-router"))
                                obj = json_obj_set(obj, "transport", JStr(def_transport))
                                obj = json_obj_set(obj, "max_queue", JInt(max_queue))
                                obj = json_obj_set(obj, "prefill_workers", pwa)
                                obj = json_obj_set(obj, "decode_workers", dwa)
                                obj = json_obj_set(obj, "prefill_health", pha)
                                obj = json_obj_set(obj, "decode_health", dha)
                                obj = json_obj_set(obj, "pd_router_requests", JInt(router_reqs))
                                obj = json_obj_set(obj, "pd_shm_transfers", JInt(shm_transfers))
                                obj = json_obj_set(obj, "pd_layer_streams", JInt(layer_streams))
                                obj = json_obj_set(obj, "pd_binary_bytes", JInt(binary_bytes))
                                obj = json_obj_set(obj, "router_failovers", JInt(router_failovers))
                                obj = json_obj_set(obj, "router_backpressure", JInt(router_backpressure))
                                write_json_http(tok, 200, "OK", obj.stringify())
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/metrics" {
                                var mt = TextBuilder.new()
                                mt.push_str("# HELP tenon_pd_router_requests_total Total OpenAI requests routed across PD cluster\n# TYPE tenon_pd_router_requests_total counter\ntenon_pd_router_requests_total ")
                                mt.push_str(int_to_text(router_reqs))
                                mt.push_str("\n# HELP tenon_pd_shm_transfers_total Zero-copy POSIX SHM PD transfers\n# TYPE tenon_pd_shm_transfers_total counter\ntenon_pd_shm_transfers_total ")
                                mt.push_str(int_to_text(shm_transfers))
                                mt.push_str("\n# HELP tenon_pd_layer_streams_total Layer-wise streaming TNKL PD transfers\n# TYPE tenon_pd_layer_streams_total counter\ntenon_pd_layer_streams_total ")
                                mt.push_str(int_to_text(layer_streams))
                                mt.push_str("\n# HELP tenon_pd_binary_bytes_total Raw binary HTTP PD KV bytes\n# TYPE tenon_pd_binary_bytes_total counter\ntenon_pd_binary_bytes_total ")
                                mt.push_str(int_to_text(binary_bytes))
                                mt.push_str("\n# HELP tenon_router_failovers_total Automatic circuit-breaker worker failovers\n# TYPE tenon_router_failovers_total counter\ntenon_router_failovers_total ")
                                mt.push_str(int_to_text(router_failovers))
                                mt.push_str("\n# HELP tenon_router_backpressure_total Requests shed with HTTP 503 due to queue backpressure\n# TYPE tenon_router_backpressure_total counter\ntenon_router_backpressure_total ")
                                mt.push_str(int_to_text(router_backpressure))
                                mt.push_str("\n")
                                mt.push_str(ttft_hist.format_prom("tenon_ttft_ms", "Time-to-first-token (prefill) latency in ms"))
                                mt.push_str(tpot_hist.format_prom("tenon_tpot_ms", "Time-per-output-token (decode) latency in ms"))
                                write_text_http(tok, 200, "OK", "text/plain; version=0.0.4", mt.finish())
                                let _ = net_close(tok)
                            } else if method == "POST" && (path == "/v1/chat/completions" || path == "/v1/completions") {
                                let is_chat = path == "/v1/chat/completions"
                                match JsonValue.parse(body) {
                                    Err(_) => {
                                        write_json_http(tok, 400, "Bad Request", "{\"error\":\"invalid json\"}")
                                        let _ = net_close(tok)
                                    }
                                    Ok(jv) => {
                                        router_reqs += 1
                                        let max_toks = match json_get_int(jv, "max_tokens") { Some(n) => n, None => 32 }
                                        let tr_req = match json_get_str(jv, "transport") { Some(s) => s, None => def_transport }
                                        let use_layer = tr_req == "layer"
                                        let use_shm = !use_layer && tr_req == "shm"
                                        let lchunk = match json_get_int(jv, "layer_chunk") { Some(n) => if n > 0 { n } else { 4 }, None => 4 }

                                        let n_pf = len(pf_workers)
                                        let n_dec = len(dec_workers)
                                        let pf_start = fnv1a_prefix(body) % n_pf
                                        let dec_start = dec_rr % n_dec
                                        dec_rr += 1
                                        let now_r = moe_now_ms()

                                        // Build healthy-first candidate lists (circuit breaker with 15s cooldown)
                                        var pf_order List[Int] = []
                                        var pass_k = 0
                                        while pass_k < 2 {
                                            var k = 0
                                            while k < n_pf {
                                                let idx = (pf_start + k) % n_pf
                                                let is_h = pf_unhealthy_until[idx] <= now_r
                                                if (pass_k == 0 && is_h) || (pass_k == 1 && !is_h) {
                                                    pf_order = push(pf_order, idx)
                                                }
                                                k += 1
                                            }
                                            pass_k += 1
                                        }
                                        var dec_order List[Int] = []
                                        pass_k = 0
                                        while pass_k < 2 {
                                            var k = 0
                                            while k < n_dec {
                                                let idx = (dec_start + k) % n_dec
                                                let is_h = dec_unhealthy_until[idx] <= now_r
                                                if (pass_k == 0 && is_h) || (pass_k == 1 && !is_h) {
                                                    dec_order = push(dec_order, idx)
                                                }
                                                k += 1
                                            }
                                            pass_k += 1
                                        }

                                        let t_all = moe_now_ms()
                                        var pf_addr = pf_workers[pf_order[0]]
                                        var dec_addr = dec_workers[dec_order[0]]
                                        var pf_ms = 0.0
                                        var kv_bytes = 0
                                        var dec_raw = ""
                                        var ok_pf = false

                                        if use_layer {
                                            var found_dec = false
                                            var di = 0
                                            while di < len(dec_order) && !found_dec {
                                                let d_idx = dec_order[di]
                                                if http_probe_health(dec_workers[d_idx]) {
                                                    dec_unhealthy_until[d_idx] = 0.0
                                                    dec_addr = dec_workers[d_idx]
                                                    found_dec = true
                                                } else {
                                                    dec_unhealthy_until[d_idx] = moe_now_ms() + 15000.0
                                                    dec_failures[d_idx] = dec_failures[d_idx] + 1
                                                    if di + 1 < len(dec_order) { router_failovers += 1 }
                                                }
                                                di += 1
                                            }
                                            if found_dec {
                                                var pbody = jv
                                                pbody = json_obj_set(pbody, "transport", JStr("layer"))
                                                pbody = json_obj_set(pbody, "layer_chunk", JInt(lchunk))
                                                pbody = json_obj_set(pbody, "decode_worker", JStr(dec_addr))
                                                pbody = json_obj_set(pbody, "slot", JInt(25))
                                                let pstr = pbody.stringify()
                                                var pi = 0
                                                while pi < len(pf_order) && !ok_pf {
                                                    let p_idx = pf_order[pi]
                                                    let cand_pf = pf_workers[p_idx]
                                                    let pf_raw = http_post_raw(cand_pf, "/v1/pd/prefill?transport=layer", "application/json", "", pstr)
                                                    let phe = find_hdr_end(pf_raw)
                                                    if phe >= 0 && str_contains_ci(str_slice(pf_raw, 0, phe), " 200 ") {
                                                        let pb = str_slice(pf_raw, phe + 4, len(pf_raw))
                                                        match JsonValue.parse(pb) {
                                                            Ok(pj) => {
                                                                pf_unhealthy_until[p_idx] = 0.0
                                                                pf_addr = cand_pf
                                                                let ftok = match json_get_int(pj, "first_tok") { Some(n) => n, None => 0 }
                                                                let ptoks = match json_get_int(pj, "prompt_tokens") { Some(n) => n, None => 0 }
                                                                let dslot = match json_get_int(pj, "slot") { Some(n) => n, None => 25 }
                                                                kv_bytes = match json_get_int(pj, "kv_bytes") { Some(n) => n, None => 0 }
                                                                pf_ms = moe_now_ms() - t_all
                                                                layer_streams += 1
                                                                binary_bytes += kv_bytes
                                                                ok_pf = true
                                                                var dreq = json_obj_new()
                                                                dreq = json_obj_set(dreq, "layer_ready", JBool(true))
                                                                dreq = json_obj_set(dreq, "slot", JInt(dslot))
                                                                dreq = json_obj_set(dreq, "first_tok", JInt(ftok))
                                                                dreq = json_obj_set(dreq, "prompt_tokens", JInt(ptoks))
                                                                dreq = json_obj_set(dreq, "max_tokens", JInt(max_toks))
                                                                dec_raw = http_post_raw(dec_addr, "/v1/pd/decode", "application/json", "", dreq.stringify())
                                                            }
                                                            Err(_) => {}
                                                        }
                                                    }
                                                    if !ok_pf {
                                                        pf_unhealthy_until[p_idx] = moe_now_ms() + 15000.0
                                                        pf_failures[p_idx] = pf_failures[p_idx] + 1
                                                        if pi + 1 < len(pf_order) { router_failovers += 1 }
                                                    }
                                                    pi += 1
                                                }
                                            }
                                        } else if use_shm {
                                            var shm_n = ""
                                            var ftok = 0
                                            var ptoks = 0
                                            var pi = 0
                                            while pi < len(pf_order) && !ok_pf {
                                                let p_idx = pf_order[pi]
                                                let cand_pf = pf_workers[p_idx]
                                                let pf_raw = http_post_raw(cand_pf, "/v1/pd/prefill?transport=shm", "application/json", "", body)
                                                let phe = find_hdr_end(pf_raw)
                                                if phe >= 0 && str_contains_ci(str_slice(pf_raw, 0, phe), " 200 ") {
                                                    let pb = str_slice(pf_raw, phe + 4, len(pf_raw))
                                                    match JsonValue.parse(pb) {
                                                        Ok(pj) => {
                                                            shm_n = match json_get_str(pj, "shm_name") { Some(s) => s, None => "" }
                                                            ftok = match json_get_int(pj, "first_tok") { Some(n) => n, None => 0 }
                                                            ptoks = match json_get_int(pj, "prompt_tokens") { Some(n) => n, None => 0 }
                                                            kv_bytes = match json_get_int(pj, "kv_bytes") { Some(n) => n, None => 0 }
                                                            pf_ms = moe_now_ms() - t_all
                                                            if len(shm_n) > 0 {
                                                                pf_unhealthy_until[p_idx] = 0.0
                                                                pf_addr = cand_pf
                                                                shm_transfers += 1
                                                                ok_pf = true
                                                            }
                                                        }
                                                        Err(_) => {}
                                                    }
                                                }
                                                if !ok_pf {
                                                    pf_unhealthy_until[p_idx] = moe_now_ms() + 15000.0
                                                    pf_failures[p_idx] = pf_failures[p_idx] + 1
                                                    if pi + 1 < len(pf_order) { router_failovers += 1 }
                                                }
                                                pi += 1
                                            }
                                            if ok_pf {
                                                var dreq = json_obj_new()
                                                dreq = json_obj_set(dreq, "shm_name", JStr(shm_n))
                                                dreq = json_obj_set(dreq, "first_tok", JInt(ftok))
                                                dreq = json_obj_set(dreq, "prompt_tokens", JInt(ptoks))
                                                dreq = json_obj_set(dreq, "max_tokens", JInt(max_toks))
                                                let dstr = dreq.stringify()
                                                var ok_dec = false
                                                var di = 0
                                                while di < len(dec_order) && !ok_dec {
                                                    let d_idx = dec_order[di]
                                                    let cand_dec = dec_workers[d_idx]
                                                    let try_r = http_post_raw(cand_dec, "/v1/pd/decode", "application/json", "", dstr)
                                                    let the = find_hdr_end(try_r)
                                                    if the >= 0 && str_contains_ci(str_slice(try_r, 0, the), " 200 ") {
                                                        dec_unhealthy_until[d_idx] = 0.0
                                                        dec_addr = cand_dec
                                                        dec_raw = try_r
                                                        ok_dec = true
                                                    } else {
                                                        dec_unhealthy_until[d_idx] = moe_now_ms() + 15000.0
                                                        dec_failures[d_idx] = dec_failures[d_idx] + 1
                                                        if di + 1 < len(dec_order) { router_failovers += 1 }
                                                    }
                                                    di += 1
                                                }
                                            }
                                        } else {
                                            var kv_bin = ""
                                            var ftok_s = "0"
                                            var ptok_s = "0"
                                            var pi = 0
                                            while pi < len(pf_order) && !ok_pf {
                                                let p_idx = pf_order[pi]
                                                let cand_pf = pf_workers[p_idx]
                                                let pf_raw = http_post_raw(cand_pf, "/v1/pd/prefill?format=binary", "application/json", "Accept: application/octet-stream\r\n", body)
                                                let phe = find_hdr_end(pf_raw)
                                                if phe >= 0 && str_contains_ci(str_slice(pf_raw, 0, phe), " 200 ") {
                                                    let phdr = str_slice(pf_raw, 0, phe)
                                                    kv_bin = str_slice(pf_raw, phe + 4, len(pf_raw))
                                                    ftok_s = hdr_get_val(phdr, "x-tenon-pd-first-tok:")
                                                    ptok_s = hdr_get_val(phdr, "x-tenon-pd-prompt-tokens:")
                                                    kv_bytes = len(kv_bin)
                                                    pf_ms = moe_now_ms() - t_all
                                                    if kv_bytes >= 48 {
                                                        pf_unhealthy_until[p_idx] = 0.0
                                                        pf_addr = cand_pf
                                                        binary_bytes += kv_bytes
                                                        ok_pf = true
                                                    }
                                                }
                                                if !ok_pf {
                                                    pf_unhealthy_until[p_idx] = moe_now_ms() + 15000.0
                                                    pf_failures[p_idx] = pf_failures[p_idx] + 1
                                                    if pi + 1 < len(pf_order) { router_failovers += 1 }
                                                }
                                                pi += 1
                                            }
                                            if ok_pf {
                                                let dhdr = "X-Tenon-PD-First-Tok: " ++ ftok_s
                                                    ++ "\r\nX-Tenon-PD-Prompt-Tokens: " ++ ptok_s
                                                    ++ "\r\nX-Tenon-PD-Max-Tokens: " ++ int_to_text(max_toks) ++ "\r\n"
                                                var ok_dec = false
                                                var di = 0
                                                while di < len(dec_order) && !ok_dec {
                                                    let d_idx = dec_order[di]
                                                    let cand_dec = dec_workers[d_idx]
                                                    let try_r = http_post_raw(cand_dec, "/v1/pd/decode", "application/octet-stream", dhdr, kv_bin)
                                                    let the = find_hdr_end(try_r)
                                                    if the >= 0 && str_contains_ci(str_slice(try_r, 0, the), " 200 ") {
                                                        dec_unhealthy_until[d_idx] = 0.0
                                                        dec_addr = cand_dec
                                                        dec_raw = try_r
                                                        ok_dec = true
                                                    } else {
                                                        dec_unhealthy_until[d_idx] = moe_now_ms() + 15000.0
                                                        dec_failures[d_idx] = dec_failures[d_idx] + 1
                                                        if di + 1 < len(dec_order) { router_failovers += 1 }
                                                    }
                                                    di += 1
                                                }
                                            }
                                        }

                                        let dhe = find_hdr_end(dec_raw)
                                        if !ok_pf || dhe < 0 {
                                            write_json_http(tok, 502, "Bad Gateway", "{\"error\":\"PD worker handoff failed\"}")
                                            let _ = net_close(tok)
                                        } else {
                                            let dbody = str_slice(dec_raw, dhe + 4, len(dec_raw))
                                            match JsonValue.parse(dbody) {
                                                Err(_) => {
                                                    write_json_http(tok, 502, "Bad Gateway", "{\"error\":\"malformed decode worker json\"}")
                                                    let _ = net_close(tok)
                                                }
                                                Ok(dj) => {
                                                    let total_ms = moe_now_ms() - t_all
                                                    let dec_ms = if total_ms > pf_ms { total_ms - pf_ms } else { 0.1 }
                                                    ttft_hist.observe(pf_ms)
                                                    var gen_text = ""
                                                    var fin_r = "length"
                                                    match json_get(dj, "choices") {
                                                        Some(chs) => {
                                                            match json_at(chs, 0) {
                                                                Some(c0) => {
                                                                    gen_text = match json_get_str(c0, "text") { Some(s) => s, None => "" }
                                                                    fin_r = match json_get_str(c0, "finish_reason") { Some(s) => s, None => "length" }
                                                                }
                                                                None => {}
                                                            }
                                                        }
                                                        None => {}
                                                    }
                                                    var ptoks = 0
                                                    var ctoks = 0
                                                    match json_get(dj, "usage") {
                                                        Some(u) => {
                                                            ptoks = match json_get_int(u, "prompt_tokens") { Some(n) => n, None => 0 }
                                                            ctoks = match json_get_int(u, "completion_tokens") { Some(n) => n, None => 0 }
                                                        }
                                                        None => {}
                                                    }
                                                    if ctoks > 0 && dec_ms > 0.0 {
                                                        let denom = if ctoks > 1 { ctoks - 1 } else { 1 }
                                                        tpot_hist.observe(dec_ms / int_to_float(denom))
                                                    }
                                                    var choice = json_obj_new()
                                                    choice = json_obj_set(choice, "index", JInt(0))
                                                    if is_chat {
                                                        var msg = json_obj_new()
                                                        msg = json_obj_set(msg, "role", JStr("assistant"))
                                                        msg = json_obj_set(msg, "content", JStr(gen_text))
                                                        choice = json_obj_set(choice, "message", msg)
                                                    } else {
                                                        choice = json_obj_set(choice, "text", JStr(gen_text))
                                                    }
                                                    choice = json_obj_set(choice, "finish_reason", JStr(fin_r))
                                                    var choices = json_arr_new()
                                                    choices = json_arr_push(choices, choice)
                                                    var usage = json_obj_new()
                                                    usage = json_obj_set(usage, "prompt_tokens", JInt(ptoks))
                                                    usage = json_obj_set(usage, "completion_tokens", JInt(ctoks))
                                                    usage = json_obj_set(usage, "total_tokens", JInt(ptoks + ctoks))
                                                    var timings = json_obj_new()
                                                    timings = json_obj_set(timings, "prefill_worker", JStr(pf_addr))
                                                    timings = json_obj_set(timings, "decode_worker", JStr(dec_addr))
                                                    let tr_lbl = if use_layer { "layer" } else if use_shm { "shm" } else { "binary" }
                                                    timings = json_obj_set(timings, "transport", JStr(tr_lbl))
                                                    timings = json_obj_set(timings, "kv_bytes", JInt(kv_bytes))
                                                    timings = json_obj_set(timings, "prefill_ms", JFloat(pf_ms))
                                                    timings = json_obj_set(timings, "decode_ms", JFloat(dec_ms))
                                                    timings = json_obj_set(timings, "total_ms", JFloat(total_ms))
                                                    var resp = json_obj_new()
                                                    resp = json_obj_set(resp, "id", JStr("chatcmpl-tenon-pd-router-" ++ int_to_text(router_reqs)))
                                                    resp = json_obj_set(resp, "object", JStr(if is_chat { "chat.completion" } else { "text_completion" }))
                                                    resp = json_obj_set(resp, "model", JStr("tenon-pd-cluster"))
                                                    resp = json_obj_set(resp, "choices", choices)
                                                    resp = json_obj_set(resp, "usage", usage)
                                                    resp = json_obj_set(resp, "timings", timings)
                                                    write_json_http(tok, 200, "OK", resp.stringify())
                                                    let _ = net_close(tok)
                                                }
                                            }
                                        }
                                    }
                                }
                            } else {
                                write_json_http(tok, 404, "Not Found", "{\"error\":\"unknown router endpoint\"}")
                                let _ = net_close(tok)
                            }
                        } else if closed {
                            let _ = reactor_del(rfd, tok)
                            let _ = net_close(tok)
                            rd_fds[rslot] = -1
                            rd_bufs[rslot] = ""
                        }
                    } else if closed {
                        let _ = reactor_del(rfd, tok)
                        let _ = net_close(tok)
                        rd_fds[rslot] = -1
                        rd_bufs[rslot] = ""
                    }
                }
            }
            ei += 1
        }
    }

    let _ = reactor_del(rfd, lfd)
    let _ = reactor_close(rfd)
    let _ = net_close(lfd)
    println("[tenon-pd-router-v11] graceful shutdown complete.")
    0
}

fn main() Int {
    let addr_env = sys_env("TENON_ADDR")
    let addr = if len(addr_env) > 0 { addr_env } else { "127.0.0.1:28091" }
    let router_env = sys_env("TENON_PD_ROUTER")
    if router_env == "1" || router_env == "true" {
        return run_pd_router_mode(addr)
    }

    let model_env = sys_env("TENON_MODEL")
    let model_path = if len(model_env) > 0 {
        model_env
    } else {
        "/tmp/models/v6/Llama-3.2-1B-Instruct-Q4_0.gguf"
    }
    let chunk_env = sys_env("TENON_PREFILL_CHUNK")
    let prefill_chunk = parse_pos_int(chunk_env, 256)
    let max_queue = parse_pos_int(sys_env("TENON_MAX_QUEUE"), 64)
    let model_name = "tenon-native-gguf"

    var plan List[Int] = list_filled(9, 0)
    let ok = unsafe { tn_moe_auto_plan(text_cstr_ptr(model_path), 0.0, 4096, -1, list_data_ptr(plan)) }
    assert(ok != 0)
    let slots = plan[0]
    let nocache = plan[1] != 0

    var model = StreamingMoeModel.open_gguf(model_path, slots, nocache, true)
    assert(model.is_valid())
    let arch = model.arch_name()
    let handle = model.handle
    let bos = unsafe { tn_moe_info(handle, 11) }
    let eos = unsafe { tn_moe_info(handle, 12) }
    let pa_init_blks = unsafe { tn_moe_paged_kv_info(handle, 1) }

    // Load optional Multi-Tenant Zero-Copy LoRAs from `TENON_LORA=name=path,name2=path2`
    var lora_names List[Text] = []
    var lora_ids List[Int] = []
    let lora_env = sys_env("TENON_LORA")
    if len(lora_env) > 0 {
        var pos_l = 0
        let n_le = len(lora_env)
        while pos_l < n_le && len(lora_names) < MAX_LORAS {
            let comma = find_byte_from(lora_env, 44, pos_l)
            let end_l = if comma >= 0 { comma } else { n_le }
            let spec = str_slice(lora_env, pos_l, end_l)
            let eq = find_byte_from(spec, 61, 0)
            if eq > 0 && eq + 1 < len(spec) {
                let lname = str_slice(spec, 0, eq)
                let lpath = str_slice(spec, eq + 1, len(spec))
                let lid = unsafe { tn_moe_lora_load(handle, text_cstr_ptr(lpath), 1.0) }
                if lid > 0 {
                    lora_names = push(lora_names, lname)
                    lora_ids = push(lora_ids, lid)
                    println("[tenon-native-v10] loaded zero-copy LoRA `" ++ lname ++ "` (id=" ++ int_to_text(lid) ++ ")")
                }
            }
            pos_l = if comma >= 0 { comma + 1 } else { n_le }
        }
    }

    let lfd = net_tcp_listen(addr)
    if lfd < 0 {
        println("[tenon-native-v10] listen failed on [" ++ addr ++ "]")
        model.destroy()
        return 1
    }
    let port = net_tcp_local_port(lfd)
    let _ = net_set_nonblocking(lfd, true)
    let rfd = reactor_new()
    let _ = reactor_add(rfd, lfd, EVENT_READ, 0)

    let kv_qmode = unsafe { tn_moe_info(handle, 22) }
    let swa_win = unsafe { tn_moe_info(handle, 38) }
    println("[tenon-native-v11] Pure-Tenon Zero-Rust Unified Server v11 (Metal) listening on http://" ++ addr
        ++ " (port=" ++ int_to_text(port) ++ ", arch=" ++ arch ++ ", kv_mode=" ++ int_to_text(kv_qmode)
        ++ ", swa=" ++ int_to_text(swa_win) ++ ", pa_blks=" ++ int_to_text(pa_init_blks)
        ++ ", chunk=" ++ int_to_text(prefill_chunk) ++ ", max_queue=" ++ int_to_text(max_queue)
        ++ ", loras=" ++ int_to_text(len(lora_names)) ++ ", flash_decode=true, icb_pipe=true, pd_layer=true, lora_hotswap=true, max_cb=" ++ int_to_text(MAX_CB) ++ ")")

    // Non-blocking HTTP connection read slots (`rd_fds[i] == -1` => free)
    var rd_fds List[Int] = list_filled(MAX_RD, -1)
    var rd_bufs List[Text] = list_filled(MAX_RD, "")

    // Pending ready chat/completion requests awaiting a free CB slot
    var q_cfd List[Int] = []
    var q_chat List[Int] = []
    var q_body List[Text] = []

    // Continuous Batching slot state: 0=free, 1=chunked-prefilling, 2=active-decoding
    var cb_state List[Int] = list_filled(MAX_CB, 0)
    var cb_cfd List[Int] = list_filled(MAX_CB, -1)
    var cb_chat List[Int] = list_filled(MAX_CB, 1)
    var cb_stream List[Int] = list_filled(MAX_CB, 0)
    var cb_max List[Int] = list_filled(MAX_CB, 48)
    var cb_gen List[Int] = list_filled(MAX_CB, 0)
    var cb_pos List[Int] = list_filled(MAX_CB, 0)
    var cb_tok List[Int] = list_filled(MAX_CB, 0)
    var cb_ptoks List[Int] = list_filled(MAX_CB, 0)
    var cb_cached List[Int] = list_filled(MAX_CB, 0)
    var cb_lora List[Int] = list_filled(MAX_CB, 0)
    var cb_pf_cur List[Int] = list_filled(MAX_CB, 0)
    var cb_pf_end List[Int] = list_filled(MAX_CB, 0)
    var cb_pf_chunked List[Int] = list_filled(MAX_CB, 0)
    var cb_tpf0 List[Float] = list_filled(MAX_CB, 0.0)
    var cb_lru List[Int] = list_filled(MAX_CB, 0)
    var cb_pf_ms List[Float] = list_filled(MAX_CB, 0.0)
    var cb_tdec List[Float] = list_filled(MAX_CB, 0.0)
    var cb_text List[Text] = list_filled(MAX_CB, "")

    var hist_ids List[Int] = list_filled(MAX_CB * HIST_STRIDE, 0)
    var hist_len List[Int] = list_filled(MAX_CB, 0)
    var pf_ids List[Int] = list_filled(MAX_CB * HIST_STRIDE, 0)

    // Reusable step_batch & chunked prefill scratch buffers
    var b_toks List[Int] = list_filled(MAX_CB, 0)
    var b_pos List[Int] = list_filled(MAX_CB, 0)
    var b_slots List[Int] = list_filled(MAX_CB, 0)
    var b_loras List[Int] = list_filled(MAX_CB, 0)
    var b_is_pf List[Int] = list_filled(MAX_CB, 0)
    var b_out List[Int] = list_filled(MAX_CB, 0)
    var tok_scratch List[Int] = list_filled(HIST_STRIDE, 0)
    var chunk_buf List[Int] = list_filled(HIST_STRIDE, 0)

    // Server telemetry + TTFT/TPOT histograms
    var clock_tick = 0
    var total_reqs = 0
    var cb_batches_run = 0
    var mixed_batches_run = 0
    var max_batch_seen = 0
    var cow_forks = 0
    var cow_saved_toks = 0
    var chunked_prefill_chunks = 0
    var active_lora_id = 0
    var lora_swaps = 0
    var lora_hot_swaps = 0
    var hetero_lora_batches = 0
    var pd_transfers = 0
    var pd_shm_transfers = 0
    var pd_layer_streams = 0
    var pd_binary_bytes = 0
    var pd_shm_seq = 0
    var stream_cancelled = 0
    var backpressure_rejected = 0
    var ttft_hist = LatencyHist.new([10, 25, 50, 100, 250, 500, 1000, 2500])
    var tpot_hist = LatencyHist.new([2, 5, 10, 20, 50, 100, 250])
    var draining = false

    var running = true
    while running {
        var n_dec = 0
        var n_pf = 0
        var ai = 0
        while ai < MAX_CB {
            if cb_state[ai] == 2 { n_dec += 1 }
            if cb_state[ai] == 1 { n_pf += 1 }
            ai += 1
        }
        if draining && n_dec == 0 && n_pf == 0 && len(q_cfd) == 0 {
            running = false
            break
        }

        // Tenon v13 T2.3: Multi-Pass Zero-Latency Burst Drain!
        // When waking from idle (n_dec==0 && n_pf==0), drain accepted sockets AND their HTTP bodies in the same tick
        // so simultaneous bursts (e.g. B=16) coalesce into ONE batch instead of trickling in across 8 waves!
        var drain_pass = 0
        var need_more_drain = true
        while need_more_drain && drain_pass < 6 {
            var any_rd_open = false
            var rci = 0
            while rci < MAX_RD {
                if rd_fds[rci] >= 0 { any_rd_open = true; rci = MAX_RD } else { rci += 1 }
            }
            let wait_ms = if drain_pass == 0 {
                if n_dec > 0 || n_pf > 0 || len(q_cfd) > 0 { 0 } else { 15 }
            } else if n_dec == 0 && n_pf == 0 && any_rd_open && len(q_cfd) < MAX_CB {
                1
            } else {
                0
            }
            let evs = reactor_wait(rfd, wait_ms, 64)
            if len(evs) == 0 {
                need_more_drain = false
            } else {
                var accepted_any = false
                var ei = 0
                while ei < len(evs) {
                    let tok = event_token(evs[ei])
                    if tok == 0 {
                        var accepting = true
                        while accepting {
                            let cfd = net_tcp_accept(lfd)
                            if cfd >= 0 {
                                accepted_any = true
                                var free_rd = -1
                                var ri = 0
                                while ri < MAX_RD {
                                    if rd_fds[ri] < 0 {
                                        free_rd = ri
                                        ri = MAX_RD
                                    } else {
                                        ri += 1
                                    }
                                }
                                if free_rd >= 0 {
                                    let _ = net_set_nonblocking(cfd, true)
                                    let _ = net_set_nodelay(cfd, true)
                                    let _ = reactor_add(rfd, cfd, EVENT_READ, cfd)
                                    rd_fds[free_rd] = cfd
                                    rd_bufs[free_rd] = ""
                                } else {
                                    let _ = net_close(cfd)
                                }
                            } else {
                                accepting = false
                            }
                        }
                    } else {
                var rslot = -1
                var ri = 0
                while ri < MAX_RD {
                    if rd_fds[ri] == tok {
                        rslot = ri
                        ri = MAX_RD
                    } else {
                        ri += 1
                    }
                }
                if rslot >= 0 {
                    var closed = false
                    var reading = true
                    while reading {
                        let chunk = net_read_text(tok, 32768)
                        if len(chunk) > 0 {
                            rd_bufs[rslot] = rd_bufs[rslot] ++ chunk
                        } else {
                            if !net_last_would_block() {
                                closed = true
                            }
                            reading = false
                        }
                    }
                    let buf = rd_bufs[rslot]
                    let hend = find_hdr_end(buf)
                    if hend >= 0 {
                        let hdr = str_slice(buf, 0, hend)
                        let clen = parse_cl(hdr)
                        if len(buf) >= hend + 4 + clen {
                            let _ = reactor_del(rfd, tok)
                            let _ = net_set_nonblocking(tok, false)
                            rd_fds[rslot] = -1
                            rd_bufs[rslot] = ""

                            var sp1 = 0
                            while sp1 < hend && byte_at(buf, sp1) != 32 { sp1 += 1 }
                            var sp2 = sp1 + 1
                            while sp2 < hend && byte_at(buf, sp2) != 32 { sp2 += 1 }
                            let method = str_slice(buf, 0, sp1)
                            let full_path = str_slice(buf, sp1 + 1, sp2)
                            let path = path_clean(full_path)
                            let body = if clen > 0 && hend + 4 + clen <= len(buf) {
                                str_slice(buf, hend + 4, hend + 4 + clen)
                            } else {
                                ""
                            }

                            if method == "OPTIONS" {
                                let _ = net_write_text(tok, "HTTP/1.1 204 No Content\r\nAccess-Control-Allow-Origin: *\r\nAccess-Control-Allow-Headers: Content-Type, Authorization, X-Tenon-PD-First-Tok, X-Tenon-PD-Prompt-Tokens, X-Tenon-PD-Max-Tokens\r\nAccess-Control-Allow-Methods: GET, POST, OPTIONS\r\nConnection: close\r\n\r\n")
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/health" {
                                let d_model = unsafe { tn_moe_info(handle, 1) }
                                let n_layers = unsafe { tn_moe_info(handle, 0) }
                                let pa_tot = unsafe { tn_moe_paged_kv_info(handle, 1) }
                                let pa_free = unsafe { tn_moe_paged_kv_info(handle, 2) }
                                let pa_forks = unsafe { tn_moe_paged_kv_info(handle, 4) }
                                let vram = unsafe { tn_moe_info(handle, 8) }
                                let g_rep = unsafe { tn_moe_info(handle, 40) }
                                let g_cap = unsafe { tn_moe_info(handle, 41) }
                                let tc_tiles = unsafe { tn_moe_info(handle, 39) }
                                let fd_launches = unsafe { tn_moe_info(handle, 43) }
                                let icb_overlaps = unsafe { tn_moe_info(handle, 44) }
                                let mega_v3_tiles = unsafe { tn_moe_info(handle, 45) }
                                let kv_m = unsafe { tn_moe_info(handle, 22) }
                                let swa_m = unsafe { tn_moe_info(handle, 38) }
                                let sink_m = unsafe { tn_moe_info(handle, 42) }
                                var cur_act = 0
                                var ci = 0
                                while ci < MAX_CB {
                                    if cb_state[ci] != 0 { cur_act += 1 }
                                    ci += 1
                                }
                                var la = json_arr_new()
                                var li = 0
                                while li < len(lora_names) {
                                    la = json_arr_push(la, JStr(lora_names[li]))
                                    li += 1
                                }
                                var obj = json_obj_new()
                                obj = json_obj_set(obj, "status", JStr(if draining { "draining" } else { "ok" }))
                                obj = json_obj_set(obj, "engine", JStr("tenon-native-zero-rust-v11-metal"))
                                obj = json_obj_set(obj, "arch", JStr(arch))
                                obj = json_obj_set(obj, "model", JStr(model_name))
                                obj = json_obj_set(obj, "n_layers", JInt(n_layers))
                                obj = json_obj_set(obj, "d_model", JInt(d_model))
                                obj = json_obj_set(obj, "kv_quant_mode", JInt(kv_m))
                                obj = json_obj_set(obj, "sliding_window", JInt(swa_m))
                                obj = json_obj_set(obj, "attn_sink", JInt(sink_m))
                                obj = json_obj_set(obj, "graph_replays", JInt(g_rep))
                                obj = json_obj_set(obj, "graph_captured", JInt(g_cap))
                                obj = json_obj_set(obj, "moe_tc_amx_tiles", JInt(tc_tiles))
                                obj = json_obj_set(obj, "flash_decode_launches", JInt(fd_launches))
                                obj = json_obj_set(obj, "icb_pipe_overlaps", JInt(icb_overlaps))
                                obj = json_obj_set(obj, "moe_mega_v3_tiles", JInt(mega_v3_tiles))
                                obj = json_obj_set(obj, "prefill_chunk_size", JInt(prefill_chunk))
                                obj = json_obj_set(obj, "chunked_prefill_chunks", JInt(chunked_prefill_chunks))
                                obj = json_obj_set(obj, "lora_adapters", la)
                                obj = json_obj_set(obj, "lora_swaps", JInt(lora_swaps))
                                obj = json_obj_set(obj, "lora_hot_swaps", JInt(lora_hot_swaps))
                                obj = json_obj_set(obj, "hetero_lora_batches", JInt(hetero_lora_batches))
                                obj = json_obj_set(obj, "pd_transfers", JInt(pd_transfers))
                                obj = json_obj_set(obj, "pd_shm_transfers", JInt(pd_shm_transfers))
                                obj = json_obj_set(obj, "pd_layer_streams", JInt(pd_layer_streams))
                                obj = json_obj_set(obj, "pd_binary_bytes", JInt(pd_binary_bytes))
                                obj = json_obj_set(obj, "stream_cancelled", JInt(stream_cancelled))
                                obj = json_obj_set(obj, "backpressure_rejected", JInt(backpressure_rejected))
                                obj = json_obj_set(obj, "max_queue", JInt(max_queue))
                                obj = json_obj_set(obj, "paged_kv_blocks", JInt(pa_tot))
                                obj = json_obj_set(obj, "paged_kv_free_blocks", JInt(pa_free))
                                obj = json_obj_set(obj, "paged_cow_forks", JInt(pa_forks))
                                obj = json_obj_set(obj, "cow_forks", JInt(cow_forks))
                                obj = json_obj_set(obj, "cow_saved_tokens", JInt(cow_saved_toks))
                                obj = json_obj_set(obj, "cb_batches_run", JInt(cb_batches_run))
                                obj = json_obj_set(obj, "mixed_batches_run", JInt(mixed_batches_run))
                                obj = json_obj_set(obj, "max_batch_seen", JInt(max_batch_seen))
                                obj = json_obj_set(obj, "active_batch_size", JInt(cur_act))
                                obj = json_obj_set(obj, "total_requests", JInt(total_reqs))
                                obj = json_obj_set(obj, "core_vram_bytes", JInt(vram))
                                write_json_http(tok, 200, "OK", obj.stringify())
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/metrics" {
                                let pa_tot = unsafe { tn_moe_paged_kv_info(handle, 1) }
                                let pa_free = unsafe { tn_moe_paged_kv_info(handle, 2) }
                                let pa_forks = unsafe { tn_moe_paged_kv_info(handle, 4) }
                                let g_rep = unsafe { tn_moe_info(handle, 40) }
                                let g_cap = unsafe { tn_moe_info(handle, 41) }
                                let tc_tiles = unsafe { tn_moe_info(handle, 39) }
                                let fd_launches = unsafe { tn_moe_info(handle, 43) }
                                let icb_overlaps = unsafe { tn_moe_info(handle, 44) }
                                let mega_v3_tiles = unsafe { tn_moe_info(handle, 45) }
                                let kv_m = unsafe { tn_moe_info(handle, 22) }
                                var cur_act = 0
                                var ci = 0
                                while ci < MAX_CB {
                                    if cb_state[ci] != 0 { cur_act += 1 }
                                    ci += 1
                                }
                                var mt = TextBuilder.new()
                                mt.push_str("# HELP tenon_requests_total Total HTTP requests\n# TYPE tenon_requests_total counter\ntenon_requests_total ")
                                mt.push_str(int_to_text(total_reqs))
                                mt.push_str("\n# HELP tenon_active_batch_size Current active CB sequences\n# TYPE tenon_active_batch_size gauge\ntenon_active_batch_size ")
                                mt.push_str(int_to_text(cur_act))
                                mt.push_str("\n# HELP tenon_cb_batches_total Total CB iterations\n# TYPE tenon_cb_batches_total counter\ntenon_cb_batches_total ")
                                mt.push_str(int_to_text(cb_batches_run))
                                mt.push_str("\n# HELP tenon_mixed_prefill_decode_batches_total True mixed-batch prefill+decode steps\n# TYPE tenon_mixed_prefill_decode_batches_total counter\ntenon_mixed_prefill_decode_batches_total ")
                                mt.push_str(int_to_text(mixed_batches_run))
                                mt.push_str("\n# HELP tenon_paged_kv_blocks_total Total PagedKV blocks\n# TYPE tenon_paged_kv_blocks_total gauge\ntenon_paged_kv_blocks_total ")
                                mt.push_str(int_to_text(pa_tot))
                                mt.push_str("\n# HELP tenon_paged_kv_blocks_free Free PagedKV blocks\n# TYPE tenon_paged_kv_blocks_free gauge\ntenon_paged_kv_blocks_free ")
                                mt.push_str(int_to_text(pa_free))
                                mt.push_str("\n# HELP tenon_paged_cow_forks_total COW prefix forks\n# TYPE tenon_paged_cow_forks_total counter\ntenon_paged_cow_forks_total ")
                                mt.push_str(int_to_text(pa_forks))
                                mt.push_str("\n# HELP tenon_chunked_prefill_chunks_total Chunked prefill ticks\n# TYPE tenon_chunked_prefill_chunks_total counter\ntenon_chunked_prefill_chunks_total ")
                                mt.push_str(int_to_text(chunked_prefill_chunks))
                                mt.push_str("\n# HELP tenon_lora_swaps_total Runtime LoRA swaps\n# TYPE tenon_lora_swaps_total counter\ntenon_lora_swaps_total ")
                                mt.push_str(int_to_text(lora_swaps))
                                mt.push_str("\n# HELP tenon_lora_hot_swaps_total Dynamic LoRA load/unload hot-swaps\n# TYPE tenon_lora_hot_swaps_total counter\ntenon_lora_hot_swaps_total ")
                                mt.push_str(int_to_text(lora_hot_swaps))
                                mt.push_str("\n# HELP tenon_hetero_lora_batches_total Single-launch mixed-tenant BGMV LoRA batches\n# TYPE tenon_hetero_lora_batches_total counter\ntenon_hetero_lora_batches_total ")
                                mt.push_str(int_to_text(hetero_lora_batches))
                                mt.push_str("\n# HELP tenon_pd_transfers_total Disaggregated PD PagedKV transfers\n# TYPE tenon_pd_transfers_total counter\ntenon_pd_transfers_total ")
                                mt.push_str(int_to_text(pd_transfers))
                                mt.push_str("\n# HELP tenon_pd_shm_transfers_total Zero-copy POSIX SHM PD transfers\n# TYPE tenon_pd_shm_transfers_total counter\ntenon_pd_shm_transfers_total ")
                                mt.push_str(int_to_text(pd_shm_transfers))
                                mt.push_str("\n# HELP tenon_pd_layer_streams_total Layer-wise streaming TNKL PD transfers\n# TYPE tenon_pd_layer_streams_total counter\ntenon_pd_layer_streams_total ")
                                mt.push_str(int_to_text(pd_layer_streams))
                                mt.push_str("\n# HELP tenon_pd_binary_bytes_total Raw binary HTTP PD bytes\n# TYPE tenon_pd_binary_bytes_total counter\ntenon_pd_binary_bytes_total ")
                                mt.push_str(int_to_text(pd_binary_bytes))
                                mt.push_str("\n# HELP tenon_graph_replays_total Metal ICB persistent decode replays\n# TYPE tenon_graph_replays_total counter\ntenon_graph_replays_total ")
                                mt.push_str(int_to_text(g_rep))
                                mt.push_str("\n# HELP tenon_graph_captured_total Metal ICB decode graphs captured\n# TYPE tenon_graph_captured_total counter\ntenon_graph_captured_total ")
                                mt.push_str(int_to_text(g_cap))
                                mt.push_str("\n# HELP tenon_moe_tc_amx_tiles_total AMX hot-expert grouped MoE tiles\n# TYPE tenon_moe_tc_amx_tiles_total counter\ntenon_moe_tc_amx_tiles_total ")
                                mt.push_str(int_to_text(tc_tiles))
                                mt.push_str("\n# HELP tenon_flash_decode_launches_total Hardware 2-phase FlashDecoding Split-KV launches\n# TYPE tenon_flash_decode_launches_total counter\ntenon_flash_decode_launches_total ")
                                mt.push_str(int_to_text(fd_launches))
                                mt.push_str("\n# HELP tenon_icb_pipe_overlaps_total Async unretained-ref Metal ICB overlaps\n# TYPE tenon_icb_pipe_overlaps_total counter\ntenon_icb_pipe_overlaps_total ")
                                mt.push_str(int_to_text(icb_overlaps))
                                mt.push_str("\n# HELP tenon_moe_mega_v3_tiles_total Register-direct half4 AMX MoE Mega-v3 tiles\n# TYPE tenon_moe_mega_v3_tiles_total counter\ntenon_moe_mega_v3_tiles_total ")
                                mt.push_str(int_to_text(mega_v3_tiles))
                                mt.push_str("\n# HELP tenon_stream_cancelled_total Real-time SSE client-disconnect cancellations\n# TYPE tenon_stream_cancelled_total counter\ntenon_stream_cancelled_total ")
                                mt.push_str(int_to_text(stream_cancelled))
                                mt.push_str("\n# HELP tenon_backpressure_rejected_total HTTP 503 backpressure rejections\n# TYPE tenon_backpressure_rejected_total counter\ntenon_backpressure_rejected_total ")
                                mt.push_str(int_to_text(backpressure_rejected))
                                mt.push_str("\n# HELP tenon_kv_quant_mode PagedKV precision mode (0=FP16,1=Q8,2=FP8,3=Q4)\n# TYPE tenon_kv_quant_mode gauge\ntenon_kv_quant_mode ")
                                mt.push_str(int_to_text(kv_m))
                                mt.push_str("\n# HELP tenon_draining Graceful shutdown drain state\n# TYPE tenon_draining gauge\ntenon_draining ")
                                mt.push_str(if draining { "1" } else { "0" })
                                mt.push_str("\n")
                                mt.push_str(ttft_hist.format_prom("tenon_ttft_ms", "Time-to-first-token (prefill) latency in ms"))
                                mt.push_str(tpot_hist.format_prom("tenon_tpot_ms", "Time-per-output-token (decode) latency in ms"))
                                write_text_http(tok, 200, "OK", "text/plain; version=0.0.4", mt.finish())
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/v1/lora/list" {
                                var arr = json_arr_new()
                                var li = 0
                                while li < len(lora_names) {
                                    let lid = lora_ids[li]
                                    let rk = unsafe { tn_moe_lora_info(handle, lid, 1) }
                                    let nt_l = unsafe { tn_moe_lora_info(handle, lid, 2) }
                                    var it = json_obj_new()
                                    it = json_obj_set(it, "name", JStr(lora_names[li]))
                                    it = json_obj_set(it, "lora_id", JInt(lid))
                                    it = json_obj_set(it, "rank", JInt(rk))
                                    it = json_obj_set(it, "tensors", JInt(nt_l))
                                    arr = json_arr_push(arr, it)
                                    li += 1
                                }
                                var out = json_obj_new()
                                out = json_obj_set(out, "object", JStr("list"))
                                out = json_obj_set(out, "adapters", arr)
                                out = json_obj_set(out, "lora_hot_swaps", JInt(lora_hot_swaps))
                                write_json_http(tok, 200, "OK", out.stringify())
                                let _ = net_close(tok)
                            } else if method == "POST" && path == "/v1/lora/load" {
                                match JsonValue.parse(body) {
                                    Err(_) => {
                                        write_json_http(tok, 400, "Bad Request", "{\"error\":\"invalid json\"}")
                                    }
                                    Ok(jv) => {
                                        let lname = match json_get_str(jv, "name") { Some(s) => s, None => "" }
                                        let lpath = match json_get_str(jv, "path") { Some(s) => s, None => "" }
                                        let lscale = match json_get_float(jv, "scale") { Some(f) => f, None => 1.0 }
                                        if len(lname) == 0 || len(lpath) == 0 {
                                            write_json_http(tok, 400, "Bad Request", "{\"error\":\"missing name or path\"}")
                                        } else {
                                            let lid = unsafe { tn_moe_lora_load(handle, text_cstr_ptr(lpath), lscale) }
                                            if lid <= 0 {
                                                write_json_http(tok, 400, "Bad Request", "{\"error\":\"failed to load GGUF LoRA\"}")
                                            } else {
                                                var found = -1
                                                var li = 0
                                                while li < len(lora_names) {
                                                    if lora_names[li] == lname { found = li; li = len(lora_names) } else { li += 1 }
                                                }
                                                if found >= 0 {
                                                    let old_id = lora_ids[found]
                                                    if active_lora_id == old_id {
                                                        let _ = unsafe { tn_moe_lora_set(handle, 0, 1.0) }
                                                        active_lora_id = 0
                                                    }
                                                    let _ = unsafe { tn_moe_lora_free(handle, old_id) }
                                                    lora_ids[found] = lid
                                                } else {
                                                    lora_names = push(lora_names, lname)
                                                    lora_ids = push(lora_ids, lid)
                                                }
                                                lora_hot_swaps += 1
                                                let rk = unsafe { tn_moe_lora_info(handle, lid, 1) }
                                                let nt_l = unsafe { tn_moe_lora_info(handle, lid, 2) }
                                                var out = json_obj_new()
                                                out = json_obj_set(out, "status", JStr("loaded"))
                                                out = json_obj_set(out, "name", JStr(lname))
                                                out = json_obj_set(out, "lora_id", JInt(lid))
                                                out = json_obj_set(out, "rank", JInt(rk))
                                                out = json_obj_set(out, "tensors", JInt(nt_l))
                                                write_json_http(tok, 200, "OK", out.stringify())
                                            }
                                        }
                                    }
                                }
                                let _ = net_close(tok)
                            } else if method == "POST" && path == "/v1/lora/unload" {
                                match JsonValue.parse(body) {
                                    Err(_) => {
                                        write_json_http(tok, 400, "Bad Request", "{\"error\":\"invalid json\"}")
                                    }
                                    Ok(jv) => {
                                        let lname = match json_get_str(jv, "name") { Some(s) => s, None => "" }
                                        var found = -1
                                        var li = 0
                                        while li < len(lora_names) {
                                            if lora_names[li] == lname { found = li; li = len(lora_names) } else { li += 1 }
                                        }
                                        if found < 0 {
                                            write_json_http(tok, 404, "Not Found", "{\"error\":\"LoRA adapter not found\"}")
                                        } else {
                                            let old_id = lora_ids[found]
                                            if active_lora_id == old_id {
                                                let _ = unsafe { tn_moe_lora_set(handle, 0, 1.0) }
                                                active_lora_id = 0
                                            }
                                            let _ = unsafe { tn_moe_lora_free(handle, old_id) }
                                            var new_n List[Text] = []
                                            var new_i List[Int] = []
                                            li = 0
                                            while li < len(lora_names) {
                                                if li != found {
                                                    new_n = push(new_n, lora_names[li])
                                                    new_i = push(new_i, lora_ids[li])
                                                }
                                                li += 1
                                            }
                                            lora_names = new_n
                                            lora_ids = new_i
                                            lora_hot_swaps += 1
                                            var out = json_obj_new()
                                            out = json_obj_set(out, "status", JStr("unloaded"))
                                            out = json_obj_set(out, "name", JStr(lname))
                                            write_json_http(tok, 200, "OK", out.stringify())
                                        }
                                    }
                                }
                                let _ = net_close(tok)
                            } else if method == "POST" && path == "/v1/pd/layer" {
                                if draining {
                                    write_503_backpressure(tok, "server draining")
                                    let _ = net_close(tok)
                                } else {
                                    let lb = handle_pd_layer(tok, handle, hdr, body)
                                    if lb > 0 { pd_binary_bytes += lb }
                                }
                            } else if method == "POST" && path == "/shutdown" {
                                draining = true
                                write_json_http(tok, 200, "OK", "{\"status\":\"draining\"}")
                                let _ = net_close(tok)
                            } else if method == "GET" && path == "/v1/models" {
                                var item = json_obj_new()
                                item = json_obj_set(item, "id", JStr(model_name))
                                item = json_obj_set(item, "object", JStr("model"))
                                item = json_obj_set(item, "owned_by", JStr("tenon-native"))
                                var data = json_arr_new()
                                data = json_arr_push(data, item)
                                var obj = json_obj_new()
                                obj = json_obj_set(obj, "object", JStr("list"))
                                obj = json_obj_set(obj, "data", data)
                                write_json_http(tok, 200, "OK", obj.stringify())
                                let _ = net_close(tok)
                            } else if method == "POST" && path == "/v1/pd/prefill" {
                                if draining {
                                    write_503_backpressure(tok, "server draining")
                                    let _ = net_close(tok)
                                } else {
                                    pd_shm_seq += 1
                                    var lbytes = 0
                                    let r = handle_pd_prefill(tok, handle, arch, model_name, full_path, hdr, body, port, pd_shm_seq, ttft_hist, lbytes)
                                    if r != 0 {
                                        pd_transfers += 1
                                        if r == -1 { pd_shm_transfers += 1 }
                                        else if r == -3 { pd_layer_streams += 1; pd_binary_bytes += lbytes }
                                        else if r > 1 { pd_binary_bytes += r }
                                    }
                                }
                            } else if method == "POST" && path == "/v1/pd/decode" {
                                if draining {
                                    write_503_backpressure(tok, "server draining")
                                    let _ = net_close(tok)
                                } else {
                                    let r = handle_pd_decode(tok, handle, eos, model_name, hdr, body, tpot_hist)
                                    if r != 0 {
                                        pd_transfers += 1
                                        if r == -1 { pd_shm_transfers += 1 }
                                        else if r == -3 { pd_layer_streams += 1 }
                                        else if r > 0 { pd_binary_bytes += r }
                                    }
                                }
                            } else if method == "POST" && path == "/v1/embeddings" {
                                if draining {
                                    write_503_backpressure(tok, "server draining")
                                    let _ = net_close(tok)
                                } else {
                                    handle_embeddings(tok, handle, model_name, body)
                                }
                            } else if method == "POST" && (path == "/v1/chat/completions" || path == "/v1/completions") {
                                if draining {
                                    write_503_backpressure(tok, "server draining")
                                    let _ = net_close(tok)
                                } else if n_dec + n_pf + len(q_cfd) >= max_queue {
                                    backpressure_rejected += 1
                                    write_503_backpressure(tok, "server busy (max queue depth reached)")
                                    let _ = net_close(tok)
                                } else {
                                    total_reqs += 1
                                    q_cfd = push(q_cfd, tok)
                                    q_chat = push(q_chat, if path == "/v1/chat/completions" { 1 } else { 0 })
                                    q_body = push(q_body, body)
                                }
                            } else {
                                write_json_http(tok, 404, "Not Found", "{\"error\":\"unknown endpoint\"}")
                                let _ = net_close(tok)
                            }
                        } else if closed {
                            let _ = reactor_del(rfd, tok)
                            let _ = net_close(tok)
                            rd_fds[rslot] = -1
                            rd_bufs[rslot] = ""
                        }
                    } else if closed {
                        let _ = reactor_del(rfd, tok)
                        let _ = net_close(tok)
                        rd_fds[rslot] = -1
                        rd_bufs[rslot] = ""
                    }
                }
            }
            ei += 1
        }
                if !accepted_any && !(n_dec == 0 && n_pf == 0 && len(q_cfd) < MAX_CB) {
                    need_more_drain = false
                }
            }
            drain_pass += 1
        }

        // Admit pending generation requests into free PagedAttention CB slots (Chunked Prefill + COW Fork + Multi-LoRA!)
        var q_head = 0
        while q_head < len(q_cfd) {
            var free_cnt = 0
            var fi = 0
            while fi < MAX_CB {
                if cb_state[fi] == 0 { free_cnt += 1 }
                fi += 1
            }
            if free_cnt == 0 { break }
            let cfd = q_cfd[q_head]
            let is_chat = q_chat[q_head] != 0
            let body = q_body[q_head]
            q_head += 1

            match JsonValue.parse(body) {
                Err(_) => {
                    write_json_http(cfd, 400, "Bad Request", "{\"error\":\"invalid json\"}")
                    let _ = net_close(cfd)
                }
                Ok(jv) => {
                    let want_stream = match json_get_bool(jv, "stream") { Some(b) => b, None => false }
                    let max_toks = match json_get_int(jv, "max_tokens") { Some(n) => n, None => 48 }
                    let req_lora = match json_get_str(jv, "lora") { Some(s) => s, None => "" }
                    var lid_sel = 0
                    if len(req_lora) > 0 {
                        var li = 0
                        while li < len(lora_names) {
                            if lora_names[li] == req_lora {
                                lid_sel = lora_ids[li]
                                li = len(lora_names)
                            } else {
                                li += 1
                            }
                        }
                    }
                    var extra_sys = ""
                    match json_get(jv, "tools") {
                        Some(tl) => {
                            extra_sys = extra_sys ++ "You may call tools by responding with JSON {\"tool_calls\":[{\"name\":\"...\",\"arguments\":{...}}]}. Tools: " ++ tl.stringify() ++ "\n"
                        }
                        None => {}
                    }
                    match json_get(jv, "response_format") {
                        Some(_) => {
                            extra_sys = extra_sys ++ "Respond strictly with a valid JSON object."
                        }
                        None => {}
                    }
                    let prompt = if is_chat {
                        match json_get(jv, "messages") {
                            Some(msgs) => format_chat(arch, msgs, extra_sys)
                            None => match json_get_str(jv, "prompt") { Some(p) => p, None => "Hello" }
                        }
                    } else {
                        match json_get_str(jv, "prompt") { Some(p) => p, None => "Hello" }
                    }
                    let nt = unsafe { tn_moe_tokenize(handle, text_cstr_ptr(prompt), list_data_ptr(tok_scratch), HIST_STRIDE - 2) }
                    let n_prompt = if bos >= 0 { nt + 1 } else if nt > 0 { nt } else { 1 }
                    var ids List[Int] = list_filled(n_prompt, 0)
                    if bos >= 0 {
                        ids[0] = bos
                        var ti = 0
                        while ti < nt {
                            ids[ti + 1] = tok_scratch[ti]
                            ti += 1
                        }
                    } else {
                        var ti = 0
                        while ti < nt {
                            ids[ti] = tok_scratch[ti]
                            ti += 1
                        }
                    }

                    // Find longest common prefix across ALL slots for Zero-Copy COW Fork (base model only!)
                    var best_src = -1
                    var best_lcp = 0
                    let max_reuse = if lid_sel == 0 && n_prompt > 1 { n_prompt - 1 } else { 0 }
                    var si = 0
                    while si < MAX_CB {
                        let slen = hist_len[si]
                        if slen > 0 && max_reuse > 0 {
                            let lim = if slen < max_reuse { slen } else { max_reuse }
                            let base = si * HIST_STRIDE
                            var lcp = 0
                            while lcp < lim && hist_ids[base + lcp] == ids[lcp] {
                                lcp += 1
                            }
                            if lcp > best_lcp {
                                best_lcp = lcp
                                best_src = si
                            }
                        }
                        si += 1
                    }

                    var dst = -1
                    var best_lru = 9223372036854775800
                    var di = 0
                    while di < MAX_CB {
                        if cb_state[di] == 0 {
                            if !(best_lcp > 0 && di == best_src && free_cnt > 1) {
                                if cb_lru[di] < best_lru {
                                    best_lru = cb_lru[di]
                                    dst = di
                                }
                            }
                        }
                        di += 1
                    }
                    if dst < 0 {
                        di = 0
                        while di < MAX_CB {
                            if cb_state[di] == 0 { dst = di; di = MAX_CB } else { di += 1 }
                        }
                    }

                    clock_tick += 1
                    cb_lru[dst] = clock_tick

                    var actual_lcp = 0
                    if best_lcp > 0 && best_src >= 0 && best_src != dst {
                        let _ = unsafe { tn_moe_paged_seq_fork(handle, best_src, dst, best_lcp) }
                        cow_forks += 1
                        cow_saved_toks += best_lcp
                        actual_lcp = best_lcp
                    } else {
                        let _ = unsafe { tn_moe_paged_seq_free(handle, dst) }
                    }

                    // Copy prompt tokens into slot's chunked prefill buffer
                    let pbase = dst * HIST_STRIDE
                    var pi = 0
                    while pi < n_prompt {
                        pf_ids[pbase + pi] = ids[pi]
                        pi += 1
                    }
                    cb_state[dst] = 1
                    cb_cfd[dst] = cfd
                    cb_chat[dst] = if is_chat { 1 } else { 0 }
                    cb_stream[dst] = if want_stream { 1 } else { 0 }
                    cb_max[dst] = max_toks
                    cb_gen[dst] = 0
                    cb_ptoks[dst] = n_prompt
                    cb_cached[dst] = actual_lcp
                    cb_lora[dst] = lid_sel
                    cb_pf_cur[dst] = actual_lcp
                    cb_pf_end[dst] = n_prompt
                    cb_pf_chunked[dst] = if (n_prompt - actual_lcp) > prefill_chunk { 1 } else { 0 }
                    cb_tpf0[dst] = moe_now_ms()
                    cb_text[dst] = ""

                    // Tenon v13 T2.3: Cold-Burst Shared-Prefix COW Deduplication!
                    // When >=1 more request is waiting right behind in `q_cfd`, immediately prefill req #1 & publish
                    // its `hist_ids` so reqs #2..N in the same burst hit ZERO-COPY `tn_moe_paged_seq_fork`!
                    if q_head < len(q_cfd) && actual_lcp == 0 && lid_sel == 0 && n_prompt <= prefill_chunk {
                        if active_lora_id != 0 {
                            let _ = unsafe { tn_moe_lora_set(handle, 0, 1.0) }
                            active_lora_id = 0
                            lora_swaps += 1
                        }
                        let first_tok = unsafe { tn_moe_paged_prefill(handle, dst, list_data_ptr(ids), n_prompt, 0) }
                        let pf_ms = moe_now_ms() - cb_tpf0[dst]
                        cb_pf_ms[dst] = pf_ms
                        ttft_hist.observe(pf_ms)
                        let copy_n = if n_prompt < HIST_STRIDE { n_prompt } else { HIST_STRIDE }
                        var hi = 0
                        while hi < copy_n {
                            hist_ids[pbase + hi] = ids[hi]
                            hi += 1
                        }
                        hist_len[dst] = copy_n
                        if want_stream {
                            let hdr = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n"
                            let _ = net_write_text(cfd, hdr)
                        }
                        let piece0 = unsafe { cstr_to_text(tn_moe_token_cstr(handle, first_tok)) }
                        if is_stop_piece(first_tok, eos, piece0) || max_toks <= 0 {
                            send_final_cb_response(cfd, model_name, is_chat, want_stream, "", n_prompt, 0, 0, dst, pf_ms, 0.0, "stop")
                            cb_state[dst] = 0
                            cb_cfd[dst] = -1
                        } else {
                            var alive = true
                            if want_stream { alive = write_sse_piece(cfd, model_name, is_chat, piece0) }
                            if copy_n < HIST_STRIDE {
                                hist_ids[pbase + copy_n] = first_tok
                                hist_len[dst] = copy_n + 1
                            }
                            if !alive {
                                stream_cancelled += 1
                                let _ = unsafe { tn_moe_paged_seq_free(handle, dst) }
                                hist_len[dst] = 0
                                let _ = net_close(cfd)
                                cb_state[dst] = 0
                                cb_cfd[dst] = -1
                            } else if max_toks <= 1 {
                                send_final_cb_response(cfd, model_name, is_chat, want_stream, piece0, n_prompt, 0, 1, dst, pf_ms, 0.0, "length")
                                cb_state[dst] = 0
                                cb_cfd[dst] = -1
                            } else {
                                cb_state[dst] = 2
                                cb_gen[dst] = 1
                                cb_pos[dst] = n_prompt
                                cb_tok[dst] = first_tok
                                cb_tdec[dst] = moe_now_ms()
                                cb_text[dst] = piece0
                            }
                        }
                    }
                }
            }
        }
        if q_head > 0 {
            var n_cfd List[Int] = []
            var n_chat List[Int] = []
            var n_body List[Text] = []
            var qi = q_head
            while qi < len(q_cfd) {
                n_cfd = push(n_cfd, q_cfd[qi])
                n_chat = push(n_chat, q_chat[qi])
                n_body = push(n_body, q_body[qi])
                qi += 1
            }
            q_cfd = n_cfd
            q_chat = n_chat
            q_body = n_body
        }

        // Tenon v14 P5: Long-Prompt Chunked Prefill (>16 remaining tokens) via AMX/FA2 `paged_prefill`;
        // Short-suffix (<=16 tokens) prefill slots are packed directly with active decode slots into ONE True Mixed-Batch `step_batch` below!
        var budget = prefill_chunk
        var pfs = 0
        while pfs < MAX_CB && budget > 0 {
            if cb_state[pfs] == 1 {
                let cur = cb_pf_cur[pfs]
                let end_p = cb_pf_end[pfs]
                let rem = end_p - cur
                if rem > 16 {
                    let take = if rem < budget { rem } else { budget }
                    let lid = cb_lora[pfs]
                    if lid != active_lora_id {
                        let _ = unsafe { tn_moe_lora_set(handle, lid, 1.0) }
                        active_lora_id = lid
                        lora_swaps += 1
                    }
                    let pbase = pfs * HIST_STRIDE
                    var ci = 0
                    while ci < take {
                        chunk_buf[ci] = pf_ids[pbase + cur + ci]
                        ci += 1
                    }
                    let first_tok = unsafe { tn_moe_paged_prefill(handle, pfs, list_data_ptr(chunk_buf), take, cur) }
                    cb_pf_cur[pfs] = cur + take
                    budget -= take
                    if cb_pf_chunked[pfs] != 0 {
                        chunked_prefill_chunks += 1
                    }
                    if cb_pf_cur[pfs] >= end_p {
                        let pf_ms = moe_now_ms() - cb_tpf0[pfs]
                        cb_pf_ms[pfs] = pf_ms
                        ttft_hist.observe(pf_ms)
                        let n_prompt = cb_ptoks[pfs]
                        let actual_lcp = cb_cached[pfs]
                        let cfd = cb_cfd[pfs]
                        let is_chat = cb_chat[pfs] != 0
                        let want_stream = cb_stream[pfs] != 0
                        let max_toks = cb_max[pfs]
                        let copy_n = if n_prompt < HIST_STRIDE { n_prompt } else { HIST_STRIDE }
                        var hi = 0
                        while hi < copy_n {
                            hist_ids[pbase + hi] = pf_ids[pbase + hi]
                            hi += 1
                        }
                        hist_len[pfs] = copy_n
                        if want_stream {
                            let hdr = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n"
                            let _ = net_write_text(cfd, hdr)
                        }
                        let piece0 = unsafe { cstr_to_text(tn_moe_token_cstr(handle, first_tok)) }
                        if is_stop_piece(first_tok, eos, piece0) || max_toks <= 0 {
                            send_final_cb_response(cfd, model_name, is_chat, want_stream, "", n_prompt, actual_lcp, 0, pfs, pf_ms, 0.0, "stop")
                            cb_state[pfs] = 0
                            cb_cfd[pfs] = -1
                        } else {
                            var alive = true
                            if want_stream { alive = write_sse_piece(cfd, model_name, is_chat, piece0) }
                            if copy_n < HIST_STRIDE {
                                hist_ids[pbase + copy_n] = first_tok
                                hist_len[pfs] = copy_n + 1
                            }
                            if !alive {
                                stream_cancelled += 1
                                let _ = unsafe { tn_moe_paged_seq_free(handle, pfs) }
                                hist_len[pfs] = 0
                                let _ = net_close(cfd)
                                cb_state[pfs] = 0
                                cb_cfd[pfs] = -1
                            } else if max_toks <= 1 {
                                send_final_cb_response(cfd, model_name, is_chat, want_stream, piece0, n_prompt, actual_lcp, 1, pfs, pf_ms, 0.0, "length")
                                cb_state[pfs] = 0
                                cb_cfd[pfs] = -1
                            } else {
                                cb_state[pfs] = 2
                                cb_gen[pfs] = 1
                                cb_pos[pfs] = n_prompt
                                cb_tok[pfs] = first_tok
                                cb_tdec[pfs] = moe_now_ms()
                                cb_text[pfs] = piece0
                            }
                        }
                    } else {
                        break
                    }
                }
            }
            pfs += 1
        }

        // Tenon v14 P5: ONE Single-Launch True Mixed-Batch (Prefill + Decode + Heterogeneous Multi-LoRA BGMV + Metal ICB)!
        var b_sz = 0
        var n_mix_pf = 0
        var n_mix_dec = 0
        var first_lid = -1
        var has_hetero = false
        var si = 0
        while si < MAX_CB {
            if cb_state[si] == 2 {
                b_toks[b_sz] = cb_tok[si]
                b_pos[b_sz] = cb_pos[si]
                b_slots[b_sz] = si
                let lid = cb_lora[si]
                b_loras[b_sz] = lid
                b_is_pf[b_sz] = 0
                if first_lid < 0 { first_lid = lid } else if lid != first_lid { has_hetero = true }
                b_sz += 1
                n_mix_dec += 1
            } else if cb_state[si] == 1 {
                let rem = cb_pf_end[si] - cb_pf_cur[si]
                if rem > 0 && rem <= 16 {
                    b_toks[b_sz] = pf_ids[si * HIST_STRIDE + cb_pf_cur[si]]
                    b_pos[b_sz] = cb_pf_cur[si]
                    b_slots[b_sz] = si
                    let lid = cb_lora[si]
                    b_loras[b_sz] = lid
                    b_is_pf[b_sz] = 1
                    if first_lid < 0 { first_lid = lid } else if lid != first_lid { has_hetero = true }
                    b_sz += 1
                    n_mix_pf += 1
                }
            }
            si += 1
        }
        if b_sz > 0 {
            if b_sz > max_batch_seen { max_batch_seen = b_sz }
            if n_mix_pf > 0 && n_mix_dec > 0 { mixed_batches_run += 1 }
            if has_hetero {
                let _ = unsafe { tn_moe_lora_set_batch(handle, list_data_ptr(b_loras), b_sz) }
                hetero_lora_batches += 1
            } else {
                if first_lid != active_lora_id {
                    let _ = unsafe { tn_moe_lora_set(handle, first_lid, 1.0) }
                    active_lora_id = first_lid
                    lora_swaps += 1
                }
            }
            cb_batches_run += 1
            let _ = unsafe {
                tn_moe_step_batch(
                    handle,
                    list_data_ptr(b_toks),
                    list_data_ptr(b_pos),
                    list_data_ptr(b_slots),
                    b_sz,
                    list_data_ptr(b_out)
                )
            }
            if has_hetero {
                let _ = unsafe { tn_moe_lora_set_batch(handle, list_data_ptr(b_loras), 0) }
            }
            var bi = 0
            while bi < b_sz {
                let s = b_slots[bi]
                let chosen = b_out[bi]
                if b_is_pf[bi] != 0 {
                    cb_pf_cur[s] = cb_pf_cur[s] + 1
                    if cb_pf_cur[s] >= cb_pf_end[s] {
                        let pf_ms = moe_now_ms() - cb_tpf0[s]
                        cb_pf_ms[s] = pf_ms
                        ttft_hist.observe(pf_ms)
                        let n_prompt = cb_ptoks[s]
                        let actual_lcp = cb_cached[s]
                        let cfd = cb_cfd[s]
                        let is_chat = cb_chat[s] != 0
                        let want_stream = cb_stream[s] != 0
                        let max_toks = cb_max[s]
                        let pbase = s * HIST_STRIDE
                        let copy_n = if n_prompt < HIST_STRIDE { n_prompt } else { HIST_STRIDE }
                        var hi = 0
                        while hi < copy_n {
                            hist_ids[pbase + hi] = pf_ids[pbase + hi]
                            hi += 1
                        }
                        hist_len[s] = copy_n
                        if want_stream {
                            let hdr = "HTTP/1.1 200 OK\r\nContent-Type: text/event-stream\r\nCache-Control: no-cache\r\nAccess-Control-Allow-Origin: *\r\nConnection: close\r\n\r\n"
                            let _ = net_write_text(cfd, hdr)
                        }
                        let piece0 = unsafe { cstr_to_text(tn_moe_token_cstr(handle, chosen)) }
                        if is_stop_piece(chosen, eos, piece0) || max_toks <= 0 {
                            send_final_cb_response(cfd, model_name, is_chat, want_stream, "", n_prompt, actual_lcp, 0, s, pf_ms, 0.0, "stop")
                            cb_state[s] = 0
                            cb_cfd[s] = -1
                        } else {
                            var alive = true
                            if want_stream { alive = write_sse_piece(cfd, model_name, is_chat, piece0) }
                            if copy_n < HIST_STRIDE {
                                hist_ids[pbase + copy_n] = chosen
                                hist_len[s] = copy_n + 1
                            }
                            if !alive {
                                stream_cancelled += 1
                                let _ = unsafe { tn_moe_paged_seq_free(handle, s) }
                                hist_len[s] = 0
                                let _ = net_close(cfd)
                                cb_state[s] = 0
                                cb_cfd[s] = -1
                            } else if max_toks <= 1 {
                                send_final_cb_response(cfd, model_name, is_chat, want_stream, piece0, n_prompt, actual_lcp, 1, s, pf_ms, 0.0, "length")
                                cb_state[s] = 0
                                cb_cfd[s] = -1
                            } else {
                                cb_state[s] = 2
                                cb_gen[s] = 1
                                cb_pos[s] = n_prompt
                                cb_tok[s] = chosen
                                cb_tdec[s] = moe_now_ms()
                                cb_text[s] = piece0
                            }
                        }
                    }
                } else {
                    let piece = unsafe { cstr_to_text(tn_moe_token_cstr(handle, chosen)) }
                    let is_chat = cb_chat[s] != 0
                    let want_stream = cb_stream[s] != 0
                    if is_stop_piece(chosen, eos, piece) {
                        let dec_ms = moe_now_ms() - cb_tdec[s]
                        if cb_gen[s] > 0 && dec_ms > 0.0 {
                            let denom = if cb_gen[s] > 1 { cb_gen[s] - 1 } else { 1 }
                            tpot_hist.observe(dec_ms / int_to_float(denom))
                        }
                        send_final_cb_response(cb_cfd[s], model_name, is_chat, want_stream, cb_text[s], cb_ptoks[s], cb_cached[s], cb_gen[s], s, cb_pf_ms[s], dec_ms, "stop")
                        cb_state[s] = 0
                        cb_cfd[s] = -1
                        cb_text[s] = ""
                    } else {
                        cb_tok[s] = chosen
                        cb_pos[s] = cb_pos[s] + 1
                        cb_gen[s] = cb_gen[s] + 1
                        cb_text[s] = cb_text[s] ++ piece
                        let hl = hist_len[s]
                        if hl < HIST_STRIDE {
                            hist_ids[s * HIST_STRIDE + hl] = chosen
                            hist_len[s] = hl + 1
                        }
                        var alive = true
                        if want_stream { alive = write_sse_piece(cb_cfd[s], model_name, is_chat, piece) }
                        if !alive {
                            stream_cancelled += 1
                            let _ = unsafe { tn_moe_paged_seq_free(handle, s) }
                            hist_len[s] = 0
                            let _ = net_close(cb_cfd[s])
                            cb_state[s] = 0
                            cb_cfd[s] = -1
                            cb_text[s] = ""
                        } else if cb_gen[s] >= cb_max[s] || cb_pos[s] + 2 >= 4096 {
                            let dec_ms = moe_now_ms() - cb_tdec[s]
                            if cb_gen[s] > 0 && dec_ms > 0.0 {
                                let denom = if cb_gen[s] > 1 { cb_gen[s] - 1 } else { 1 }
                                tpot_hist.observe(dec_ms / int_to_float(denom))
                            }
                            send_final_cb_response(cb_cfd[s], model_name, is_chat, want_stream, cb_text[s], cb_ptoks[s], cb_cached[s], cb_gen[s], s, cb_pf_ms[s], dec_ms, "length")
                            cb_state[s] = 0
                            cb_cfd[s] = -1
                            cb_text[s] = ""
                        }
                    }
                }
                bi += 1
            }
        }
    }

    let _ = reactor_del(rfd, lfd)
    let _ = reactor_close(rfd)
    let _ = net_close(lfd)
    model.destroy()
    println("[tenon-native-v10] graceful shutdown complete.")
    0
}
