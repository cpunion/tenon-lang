// examples/showcase/interactive_tui.tn — Real Full-Screen Interactive ANSI TUI (OpenUI -> VDOM -> Double-Buffered Diff)
//
// Build & run interactively in your terminal:
//   ./target/release/tenon build --c-src std/os/term_shim.c -o /tmp/tenon_tui examples/showcase/interactive_tui.tn
//   /tmp/tenon_tui
//
// Keys:
//   [+] / [=]  Increase TPS load live (watch minimal ANSI diff byte count!)
//   [-]        Decrease TPS load live
//   [1]/[2]    Switch between SaaS Revenue & Apple Silicon GPU OpenUI presets
//   [s]        Replay live progressive OpenUI Lang LLM streaming animation!
//   [q] / Esc  Restore terminal and exit cleanly with 0 leaks

import "std/os/io.tn"
import "std/text/text.tn"
import "std/ui/vdom.tn"
import "std/ui/openui.tn"
import "std/ui/tui.tn"

extern "C" {
    fn tn_term_enter_raw() Int
    fn tn_term_leave_raw() Int
    fn tn_term_poll_key(timeout_ms Int) Int
    fn tn_term_flush() Int
}

pure fn preset_openui(mode Int) Text {
    if mode == 1 {
        "root = Card([hdr, kpis, chart, btn])\nhdr = Header(\"Tenon Interactive TUI\", \"Keys: [+/-] Load  [1/2] View  [s] Stream  [q] Quit\")\nkpis = Row([m1, m2])\nm1 = Metric(\"Throughput\", $tps, \"+24%\")\nm2 = Metric(\"ANSI Diff\", $diff_b, \"Perceus=0\")\nchart = BarChart([\"Web\", \"TUI\", \"GPU\"], [$b1, $b2, $b3])\nbtn = Button(\"Active: Dashboard\", @dash)\n"
    } else {
        "root = Card([hdr, kpis, chart, btn])\nhdr = Header(\"Apple Silicon Metal GPU\", \"Keys: [+/-] Load  [1/2] View  [s] Stream  [q] Quit\")\nkpis = Row([m1, m2])\nm1 = Metric(\"Fused Ops\", $tps, \"-50% VRAM\")\nm2 = Metric(\"ANSI Diff\", $diff_b, \"Zero-Rust\")\nchart = BarChart([\"MM\", \"Bias\", \"ReLU\"], [$b1, $b2, $b3])\nbtn = Button(\"Active: Metal GPU\", @gpu)\n"
    }
}

pub fn main() Int {
    let demo_mode = sys_env("TENON_TUI_DEMO") == "1"
    let is_tty = if demo_mode { false } else { unsafe { tn_term_enter_raw() != 0 } }

    var tps = 180
    var view_mode = 1
    var stream_chars = 9999
    var last_diff_bytes = 0
    var prev_buf = tui_buffer_new(66, 15)
    var first_frame = true
    var frame = 0

    var running = true
    while running {
        let full_src = preset_openui(view_mode)
        let cur_src = if stream_chars < len(full_src) {
            str_slice(full_src, 0, stream_chars)
        } else {
            full_src
        }
        let doc = openui_parse_stream(cur_src, stream_chars >= len(full_src))
        var store = ui_store_new()
        store = ui_store_set(store, "tps", int_to_text(tps) ++ "k/s")
        store = ui_store_set(store, "diff_b", int_to_text(last_diff_bytes) ++ " B")
        store = ui_store_set(store, "b1", int_to_text(tps / 2))
        store = ui_store_set(store, "b2", int_to_text((tps * 3) / 4))
        store = ui_store_set(store, "b3", int_to_text(tps))

        let vdom = openui_to_vdom(doc, store)
        let next_buf = render_vdom_to_tui(vdom, 66, 15)
        let diff = if first_frame {
            tui_diff_ansi(tui_buffer_new(66, 15), next_buf)
        } else {
            tui_diff_ansi(prev_buf, next_buf)
        }
        last_diff_bytes = len(diff)
        prev_buf = next_buf
        first_frame = false

        if is_tty {
            if len(diff) > 0 {
                print(diff)
                let _ = unsafe { tn_term_flush() }
            }
            let wait_ms = if stream_chars < len(full_src) { 25 } else { 60 }
            let key = unsafe { tn_term_poll_key(wait_ms) }
            if key == 113 || key == 81 || key == 27 { // 'q' / 'Q' / Esc
                running = false
            } else if key == 43 || key == 61 { // '+' / '='
                tps += 15
            } else if key == 45 { // '-'
                if tps > 30 { tps -= 15 }
            } else if key == 49 { // '1'
                view_mode = 1
            } else if key == 50 { // '2'
                view_mode = 2
            } else if key == 115 || key == 83 { // 's' / 'S' -> replay OpenUI streaming!
                stream_chars = 16
            }
            if stream_chars < len(full_src) {
                stream_chars += 14
            }
        } else {
            // Non-interactive preview / CI smoke mode
            if frame == 0 || frame == 3 {
                println("--- TUI Frame " ++ int_to_text(frame) ++ " (ANSI diff=" ++ int_to_text(last_diff_bytes) ++ " B) ---")
                print(tui_buffer_to_plain_text(prev_buf))
            }
            tps += 20
            frame += 1
            if frame >= 4 {
                running = false
            }
        }
    }

    if is_tty {
        let _ = unsafe { tn_term_leave_raw() }
    }
    0
}
