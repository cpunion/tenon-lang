import "std/nn/tensor.tn"

pub pure fn broken_linear_layer(x Matrix[4, 8], w Matrix[6, 2]) Tensor2D {
    // Compile-time FAIL-CLOSED error: requires `a.cols == b.rows` (8 != 6)!
    nn_matmul_verified(x, w)
}

pub fn main() Int { 0 }
