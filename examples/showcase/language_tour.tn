// examples/showcase/language_tour.tn — Tenon Programming Experience Tour!
//
// Experience why writing Tenon feels as clean as Go/TypeScript while giving you
// stronger static guarantees than Rust (zero lifetime annotations, zero borrow-checker fights,
// zero GC pauses, compile-time Z3 proofs, linear typestates, and single-source GPU compute!).
//
// Try running:
//   ./target/release/tenon check examples/showcase/language_tour.tn
//   ./target/release/tenon run   examples/showcase/language_tour.tn
//
// Then scroll to the bottom and uncomment ANY of the 4 "TRY BREAKING IT" lines to see
// Tenon catch bugs at compile time with caret highlights & Z3 counterexamples!

import "std/core/types.tn"
import "std/text/text.tn"
import "std/encoding/json.tn"
import "std/os/io.tn"
import "std/gpu/tensor.tn"

// =========================================================================
// 1. Refined Types & Zero-Boilerplate `@checkfree` Loops (No Bounds/Div Checks!)
// =========================================================================

pub type Percentage = Int where 0 <= self && self <= 100

/// Notice: NO manual `invariant` needed — Tenon auto-synthesizes `0 <= i <= len(scores)`,
/// eliminates every bounds check, and proves `len(scores) > 0` makes integer division trap-free!
pub pure fn average_score(scores List[Percentage]) Percentage
    requires len(scores) >= 1 && len(scores) <= 10000
{
    var sum = 0
    var i = 0
    while i < len(scores) invariant 0 <= i && i <= len(scores) && 0 <= sum && sum <= 100 * i {
        sum = sum + scores[i]
        i += 1
    }
    sum / len(scores)
}

/// Static NaN-freedom: `FiniteFloat` / `NonNegFloat` reject NaN/Inf & div-by-zero at compile time!
pub pure fn weighted_blend(a NonNegFloat, b NonNegFloat, weight FiniteFloat where self > 0.0) FiniteFloat {
    (a + b) / weight
}

// =========================================================================
// 2. Zero-Lifetime Value Safety (MVS + Perceus COW + `inout` Exclusivity)
//    No `&'a mut`, no `Rc<RefCell<T>>`, no `.clone()` clutter, and 0 leaks!
// =========================================================================

@derive(Eq, ToJson, FromJson)
pub record Order {
    symbol Text
    qty    Positive
    price  Positive
}

pub pure fn swap_ints(inout a Int, inout b Int) {
    let tmp = a
    a = b
    b = tmp
}

pub pure fn apply_fill(inout order Order, filled Positive) Result[Order, Text] {
    if filled >= order.qty {
        return Err(f"fill {filled} exceeds order qty {order.qty}")
    }
    mutate order {
        order.qty = order.qty - filled
    }
    Ok(order)
}

// =========================================================================
// 3. Compile-Time `@linear` Typestate Resources (`inout self` borrow vs `self` consume)
//    Try forgetting `tx.commit()` or calling `tx.exec()` after `commit()` -> compile error E0821!
// =========================================================================

@linear
pub record DbTransaction {
    id       Int
    ops_done Int
}

impl DbTransaction {
    pub fn begin(id Int) DbTransaction {
        DbTransaction { id = id, ops_done = 0 }
    }

    /// `inout self` borrows the linear transaction -> stays alive for more queries!
    pub fn exec(inout self, rows Int) {
        self.ops_done = self.ops_done + rows
    }

    /// By-value `self` consumes the transaction -> statically prevents use-after-commit!
    pub fn commit(self) Int {
        self.ops_done
    }
}

pub fn run_safe_transaction() Int {
    var tx = DbTransaction.begin(101)
    tx.exec(3)
    tx.exec(4)
    tx.commit()
    // TRY BREAKING IT #1: uncomment the line below -> E0821 use-after-consume!
    // tx.exec(1)
}

// =========================================================================
// 4. Dependent-Shape Tensors + Declarative `@kernel` / `@gpu_graph`
//    Matrix dimension mismatches are caught at COMPILE TIME!
// =========================================================================

@kernel("elementwise")
pub fn tour_scale_kernel(src List[Float32], inout dst List[Float32], n UInt32) {
    let i = gpu_global_id_x()
    if i < (n as Int) {
        dst[i] = src[i] * (2.0 as Float32)
    }
}

pub fn run_verified_tensor_pipeline() Int {
    let a = tensor2d_from_data(2, 3, [1.0 as Float32, 2.0 as Float32, 3.0 as Float32, 4.0 as Float32, 5.0 as Float32, 6.0 as Float32])
    let b = tensor2d_from_data(3, 2, [7.0 as Float32, 8.0 as Float32, 9.0 as Float32, 10.0 as Float32, 11.0 as Float32, 12.0 as Float32])
    let c = tensor2d_matmul(a, b) // Statically proved: 2x3 * 3x2 -> 2x2!

    // TRY BREAKING IT #2: uncomment below -> E0440 compile-time shape mismatch (2x3 * 4x2)!
    // let bad = tensor2d_zeros(4, 2)
    // let _ = tensor2d_matmul(a, bad)

    float_to_int(c.data[0] as Float)
}

// =========================================================================
// 5. Run the Full Interactive Tour!
// =========================================================================

pub fn main() Int {
    println("=== Welcome to the Tenon Language Experience Tour ===")

    // 1. Refined Types & Bounds-Check-Free Average
    let scores List[Percentage] = [92, 88, 96, 100]
    let avg = average_score(scores)
    println(f"[1] Verified average_score([92, 88, 96, 100]) = {avg}% (0 runtime bounds/div checks)")

    // TRY BREAKING IT #3: uncomment below -> E0410 `150` violates `Percentage (0..=100)`!
    // let bad_pct Percentage = 150

    // 2. FiniteFloat NaN-Free Arithmetic
    let blended = weighted_blend(80.0, 40.0, 2.0)
    println("[2] NaN-free weighted_blend(80.0, 40.0, 2.0)  = " ++ int_to_text(float_to_int(blended)))

    // 3. MVS `inout` + `@derive(ToJson, FromJson)` + Exhaustive `match`
    var ord = Order { symbol = "BTC-USD", qty = 10, price = 95000 }
    match apply_fill(ord, 3) {
        Ok(rem) => println("[3] Order JSON after fill(3)                  = " ++ json_encode[Order](rem))
        Err(msg) => println("[3] Fill rejected: " ++ msg)
    }

    // 4. `@linear` Typestate Transaction
    let committed = run_safe_transaction()
    println(f"[4] @linear DbTransaction committed rows      = {committed} (leak/double-commit impossible)")

    // 5. Dependent-Shape Tensor2D Matrix Multiplication
    let c00 = run_verified_tensor_pipeline()
    println(f"[5] Verified Tensor2D (2x3 * 3x2)[0,0]        = {c00} (compile-time shape checked)")

    // TRY BREAKING IT #4: uncomment below -> E0501 `inout` MVS Law of Exclusivity aliasing error!
    // var alias_val = 42
    // swap_ints(alias_val, alias_val)

    println("=== All 5 Tenon pillars verified with ZERO heap leaks! ===")
    0
}
