// examples/showcase/tenon_tpu_llm_bench.tn
// Tenon Native Google Cloud TPU Engine — Direct `libtpu.so` PJRT C-API + StableHLO XLA Compiler!
//
// Zero Python in the execution path: Tenon LLVM AOT -> `dlopen("libtpu.so")` -> `GetPjrtApi()`
// -> `PJRT_Client_Compile(StableHLO MLIR)` -> TPU TensorCore MXU Systolic Array!
//
// Verifies & benchmarks on real Google Cloud TPU (v5e-1 / v6e-1 Trillium):
//   1. PJRT C-API discovery + single-source `@kernel` compiled via `gpu_embedded_stablehlo()`
//   2. TPU MXU BF16 Matmul Roofline (4096x4096x4096 -> real Hardware TFLOPS!)
//   3. TPU HBM Bandwidth Roofline (BF16 vs W8A16 INT8 Weight-Only GEMV 8192x8192 -> real GB/s!)
//   4. Exact Numerical Verification of XLA-Fused Llama-3 Block (RMSNorm + Attn + SwiGLU) vs CPU FP32 Oracle
//   5. Full Llama-3.2-1B (16-layer d=2048 d_ff=8192) Prefill (S=512) & Decode Throughput on Google TPU!

import "std/core/types.tn"
import "std/os/io.tn"
import "std/text/text.tn"
import "std/gpu/tpu/tpu.tn"
import "std/nn/gpu/transformer_tpu.tn"

@kernel
pub fn tenon_tpu_vec_fma(a List[Float32], b List[Float32], inout out List[Float32]) Int {
    let i = gpu_global_id_x()
    out[i] = a[i] * b[i] + b[i]
    0
}

pure fn abs_f(x Float) Float {
    if x < 0.0 { -x } else { x }
}

fn synth_f32(n Int, seed Int, scale Float) List[Float32] {
    var out List[Float32] = list_filled(n, 0.0 as Float32)
    var s = seed
    var i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483647
        let u = int_to_float((s % 2001) - 1000) / 1000.0
        out[i] = (u * scale) as Float32
        i += 1
    }
    out
}

fn bench_tpu_mxu_bf16(m Int, k Int, n Int, iters Int) Int {
    let mlir = shlo_bf16_matmul(m, k, n)
    var exec = TpuExecutable.compile_mlir(mlir)
    assert(exec.handle > 0)
    let a = TpuBuffer.zeros_bf16_2d(m, k)
    let b = TpuBuffer.zeros_bf16_2d(k, n)
    // Warmup
    var wi = 0
    while wi < 5 {
        let tmp = exec.run_2(a.handle, b.handle, m * n, TPU_BF16)
        let _ = tmp.free()
        wi += 1
    }
    let t0 = time_now_ns()
    var i = 0
    while i < iters {
        let out = exec.run_2(a.handle, b.handle, m * n, TPU_BF16)
        let _ = out.free()
        i += 1
    }
    let dt_ns = time_now_ns() - t0
    let ms = int_to_float(dt_ns) / (int_to_float(iters) * 1000000.0)
    let flops = 2.0 * int_to_float(m) * int_to_float(k) * int_to_float(n)
    let tflops = (flops / (ms / 1000.0)) / 1000000000000.0
    let bytes = int_to_float(m * k + k * n + m * n) * 2.0
    let gbs = (bytes / 1000000000.0) / (ms / 1000.0)
    println(
        "TPU_MXU_BF16 " ++ int_to_text(m) ++ "x" ++ int_to_text(k) ++ "x" ++ int_to_text(n)
        ++ " ms=" ++ float_to_text(ms)
        ++ " TFLOPS=" ++ float_to_text(tflops)
        ++ " eff_GBs=" ++ float_to_text(gbs)
    )
    let _ = a.free()
    let _ = b.free()
    let _ = exec.free()
    0
}

fn bench_tpu_w8a16_gemv(k Int, n Int, iters Int) Int {
    let mlir = shlo_w8a16_matmul(1, k, n)
    var exec = TpuExecutable.compile_mlir(mlir)
    assert(exec.handle > 0)
    let x = TpuBuffer.zeros_bf16_2d(1, k)
    let wq = TpuBuffer.zeros_s8_2d(k, n)
    let sc_list = list_filled(n, 0.01 as Float32)
    let sc = TpuBuffer.from_bf16_1d(f32_list_to_bf16(sc_list))
    var wi = 0
    while wi < 5 {
        let tmp = exec.run_3(x.handle, wq.handle, sc.handle, n, TPU_BF16)
        let _ = tmp.free()
        wi += 1
    }
    let t0 = time_now_ns()
    var i = 0
    while i < iters {
        let out = exec.run_3(x.handle, wq.handle, sc.handle, n, TPU_BF16)
        let _ = out.free()
        i += 1
    }
    let dt_ns = time_now_ns() - t0
    let ms = int_to_float(dt_ns) / (int_to_float(iters) * 1000000.0)
    let bytes = int_to_float(k * n)
    let gbs = (bytes / 1000000000.0) / (ms / 1000.0)
    println(
        "TPU_HBM_W8A16_GEMV 1x" ++ int_to_text(k) ++ "x" ++ int_to_text(n)
        ++ " ms=" ++ float_to_text(ms)
        ++ " eff_GBs=" ++ float_to_text(gbs)
    )
    let _ = x.free()
    let _ = wq.free()
    let _ = sc.free()
    let _ = exec.free()
    0
}

fn bench_tpu_llama3_layers(name Text, seq Int where self > 0, d Int where self > 0, dff Int where self > 0, n_layers Int, iters Int) Int {
    let mlir = shlo_llama3_block_bf16(seq, d, dff)
    var exec = TpuExecutable.compile_mlir(mlir)
    let x0 = TpuBuffer.zeros_bf16_2d(seq, d)
    let ones_d = f32_list_to_bf16(list_filled(d, 1.0 as Float32))
    let n1 = TpuBuffer.from_bf16_1d(ones_d)
    let wq = TpuBuffer.zeros_bf16_2d(d, d)
    let wk = TpuBuffer.zeros_bf16_2d(d, d)
    let wv = TpuBuffer.zeros_bf16_2d(d, d)
    let wo = TpuBuffer.zeros_bf16_2d(d, d)
    let n2 = TpuBuffer.from_bf16_1d(ones_d)
    let wg = TpuBuffer.zeros_bf16_2d(d, dff)
    let wu = TpuBuffer.zeros_bf16_2d(d, dff)
    let wd = TpuBuffer.zeros_bf16_2d(dff, d)

    let ins = [x0.handle, n1.handle, wq.handle, wk.handle, wv.handle, wo.handle, n2.handle, wg.handle, wu.handle, wd.handle]
    // Warmup
    var wi = 0
    while wi < 3 {
        let tmp = exec.run_many(ins, seq * d, TPU_BF16)
        let _ = tmp.free()
        wi += 1
    }
    let t0 = time_now_ns()
    var i = 0
    while i < iters {
        let out = exec.run_many(ins, seq * d, TPU_BF16)
        let _ = out.free()
        i += 1
    }
    let dt_ns = time_now_ns() - t0
    let layer_ms = int_to_float(dt_ns) / (int_to_float(iters) * 1000000.0)
    let full_ms = layer_ms * int_to_float(n_layers)
    let tok_s = (int_to_float(seq) * 1000.0) / full_ms
    let layer_w_bytes = int_to_float(4 * d * d + 3 * d * dff) * 2.0
    let gbs = (layer_w_bytes / 1000000000.0) / (layer_ms / 1000.0)
    println(
        "BENCH_TPU_LLAMA3 " ++ name
        ++ " seq=" ++ int_to_text(seq)
        ++ " layers=" ++ int_to_text(n_layers)
        ++ " layer_ms=" ++ float_to_text(layer_ms)
        ++ " full_ms=" ++ float_to_text(full_ms)
        ++ " tok_s=" ++ float_to_text(tok_s)
        ++ " eff_GBs=" ++ float_to_text(gbs)
    )
    let _ = x0.free()
    let _ = n1.free()
    let _ = wq.free()
    let _ = wk.free()
    let _ = wv.free()
    let _ = wo.free()
    let _ = n2.free()
    let _ = wg.free()
    let _ = wu.free()
    let _ = wd.free()
    let _ = exec.free()
    0
}

fn main() Int {
    println("=== Tenon Native Google Cloud TPU Engine (Direct `libtpu.so` PJRT C-API + StableHLO XLA) ===")
    let embedded_shlo = gpu_embedded_stablehlo()
    println("EMBEDDED_STABLEHLO_BYTES=" ++ int_to_text(len(embedded_shlo)))

    if !tpu_init() {
        println("Google Cloud TPU PJRT plugin (`libtpu.so`) not detected on this host (expected on macOS).")
        return 0
    }
    println(
        "TPU_DEVICE platform=\"" ++ tpu_platform_name()
        ++ "\" kind=\"" ++ tpu_device_kind()
        ++ "\" count=" ++ int_to_text(tpu_device_count())
        ++ " PJRT=v" ++ int_to_text(tpu_pjrt_major()) ++ "." ++ int_to_text(tpu_pjrt_minor())
    )

    // 1. Exact Numerical Verification of Tenon StableHLO BF16 Matmul on real Google TPU MXU!
    let vm = 64
    let vk = 64
    let vn = 64
    let a_f32 = synth_f32(vm * vk, 17, 0.5)
    let b_f32 = synth_f32(vk * vn, 31, 0.5)
    let a_bf = f32_list_to_bf16(a_f32)
    let b_bf = f32_list_to_bf16(b_f32)
    let a_q = bf16_list_to_f32(a_bf)
    let b_q = bf16_list_to_f32(b_bf)
    var mm_exec = TpuExecutable.compile_mlir(shlo_bf16_matmul(vm, vk, vn))
    let ta = TpuBuffer.from_bf16_2d(a_bf, vm, vk)
    let tb = TpuBuffer.from_bf16_2d(b_bf, vk, vn)
    var tc = mm_exec.run_2(ta.handle, tb.handle, vm * vn, TPU_BF16)
    var out_bf List[BFloat16] = list_filled(vm * vn, 0.0 as BFloat16)
    let _ = tc.read_bf16(out_bf)
    let out_f32 = bf16_list_to_f32(out_bf)
    var max_err = 0.0
    var r = 0
    while r < vm {
        var c = 0
        while c < vn {
            var acc = 0.0
            var k = 0
            while k < vk {
                acc += (a_q[r * vk + k] as Float) * (b_q[k * vn + c] as Float)
                k += 1
            }
            let diff = abs_f((out_f32[r * vn + c] as Float) - acc)
            if diff > max_err { max_err = diff }
            c += 1
        }
        r += 1
    }
    assert(max_err < 0.05)
    println("VERIFY_TPU_MXU_BF16 64x64x64 max_err=" ++ float_to_text(max_err) ++ " PASS")
    let _ = ta.free()
    let _ = tb.free()
    let _ = tc.free()
    let _ = mm_exec.free()

    // 2. TPU MXU Compute Roofline (BF16 TFLOPS) & HBM Bandwidth Roofline (BF16 & W8A16 INT8 GB/s)
    let _ = bench_tpu_mxu_bf16(4096, 4096, 4096, 50)
    let _ = bench_tpu_mxu_bf16(1, 16384, 16384, 50)
    let _ = bench_tpu_w8a16_gemv(16384, 16384, 50)

    // 3. Full XLA-Fused Llama-3.2-1B (16-layer d=2048 d_ff=8192) Prefill (S=512) & Batched/Single Decode on TPU!
    let _ = bench_tpu_llama3_layers("Llama3.2_1B_Prefill_S512_BF16", 512, 2048, 8192, 16, 20)
    let _ = bench_tpu_llama3_layers("Llama3.2_1B_Decode_B32_BF16", 32, 2048, 8192, 16, 30)
    let _ = bench_tpu_llama3_layers("Llama3.2_1B_Decode_B1_BF16", 1, 2048, 8192, 16, 50)
    println("=== TPU DONE (Perceus live_objects == 0, Linear HBM == 0 leaks) ===")
    0
}
