test fn router_matches_static_param_and_wildcard() {
    let m1 = match_route_pattern("/users/:id/posts/:pid", "/users/42/posts/9")
    assert m1.matched && len(m1.params) == 2
    assert m1.params[0].name == "id" && m1.params[0].value == "42"
    assert m1.params[1].name == "pid" && m1.params[1].value == "9"

    let m2 = match_route_pattern("/files/*path", "/files/a/b/c.txt")
    assert m2.matched && len(m2.params) == 1
    assert m2.params[0].name == "path" && m2.params[0].value == "a/b/c.txt"

    let m3 = match_route_pattern("/users/:id", "/orders/42")
    assert !m3.matched
}

test fn radix_router_and_static_security_work() {
    var rx = radix_router_new()
    rx = rx.insert("GET", "/health", 0)
    rx = rx.insert("GET", "/users/:id/posts/:pid", 1)
    rx = rx.insert("POST", "/users/:id/posts/:pid", 2)
    rx = rx.insert("GET", "/static/*file", 3)

    let h0 = rx.lookup("GET", "/health")
    assert h0.route_idx == 0 && !h0.matched_other_m

    let h1 = rx.lookup("GET", "/users/42/posts/9")
    assert h1.route_idx == 1 && len(h1.params) == 2
    assert h1.params[0].value == "42" && h1.params[1].value == "9"

    let h405 = rx.lookup("DELETE", "/users/42/posts/9")
    assert h405.route_idx == -1 && h405.matched_other_m

    let hw = rx.lookup("GET", "/static/js/app.js")
    assert hw.route_idx == 3 && hw.params[0].value == "js/app.js"

    // Path traversal attack (`..`) MUST be rejected with 400 Bad Request
    let bad = serve_static_with("examples/web_app", "../secret.txt", |_| Some("secret"))
    assert bad.status == 400
    let ok_js = serve_static_with("examples/web_app", "app.js", |_| Some("console.log(1)"))
    assert ok_js.status == 200 && ok_js.body == "console.log(1)"
}

test fn web_app_end_to_end_live_http_and_openapi() {
    assert main() == 200
}
