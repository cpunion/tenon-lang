// examples/dogfood/unified_ui_demo.tn — ONE OpenUI Stream + ONE Unified VDOM -> Web + TUI + Real Metal GPU (`tenon-gpui`)!
//
// Proves the complete Tenon unified UI vision end-to-end:
//   Single OpenUI Lang source (`root = Card([hdr, kpis, chart, btn])`)
//     -> Single `VNode` React-like Virtual DOM
//     -> Target 1 (Web):  SSR HTML + minimal keyed JSON VDOM Patch stream
//     -> Target 2 (TUI):  Double-buffered 2D cell grid + minimal ANSI escape diff
//     -> Target 3 (GPUI): `FiniteFloat` Flexbox layout -> batched SDF `QuadInstance`s
//                         -> Real Apple Silicon Metal GPU offscreen RGBA8 hardware render!

import "std/os/io.tn"
import "std/text/text.tn"
import "std/ui/vdom.tn"
import "std/ui/openui.tn"
import "std/ui/tui.tn"
import "std/ui/layout.tn"
import "std/ui/scene.tn"
import "std/gpu/gpu.tn"

pure fn px_ch(rgba Bytes, width Int, x Int, y Int, ch Int) Int {
    bytes_get(rgba, (y * width + x) * 4 + ch) as Int
}

fn render_scene_on_metal_gpu(scene SceneGraph) Bytes {
    var pass = GpuQuadPass.begin()
    var i = 0
    while i < len(scene.quads) {
        let q = scene.quads[i]
        pass.push_quad(q.x, q.y, q.w, q.h, q.r, q.g, q.b, q.a, q.radius, q.border_w, q.br, q.bg)
        i += 1
    }
    pass.submit_offscreen(scene.width, scene.height)
}

pub fn main() Int {
    let openui_src = "root = Card([hdr, kpis, chart, btn])\nhdr = Header(\"Tenon Unified UI\", \"1 OpenUI Source -> Web + TUI + Metal GPU\")\nkpis = Row([m1, m2])\nm1 = Metric(\"Frame Rate\", $fps, \"120Hz\")\nm2 = Metric(\"Leaks\", \"0\", \"Perceus\")\nchart = BarChart([\"Web\", \"TUI\", \"GPU\"], [100, 140, 220])\nbtn = Button(\"Deploy\", @deploy)\n"

    let doc = openui_parse_stream(openui_src, true)
    let state1 = ui_store_set(ui_store_new(), "fps", "118 fps")
    let state2 = ui_store_set(state1, "fps", "120 fps")
    let vdom1 = openui_to_vdom(doc, state1)
    let vdom2 = openui_to_vdom(doc, state2)

    // ===== TARGET 1: WEB (SSR HTML + Keyed VDOM JSON Patches) =====
    let web_html = vnode_to_html(vdom2)
    let web_patches = patches_to_json(diff_vdom(vdom1, vdom2))
    println("=== [Target 1: Web VDOM] ===")
    println("HTML bytes       : " ++ int_to_text(len(web_html)))
    println("VDOM JSON patch  : " ++ web_patches)

    // ===== TARGET 2: TERMINAL TUI (Double-Buffered 2D Grid + ANSI Diff) =====
    let tui1 = render_vdom_to_tui(vdom1, 58, 14)
    let tui2 = render_vdom_to_tui(vdom2, 58, 14)
    let tui_diff = tui_diff_ansi(tui1, tui2)
    println("")
    println("=== [Target 2: Terminal TUI (ANSI Diff = " ++ int_to_text(len(tui_diff)) ++ " bytes)] ===")
    print(tui_buffer_to_plain_text(tui2))

    // ===== TARGET 3: NATIVE METAL GPU (`tenon-gpui` Flexbox + Batched SDF Quads) =====
    println("=== [Target 3: Native Metal GPU (`tenon-gpui`)] ===")
    if !gpu_init() {
        println("ERROR: Metal GPU unavailable")
        return 1
    }
    println("Metal GPU Device : " ++ gpu_device_name())
    let scene = vdom_to_scene(vdom2, 640, 400)
    let fb = render_scene_on_metal_gpu(scene)

    // Sample pixels inside:
    // - Header cyan banner at (100, 50): R~15, G~133, B~217
    // - BarChart sky-blue bar #3 (longest bar) at (200, 275): B > 200
    // - Amber Button pill at (60, 325): R > 220, G > 140, B < 40
    let hdr_b = px_ch(fb, 640, 100, 50, 2)
    let hdr_g = px_ch(fb, 640, 100, 50, 1)
    let btn_r = px_ch(fb, 640, 60, 325, 0)
    let btn_g = px_ch(fb, 640, 60, 325, 1)
    let btn_b = px_ch(fb, 640, 60, 325, 2)

    println("Batched Quads    : " ++ int_to_text(len(scene.quads)) ++ " SDF quads -> 1 instanced Metal draw call (640x400 RGBA8)")
    println("Header (100,50)  : G=" ++ int_to_text(hdr_g) ++ " B=" ++ int_to_text(hdr_b))
    println("Button (60,325)  : R=" ++ int_to_text(btn_r) ++ " G=" ++ int_to_text(btn_g) ++ " B=" ++ int_to_text(btn_b))

    if hdr_b < 180 || btn_r < 210 || btn_g < 130 || btn_b > 50 {
        println("ERROR: Metal GPUI pixel verification failed!")
        return 2
    }
    println("ALL 3 TARGETS (Web + TUI + Apple Silicon Metal GPUI): VERIFIED OK!")
    0
}
