// Tenon Standard Library Self-Test (4-Layer OOP Stdlib + Interfaces + @derive JSON/Schema)
// Verifies:
//   - Layer 0 (`std/core/types`, `std/core/ops`): refined primitives, `List[T]` OOP methods
//     (`push`/`len`/`get`/`first`/`last`/`clear`), `Option`/`Result` methods, `Display`/`Writer`
//   - Layer 1 (`std/text/text`, `std/text/builder`, `std/collections/map`):
//     `Text` & `Int` OOP methods, O(n) `TextBuilder.new()`, COW generic `Map[K, V].new()` (`set`/`with`/`clear`)
//   - Layer 2 (`std/encoding/json`, `std/encoding/dotenv`): `JsonValue.object()` / `JsonValue.parse()`,
//     `@derive(ToJson, FromJson, JsonSchema)` with refined `SafeRelPath` & `Positive` boundary proofs
//   - Layer 3 (`std/os/*`): `SafeRelPath.parse()`, `Path.join()`, `MemFs.new()` / `OsFs.new()`,
//     `dyn FileSystem`, `dyn Writer` + static `[W Writer]`, `Process.exec()`

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"
import "std/text/builder.tn"
import "std/collections/map.tn"
import "std/collections/set.tn"
import "std/encoding/json.tn" as json
import "std/encoding/dotenv.tn" as dotenv
import "std/os/io.tn"
import "std/os/path.tn"
import "std/os/fs.tn" as fs
import "std/os/process.tn"

@derive(ToJson, FromJson, JsonSchema)
pub record FilePatchReq {
    @doc("Workspace-relative path")
    path        SafeRelPath
    @doc("Line number (1-based)")
    line_no     Positive
    @rename("new_text")
    @doc("Replacement content")
    replacement Text
    @skip_if_none
    note        Option[Text] = None
}

@derive(ToJson, FromJson)
@tag("type")
pub enum AgentEvent {
    Ping
    Message(Text)
}

@derive(ToJson, FromJson, JsonSchema)
pub record SensorReading {
    sensor Text
    temp   Float
    humid  Float
}

@derive(Eq, Hash)
pub record Point {
    x   Int
    y   Int
    tag Text
}

pub enum Tree[T] {
    Empty
    Leaf(T)
    Node(Tree[T], T, Tree[T])
}

pub pure fn tree_sum(t Tree[Int]) Int {
    match t {
        Empty => 0
        Leaf(v) => v
        Node(Leaf(a), v, Leaf(b)) => a + v + b
        Node(l, v, r) => tree_sum(l) + v + tree_sum(r)
    }
}

pub pure fn tree_join(t Tree[Text]) Text {
    match t {
        Empty => ""
        Leaf(s) => s
        Node(l, s, r) => tree_join(l) ++ s ++ tree_join(r)
    }
}

pub pure fn make_adder(base Int) fn(Int) Int {
    |x| x + base
}

pub pure fn make_prefixer(prefix Text) fn(Text) Text {
    |s| prefix ++ s
}

pub pure fn parse_sum_pair(a Text, b Text) Result[Int, Text] {
    let keep = "alive:" ++ a
    let x = a.parse_int()?
    let y = b.parse_int()?
    if keep.len() == 0 {
        return Err("impossible")
    }
    Ok(x + y)
}

pub pure fn lookup_double(m Map[Text, Int], k Text) Option[Int] {
    let note = "lookup:" ++ k
    let v = m.get(k)?
    if note.len() == 0 {
        return None
    }
    Some(v * 2)
}

pub pure fn swap_pair(a Int, b Text) (Text, Int) {
    (b, a)
}

pub fn write_labeled[W Writer](inout w W, label Text, body Text) Int {
    let a = w.write_str(label)
    let b = w.write_byte(58)
    let c = w.write_str(body)
    a + b + c
}

pub fn write_dyn(inout w dyn Writer, text Text) Int {
    w.write_line(text)
}

pub fn roundtrip_fs(inout storage dyn FileSystem, path Text, content Text) Result[Text, FsError] {
    match storage.write_text(path, content) {
        Err(e) => { return Err(e) }
        Ok(_) => {}
    }
    storage.read_text(path)
}

pub fn main() Int {
    // 1. Layer 0: `List[T]` OOP methods (`filled`, `push`, `set`, `pop`, `len`, `get`, `first`, `last`, `clear`) — zero leaks!
    var nums = List.filled(3, 7)
    assert nums.len() == 3
    assert nums[0] == 7 && nums[2] == 7
    assert nums.set(1, 20)
    nums[2] = 30
    assert nums.first().unwrap_or(0) == 7
    assert nums.get(1).unwrap_or(0) == 20
    assert nums.pop().unwrap_or(0) == 30
    assert nums.len() == 2
    nums.push(99)
    assert nums.last().unwrap_or(0) == 99
    assert nums.get(9).is_none()
    nums.clear()
    assert nums.is_empty()

    var words List[Text] = []
    words.push("tenon")
    words.push("oop")
    words[1] = "fast"
    assert words.len() == 2
    assert words.first().unwrap_or("") == "tenon"
    assert words.pop().unwrap_or("") == "fast"
    assert words.len() == 1

    // List[dyn Display] with `list.push(...)` auto-boxing concrete types!
    var items List[dyn Display] = []
    items.push(42)
    items.push(true)
    items.push("hello")
    assert items.len() == 3
    assert items[0].display() == "42"
    assert items[1].display() == "true"
    assert items[2].display() == "hello"

    // 2. Layer 1: `Text` & `Int` OOP methods, generic `Map[K, V]`, `TextBuilder.new()`
    let r = SliceRange { start = 0, end = 5 }
    assert "tenon-lang".len() == 10
    assert "tenon-lang".slice(0, 5) == "tenon"
    assert "tenon-lang".slice_range(r) == "tenon"
    assert "data: {\"a\":1}".starts_with("data:")
    assert "hello.tn".ends_with(".tn")
    assert "  \t hello world \r\n ".trim() == "hello world"
    assert "data: hello".strip_prefix("data: ").unwrap_or("") == "hello"
    assert "abcdef".find("cd").unwrap_or(999) == 2
    assert "abcdef".find("zz").is_none()
    assert "tenon-lang".contains("lang")
    assert "a b a".replace_first("a", "X") == "X b a"
    assert "a'b'c".replace_all("'", "'\\''") == "a'\\''b'\\''c"
    assert (-42).to_text() == "-42"
    assert Int.parse("  -12345 ").unwrap_or(0) == -12345
    assert "12x".parse_int().is_err()
    assert div_exact(21, 3) == 7

    var m = Map[Text, Text].new()
    m.set("lang", "tenon")
    m.set("ver", "3")
    m.set("ver", "3.1")
    assert m.len() == 2
    assert m.has("lang")
    assert m.get("ver").unwrap_or("") == "3.1"
    let m2 = m.with("ver", "4")
    assert m.get("ver").unwrap_or("") == "3.1"
    assert m2.get("ver").unwrap_or("") == "4"
    assert m.remove("lang").unwrap_or("") == "tenon"
    assert m.len() == 1
    assert !m.has("lang")
    assert m2.has("lang")
    m.clear()
    assert m.is_empty()

    // Generic monomorphization across distinct concrete `(K, V)` pairs (`Map[Text, Int]` and `Map[Int, Text]`)
    var scores Map[Text, Int] = Map.new()
    scores.set("alice", 95)
    scores.set("bob", 88)
    scores.set("alice", 99)
    assert scores.len() == 2
    assert scores.get("alice").unwrap_or(0) == 99
    assert scores.remove("bob").unwrap_or(0) == 88
    assert scores.len() == 1

    var by_id = Map[Int, Text].with_capacity(8)
    by_id.set(1, "one")
    by_id.set(42, "answer")
    assert by_id.get(42).unwrap_or("") == "answer"
    assert by_id.remove(1).unwrap_or("") == "one"
    assert by_id.len() == 1

    // High-scale O(1) HashMap stress test: 2000 inserts, updates, swap-removes, tombstone compaction & lookups!
    var big = Map[Text, Text].with_capacity(16)
    var k = 0
    while k < 2000 {
        let ks = "k_" ++ k.to_text()
        big.set(ks, "v_" ++ k.to_text())
        k += 1
    }
    assert big.len() == 2000
    assert big.get("k_0").unwrap_or("") == "v_0"
    assert big.get("k_1337").unwrap_or("") == "v_1337"
    assert big.get("k_1999").unwrap_or("") == "v_1999"
    assert big.get("missing_key").is_none()

    // Overwrite & delete half to exercise in-place update + O(1) swap-remove + tombstone compaction
    var d = 0
    while d < 1000 {
        assert big.remove("k_" ++ d.to_text()).is_some()
        d += 1
    }
    assert big.len() == 1000
    assert big.get("k_500").is_none()
    assert big.get("k_1500").unwrap_or("") == "v_1500"
    big.set("k_1500", "updated_1500")
    assert big.get("k_1500").unwrap_or("") == "updated_1500"
    let ks_live = big.keys()
    assert ks_live.len() == 1000
    assert big.has(ks_live[0])
    assert big.has(ks_live[999])

    // Static `[W Writer]` + Dynamic `dyn Writer` (with default method `write_line`!)
    var tb = TextBuilder.new()
    let _ = write_labeled(tb, "tenon", "ok")
    assert tb.finish() == "tenon:ok"

    let tb2 = TextBuilder.new()
    var dw dyn Writer = tb2
    let _ = write_dyn(dw, "line1")
    assert tb2.finish() == "line1\n"

    // 3. Layer 2: `JsonValue.parse` / `json.parse` + fluent `JsonValue` methods + O(n) serializer!
    let sample = "{\"type\":\"response.output_item.done\",\"ok\":true,\"empty\":null,\"nums\":[10,20,30],\"item\":{\"arguments\":\"{\\\"path\\\":\\\"demo.txt\\\",\\\"content\\\":\\\"line1\\\\nline2 \\\\u4f60\\\\u597d\\\"}\"}}"
    let ev = match JsonValue.parse(sample) {
        Ok(v) => v
        Err(err) => {
            println("json parse error: " ++ err.message)
            return 1
        }
    }
    assert ev.get_str("type").unwrap_or("") == "response.output_item.done"
    assert ev.get_bool("ok").unwrap_or(false)
    let num1 = match ev.get("nums") {
        Some(arr) => match arr.at(1) {
            Some(v) => v.as_int().unwrap_or(-1)
            None => -1
        }
        None => -1
    }
    assert num1 == 20

    let parsed_content = match ev.get("item") {
        Some(item) => match item.get_str("arguments") {
            Some(raw_args) => match json.parse(raw_args) {
                Ok(aobj) => aobj.get_str("content").unwrap_or("")
                Err(_) => ""
            }
            None => ""
        }
        None => ""
    }
    assert parsed_content == "line1\nline2 你好"

    // Malformed JSON -> structured Err(JsonError)
    let bad_pos = match json.parse("{\"a\": [1, 2, }") {
        Ok(_) => -1
        Err(e) => e.pos
    }
    assert bad_pos > 0

    // 4. `@derive(ToJson, FromJson, JsonSchema)` + `SafeRelPath.parse` + Generic `json.encode` / `json.decode[T]`!
    let p_ok = match SafeRelPath.parse("src/main.tn") {
        Ok(p) => p
        Err(_) => { return 2 }
    }
    let req = FilePatchReq {
        path = p_ok,
        line_no = 12,
        replacement = "hello tenon",
        note = Some("verified")
    }
    let encoded = json.encode(req)
    assert encoded == "{\"path\":\"src/main.tn\",\"line_no\":12,\"new_text\":\"hello tenon\",\"note\":\"verified\"}"

    let decoded = match json.decode[FilePatchReq](encoded) {
        Ok(d) => d
        Err(e) => {
            println("decode error: " ++ e.message)
            return 3
        }
    }
    assert decoded.path == "src/main.tn"
    assert decoded.line_no == 12
    assert decoded.replacement == "hello tenon"
    assert decoded.note.unwrap_or("") == "verified"

    // Refinement boundary enforcement in derived `FromJson`:
    assert json.decode[FilePatchReq]("{\"path\":\"../etc/passwd\",\"line_no\":1,\"new_text\":\"x\"}").is_err()
    assert json.decode[FilePatchReq]("{\"path\":\"ok.tn\",\"line_no\":0,\"new_text\":\"x\"}").is_err()

    // Derived `JsonSchema` includes description + minimum: 1 from `Positive`!
    let sch = FilePatchReq.json_schema()
    assert sch.get_str("type").unwrap_or("") == "object"
    let sch_text = sch.stringify()
    assert sch_text.contains("\"minimum\":1")
    assert sch_text.contains("\"new_text\"")

    // Derived Tagged Union Enum `AgentEvent` (`@tag("type")`) roundtrip!
    let ev_msg = Message("hello")
    let ev_json = json.encode(ev_msg)
    assert ev_json == "{\"type\":\"Message\",\"value\":\"hello\"}"
    let ev_rt = match json.decode[AgentEvent](ev_json) {
        Ok(e) => match e {
            Message(s) => s
            Ping => ""
        }
        Err(_) => ""
    }
    assert ev_rt == "hello"

    // 5. Layer 2: `Dotenv.parse` & aliased `dotenv.parse` returning `Map[Text, Text]`
    let env_map = dotenv.parse("# c\nexport FOO = \"bar_baz\"\nA=1\n")
    assert env_map.get("FOO").unwrap_or("") == "bar_baz"
    assert env_map.get("MISSING").is_none()

    // 6. Layer 3: `dyn FileSystem` with BOTH pure in-memory `MemFs.new()` AND real `OsFs.new()`!
    var mem dyn FileSystem = MemFs.new()
    let mem_res = match roundtrip_fs(mem, "virtual/hello.txt", "sandboxed") {
        Ok(txt) => txt
        Err(e) => e.message()
    }
    assert mem_res == "sandboxed"

    let ws = "/tmp/tenon_stdlib_v3_test_ws"
    let _ = Process.exec("mkdir -p " ++ Path.shell_quote(ws))
    var real_fs dyn FileSystem = OsFs.new()
    let os_res = match roundtrip_fs(real_fs, Path.join(ws, "real.txt"), "from os_fs") {
        Ok(txt) => txt
        Err(e) => e.message()
    }
    assert os_res == "from os_fs"
    let _ = Process.exec("rm -rf " ++ Path.shell_quote(ws))

    // 7. IEEE-754 `Float` + JSON `JFloat` + `@derive(ToJson, FromJson, JsonSchema)` with `Float`
    var fval = 1.5
    fval += 2.5
    fval *= 2.0
    fval /= 4.0
    fval -= 0.5
    assert fval == 1.5
    assert (-fval).abs() == 1.5
    assert (7).to_float() == 7.0
    assert (3.75).to_int() == 3
    assert 1.5e-2 > 0.01 && 1.5e-2 < 0.02
    assert Float.parse("3.25").unwrap_or(0.0) == 3.25
    assert "-0.5".parse_float().unwrap_or(0.0) == -0.5
    assert "not-a-float".parse_float().is_err()

    let jfloat_doc = match JsonValue.parse("{\"pi\":3.14,\"whole\":3.0,\"sci\":1.5e2}") {
        Ok(v) => v
        Err(_) => { return 4 }
    }
    assert jfloat_doc.get_float("pi").unwrap_or(0.0) > 3.13
    assert jfloat_doc.get_float("pi").unwrap_or(0.0) < 3.15
    assert jfloat_doc.get_float("whole").unwrap_or(0.0) == 3.0
    assert jfloat_doc.get_float("sci").unwrap_or(0.0) == 150.0
    assert jfloat_doc.stringify().contains("\"whole\":3.0")

    let sr = SensorReading { sensor = "lab-1", temp = 23.5, humid = 48.0 }
    let sr_json = json.encode(sr)
    assert sr_json.contains("\"temp\":23.5")
    assert sr_json.contains("\"humid\":48.0")
    let sr_dec = match json.decode[SensorReading](sr_json) {
        Ok(r2) => r2
        Err(_) => { return 5 }
    }
    assert sr_dec.sensor == "lab-1" && sr_dec.temp == 23.5 && sr_dec.humid == 48.0
    assert SensorReading.json_schema().stringify().contains("\"number\"")

    // 8. First-class Closures / Lambdas + Higher-Order `List`/`Option`/`Result` methods
    let add10 = make_adder(10)
    assert add10(32) == 42
    let greet = make_prefixer("hi, ")
    assert greet("tenon") == "hi, tenon"

    let xs = [1, 2, 3, 4, 5]
    let factor = 3
    let scaled = xs.map(|x| x * factor)
    assert scaled.len() == 5 && scaled[0] == 3 && scaled[4] == 15
    let evens = xs.filter(|x| x % 2 == 0)
    assert evens.len() == 2 && evens[0] == 2 && evens[1] == 4
    let sum_xs = xs.fold(0, |acc, x| acc + x)
    assert sum_xs == 15
    assert xs.any(|x| x == 4)
    assert !xs.any(|x| x == 99)
    assert xs.all(|x| x > 0)
    assert !xs.all(|x| x < 5)
    assert xs.find_by(|x| x > 3).unwrap_or(0) == 4

    let tag_prefix = "item:"
    let labels = xs.map(|x| tag_prefix ++ x.to_text())
    assert labels.len() == 5 && labels[2] == "item:3"

    let opt_v Option[Int] = Some(5)
    assert opt_v.map(|x| x * 4).unwrap_or(0) == 20
    assert opt_v.and_then(|x| if x > 0 { Some(x + 1) } else { None }).unwrap_or(0) == 6
    let res_ok Result[Int, Text] = Ok(10)
    assert res_ok.map(|x| x + 5).unwrap_or(0) == 15
    assert res_ok.and_then(|x| Ok(x * 2)).unwrap_or(0) == 20
    let res_err Result[Int, Text] = Err("boom")
    let res_err2 = res_err.map_err(|e| "err:" ++ e)
    let err_txt = match res_err2 {
        Ok(_) => ""
        Err(e) => e
    }
    assert err_txt == "err:boom"

    // 9. `for` loops (`a..b`, `List`, `Map`), `continue`/`break`, standalone Range, Compound Assignments
    var for_sum = 0
    for i in 0..10 {
        if i == 3 {
            continue
        }
        if i == 8 {
            break
        }
        for_sum += i
    }
    // 0+1+2+4+5+6+7 = 25
    assert for_sum == 25

    let rng = 2..6
    var rng_sum = 0
    for i in rng {
        rng_sum += i
    }
    assert rng_sum == 14

    var word_concat = ""
    let wlist = ["a", "b", "c"]
    for w in wlist {
        word_concat = word_concat ++ w
    }
    assert word_concat == "abc"

    var kv_map = Map[Text, Int].new()
    kv_map.set("alpha", 10)
    kv_map.set("beta", 20)
    var kv_sum = 0
    var kv_key_bytes = 0
    for (mk, mv) in kv_map {
        kv_key_bytes += mk.len()
        kv_sum += mv
    }
    assert kv_sum == 30 && kv_key_bytes == 9

    var bits = 3
    bits <<= 3
    assert bits == 24
    bits >>= 1
    assert bits == 12
    bits |= 3
    assert bits == 15
    bits &= 10
    assert bits == 10
    bits ^= 6
    assert bits == 12
    bits *= 5
    assert bits == 60
    bits /= 4
    assert bits == 15

    // 10. `?` Error Propagation (`Result` & `Option`) with RC locals alive before early return
    assert parse_sum_pair("19", "23").unwrap_or(0) == 42
    assert parse_sum_pair("19", "oops").is_err()
    assert lookup_double(kv_map, "beta").unwrap_or(0) == 40
    assert lookup_double(kv_map, "missing").is_none()

    // 11. Tuples, `.0`/`.1`/`.2`, Destructuring `let (a, b) = ...`, `List[(Int, Text)]`
    let tup = (10, "tenon", 2.5)
    assert tup.0 == 10 && tup.1 == "tenon" && tup.2 == 2.5
    let (ta, tb_str, tc) = tup
    assert ta == 10 && tb_str == "tenon" && tc == 2.5
    let (swapped_s, swapped_n) = swap_pair(7, "lucky")
    assert swapped_s == "lucky" && swapped_n == 7
    let pairs List[(Int, Text)] = [(1, "x"), (2, "yy"), (3, "zzz")]
    var pair_acc = 0
    for (pid, plabel) in pairs {
        pair_acc += pid + plabel.len()
    }
    assert pair_acc == 12

    // 12. Generic `enum Tree[T]` + Multi-Payload & Nested Pattern Matching
    let int_tree Tree[Int] = Node(Node(Leaf(1), 2, Leaf(3)), 4, Leaf(5))
    assert tree_sum(int_tree) == 15
    let txt_tree Tree[Text] = Node(Leaf("te"), "n", Node(Leaf("o"), "n", Empty))
    assert tree_join(txt_tree) == "tenon"

    let nested Option[Result[(Int, Text), Text]] = Some(Ok((9, "ok")))
    let nested_score = match nested {
        Some(Ok((n, s))) => n + s.len()
        Some(Err(_)) => -1
        None => -2
    }
    assert nested_score == 11

    // 13. Interpolated f-strings (`f"..."`)
    let uname = "alice"
    let uscore = 99
    let uratio = 0.5
    let formatted = f"user={uname}, score={uscore}, ratio={uratio}, {{esc}}"
    assert formatted == "user=alice, score=99, ratio=0.5, {esc}"

    // 14. `@derive(Eq, Hash)` + `==`/`!=` Operator Protocol + `Set[T]`
    let p1 = Point { x = 3, y = 4, tag = "origin" }
    let p2 = Point { x = 3, y = 4, tag = "origin" }
    let p3 = Point { x = 5, y = 6, tag = "other" }
    assert p1 == p2
    assert p1 != p3

    var pmap = Map[Point, Text].new()
    pmap.set(p1, "first")
    pmap.set(p3, "second")
    assert pmap.get(p2).unwrap_or("") == "first"
    assert pmap.len() == 2

    var iset = Set[Int].new()
    assert iset.insert(10)
    assert !iset.insert(10)
    assert iset.insert(20)
    assert iset.len() == 2 && iset.contains(10) && !iset.contains(99)
    assert iset.remove(10) && !iset.contains(10) && iset.len() == 1
    iset.clear()
    assert iset.is_empty()

    var tset = Set[Text].with_capacity(8)
    assert tset.insert("rust")
    assert tset.insert("tenon")
    assert !tset.insert("tenon")
    assert tset.len() == 2 && tset.contains("tenon")
    assert tset.items().len() == 2

    var pset = Set[Point].new()
    assert pset.insert(p1)
    assert !pset.insert(p2)
    assert pset.insert(p3)
    assert pset.len() == 2 && pset.contains(p2)

    println("PASS: Tenon 4-Layer OOP Standard Library + Complete Expressiveness Suite verified!")
    0
}
