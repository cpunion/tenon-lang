// Pure-Tenon Standard Library Self-Test
// Verifies std/io, std/text, std/json, std/env, std/tools, std/openai in BOTH Cranelift JIT and LLVM 22 AOT!

import "std/io.tn"
import "std/text.tn"
import "std/json.tn"
import "std/env.tn"
import "std/tools.tn"
import "std/openai.tn"

pub fn main() Int {
    // 1. std/text
    assert str_starts_with("data: {\"a\":1}", "data:")
    assert str_ends_with("hello.tn", ".tn")
    assert str_trim("  \t hello world \r\n ") == "hello world"
    assert str_strip_prefix("data: hello", "data: ") == "hello"
    assert str_index_of("abcdef", "cd") == 2
    assert str_index_of("abcdef", "zz") == -1
    assert str_contains("tenon-lang", "lang")
    assert str_replace_first("a b a", "a", "X") == "X b a"
    assert str_replace_all("a'b'c", "'", "'\\''") == "a'\\''b'\\''c"
    assert int_to_text(0) == "0"
    assert int_to_text(2026) == "2026"
    assert int_to_text(-42) == "-42"
    assert text_to_int("  -12345abc") == -12345

    // 2. std/json (depth-aware member lookup + escape/unescape + nested objects + arrays!)
    let sample = "{\"type\":\"response.output_item.done\",\"item\":{\"id\":\"fc_1\",\"type\":\"function_call\",\"call_id\":\"call_99\",\"name\":\"write_file\",\"arguments\":\"{\\\"path\\\":\\\"demo.txt\\\",\\\"content\\\":\\\"line1\\\\nline2 \\\\u4f60\\\\u597d\\\"}\"},\"usage\":{\"input_tokens\":120,\"output_tokens\":35}}"
    assert json_get_string(sample, "type") == "response.output_item.done"
    let item = json_get_object_raw(sample, "item")
    assert json_get_string(item, "type") == "function_call"
    assert json_get_string(item, "call_id") == "call_99"
    assert json_get_string(item, "name") == "write_file"
    let args = json_get_string(item, "arguments")
    assert json_get_string(args, "path") == "demo.txt"
    assert json_get_string(args, "content") == "line1\nline2 你好"
    let usage = json_get_object_raw(sample, "usage")
    assert json_get_int(usage, "input_tokens") == 120
    assert json_get_int(usage, "output_tokens") == 35

    let escaped = json_quote("hi \"tenon\"\nnext")
    assert escaped == "\"hi \\\"tenon\\\"\\nnext\""

    let arr = "[{\"name\":\"a\"},{\"name\":\"b\"}]"
    assert json_array_len(arr) == 2
    assert json_get_string(json_array_get_raw(arr, 1), "name") == "b"

    // 3. std/env (handles comments, export, quotes, AND unquoted `<...>` safely!)
    let dotenv_src = "# comment\nDAST_AUTH_EMAIL_FROM=DastAI <login@auth.dast.ai>\nexport FOO = \"bar_baz\"\nNUM=42\n"
    assert dotenv_lookup(dotenv_src, "FOO") == "bar_baz"
    assert dotenv_lookup(dotenv_src, "NUM") == "42"
    assert dotenv_lookup(dotenv_src, "DAST_AUTH_EMAIL_FROM") == "DastAI <login@auth.dast.ai>"

    // 4. std/tools (workspace path guard + write/read/edit/shell)
    assert is_safe_rel_path("sub/demo.txt")
    assert !is_safe_rel_path("../etc/passwd")
    assert !is_safe_rel_path("/etc/passwd")

    let ws = "/tmp/tenon_stdlib_test_ws"
    let wr = tool_write_file(ws, "hello.txt", "alpha\nbeta\n")
    assert str_starts_with(wr, "ok:")
    let ed = tool_edit_file(ws, "hello.txt", "beta", "tenon_std")
    assert str_starts_with(ed, "ok:")
    let rd = tool_read_file(ws, "hello.txt")
    assert str_contains(rd, "2: tenon_std")
    let sh = tool_shell(ws, "cat hello.txt")
    assert str_contains(sh, "exit_code=0")
    assert str_contains(sh, "tenon_std")
    let _ = sys_exec("rm -rf " ++ shell_quote(ws))

    // 5. std/openai routing helpers
    assert resolve_dast_model("luna") == "gpt-6-luna"
    assert resolve_dast_model("sol") == "gpt-6.1-sol"
    assert resolve_dast_effort("gpt-6-luna") == "low"
    assert resolve_dast_effort("gpt-6-astra") == "high"

    let _ = println("PASS: Pure-Tenon Standard Library (io, text, json, env, tools, openai) verified!")
    0
}
