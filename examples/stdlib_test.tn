// Pure-Tenon Standard Library Self-Test
// Verifies first-class `JsonValue` ADT, `Option[T]`, `Result[T, E]`, refined types,
// `@no_heap_alloc`, `requires`/`ensures`, exhaustive `match`, and Perceus zero-leak RC
// in BOTH Cranelift JIT and LLVM 22 `-O3` AOT!

import "std/io.tn"
import "std/text.tn"
import "std/fs.tn"
import "std/json.tn"
import "std/env.tn"
import "std/tools.tn"
import "std/openai.tn"

pub fn main() Int {
    // 1. std/text — refined types, SliceRange invariant, Option, Result
    let r = SliceRange { start = 0, end = 5 }
    assert str_slice_range("tenon-lang", r) == "tenon"
    assert str_starts_with("data: {\"a\":1}", "data:")
    assert str_ends_with("hello.tn", ".tn")
    assert str_trim("  \t hello world \r\n ") == "hello world"
    let stripped = match str_strip_prefix("data: hello", "data: ") {
        Some(v) => v
        None => ""
    }
    assert stripped == "hello"
    let found_pos = match str_index_of("abcdef", "cd") {
        Some(idx) => idx
        None => -1
    }
    assert found_pos == 2
    let not_found = match str_index_of("abcdef", "zz") {
        Some(_) => false
        None => true
    }
    assert not_found
    assert str_contains("tenon-lang", "lang")
    assert str_replace_first("a b a", "a", "X") == "X b a"
    assert str_replace_all("a'b'c", "'", "'\\''") == "a'\\''b'\\''c"
    assert int_to_text(-42) == "-42"

    let parsed_ok = match text_parse_int("  -12345 ") {
        Ok(n) => n
        Err(_) => 0
    }
    assert parsed_ok == -12345
    let parsed_bad = match text_parse_int("12x") {
        Ok(_) => false
        Err(_) => true
    }
    assert parsed_bad

    // 2. std/json — REAL JsonValue ADT parsing, traversal, error reporting & serialization!
    let sample = "{\"type\":\"response.output_item.done\",\"ok\":true,\"empty\":null,\"nums\":[10,20,30],\"item\":{\"id\":\"fc_1\",\"type\":\"function_call\",\"call_id\":\"call_99\",\"name\":\"write_file\",\"arguments\":\"{\\\"path\\\":\\\"demo.txt\\\",\\\"content\\\":\\\"line1\\\\nline2 \\\\u4f60\\\\u597d\\\"}\"},\"usage\":{\"input_tokens\":120,\"output_tokens\":35}}"
    let ev = match json_parse(sample) {
        Ok(v) => v
        Err(err) => {
            let _ = println("json parse error at " ++ int_to_text(err.pos) ++ ": " ++ err.message)
            return 1
        }
    }
    let ev_type = match json_get_str(ev, "type") {
        Some(s) => s
        None => ""
    }
    assert ev_type == "response.output_item.done"
    let ok_flag = match json_get_bool(ev, "ok") {
        Some(b) => b
        None => false
    }
    assert ok_flag
    let is_null = match json_get(ev, "empty") {
        Some(v) => match v {
            JNull => true
            _ => false
        }
        None => false
    }
    assert is_null
    let num1 = match json_get(ev, "nums") {
        Some(arr) => match json_at(arr, 1) {
            Some(v) => match json_as_int(v) {
                Some(n) => n
                None => -1
            }
            None => -1
        }
        None => -1
    }
    assert num1 == 20

    let parsed_content = match json_get(ev, "item") {
        Some(item) => match json_get_str(item, "arguments") {
            Some(raw_args) => match json_parse(raw_args) {
                Ok(aobj) => match json_get_str(aobj, "content") {
                    Some(c) => c
                    None => ""
                }
                Err(_) => ""
            }
            None => ""
        }
        None => ""
    }
    assert parsed_content == "line1\nline2 你好"

    // Malformed JSON MUST return structured Err(JsonError { pos, message })!
    let bad_json_err_pos = match json_parse("{\"a\": [1, 2, }") {
        Ok(_) => -1
        Err(e) => e.pos
    }
    assert bad_json_err_pos > 0

    // Roundtrip structured JsonValue builder -> json_stringify -> json_parse!
    var built = json_obj_new()
    built = json_obj_set(built, "lang", JStr("tenon"))
    built = json_obj_set(built, "ver", JInt(2))
    built = json_obj_set(built, "verified", JBool(true))
    var tags = json_arr_new()
    tags = json_arr_push(tags, JStr("z3"))
    tags = json_arr_push(tags, JStr("perceus"))
    built = json_obj_set(built, "tags", tags)
    let serialized = json_stringify(built)
    assert serialized == "{\"lang\":\"tenon\",\"ver\":2,\"verified\":true,\"tags\":[\"z3\",\"perceus\"]}"
    let rt_ok = match json_parse(serialized) {
        Ok(rt) => match json_get_int(rt, "ver") {
            Some(v) => v == 2
            None => false
        }
        Err(_) => false
    }
    assert rt_ok

    // 3. std/env — Option[Text] lookup
    let dotenv_src = "# comment\nDAST_AUTH_EMAIL_FROM=DastAI <login@auth.dast.ai>\nexport FOO = \"bar_baz\"\n"
    let foo_val = match dotenv_lookup(dotenv_src, "FOO") {
        Some(v) => v
        None => ""
    }
    assert foo_val == "bar_baz"
    let missing_env = match dotenv_lookup(dotenv_src, "NO_SUCH_KEY") {
        Some(_) => false
        None => true
    }
    assert missing_env

    // 4. std/tools — Result[Text, Text] + workspace path guard
    assert is_safe_rel_path("sub/demo.txt")
    assert !is_safe_rel_path("../etc/passwd")
    assert !is_safe_rel_path("/etc/passwd")

    let ws = "/tmp/tenon_stdlib_v2_test_ws"
    let wr_ok = match tool_write_file(ws, "hello.txt", "alpha\nbeta\n") {
        Ok(_) => true
        Err(_) => false
    }
    assert wr_ok
    let ed_ok = match tool_edit_file(ws, "hello.txt", "beta", "tenon_std_v2") {
        Ok(_) => true
        Err(_) => false
    }
    assert ed_ok
    let rd_ok = match tool_read_file(ws, "hello.txt") {
        Ok(txt) => str_contains(txt, "2: tenon_std_v2")
        Err(_) => false
    }
    assert rd_ok
    let bad_path_rejected = match tool_read_file(ws, "../etc/passwd") {
        Ok(_) => false
        Err(_) => true
    }
    assert bad_path_rejected
    let _ = exec_sh("rm -rf " ++ shell_quote(ws))

    // 5. std/openai structured JsonValue request builder!
    let uitem = openai_user_item("hello")
    var conv List[JsonValue] = []
    conv = push(conv, uitem)
    let req = openai_build_request("gpt-6-luna", "low", "s1", "be concise", conv, json_arr_new())
    let req_model = match json_get_str(req, "model") {
        Some(m) => m
        None => ""
    }
    assert req_model == "gpt-6-luna"

    let _ = println("PASS: Pure-Tenon Standard Library v2 (JsonValue ADT, Option/Result, Contracts & Proofs) verified!")
    0
}
