// Tenon Interactive CLI Agent — Written 100% in Tenon!
//
// Layered architecture:
//   1. Minimal Language Core (`tenon-rt`: Perceus RC/COW/vtable + minimal byte/buffer/OS/HTTP syscalls)
//   2. 4-Layer Pure-Tenon Standard Library (`std/core`, `std/text`, `std/collections`, `std/encoding`, `std/os`)
//   3. Application SDK (`examples/agent/lib/llm.tn` + `examples/agent/lib/tools.tn`)
//      using `dyn LlmProvider`, `List[dyn Tool]`, `@derive(FromJson, JsonSchema)`, and `SafeRelPath`
//   4. Formally verified `AgentLease` (Z3 `mutate`), `@no_heap_alloc`, `lock_lattice`, and
//      `protocol state_machine`, runnable via Cranelift JIT (`live_objects=0`) & LLVM 22 `-O3` AOT!

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"
import "std/encoding/json.tn"
import "std/os/io.tn"
import "std/os/env.tn"
import "examples/agent/lib/llm.tn"
import "examples/agent/lib/tools.tn"

// =========================================================================
// 1. Formally Verified Agent Lease, Lock Lattice & Protocol State Machine
// =========================================================================

pub type BranchId = Int where self >= 1
pub type Epoch    = Int where self >= 0

pub record AgentLease {
    branch_id  BranchId
    epoch      Epoch
    turns_done NonNegative
}

@no_heap_alloc
pub pure fn is_epoch_valid(active Epoch, candidate Epoch) Bool {
    candidate == active
}

pub lock_lattice AgentLocks {
    SessionLease < ToolExec
}

@acquires("SessionLease")
pub fn bump_turn_epoch(inout lease AgentLease) {
    mutate lease {
        lease.epoch += 1
        lease.turns_done += 1
    }
}

@acquires("SessionLease")
pub fn fork_clean_branch(inout lease AgentLease) {
    mutate lease {
        lease.branch_id += 1
        lease.epoch += 1
    }
}

pub protocol state_machine TenonCliAgentFence {
    state {
        branch_id    Int = 1
        exec_epoch   Int = 0
        turns_done   Int = 0
        stale_writes Int = 0
    }

    action StartTurn when exec_epoch < 4 {
        exec_epoch = exec_epoch + 1
        turns_done = turns_done + 1
    }

    action ForkBranch when branch_id < 3 && exec_epoch < 4 {
        branch_id = branch_id + 1
        exec_epoch = exec_epoch + 1
    }

    fault StaleWorkerCommit when exec_epoch >= 1 {
        stale_writes = stale_writes + 1
    }

    laws {
        invariant SingleExecutorFence: stale_writes == 0
        invariant MonotonicBranch: branch_id >= 1 && exec_epoch >= 0
        invariant TurnCountNonNegative: turns_done >= 0
    }
}

// =========================================================================
// 2. Multi-Round Pure-Tenon ReAct Loop (`dyn LlmProvider` + `List[dyn Tool]`)
// =========================================================================

pub pure fn agent_instructions(workspace Text) Text {
    "You are the Tenon CLI Agent — an interactive coding and systems assistant implemented natively in the Tenon programming language. " ++
    "Current workspace: " ++ workspace ++ ". " ++
    "You have real tools: shell, read_file, write_file, edit_file, list_dir, grep_search. " ++
    "Use tools to inspect, create, edit, and verify files/commands instead of guessing. " ++
    "Be concise and direct in your answers."
}

pub fn run_agent_turn(
    inout lease AgentLease,
    provider dyn LlmProvider,
    tools List[dyn Tool],
    workspace Text,
    conv_items List[JsonValue],
    user_prompt Text
) List[JsonValue] {
    bump_turn_epoch(lease)
    let active_epoch = lease.epoch
    assert is_epoch_valid(lease.epoch, active_epoch)

    let session_id = "tenon-cli-b" ++ int_to_text(lease.branch_id)
    let instructions = agent_instructions(workspace)
    let tools_schema = build_tools_schema(tools)

    var items List[JsonValue] = conv_items
    items = push(items, llm_user_item(user_prompt))
    var rounds = 0
    var total_tools = 0
    var total_in = 0
    var total_cached = 0
    var total_out = 0

    while rounds < 12 {
        rounds += 1
        let req = LlmRequest {
            session_id = session_id,
            instructions = instructions,
            input_items = items,
            tools = tools_schema,
            stream = true
        }
        match provider.stream_turn(req) {
            Err(err) => {
                let _ = println("[agent error] " ++ err)
                return items
            }
            Ok(turn) => {
                var oi = 0
                while oi < len(turn.output_items) {
                    items = push(items, turn.output_items[oi])
                    oi += 1
                }
                total_in += turn.usage.input_tokens
                total_cached += turn.usage.cached_tokens
                total_out += turn.usage.output_tokens

                let ncalls = len(turn.tool_calls)
                if ncalls == 0 {
                    break
                }

                var ci = 0
                while ci < ncalls {
                    let call = turn.tool_calls[ci]
                    let tool_out = dispatch_dyn_tool(tools, workspace, call.name, call.arguments)
                    items = push(items, llm_tool_output_item(call.call_id, tool_out))
                    total_tools += 1
                    ci += 1
                }
            }
        }
    }

    let _ = println(
        "[tenon-agent branch=#" ++ int_to_text(lease.branch_id) ++
        " epoch=" ++ int_to_text(lease.epoch) ++
        " model=" ++ provider.model_name() ++
        " rounds=" ++ int_to_text(rounds) ++
        " tools=" ++ int_to_text(total_tools) ++
        " in=" ++ int_to_text(total_in) ++
        " cached=" ++ int_to_text(total_cached) ++
        " out=" ++ int_to_text(total_out) ++ "]"
    )
    items
}

// =========================================================================
// 3. Interactive CLI REPL & Single-Shot Entry Point
// =========================================================================

pub fn print_help() Int {
    let _ = println("Commands:")
    let _ = println("  /model <luna|terra|sol|astra|<id>>  Switch dast-os OpenAI model (hot-swaps dyn LlmProvider)")
    let _ = println("  /state                              Show verified AgentLease & context info")
    let _ = println("  /branch                             Fork clean branch (Z3-proved mutate) & clear context")
    let _ = println("  /clear                              Clear conversation context")
    let _ = println("  /help                               Show this help message")
    let _ = println("  /exit                               Exit Tenon CLI Agent")
    0
}

pub fn main() Int {
    let api_key = match env_or_dotenv("OPENAI_API_KEY") {
        Some(k) => k
        None => {
            let _ = println("error: OPENAI_API_KEY not found in environment or .env")
            return 1
        }
    }
    let base_url = env_or_dotenv("OPENAI_BASE_URL")
    let workspace = env_get("TENON_WORKSPACE").unwrap_or(env_cwd())
    let initial_model = env_get("TENON_MODEL").unwrap_or("")

    var provider dyn LlmProvider = openai_provider_new(api_key, base_url, initial_model)
    let tools List[dyn Tool] = default_agent_tools()
    var lease AgentLease = AgentLease { branch_id = 1, epoch = 0, turns_done = 0 }
    var conv_items List[JsonValue] = []

    // Single-shot mode via TENON_PROMPT="..."
    match env_get("TENON_PROMPT") {
        Some(single_prompt) => {
            let _ = println("Tenon Pure-Language CLI Agent | model=" ++ provider.model_name() ++ " (" ++ provider.effort_name() ++ ") | workspace=" ++ workspace)
            conv_items = run_agent_turn(lease, provider, tools, workspace, conv_items, single_prompt)
            return 0
        }
        None => {}
    }

    // Interactive REPL mode
    let _ = println("======================================================================")
    let _ = println("  Tenon Interactive CLI Agent (100% Pure Tenon + 4-Layer Stdlib + dyn)")
    let _ = println("  Model:     " ++ provider.model_name() ++ " (reasoning=" ++ provider.effort_name() ++ ")")
    let _ = println("  Workspace: " ++ workspace)
    let _ = println("  Tools:     " ++ int_to_text(len(tools)) ++ " registered `dyn Tool` plugins (derived JSON Schema)")
    let _ = println("  Commands:  /model <luna|terra|sol|astra>  /state  /branch  /clear  /help  /exit")
    let _ = println("======================================================================")

    while true {
        let _ = print("\ntenon[" ++ provider.model_name() ++ "]> ")
        let raw_line = match read_line() {
            None => {
                let _ = println("\nBye.")
                break
            }
            Some(l) => l
        }
        let line = raw_line.trim()
        if line.is_empty() {
            continue
        }
        if line == "/exit" || line == "/quit" || line == "exit" || line == "quit" {
            let _ = println("Bye.")
            break
        }
        if line == "/help" {
            let _ = print_help()
            continue
        }
        match line.strip_prefix("/model ") {
            Some(raw_alias) => {
                provider = openai_provider_new(api_key, base_url, raw_alias.trim())
                let _ = println("Switched model -> " ++ provider.model_name() ++ " (reasoning=" ++ provider.effort_name() ++ ")")
                continue
            }
            None => {}
        }
        if line == "/state" {
            let _ = println(
                "lease: branch=#" ++ int_to_text(lease.branch_id) ++
                " epoch=" ++ int_to_text(lease.epoch) ++
                " turns_done=" ++ int_to_text(lease.turns_done) ++
                " model=" ++ provider.model_name() ++
                " effort=" ++ provider.effort_name() ++
                " workspace=" ++ workspace ++
                " tools=" ++ int_to_text(len(tools)) ++
                " context_items=" ++ int_to_text(len(conv_items))
            )
            continue
        }
        if line == "/branch" {
            fork_clean_branch(lease)
            conv_items = []
            let _ = println(
                "Forked clean branch -> branch=#" ++ int_to_text(lease.branch_id) ++
                " epoch=" ++ int_to_text(lease.epoch)
            )
            continue
        }
        if line == "/clear" {
            conv_items = []
            let _ = println("Cleared conversation context.")
            continue
        }

        conv_items = run_agent_turn(lease, provider, tools, workspace, conv_items, line)
    }
    0
}
