// Tenon Interactive CLI Agent — Written 100% in Tenon!
//
// Layered architecture:
//   1. Minimal Language Core (`tenon-rt`: Perceus RC + 19 byte/OS/SSE transport syscalls)
//   2. Idiomatic, Contract-Verified Pure-Tenon Standard Library (`std/io.tn`, `std/text.tn`,
//      `std/fs.tn`, `std/json.tn` with `JsonValue` ADT, `std/env.tn`, `std/tools.tn`, `std/openai.tn`)
//   3. This Interactive CLI Agent (`examples/agent/cli_agent.tn`), formally verified with
//      refined types, Z3 `mutate` proofs, exhaustive `Option`/`Result`/`JsonValue` matching,
//      `@no_heap_alloc`, `lock_lattice`, and `protocol state_machine`, runnable via BOTH
//      Cranelift JIT (`tenon run`) AND LLVM 22 `-O3` AOT standalone native binary (`tenon build`)!

import "std/io.tn"
import "std/text.tn"
import "std/fs.tn"
import "std/json.tn"
import "std/env.tn"
import "std/tools.tn"
import "std/openai.tn"

// =========================================================================
// 1. Formally Verified Agent Lease, Lock Lattice & Protocol State Machine
// =========================================================================

pub type BranchId = Int where self >= 1
pub type Epoch    = Int where self >= 0

pub record AgentLease {
    branch_id  BranchId
    epoch      Epoch
    turns_done Int where self >= 0
}

@no_heap_alloc
pub pure fn is_epoch_valid(active Epoch, candidate Epoch) Bool {
    candidate == active
}

pub lock_lattice AgentLocks {
    SessionLease < ToolExec
}

@acquires("SessionLease")
pub fn bump_turn_epoch(inout lease AgentLease) {
    mutate lease {
        lease.epoch += 1
        lease.turns_done += 1
    }
}

@acquires("SessionLease")
pub fn fork_clean_branch(inout lease AgentLease) {
    mutate lease {
        lease.branch_id += 1
        lease.epoch += 1
    }
}

pub protocol state_machine TenonCliAgentFence {
    state {
        branch_id    Int = 1
        exec_epoch   Int = 0
        turns_done   Int = 0
        stale_writes Int = 0
    }

    action StartTurn when exec_epoch < 4 {
        exec_epoch = exec_epoch + 1
        turns_done = turns_done + 1
    }

    action ForkBranch when branch_id < 3 && exec_epoch < 4 {
        branch_id = branch_id + 1
        exec_epoch = exec_epoch + 1
    }

    fault StaleWorkerCommit when exec_epoch >= 1 {
        stale_writes = stale_writes + 1
    }

    laws {
        invariant SingleExecutorFence: stale_writes == 0
        invariant MonotonicBranch: branch_id >= 1 && exec_epoch >= 0
        invariant TurnCountNonNegative: turns_done >= 0
    }
}

// =========================================================================
// 2. Structured `JsonValue` Tool Schemas & Typed Tool Dispatcher
// =========================================================================

pub pure fn agent_instructions(workspace Text) Text {
    "You are the Tenon CLI Agent — an interactive coding and systems assistant implemented natively in the Tenon programming language. " ++
    "Current workspace: " ++ workspace ++ ". " ++
    "You have real tools: shell, read_file, write_file, edit_file, list_dir, grep_search. " ++
    "Use tools to inspect, create, edit, and verify files/commands instead of guessing. " ++
    "Be concise and direct in your answers."
}

pub pure fn agent_tools_json() JsonValue {
    var tools = json_arr_new()

    var shell_props = json_obj_new()
    shell_props = json_obj_set(shell_props, "command", openai_string_prop("Shell command to run via /bin/sh -c"))
    let shell_req List[Text] = ["command"]
    tools = json_arr_push(tools, openai_function_tool(
        "shell",
        "Execute a shell command in the workspace and return exit_code plus combined stdout/stderr.",
        shell_props,
        shell_req
    ))

    var read_props = json_obj_new()
    read_props = json_obj_set(read_props, "path", openai_string_prop("Relative file path"))
    let read_req List[Text] = ["path"]
    tools = json_arr_push(tools, openai_function_tool(
        "read_file",
        "Read a file relative to the workspace with line numbers.",
        read_props,
        read_req
    ))

    var write_props = json_obj_new()
    write_props = json_obj_set(write_props, "path", openai_string_prop("Relative file path"))
    write_props = json_obj_set(write_props, "content", openai_string_prop("Full file content"))
    let write_req List[Text] = ["path", "content"]
    tools = json_arr_push(tools, openai_function_tool(
        "write_file",
        "Create or overwrite a file relative to the workspace.",
        write_props,
        write_req
    ))

    var edit_props = json_obj_new()
    edit_props = json_obj_set(edit_props, "path", openai_string_prop("Relative file path"))
    edit_props = json_obj_set(edit_props, "target", openai_string_prop("Exact substring to replace"))
    edit_props = json_obj_set(edit_props, "replacement", openai_string_prop("Replacement text"))
    let edit_req List[Text] = ["path", "target", "replacement"]
    tools = json_arr_push(tools, openai_function_tool(
        "edit_file",
        "Replace the first exact occurrence of target text with replacement in a workspace file.",
        edit_props,
        edit_req
    ))

    var list_props = json_obj_new()
    list_props = json_obj_set(list_props, "path", openai_string_prop("Relative directory path (default '.')"))
    let list_req List[Text] = []
    tools = json_arr_push(tools, openai_function_tool(
        "list_dir",
        "List files and subdirectories in the workspace.",
        list_props,
        list_req
    ))

    var grep_props = json_obj_new()
    grep_props = json_obj_set(grep_props, "query", openai_string_prop("Search text"))
    grep_props = json_obj_set(grep_props, "path", openai_string_prop("Optional relative subdirectory"))
    let grep_req List[Text] = ["query"]
    tools = json_arr_push(tools, openai_function_tool(
        "grep_search",
        "Recursively search for text in workspace files.",
        grep_props,
        grep_req
    ))

    tools
}

pub pure fn arg_str(args JsonValue, key Text) Text {
    match json_get_str(args, key) {
        Some(s) => s
        None => ""
    }
}

pub pure fn format_tool_result(res Result[Text, Text]) Text {
    match res {
        Ok(out) => out
        Err(msg) => "error: " ++ msg
    }
}

pub fn dispatch_tool(workspace Text, call ToolCall) Text {
    let name = call.name
    let args = call.arguments
    if name == "shell" {
        let cmd = arg_str(args, "command")
        let _ = println("  [tool:shell] $ " ++ cmd)
        return format_tool_result(tool_shell(workspace, cmd))
    }
    if name == "read_file" {
        let path = arg_str(args, "path")
        let _ = println("  [tool:read_file] " ++ path)
        return format_tool_result(tool_read_file(workspace, path))
    }
    if name == "write_file" {
        let path = arg_str(args, "path")
        let content = arg_str(args, "content")
        let _ = println("  [tool:write_file] " ++ path ++ " (" ++ int_to_text(len(content)) ++ " bytes)")
        return format_tool_result(tool_write_file(workspace, path, content))
    }
    if name == "edit_file" {
        let path = arg_str(args, "path")
        let target = arg_str(args, "target")
        let replacement = arg_str(args, "replacement")
        let _ = println("  [tool:edit_file] " ++ path)
        return format_tool_result(tool_edit_file(workspace, path, target, replacement))
    }
    if name == "list_dir" {
        let path = arg_str(args, "path")
        let _ = println("  [tool:list_dir] " ++ path)
        return format_tool_result(tool_list_dir(workspace, path))
    }
    if name == "grep_search" {
        let query = arg_str(args, "query")
        let path = arg_str(args, "path")
        let _ = println("  [tool:grep_search] " ++ query)
        return format_tool_result(tool_grep(workspace, query, path))
    }
    "error: unknown tool `" ++ name ++ "`"
}

// =========================================================================
// 3. Multi-Round Pure-Tenon ReAct Agent Loop (`List[JsonValue]` history)
// =========================================================================

pub fn run_agent_turn(
    inout lease AgentLease,
    api_key Text,
    model Text,
    effort Text,
    workspace Text,
    conv_items List[JsonValue],
    user_prompt Text
) List[JsonValue] {
    bump_turn_epoch(lease)
    let active_epoch = lease.epoch
    assert is_epoch_valid(lease.epoch, active_epoch)

    let session_id = "tenon-cli-b" ++ int_to_text(lease.branch_id)
    let instructions = agent_instructions(workspace)
    let tools = agent_tools_json()

    var items List[JsonValue] = conv_items
    items = push(items, openai_user_item(user_prompt))
    var rounds = 0
    var total_tools = 0
    var total_in = 0
    var total_cached = 0
    var total_out = 0

    while rounds < 12 {
        rounds += 1
        match openai_stream_turn(
            api_key,
            model,
            effort,
            session_id,
            instructions,
            items,
            tools,
            true
        ) {
            Err(err) => {
                let _ = println("[agent error] " ++ err)
                return items
            }
            Ok(turn) => {
                var oi = 0
                while oi < len(turn.output_items) {
                    items = push(items, turn.output_items[oi])
                    oi += 1
                }
                total_in += turn.usage.input_tokens
                total_cached += turn.usage.cached_tokens
                total_out += turn.usage.output_tokens

                let ncalls = len(turn.tool_calls)
                if ncalls == 0 {
                    break
                }

                var ci = 0
                while ci < ncalls {
                    let call = turn.tool_calls[ci]
                    let tool_out = dispatch_tool(workspace, call)
                    items = push(items, openai_tool_output_item(call.call_id, tool_out))
                    total_tools += 1
                    ci += 1
                }
            }
        }
    }

    let _ = println(
        "[tenon-agent branch=#" ++ int_to_text(lease.branch_id) ++
        " epoch=" ++ int_to_text(lease.epoch) ++
        " model=" ++ model ++
        " rounds=" ++ int_to_text(rounds) ++
        " tools=" ++ int_to_text(total_tools) ++
        " in=" ++ int_to_text(total_in) ++
        " cached=" ++ int_to_text(total_cached) ++
        " out=" ++ int_to_text(total_out) ++ "]"
    )
    items
}

// =========================================================================
// 4. Interactive CLI REPL & Single-Shot Entry Point
// =========================================================================

pub fn print_help() Int {
    let _ = println("Commands:")
    let _ = println("  /model <luna|terra|sol|astra|<id>>  Switch dast-os OpenAI model")
    let _ = println("  /state                              Show verified AgentLease & context info")
    let _ = println("  /branch                             Fork clean branch (Z3-proved mutate) & clear context")
    let _ = println("  /clear                              Clear conversation context")
    let _ = println("  /help                               Show this help message")
    let _ = println("  /exit                               Exit Tenon CLI Agent")
    0
}

pub fn main() Int {
    let api_key = match env_or_dotenv("OPENAI_API_KEY") {
        Some(k) => k
        None => {
            let _ = println("error: OPENAI_API_KEY not found in environment or .env")
            return 1
        }
    }

    let workspace = match env_get("TENON_WORKSPACE") {
        Some(w) => w
        None => sys_cwd()
    }
    let initial_model = match env_get("TENON_MODEL") {
        Some(m) => m
        None => ""
    }
    var model = resolve_dast_model(initial_model)
    var effort = resolve_dast_effort(model)
    var lease AgentLease = AgentLease { branch_id = 1, epoch = 0, turns_done = 0 }
    var conv_items List[JsonValue] = []

    // Single-shot mode via TENON_PROMPT="..."
    match env_get("TENON_PROMPT") {
        Some(single_prompt) => {
            let _ = println("Tenon Pure-Language CLI Agent | model=" ++ model ++ " (" ++ effort ++ ") | workspace=" ++ workspace)
            conv_items = run_agent_turn(lease, api_key, model, effort, workspace, conv_items, single_prompt)
            return 0
        }
        None => {}
    }

    // Interactive REPL mode
    let _ = println("======================================================================")
    let _ = println("  Tenon Interactive CLI Agent (100% Pure Tenon + Typed Stdlib v2)")
    let _ = println("  Model:     " ++ model ++ " (reasoning=" ++ effort ++ ")")
    let _ = println("  Workspace: " ++ workspace)
    let _ = println("  Tools:     shell, read_file, write_file, edit_file, list_dir, grep_search")
    let _ = println("  Commands:  /model <luna|terra|sol|astra>  /state  /branch  /clear  /help  /exit")
    let _ = println("======================================================================")

    while true {
        let _ = print("\ntenon[" ++ model ++ "]> ")
        let raw_line = match read_line() {
            None => {
                let _ = println("\nBye.")
                break
            }
            Some(l) => l
        }
        let line = str_trim(raw_line)
        if len(line) == 0 {
            continue
        }
        if line == "/exit" || line == "/quit" || line == "exit" || line == "quit" {
            let _ = println("Bye.")
            break
        }
        if line == "/help" {
            let _ = print_help()
            continue
        }
        match str_strip_prefix(line, "/model ") {
            Some(raw_alias) => {
                let alias = str_trim(raw_alias)
                model = resolve_dast_model(alias)
                effort = resolve_dast_effort(model)
                let _ = println("Switched model -> " ++ model ++ " (reasoning=" ++ effort ++ ")")
                continue
            }
            None => {}
        }
        if line == "/state" {
            let _ = println(
                "lease: branch=#" ++ int_to_text(lease.branch_id) ++
                " epoch=" ++ int_to_text(lease.epoch) ++
                " turns_done=" ++ int_to_text(lease.turns_done) ++
                " model=" ++ model ++
                " effort=" ++ effort ++
                " workspace=" ++ workspace ++
                " context_items=" ++ int_to_text(len(conv_items))
            )
            continue
        }
        if line == "/branch" {
            fork_clean_branch(lease)
            conv_items = []
            let _ = println(
                "Forked clean branch -> branch=#" ++ int_to_text(lease.branch_id) ++
                " epoch=" ++ int_to_text(lease.epoch)
            )
            continue
        }
        if line == "/clear" {
            conv_items = []
            let _ = println("Cleared conversation context.")
            continue
        }

        conv_items = run_agent_turn(lease, api_key, model, effort, workspace, conv_items, line)
    }
    0
}
