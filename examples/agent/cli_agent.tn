// Tenon Interactive CLI Agent — Written 100% in Tenon!
//
// Layered OOP architecture:
//   1. Minimal Language Core (`tenon-rt`: Perceus RC/COW/vtable + 24 byte/buffer/OS/HTTP syscalls)
//   2. 4-Layer OOP Pure-Tenon Stdlib (`List.push`, `TextBuilder.new`, `Map[K, V].new`, `JsonValue`, `Env`, `OsFs`, `HttpStream`)
//   3. Decoupled Application SDK (`examples/agent/lib/{llm,tools}.tn`): `dyn LlmProvider`, `ToolRegistry` (`List[dyn Tool]`),
//      `@derive(FromJson, JsonSchema)` + `SafeRelPath`
//   4. Formally verified `AgentLease` (Z3 `mutate`), `@no_heap_alloc`, `lock_lattice`, and `protocol state_machine`!

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"
import "std/encoding/json.tn"
import "std/os/io.tn"
import "std/os/env.tn"
import "examples/agent/lib/llm.tn"
import "examples/agent/lib/tools.tn"

// =========================================================================
// 1. Formally Verified Agent Lease, Lock Lattice & Protocol State Machine
// =========================================================================

pub type BranchId = Int where self >= 1
pub type Epoch    = Int where self >= 0

pub record AgentLease {
    branch_id  BranchId
    epoch      Epoch
    turns_done NonNegative
}

@no_heap_alloc
pub pure fn is_epoch_valid(active Epoch, candidate Epoch) Bool {
    candidate == active
}

pub lock_lattice AgentLocks {
    SessionLease < ToolExec
}

impl AgentLease {
    pub pure fn new() AgentLease {
        AgentLease { branch_id = 1, epoch = 0, turns_done = 0 }
    }

    @acquires("SessionLease")
    pub fn bump_turn_epoch(inout self) {
        mutate self {
            self.epoch += 1
            self.turns_done += 1
        }
    }

    @acquires("SessionLease")
    pub fn fork_clean_branch(inout self) {
        mutate self {
            self.branch_id += 1
            self.epoch += 1
        }
    }
}

pub protocol state_machine TenonCliAgentFence {
    state {
        branch_id    Int = 1
        exec_epoch   Int = 0
        turns_done   Int = 0
        stale_writes Int = 0
    }

    action StartTurn when exec_epoch < 4 {
        exec_epoch = exec_epoch + 1
        turns_done = turns_done + 1
    }

    action ForkBranch when branch_id < 3 && exec_epoch < 4 {
        branch_id = branch_id + 1
        exec_epoch = exec_epoch + 1
    }

    fault StaleWorkerCommit when exec_epoch >= 1 {
        stale_writes = stale_writes + 1
    }

    laws {
        invariant SingleExecutorFence: stale_writes == 0
        invariant MonotonicBranch: branch_id >= 1 && exec_epoch >= 0
        invariant TurnCountNonNegative: turns_done >= 0
    }
}

// =========================================================================
// 2. Multi-Round Pure-Tenon ReAct Loop (`dyn LlmProvider` + `ToolRegistry`)
// =========================================================================

pub pure fn agent_instructions(workspace Text) Text {
    "You are the Tenon CLI Agent — an interactive coding and systems assistant implemented natively in the Tenon programming language. " ++
    "Current workspace: " ++ workspace ++ ". " ++
    "You have real tools: shell, read_file, write_file, edit_file, list_dir, grep_search. " ++
    "Use tools to inspect, create, edit, and verify files/commands instead of guessing. " ++
    "Be concise and direct in your answers."
}

pub fn run_agent_turn(
    inout lease AgentLease,
    provider dyn LlmProvider,
    registry ToolRegistry,
    workspace Text,
    inout items List[JsonValue],
    user_prompt Text
) {
    lease.bump_turn_epoch()
    let active_epoch = lease.epoch
    assert is_epoch_valid(lease.epoch, active_epoch)

    let session_id = "tenon-cli-b" ++ lease.branch_id.to_text()
    let instructions = agent_instructions(workspace)
    let tools_schema = registry.schemas()

    items.push(LlmRequest.user_item(user_prompt))
    var rounds = 0
    var total_tools = 0
    var total_in = 0
    var total_cached = 0
    var total_out = 0

    while rounds < 12 {
        rounds += 1
        let req = LlmRequest {
            session_id = session_id,
            instructions = instructions,
            input_items = items,
            tools = tools_schema,
            stream = true
        }
        match provider.stream_turn(req) {
            Err(err) => {
                println("[agent error] " ++ err)
                return
            }
            Ok(turn) => {
                var oi = 0
                while oi < turn.output_items.len() {
                    items.push(turn.output_items[oi])
                    oi += 1
                }
                total_in += turn.usage.input_tokens
                total_cached += turn.usage.cached_tokens
                total_out += turn.usage.output_tokens

                if turn.tool_calls.is_empty() {
                    break
                }

                var ci = 0
                while ci < turn.tool_calls.len() {
                    let call = turn.tool_calls[ci]
                    let tool_out = registry.dispatch(workspace, call.name, call.arguments)
                    items.push(LlmRequest.tool_output_item(call.call_id, tool_out))
                    total_tools += 1
                    ci += 1
                }
            }
        }
    }

    println(
        "[tenon-agent branch=#" ++ lease.branch_id.to_text() ++
        " epoch=" ++ lease.epoch.to_text() ++
        " model=" ++ provider.model_name() ++
        " rounds=" ++ rounds.to_text() ++
        " tools=" ++ total_tools.to_text() ++
        " in=" ++ total_in.to_text() ++
        " cached=" ++ total_cached.to_text() ++
        " out=" ++ total_out.to_text() ++ "]"
    )
}

// =========================================================================
// 3. Interactive CLI REPL & Single-Shot Entry Point
// =========================================================================

pub fn print_help() {
    println("Commands:")
    println("  /model <luna|terra|sol|astra|<id>>  Switch dast-os OpenAI model (hot-swaps dyn LlmProvider)")
    println("  /state                              Show verified AgentLease & context info")
    println("  /branch                             Fork clean branch (Z3-proved mutate) & clear context")
    println("  /clear                              Clear conversation context")
    println("  /help                               Show this help message")
    println("  /exit                               Exit Tenon CLI Agent")
}

pub fn main() Int {
    let api_key = match Env.get_or_dotenv("OPENAI_API_KEY") {
        Some(k) => k
        None => {
            println("error: OPENAI_API_KEY not found in environment or .env")
            return 1
        }
    }
    let base_url = Env.get_or_dotenv("OPENAI_BASE_URL")
    let workspace = Env.get("TENON_WORKSPACE").unwrap_or(Env.cwd())
    let initial_model = Env.get("TENON_MODEL").unwrap_or("")

    var provider dyn LlmProvider = OpenAIProvider.new(api_key, base_url, initial_model)
    let registry = ToolRegistry.default_agent()
    var lease = AgentLease.new()
    var conv_items List[JsonValue] = []

    // Single-shot mode via TENON_PROMPT="..."
    match Env.get("TENON_PROMPT") {
        Some(single_prompt) => {
            println("Tenon Pure-Language CLI Agent | model=" ++ provider.model_name() ++ " (" ++ provider.effort_name() ++ ") | workspace=" ++ workspace)
            run_agent_turn(lease, provider, registry, workspace, conv_items, single_prompt)
            return 0
        }
        None => {}
    }

    // Interactive REPL mode
    println("======================================================================")
    println("  Tenon Interactive CLI Agent (100% Pure Tenon + OOP Stdlib + dyn)")
    println("  Model:     " ++ provider.model_name() ++ " (reasoning=" ++ provider.effort_name() ++ ")")
    println("  Workspace: " ++ workspace)
    println("  Tools:     " ++ registry.len().to_text() ++ " registered `dyn Tool` plugins (derived JSON Schema)")
    println("  Commands:  /model <luna|terra|sol|astra>  /state  /branch  /clear  /help  /exit")
    println("======================================================================")

    while true {
        print("\ntenon[" ++ provider.model_name() ++ "]> ")
        let raw_line = match read_line() {
            None => {
                println("\nBye.")
                break
            }
            Some(l) => l
        }
        let line = raw_line.trim()
        if line.is_empty() {
            continue
        }
        if line == "/exit" || line == "/quit" || line == "exit" || line == "quit" {
            println("Bye.")
            break
        }
        if line == "/help" {
            print_help()
            continue
        }
        match line.strip_prefix("/model ") {
            Some(raw_alias) => {
                provider = OpenAIProvider.new(api_key, base_url, raw_alias.trim())
                println("Switched model -> " ++ provider.model_name() ++ " (reasoning=" ++ provider.effort_name() ++ ")")
                continue
            }
            None => {}
        }
        if line == "/state" {
            println(
                "lease: branch=#" ++ lease.branch_id.to_text() ++
                " epoch=" ++ lease.epoch.to_text() ++
                " turns_done=" ++ lease.turns_done.to_text() ++
                " model=" ++ provider.model_name() ++
                " effort=" ++ provider.effort_name() ++
                " workspace=" ++ workspace ++
                " tools=" ++ registry.len().to_text() ++
                " context_items=" ++ conv_items.len().to_text()
            )
            continue
        }
        if line == "/branch" {
            lease.fork_clean_branch()
            conv_items.clear()
            println(
                "Forked clean branch -> branch=#" ++ lease.branch_id.to_text() ++
                " epoch=" ++ lease.epoch.to_text()
            )
            continue
        }
        if line == "/clear" {
            conv_items.clear()
            println("Cleared conversation context.")
            continue
        }

        run_agent_turn(lease, provider, registry, workspace, conv_items, line)
    }
    0
}
