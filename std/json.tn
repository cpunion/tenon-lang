// Tenon Standard Library: std/json.tn
// First-class algebraic `JsonValue` ADT, recursive-descent parser returning
// `Result[JsonValue, JsonError]`, exhaustive serializer `json_stringify`,
// immutable builders, and typed `Option[T]` accessors — 100% pure Tenon!

import "std/text.tn"

pub record JsonEntry {
    key Text
    val JsonValue
}

pub record JsonError {
    pos     NonNegative
    message Text
}

pub enum JsonValue {
    JNull
    JBool(Bool)
    JInt(Int)
    JStr(Text)
    JArr(List[JsonValue])
    JObj(List[JsonEntry])
}

pub record JsonParsed {
    value JsonValue
    next  NonNegative
}

// =========================================================================
// 1. Constructors & Immutable MVS Builders
// =========================================================================

pub pure fn json_null() JsonValue {
    JNull
}

pub pure fn json_bool(b Bool) JsonValue {
    JBool(b)
}

pub pure fn json_int(n Int) JsonValue {
    JInt(n)
}

pub pure fn json_str(s Text) JsonValue {
    JStr(s)
}

pub pure fn json_arr_new() JsonValue {
    let empty List[JsonValue] = []
    JArr(empty)
}

pub pure fn json_obj_new() JsonValue {
    let empty List[JsonEntry] = []
    JObj(empty)
}

pub pure fn json_arr_push(arr JsonValue, item JsonValue) JsonValue {
    match arr {
        JArr(items) => {
            var next List[JsonValue] = items
            next = push(next, item)
            JArr(next)
        }
        JNull => {
            var next List[JsonValue] = []
            next = push(next, item)
            JArr(next)
        }
        JBool(_) => arr
        JInt(_) => arr
        JStr(_) => arr
        JObj(_) => arr
    }
}

pub pure fn json_obj_set(obj JsonValue, key Text, val JsonValue) JsonValue {
    match obj {
        JObj(entries) => {
            var next List[JsonEntry] = []
            var replaced = false
            var i = 0
            while i < len(entries) {
                let e = entries[i]
                if e.key == key {
                    next = push(next, JsonEntry { key = key, val = val })
                    replaced = true
                } else {
                    next = push(next, e)
                }
                i += 1
            }
            if !replaced {
                next = push(next, JsonEntry { key = key, val = val })
            }
            JObj(next)
        }
        JNull => {
            var next List[JsonEntry] = []
            next = push(next, JsonEntry { key = key, val = val })
            JObj(next)
        }
        JBool(_) => obj
        JInt(_) => obj
        JStr(_) => obj
        JArr(_) => obj
    }
}

// =========================================================================
// 2. Typed Accessors (`Option[T]` with Exhaustive Match)
// =========================================================================

pub pure fn json_get(v JsonValue, key Text) Option[JsonValue] {
    match v {
        JObj(entries) => {
            var i = 0
            while i < len(entries) {
                let e = entries[i]
                if e.key == key {
                    return Some(e.val)
                }
                i += 1
            }
            None
        }
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JStr(_) => None
        JArr(_) => None
    }
}

pub pure fn json_at(v JsonValue, idx NonNegative) Option[JsonValue] {
    match v {
        JArr(items) => {
            if idx >= len(items) {
                return None
            }
            Some(items[idx])
        }
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JStr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_len(v JsonValue) NonNegative {
    match v {
        JArr(items) => len(items)
        JObj(entries) => len(entries)
        JStr(s) => len(s)
        JNull => 0
        JBool(_) => 0
        JInt(_) => 0
    }
}

pub pure fn json_as_str(v JsonValue) Option[Text] {
    match v {
        JStr(s) => Some(s)
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_as_int(v JsonValue) Option[Int] {
    match v {
        JInt(n) => Some(n)
        JNull => None
        JBool(_) => None
        JStr(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_as_bool(v JsonValue) Option[Bool] {
    match v {
        JBool(b) => Some(b)
        JNull => None
        JInt(_) => None
        JStr(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_get_str(v JsonValue, key Text) Option[Text] {
    match json_get(v, key) {
        Some(inner) => json_as_str(inner)
        None => None
    }
}

pub pure fn json_get_int(v JsonValue, key Text) Option[Int] {
    match json_get(v, key) {
        Some(inner) => json_as_int(inner)
        None => None
    }
}

pub pure fn json_get_bool(v JsonValue, key Text) Option[Bool] {
    match json_get(v, key) {
        Some(inner) => json_as_bool(inner)
        None => None
    }
}

// =========================================================================
// 3. String Escaping & Exhaustive `json_stringify(v JsonValue) Text`
// =========================================================================

pub pure fn json_escape(s Text) Text {
    let n = len(s)
    var out = ""
    var run_start = 0
    var i = 0
    while i < n {
        let b = byte_at(s, i)
        if b == 34 || b == 92 || b == 10 || b == 13 || b == 9 || (b >= 0 && b < 32) {
            if i > run_start {
                out = out ++ str_slice(s, run_start, i)
            }
            if b == 34 {
                out = out ++ "\\\""
            } else if b == 92 {
                out = out ++ "\\\\"
            } else if b == 10 {
                out = out ++ "\\n"
            } else if b == 13 {
                out = out ++ "\\r"
            } else if b == 9 {
                out = out ++ "\\t"
            } else {
                let hi = (b / 16) % 16
                let lo = b % 16
                if hi >= 0 && hi <= 15 && lo >= 0 && lo <= 15 {
                    out = out ++ "\\u00" ++ hex_nibble(hi) ++ hex_nibble(lo)
                }
            }
            run_start = i + 1
        }
        i += 1
    }
    if run_start == 0 {
        return s
    }
    if n > run_start {
        out = out ++ str_slice(s, run_start, n)
    }
    out
}

pub pure fn json_quote(s Text) Text {
    "\"" ++ json_escape(s) ++ "\""
}

pub pure fn json_stringify(v JsonValue) Text {
    match v {
        JNull => "null"
        JBool(b) => if b { "true" } else { "false" }
        JInt(n) => int_to_text(n)
        JStr(s) => json_quote(s)
        JArr(items) => {
            var out = "["
            var i = 0
            while i < len(items) {
                if i > 0 {
                    out = out ++ ","
                }
                out = out ++ json_stringify(items[i])
                i += 1
            }
            out ++ "]"
        }
        JObj(entries) => {
            var out = "{"
            var i = 0
            while i < len(entries) {
                if i > 0 {
                    out = out ++ ","
                }
                let e = entries[i]
                out = out ++ json_quote(e.key) ++ ":" ++ json_stringify(e.val)
                i += 1
            }
            out ++ "}"
        }
    }
}

// =========================================================================
// 4. Full Recursive-Descent Parser (`json_parse -> Result[JsonValue, JsonError]`)
// =========================================================================

pub pure fn codepoint_to_utf8(cp NonNegative) Text {
    if cp < 128 {
        return byte_to_text(cp)
    }
    if cp < 2048 {
        let b1 = 192 + (cp / 64)
        let b2 = 128 + (cp % 64)
        return byte_to_text(b1) ++ byte_to_text(b2)
    }
    let b1 = 224 + (cp / 4096)
    let b2 = 128 + ((cp / 64) % 64)
    let b3 = 128 + (cp % 64)
    byte_to_text(b1) ++ byte_to_text(b2) ++ byte_to_text(b3)
}

pub pure fn json_unescape(raw Text) Text {
    let n = len(raw)
    var out = ""
    var run_start = 0
    var i = 0
    while i < n {
        if byte_at(raw, i) == 92 && i + 1 < n {
            if i > run_start {
                out = out ++ str_slice(raw, run_start, i)
            }
            let esc = byte_at(raw, i + 1)
            if esc == 110 {
                out = out ++ "\n"
                i += 2
            } else if esc == 114 {
                out = out ++ "\r"
                i += 2
            } else if esc == 116 {
                out = out ++ "\t"
                i += 2
            } else if esc == 34 {
                out = out ++ "\""
                i += 2
            } else if esc == 92 {
                out = out ++ "\\"
                i += 2
            } else if esc == 47 {
                out = out ++ "/"
                i += 2
            } else if esc == 98 {
                out = out ++ byte_to_text(8)
                i += 2
            } else if esc == 102 {
                out = out ++ byte_to_text(12)
                i += 2
            } else if esc == 117 && i + 5 < n {
                let h0 = parse_hex_digit_raw(byte_at(raw, i + 2))
                let h1 = parse_hex_digit_raw(byte_at(raw, i + 3))
                let h2 = parse_hex_digit_raw(byte_at(raw, i + 4))
                let h3 = parse_hex_digit_raw(byte_at(raw, i + 5))
                if h0 >= 0 && h1 >= 0 && h2 >= 0 && h3 >= 0 {
                    let cp = clamp_non_neg(h0 * 4096 + h1 * 256 + h2 * 16 + h3)
                    out = out ++ codepoint_to_utf8(cp)
                    i += 6
                } else {
                    out = out ++ byte_to_text(esc)
                    i += 2
                }
            } else {
                out = out ++ byte_to_text(esc)
                i += 2
            }
            run_start = i
        } else {
            i += 1
        }
    }
    if run_start == 0 {
        return raw
    }
    if n > run_start {
        out = out ++ str_slice(raw, run_start, n)
    }
    out
}

pub pure fn json_skip_ws(src Text, pos NonNegative) NonNegative {
    let n = len(src)
    var i = pos
    while i < n && is_space_byte(byte_at(src, i)) {
        i += 1
    }
    clamp_non_neg(i)
}

pub pure fn json_parse_string_at(src Text, start NonNegative) Result[JsonParsed, JsonError] {
    let n = len(src)
    if start >= n || byte_at(src, start) != 34 {
        return Err(JsonError { pos = start, message = "expected opening '\"'" })
    }
    var i = start + 1
    while i < n {
        let b = byte_at(src, i)
        if b == 92 {
            if i + 1 >= n {
                return Err(JsonError { pos = clamp_non_neg(i), message = "unterminated escape in JSON string" })
            }
            i += 2
            continue
        }
        if b == 34 {
            let raw = str_slice(src, start + 1, i)
            let decoded = json_unescape(raw)
            return Ok(JsonParsed {
                value = JStr(decoded),
                next = clamp_non_neg(i + 1)
            })
        }
        i += 1
    }
    Err(JsonError { pos = start, message = "unterminated JSON string" })
}

pub pure fn json_parse_number_at(src Text, start NonNegative) Result[JsonParsed, JsonError] {
    let n = len(src)
    var i = start
    var neg = false
    if i < n && byte_at(src, i) == 45 {
        neg = true
        i += 1
    }
    if i >= n || !is_digit_byte(byte_at(src, i)) {
        return Err(JsonError { pos = start, message = "invalid JSON number" })
    }
    var acc = 0
    while i < n && is_digit_byte(byte_at(src, i)) {
        acc = acc * 10 + (byte_at(src, i) - 48)
        i += 1
    }
    // Consume optional fractional / exponent parts (e.g. `1.0`, `1e-5`) cleanly
    if i < n && byte_at(src, i) == 46 {
        i += 1
        while i < n && is_digit_byte(byte_at(src, i)) {
            i += 1
        }
    }
    if i < n && (byte_at(src, i) == 101 || byte_at(src, i) == 69) {
        i += 1
        if i < n && (byte_at(src, i) == 43 || byte_at(src, i) == 45) {
            i += 1
        }
        while i < n && is_digit_byte(byte_at(src, i)) {
            i += 1
        }
    }
    let val = if neg { -acc } else { acc }
    Ok(JsonParsed {
        value = JInt(val),
        next = clamp_non_neg(i)
    })
}

pub pure fn json_parse_array_at(src Text, start NonNegative) Result[JsonParsed, JsonError] {
    let n = len(src)
    if start >= n || byte_at(src, start) != 91 {
        return Err(JsonError { pos = start, message = "expected '['" })
    }
    var i = json_skip_ws(src, clamp_non_neg(start + 1))
    var items List[JsonValue] = []
    if i < n && byte_at(src, i) == 93 {
        return Ok(JsonParsed { value = JArr(items), next = clamp_non_neg(i + 1) })
    }
    while i < n {
        match json_parse_value_at(src, clamp_non_neg(i)) {
            Err(e) => { return Err(e) }
            Ok(parsed) => {
                items = push(items, parsed.value)
                i = json_skip_ws(src, parsed.next)
                if i < n && byte_at(src, i) == 44 {
                    i = json_skip_ws(src, clamp_non_neg(i + 1))
                    continue
                }
                if i < n && byte_at(src, i) == 93 {
                    return Ok(JsonParsed { value = JArr(items), next = clamp_non_neg(i + 1) })
                }
                return Err(JsonError { pos = clamp_non_neg(i), message = "expected ',' or ']' in JSON array" })
            }
        }
    }
    Err(JsonError { pos = start, message = "unterminated JSON array" })
}

pub pure fn json_parse_object_at(src Text, start NonNegative) Result[JsonParsed, JsonError] {
    let n = len(src)
    if start >= n || byte_at(src, start) != 123 {
        return Err(JsonError { pos = start, message = "expected '{'" })
    }
    var i = json_skip_ws(src, clamp_non_neg(start + 1))
    var entries List[JsonEntry] = []
    if i < n && byte_at(src, i) == 125 {
        return Ok(JsonParsed { value = JObj(entries), next = clamp_non_neg(i + 1) })
    }
    while i < n {
        match json_parse_string_at(src, clamp_non_neg(i)) {
            Err(e) => { return Err(e) }
            Ok(key_parsed) => {
                let key_text = match key_parsed.value {
                    JStr(k) => k
                    _ => ""
                }
                i = json_skip_ws(src, key_parsed.next)
                if i >= n || byte_at(src, i) != 58 {
                    return Err(JsonError { pos = clamp_non_neg(i), message = "expected ':' after JSON object key" })
                }
                let val_pos = json_skip_ws(src, clamp_non_neg(i + 1))
                match json_parse_value_at(src, val_pos) {
                    Err(e) => { return Err(e) }
                    Ok(val_parsed) => {
                        entries = push(entries, JsonEntry { key = key_text, val = val_parsed.value })
                        i = json_skip_ws(src, val_parsed.next)
                        if i < n && byte_at(src, i) == 44 {
                            i = json_skip_ws(src, clamp_non_neg(i + 1))
                            continue
                        }
                        if i < n && byte_at(src, i) == 125 {
                            return Ok(JsonParsed { value = JObj(entries), next = clamp_non_neg(i + 1) })
                        }
                        return Err(JsonError { pos = clamp_non_neg(i), message = "expected ',' or '}' in JSON object" })
                    }
                }
            }
        }
    }
    Err(JsonError { pos = start, message = "unterminated JSON object" })
}

pub pure fn json_parse_value_at(src Text, pos NonNegative) Result[JsonParsed, JsonError] {
    let n = len(src)
    let i = json_skip_ws(src, pos)
    if i >= n {
        return Err(JsonError { pos = i, message = "unexpected end of JSON input" })
    }
    let b = byte_at(src, i)
    if b == 34 {
        return json_parse_string_at(src, i)
    }
    if b == 123 {
        return json_parse_object_at(src, i)
    }
    if b == 91 {
        return json_parse_array_at(src, i)
    }
    if b == 45 || is_digit_byte(b) {
        return json_parse_number_at(src, i)
    }
    if i + 4 <= n && str_slice(src, i, i + 4) == "true" {
        return Ok(JsonParsed { value = JBool(true), next = clamp_non_neg(i + 4) })
    }
    if i + 5 <= n && str_slice(src, i, i + 5) == "false" {
        return Ok(JsonParsed { value = JBool(false), next = clamp_non_neg(i + 5) })
    }
    if i + 4 <= n && str_slice(src, i, i + 4) == "null" {
        return Ok(JsonParsed { value = JNull, next = clamp_non_neg(i + 4) })
    }
    Err(JsonError { pos = i, message = "unexpected token in JSON input" })
}

pub pure fn json_parse(src Text) Result[JsonValue, JsonError] {
    match json_parse_value_at(src, 0) {
        Err(e) => Err(e)
        Ok(parsed) => {
            let tail = json_skip_ws(src, parsed.next)
            if tail < len(src) {
                return Err(JsonError { pos = tail, message = "trailing characters after JSON value" })
            }
            Ok(parsed.value)
        }
    }
}
