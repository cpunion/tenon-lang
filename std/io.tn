// Tenon Standard Library: std/io.tn
// Console I/O returning structured `Option[Text]` instead of global EOF side-channels.

pub fn print(s Text) Int {
    sys_write_stdout(s)
}

pub fn println(s Text) Int {
    sys_write_stdout(s ++ "\n")
}

pub fn read_line() Option[Text] {
    let line = sys_read_line()
    if sys_is_eof() {
        return None
    }
    Some(line)
}
