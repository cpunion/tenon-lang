// Tenon Standard Library: std/openai.tn
// 100% pure-Tenon OpenAI Responses API (/v1/responses) streaming SSE client
// built on structured `JsonValue` trees, `List[JsonValue]`, `List[ToolCall]`,
// refined `TokenUsage` (`NonNegative`), and `Result[OpenAITurn, Text]`!

import "std/io.tn"
import "std/text.tn"
import "std/json.tn"
import "std/env.tn"

pub record ToolCall {
    call_id   Text
    name      Text
    arguments JsonValue
}

pub record TokenUsage {
    input_tokens  NonNegative
    cached_tokens NonNegative
    output_tokens NonNegative
}

pub record OpenAITurn {
    output_items List[JsonValue]
    tool_calls   List[ToolCall]
    usage        TokenUsage
}

pub pure fn resolve_dast_model(alias Text) Text {
    let m = str_trim(alias)
    if m == "luna" || m == "" {
        return "gpt-6-luna"
    }
    if m == "terra" {
        return "gpt-6.1-terra"
    }
    if m == "sol" {
        return "gpt-6.1-sol"
    }
    if m == "astra" {
        return "gpt-6-astra"
    }
    m
}

pub pure fn resolve_dast_effort(model Text) Text {
    if model == "gpt-6-luna" {
        return "low"
    }
    if model == "gpt-6-astra" {
        return "high"
    }
    "medium"
}

pub pure fn openai_user_item(text Text) JsonValue {
    var part = json_obj_new()
    part = json_obj_set(part, "type", JStr("input_text"))
    part = json_obj_set(part, "text", JStr(text))
    var content = json_arr_new()
    content = json_arr_push(content, part)
    var msg = json_obj_new()
    msg = json_obj_set(msg, "role", JStr("user"))
    msg = json_obj_set(msg, "content", content)
    msg
}

pub pure fn openai_tool_output_item(call_id Text, tool_output Text) JsonValue {
    var item = json_obj_new()
    item = json_obj_set(item, "type", JStr("function_call_output"))
    item = json_obj_set(item, "call_id", JStr(call_id))
    item = json_obj_set(item, "output", JStr(tool_output))
    item
}

pub pure fn openai_string_prop(description Text) JsonValue {
    var p = json_obj_new()
    p = json_obj_set(p, "type", JStr("string"))
    p = json_obj_set(p, "description", JStr(description))
    p
}

pub pure fn openai_function_tool(name Text, description Text, props JsonValue, required List[Text]) JsonValue {
    var req_arr = json_arr_new()
    var i = 0
    while i < len(required) {
        req_arr = json_arr_push(req_arr, JStr(required[i]))
        i += 1
    }
    var params = json_obj_new()
    params = json_obj_set(params, "type", JStr("object"))
    params = json_obj_set(params, "properties", props)
    params = json_obj_set(params, "required", req_arr)

    var tool = json_obj_new()
    tool = json_obj_set(tool, "type", JStr("function"))
    tool = json_obj_set(tool, "name", JStr(name))
    tool = json_obj_set(tool, "description", JStr(description))
    tool = json_obj_set(tool, "strict", JBool(false))
    tool = json_obj_set(tool, "parameters", params)
    tool
}

pub pure fn openai_build_request(
    model Text,
    effort Text,
    session_id Text,
    instructions Text,
    input_items List[JsonValue],
    tools JsonValue
) JsonValue {
    var reasoning = json_obj_new()
    reasoning = json_obj_set(reasoning, "effort", JStr(effort))
    var include = json_arr_new()
    include = json_arr_push(include, JStr("reasoning.encrypted_content"))

    var req = json_obj_new()
    req = json_obj_set(req, "model", JStr(model))
    req = json_obj_set(req, "instructions", JStr(instructions))
    req = json_obj_set(req, "input", JArr(input_items))
    req = json_obj_set(req, "tools", tools)
    req = json_obj_set(req, "stream", JBool(true))
    req = json_obj_set(req, "store", JBool(false))
    req = json_obj_set(req, "reasoning", reasoning)
    req = json_obj_set(req, "include", include)
    req = json_obj_set(req, "prompt_cache_key", JStr("tenon-agent:" ++ session_id))
    req
}

pub fn openai_stream_turn(
    api_key Text,
    model Text,
    effort Text,
    session_id Text,
    instructions Text,
    input_items List[JsonValue],
    tools JsonValue,
    stream_to_stdout Bool
) Result[OpenAITurn, Text] {
    var endpoint = "https://api.openai.com/v1/responses"
    match env_or_dotenv("OPENAI_BASE_URL") {
        Some(base_url) => {
            if str_ends_with(base_url, "/responses") {
                endpoint = base_url
            } else if str_ends_with(base_url, "/") {
                endpoint = base_url ++ "responses"
            } else {
                endpoint = base_url ++ "/responses"
            }
        }
        None => {}
    }

    let req_val = openai_build_request(model, effort, session_id, instructions, input_items, tools)
    let body = json_stringify(req_val)

    let h = sys_http_sse_open(endpoint, api_key, body)
    var out_items List[JsonValue] = []
    var calls List[ToolCall] = []
    var in_tok = 0
    var cached_tok = 0
    var out_tok = 0
    var err_msg = ""
    var printed_any = false

    while !sys_http_sse_eof(h) {
        let line = sys_http_sse_next_line(h)
        if sys_http_sse_eof(h) {
            break
        }
        let data = match str_strip_prefix(line, "data:") {
            Some(rest) => str_trim(rest)
            None => { continue }
        }
        if len(data) == 0 || data == "[DONE]" {
            continue
        }
        match json_parse(data) {
            Err(_) => { continue }
            Ok(ev) => {
                let ev_type = match json_get_str(ev, "type") {
                    Some(t) => t
                    None => ""
                }
                if ev_type == "response.output_text.delta" {
                    match json_get_str(ev, "delta") {
                        Some(delta) => {
                            if stream_to_stdout && len(delta) > 0 {
                                let _ = print(delta)
                                printed_any = true
                            }
                        }
                        None => {}
                    }
                } else if ev_type == "response.output_item.done" {
                    match json_get(ev, "item") {
                        Some(item) => {
                            let itype = match json_get_str(item, "type") {
                                Some(t) => t
                                None => ""
                            }
                            if itype == "function_call" || itype == "message" || itype == "reasoning" {
                                out_items = push(out_items, item)
                            }
                            if itype == "function_call" {
                                let cid = match json_get_str(item, "call_id") {
                                    Some(s) => s
                                    None => ""
                                }
                                let cname = match json_get_str(item, "name") {
                                    Some(s) => s
                                    None => ""
                                }
                                let parsed_args = match json_get_str(item, "arguments") {
                                    Some(raw_args) => match json_parse(raw_args) {
                                        Ok(v) => v
                                        Err(_) => json_obj_new()
                                    }
                                    None => json_obj_new()
                                }
                                calls = push(calls, ToolCall {
                                    call_id = cid,
                                    name = cname,
                                    arguments = parsed_args
                                })
                            }
                        }
                        None => {}
                    }
                } else if ev_type == "response.completed" {
                    match json_get(ev, "response") {
                        Some(resp) => match json_get(resp, "usage") {
                            Some(usage) => {
                                in_tok = match json_get_int(usage, "input_tokens") {
                                    Some(v) => v
                                    None => 0
                                }
                                out_tok = match json_get_int(usage, "output_tokens") {
                                    Some(v) => v
                                    None => 0
                                }
                                match json_get(usage, "input_tokens_details") {
                                    Some(det) => {
                                        cached_tok = match json_get_int(det, "cached_tokens") {
                                            Some(v) => v
                                            None => 0
                                        }
                                    }
                                    None => {}
                                }
                            }
                            None => {}
                        }
                        None => {}
                    }
                } else if ev_type == "response.failed" {
                    err_msg = match json_get(ev, "response") {
                        Some(resp) => match json_get(resp, "error") {
                            Some(eobj) => match json_get_str(eobj, "message") {
                                Some(m) => m
                                None => "OpenAI response.failed"
                            }
                            None => "OpenAI response.failed"
                        }
                        None => "OpenAI response.failed"
                    }
                } else if ev_type == "error" {
                    err_msg = match json_get_str(ev, "message") {
                        Some(m) => m
                        None => match json_get(ev, "error") {
                            Some(eobj) => match json_get_str(eobj, "message") {
                                Some(m2) => m2
                                None => "OpenAI error event"
                            }
                            None => "OpenAI error event"
                        }
                    }
                }
            }
        }
    }

    let net_err = sys_http_sse_error(h)
    let _ = sys_http_sse_close(h)
    if printed_any && stream_to_stdout {
        let _ = println("")
    }
    if len(err_msg) > 0 {
        return Err(err_msg)
    }
    if len(net_err) > 0 {
        return Err(net_err)
    }

    Ok(OpenAITurn {
        output_items = out_items,
        tool_calls = calls,
        usage = TokenUsage {
            input_tokens = clamp_non_neg(in_tok),
            cached_tokens = clamp_non_neg(cached_tok),
            output_tokens = clamp_non_neg(out_tok)
        }
    })
}
