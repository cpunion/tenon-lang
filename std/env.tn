// Tenon Standard Library: std/env.tn
// Environment & `.env` lookup returning structured `Option[Text]`.

import "std/text.tn"
import "std/fs.tn"

pub pure fn dotenv_lookup(content Text, key Text) Option[Text] {
    let n = len(content)
    var pos = 0
    while pos < n {
        let p_ok = clamp_non_neg(pos)
        let nl = match str_index_of_from(content, "\n", p_ok) {
            Some(idx) => idx
            None => n
        }
        let line = str_trim(str_slice(content, p_ok, nl))
        pos = nl + 1
        if len(line) == 0 || byte_at(line, 0) == 35 {
            continue
        }
        let clean = match str_strip_prefix(line, "export ") {
            Some(rest) => str_trim(rest)
            None => line
        }
        match str_index_of(clean, "=") {
            None => { continue }
            Some(eq) => {
                if eq == 0 {
                    continue
                }
                let k = str_trim(str_slice(clean, 0, eq))
                if k == key {
                    var v = str_trim(str_slice(clean, eq + 1, len(clean)))
                    let vlen = len(v)
                    if vlen >= 2 {
                        let first = byte_at(v, 0)
                        let last = byte_at(v, vlen - 1)
                        if (first == 34 && last == 34) || (first == 39 && last == 39) {
                            v = str_slice(v, 1, vlen - 1)
                        }
                    }
                    return Some(v)
                }
            }
        }
    }
    None
}

pub fn lookup_dotenv_file(path Text, key Text) Option[Text] {
    match fs_read(path) {
        Err(_) => None
        Ok(content) => dotenv_lookup(content, key)
    }
}

pub fn env_get(key Text) Option[Text] {
    let v = sys_env(key)
    if len(v) == 0 {
        return None
    }
    Some(v)
}

pub fn env_or_dotenv(key Text) Option[Text] {
    match env_get(key) {
        Some(v) => { return Some(v) }
        None => {}
    }
    match env_get("TENON_ENV_FILE") {
        Some(custom) => match lookup_dotenv_file(custom, key) {
            Some(v0) => { return Some(v0) }
            None => {}
        }
        None => {}
    }
    match lookup_dotenv_file(".env", key) {
        Some(v1) => { return Some(v1) }
        None => {}
    }
    match lookup_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.env", key) {
        Some(v2) => { return Some(v2) }
        None => {}
    }
    lookup_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.data/secrets/local.env", key)
}
