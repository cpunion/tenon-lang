// Tenon Standard Library: std/env.tn
// Pure-Tenon environment & `.env` file parser (handles unquoted values safely!).

import "std/text.tn"

pub fn dotenv_lookup(content Text, key Text) Text {
    let n = len(content)
    var pos = 0
    while pos < n {
        var nl = str_index_of_from(content, "\n", pos)
        if nl < 0 {
            nl = n
        }
        let line = str_trim(str_slice(content, pos, nl))
        pos = nl + 1
        if len(line) == 0 || byte_at(line, 0) == 35 {
            continue
        }
        let clean = str_trim(str_strip_prefix(line, "export "))
        let eq = str_index_of(clean, "=")
        if eq <= 0 {
            continue
        }
        let k = str_trim(str_slice(clean, 0, eq))
        if k == key {
            var v = str_trim(str_slice(clean, eq + 1, len(clean)))
            let vlen = len(v)
            if vlen >= 2 {
                let first = byte_at(v, 0)
                let last = byte_at(v, vlen - 1)
                if (first == 34 && last == 34) || (first == 39 && last == 39) {
                    v = str_slice(v, 1, vlen - 1)
                }
            }
            return v
        }
    }
    ""
}

pub fn lookup_dotenv_file(path Text, key Text) Text {
    let content = sys_read_file(path)
    if !sys_file_ok() {
        return ""
    }
    dotenv_lookup(content, key)
}

pub fn env_or_dotenv(key Text) Text {
    let direct = sys_env(key)
    if len(direct) > 0 {
        return direct
    }
    let custom = sys_env("TENON_ENV_FILE")
    if len(custom) > 0 {
        let v0 = lookup_dotenv_file(custom, key)
        if len(v0) > 0 {
            return v0
        }
    }
    let v1 = lookup_dotenv_file(".env", key)
    if len(v1) > 0 {
        return v1
    }
    let v2 = lookup_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.env", key)
    if len(v2) > 0 {
        return v2
    }
    lookup_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.data/secrets/local.env", key)
}
