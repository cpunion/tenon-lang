// Tenon Standard Library — Layer 0: std/core/ops.tn
// Foundational interfaces (`Display`, `Hash`, `Writer`) and O(1) OOP container methods (`List[T]`, `Option[T]`, `Result[T, E]`).

import "std/core/types.tn"

pub interface Display {
    pure fn display(self) Text
}

pub interface Eq {
    pure fn eq(self, other Self) Bool
}

pub interface Hash {
    pure fn hash(self) NonNegative
}

impl Eq for Int {
    pub pure fn eq(self, other Int) Bool {
        self == other
    }
}

impl Eq for Bool {
    pub pure fn eq(self, other Bool) Bool {
        self == other
    }
}

impl Eq for Text {
    pub pure fn eq(self, other Text) Bool {
        self == other
    }
}

impl Eq for Float {
    pub pure fn eq(self, other Float) Bool {
        self == other
    }
}

impl Hash for Float {
    pub pure fn hash(self) NonNegative {
        var h = float_bits(self)
        h = (h ^ (h >> 30)) * 490278349
        h = (h ^ (h >> 27)) * 16777619
        h = h ^ (h >> 31)
        h & 9223372036854775807
    }
}

impl Display for Float {
    pub pure fn display(self) Text {
        float_to_text(self)
    }
}

impl Float {
    pub pure fn to_int(self) Int {
        float_to_int(self)
    }

    pub pure fn to_text(self) Text {
        float_to_text(self)
    }

    pub pure fn abs(self) Float {
        if self < 0.0 { -self } else { self }
    }

    pub pure fn is_nan(self) Bool {
        float_is_nan(self)
    }

    pub pure fn parse(s Text) Result[Float, Text] {
        let v = parse_float(s)
        if float_is_nan(v) {
            return Err("invalid float")
        }
        Ok(v)
    }
}

pub interface Writer {
    fn write_str(inout self, s Text) Int
        ensures result >= 0
    fn write_byte(inout self, b ByteVal) Int
        ensures result >= 0
    fn write_line(inout self, s Text) Int {
        let a = self.write_str(s)
        let b = self.write_byte(10)
        a + b
    }
}

impl[T] List[T] {
    pub pure fn filled(count NonNegative, init T) List[T] {
        list_filled(count, init)
    }

    pub pure fn len(self) NonNegative {
        len(self)
    }

    pub pure fn is_empty(self) Bool {
        len(self) == 0
    }

    pub pure fn get(self, idx NonNegative) Option[T] {
        if idx >= len(self) {
            return None
        }
        Some(self[idx])
    }

    pub pure fn set(inout self, idx NonNegative, item T) Bool {
        if idx >= len(self) {
            return false
        }
        self[idx] = item
        true
    }

    pub pure fn first(self) Option[T] {
        if len(self) == 0 {
            return None
        }
        Some(self[0])
    }

    pub pure fn last(self) Option[T] {
        let n = len(self)
        if n == 0 {
            return None
        }
        Some(self[n - 1])
    }

    pub pure fn push(inout self, item T) {
        self = push(self, item)
    }

    pub pure fn pop(inout self) Option[T] {
        let n = len(self)
        if n == 0 {
            return None
        }
        let item = self[n - 1]
        self = list_pop_shrink(self)
        Some(item)
    }

    pub pure fn clear(inout self) {
        let empty List[T] = []
        self = empty
    }

    pub pure fn map[U](self, f fn(T) U) List[U] {
        var out List[U] = []
        for x in self {
            out.push(f(x))
        }
        out
    }

    pub pure fn filter(self, pred fn(T) Bool) List[T] {
        var out List[T] = []
        for x in self {
            if pred(x) {
                out.push(x)
            }
        }
        out
    }

    pub pure fn fold[U](self, init U, f fn(U, T) U) U {
        var acc = init
        for x in self {
            acc = f(acc, x)
        }
        acc
    }

    pub pure fn any(self, pred fn(T) Bool) Bool {
        for x in self {
            if pred(x) {
                return true
            }
        }
        false
    }

    pub pure fn all(self, pred fn(T) Bool) Bool {
        for x in self {
            if !pred(x) {
                return false
            }
        }
        true
    }

    pub pure fn find_by(self, pred fn(T) Bool) Option[T] {
        for x in self {
            if pred(x) {
                return Some(x)
            }
        }
        None
    }

    pub fn each(self, f fn(T)) {
        for x in self {
            f(x)
        }
    }
}

impl[T] Option[T] {
    pub pure fn is_some(self) Bool {
        match self {
            Some(_) => true
            None => false
        }
    }

    pub pure fn is_none(self) Bool {
        match self {
            Some(_) => false
            None => true
        }
    }

    pub pure fn unwrap_or(self, fallback T) T {
        match self {
            Some(v) => v
            None => fallback
        }
    }

    pub pure fn map[U](self, f fn(T) U) Option[U] {
        match self {
            Some(v) => Some(f(v))
            None => None
        }
    }

    pub pure fn and_then[U](self, f fn(T) Option[U]) Option[U] {
        match self {
            Some(v) => f(v)
            None => None
        }
    }
}

impl[T, E] Result[T, E] {
    pub pure fn is_ok(self) Bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }

    pub pure fn is_err(self) Bool {
        match self {
            Ok(_) => false
            Err(_) => true
        }
    }

    pub pure fn unwrap_or(self, fallback T) T {
        match self {
            Ok(v) => v
            Err(_) => fallback
        }
    }

    pub pure fn map[U](self, f fn(T) U) Result[U, E] {
        match self {
            Ok(v) => Ok(f(v))
            Err(e) => Err(e)
        }
    }

    pub pure fn map_err[E2](self, f fn(E) E2) Result[T, E2] {
        match self {
            Ok(v) => Ok(v)
            Err(e) => Err(f(e))
        }
    }

    pub pure fn and_then[U](self, f fn(T) Result[U, E]) Result[U, E] {
        match self {
            Ok(v) => f(v)
            Err(e) => Err(e)
        }
    }
}
