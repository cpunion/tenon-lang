// Tenon Standard Library — Layer 0: std/core/ops.tn
// Foundational interfaces (`Display`, `Hash`, `Writer`) and O(1) OOP container methods (`List[T]`, `Option[T]`, `Result[T, E]`).

import "std/core/types.tn"

pub interface Display {
    pure fn display(self) Text
}

pub interface Hash {
    pure fn hash(self) NonNegative
}

pub interface Writer {
    fn write_str(inout self, s Text) Int
        ensures result >= 0
    fn write_byte(inout self, b ByteVal) Int
        ensures result >= 0
    fn write_line(inout self, s Text) Int {
        let a = self.write_str(s)
        let b = self.write_byte(10)
        a + b
    }
}

impl[T] List[T] {
    pub pure fn filled(count NonNegative, init T) List[T] {
        list_filled(count, init)
    }

    pub pure fn len(self) NonNegative {
        len(self)
    }

    pub pure fn is_empty(self) Bool {
        len(self) == 0
    }

    pub pure fn get(self, idx NonNegative) Option[T] {
        if idx >= len(self) {
            return None
        }
        Some(self[idx])
    }

    pub pure fn set(inout self, idx NonNegative, item T) Bool {
        if idx >= len(self) {
            return false
        }
        self[idx] = item
        true
    }

    pub pure fn first(self) Option[T] {
        if len(self) == 0 {
            return None
        }
        Some(self[0])
    }

    pub pure fn last(self) Option[T] {
        let n = len(self)
        if n == 0 {
            return None
        }
        Some(self[n - 1])
    }

    pub pure fn push(inout self, item T) {
        self = push(self, item)
    }

    pub pure fn pop(inout self) Option[T] {
        let n = len(self)
        if n == 0 {
            return None
        }
        let item = self[n - 1]
        self = list_pop_shrink(self)
        Some(item)
    }

    pub pure fn clear(inout self) {
        let empty List[T] = []
        self = empty
    }
}

impl[T] Option[T] {
    pub pure fn is_some(self) Bool {
        match self {
            Some(_) => true
            None => false
        }
    }

    pub pure fn is_none(self) Bool {
        match self {
            Some(_) => false
            None => true
        }
    }

    pub pure fn unwrap_or(self, fallback T) T {
        match self {
            Some(v) => v
            None => fallback
        }
    }
}

impl[T, E] Result[T, E] {
    pub pure fn is_ok(self) Bool {
        match self {
            Ok(_) => true
            Err(_) => false
        }
    }

    pub pure fn is_err(self) Bool {
        match self {
            Ok(_) => false
            Err(_) => true
        }
    }

    pub pure fn unwrap_or(self, fallback T) T {
        match self {
            Ok(v) => v
            Err(_) => fallback
        }
    }
}
