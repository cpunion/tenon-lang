// Tenon Standard Library — Layer 1: std/text/builder.tn
// O(n) buffered `TextBuilder` with clean OOP methods & `Writer` impl (static `[W Writer]` + `dyn Writer`).

import "std/core/types.tn"
import "std/core/ops.tn"

pub record TextBuilder {
    handle Int
}

impl TextBuilder {
    pub pure fn new() TextBuilder {
        TextBuilder { handle = buf_new() }
    }

    pub pure fn push(self, s Text) {
        let _ = buf_push_str(self.handle, s)
    }

    pub pure fn push_byte(self, b ByteVal) {
        let _ = buf_push_byte(self.handle, b)
    }

    pub pure fn push_line(self, s Text) {
        let _ = buf_push_str(self.handle, s)
        let _ = buf_push_byte(self.handle, 10)
    }

    pub pure fn push_str(self, s Text) NonNegative {
        clamp_non_neg(buf_push_str(self.handle, s))
    }

    pub pure fn finish(self) Text {
        buf_finish(self.handle)
    }
}

impl Writer for TextBuilder {
    fn write_str(inout self, s Text) Int {
        clamp_non_neg(buf_push_str(self.handle, s))
    }

    fn write_byte(inout self, b ByteVal) Int {
        clamp_non_neg(buf_push_byte(self.handle, b))
    }
}
