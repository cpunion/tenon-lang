// std/ui/tui.tn — Pure Tenon Double-Buffered 2D Cell Grid & ANSI Diff Renderer for Unified VDOM
//
// Renders ANY `VNode` (built directly or evaluated from OpenUI Lang) onto a fixed-dimension
// 2D cell grid (`cells[y * width + x]`) and emits minimal ANSI cursor + SGR diff escapes
// comparing `prev` vs `next` buffers (zero flicker, zero heap leaks).

import "std/core/types.tn"
import "std/text/text.tn"
import "std/text/builder.tn"
import "std/ui/vdom.tn"

pub record TuiCell {
    ch   Int   // ASCII / Unicode codepoint (32 = space)
    fg   Int   // ANSI foreground color (30-37, 90-97, or 0 for default)
    bg   Int   // ANSI background color (40-47, or 0 for default)
    bold Bool
}

pub record TuiBuffer {
    width  Int where self > 0
    height Int where self > 0
    cells  List[TuiCell]
}

pub pure fn tui_blank_cell() TuiCell {
    TuiCell { ch = 32, fg = 0, bg = 0, bold = false }
}

pub pure fn tui_buffer_new(w Int where 1 <= self && self <= 512, h Int where 1 <= self && self <= 256) TuiBuffer
    ensures len(result.cells) == w * h
{
    let total = w * h
    let cells = list_filled(total, tui_blank_cell())
    TuiBuffer { width = w, height = h, cells = cells }
}

pub pure fn tui_set_cell(inout buf TuiBuffer, x Int, y Int, ch Int, fg Int, bg Int, bold Bool) {
    if x < 0 || y < 0 || x >= buf.width || y >= buf.height {
        return
    }
    let idx = y * buf.width + x
    if idx >= 0 && idx < len(buf.cells) {
        buf.cells[idx] = TuiCell { ch = ch, fg = fg, bg = bg, bold = bold }
    }
}

pub pure fn tui_draw_text(inout buf TuiBuffer, x Int, y Int, s Text, fg Int, bold Bool, max_w Int) {
    if y < 0 || y >= buf.height || max_w <= 0 {
        return
    }
    let n = len(s)
    var i = 0
    while i < n && i < max_w {
        let px = x + i
        if px >= 0 && px < buf.width {
            let b = byte_at(s, i) & 255
            let ch = if b >= 32 && b < 127 { b } else { 32 }
            tui_set_cell(buf, px, y, ch, fg, 0, bold)
        }
        i += 1
    }
}

pub pure fn tui_draw_box(inout buf TuiBuffer, x Int, y Int, w Int, h Int, title Text, fg Int) {
    if w < 2 || h < 2 {
        return
    }
    let x2 = x + w - 1
    let y2 = y + h - 1
    // Corners (`+`) and horizontal borders (`-`)
    tui_set_cell(buf, x, y, 43, fg, 0, false)
    tui_set_cell(buf, x2, y, 43, fg, 0, false)
    tui_set_cell(buf, x, y2, 43, fg, 0, false)
    tui_set_cell(buf, x2, y2, 43, fg, 0, false)
    var cx = x + 1
    while cx < x2 {
        tui_set_cell(buf, cx, y, 45, fg, 0, false)
        tui_set_cell(buf, cx, y2, 45, fg, 0, false)
        cx += 1
    }
    // Vertical borders (`|`)
    var cy = y + 1
    while cy < y2 {
        tui_set_cell(buf, x, cy, 124, fg, 0, false)
        tui_set_cell(buf, x2, cy, 124, fg, 0, false)
        cy += 1
    }
    if len(title) > 0 && w > 4 {
        tui_draw_text(buf, x + 2, y, " " ++ title ++ " ", fg, true, w - 4)
    }
}

pure fn tui_cell_eq(a TuiCell, b TuiCell) Bool {
    a.ch == b.ch && a.fg == b.fg && a.bg == b.bg && a.bold == b.bold
}

/// Computes minimal ANSI escape sequence diff transforming `prev` buffer into `next` buffer.
/// Emits cursor moves (`ESC[row;colH`) and SGR style codes ONLY for changed cells!
pub pure fn tui_diff_ansi(prev TuiBuffer, next TuiBuffer) Text {
    var tb = TextBuilder.new()
    let w = next.width
    let h = next.height
    let same_dims = prev.width == w && prev.height == h && len(prev.cells) == len(next.cells)
    var cur_fg = -1
    var cur_bold = false
    var last_x = -2
    var last_y = -2

    var y = 0
    while y < h {
        var x = 0
        while x < w {
            let idx = y * w + x
            if idx >= 0 && idx < len(next.cells) {
                let nc = next.cells[idx]
                let changed = if same_dims {
                    !tui_cell_eq(prev.cells[idx], nc)
                } else {
                    true
                }
                if changed {
                    if y != last_y || x != last_x + 1 {
                        tb.push_byte(27) // ESC
                        tb.push_byte(91) // '['
                        tb.push_str(int_to_text(y + 1))
                        tb.push_byte(59) // ';'
                        tb.push_str(int_to_text(x + 1))
                        tb.push_byte(72) // 'H'
                    }
                    if nc.fg != cur_fg || nc.bold != cur_bold {
                        tb.push_byte(27)
                        tb.push_str("[0")
                        if nc.bold {
                            tb.push_str(";1")
                        }
                        if nc.fg > 0 {
                            tb.push_byte(59)
                            tb.push_str(int_to_text(nc.fg))
                        }
                        tb.push_byte(109) // 'm'
                        cur_fg = nc.fg
                        cur_bold = nc.bold
                    }
                    tb.push_byte(nc.ch & 255)
                    last_x = x
                    last_y = y
                }
            }
            x += 1
        }
        y += 1
    }
    if cur_fg != -1 {
        tb.push_byte(27)
        tb.push_str("[0m")
    }
    tb.finish()
}

/// Renders a `TuiBuffer` into plain multi-line ASCII text (ideal for snapshot testing & logs).
pub pure fn tui_buffer_to_plain_text(buf TuiBuffer) Text {
    var tb = TextBuilder.new()
    var y = 0
    while y < buf.height {
        var x = 0
        while x < buf.width {
            let idx = y * buf.width + x
            if idx >= 0 && idx < len(buf.cells) {
                tb.push_byte(buf.cells[idx].ch & 255)
            }
            x += 1
        }
        tb.push_byte(10)
        y += 1
    }
    tb.finish()
}

// =========================================================================
// Unified VDOM -> TUI Terminal Layout & Renderer
// =========================================================================

pure fn split_csv_simple(s Text) List[Text] {
    var out List[Text] = []
    let n = len(s)
    if n == 0 {
        return out
    }
    var start = 0
    var i = 0
    while i <= n {
        if i == n || (byte_at(s, i) & 255) == 44 {
            out = push(out, str_slice(s, start, i))
            start = i + 1
        }
        i += 1
    }
    out
}

pure fn parse_positive_int_prefix(s Text) Int {
    var val = 0
    var i = 0
    while i < len(s) {
        let b = byte_at(s, i) & 255
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48)
        } else if b == 46 {
            return val
        }
        i += 1
    }
    val
}

pure fn render_vnode_tui_rec(inout buf TuiBuffer, node VNode, x Int, y Int, w Int, h Int, depth Int) Int {
    if depth <= 0 || w <= 0 || h <= 0 || y >= buf.height {
        return 0
    }
    match node {
        VText(t) => {
            tui_draw_text(buf, x, y, t, 37, false, w)
            1
        }
        VEl(el) => {
            let ui_kind = vnode_prop_or(el, "data-ui", el.tag)
            if ui_kind == "Card" {
                tui_draw_box(buf, x, y, w, h, el.key, 36)
                var cy = y + 1
                var ci = 0
                while ci < len(el.children) && cy < y + h - 1 {
                    let rem_h = (y + h - 1) - cy
                    let used = render_vnode_tui_rec(buf, el.children[ci], x + 2, cy, w - 4, rem_h, depth - 1)
                    cy += if used > 0 { used } else { 1 }
                    ci += 1
                }
                h
            } else if ui_kind == "Header" {
                let title = vnode_prop_or(el, "title", "")
                let sub = vnode_prop_or(el, "subtitle", "")
                tui_draw_text(buf, x, y, title, 96, true, w)
                if len(sub) > 0 && h >= 2 {
                    tui_draw_text(buf, x, y + 1, sub, 90, false, w)
                    2
                } else {
                    1
                }
            } else if ui_kind == "Row" {
                let n = len(el.children)
                if n == 0 {
                    return 0
                }
                let col_w = if w / n > 0 { w / n } else { 1 }
                var max_h = 1
                var ci = 0
                while ci < n {
                    let used = render_vnode_tui_rec(buf, el.children[ci], x + ci * col_w, y, col_w - 1, h, depth - 1)
                    if used > max_h { max_h = used }
                    ci += 1
                }
                max_h
            } else if ui_kind == "Metric" {
                let label = vnode_prop_or(el, "label", "")
                let value = vnode_prop_or(el, "value", "")
                let delta = vnode_prop_or(el, "delta", "")
                if h >= 3 && w >= 12 {
                    tui_draw_box(buf, x, y, w, 3, label, 33)
                    tui_draw_text(buf, x + 2, y + 1, value ++ " (" ++ delta ++ ")", 92, true, w - 4)
                    3
                } else {
                    tui_draw_text(buf, x, y, label ++ ": " ++ value ++ " " ++ delta, 92, true, w)
                    1
                }
            } else if ui_kind == "BarChart" {
                let labels = split_csv_simple(vnode_prop_or(el, "labels", ""))
                let vals = split_csv_simple(vnode_prop_or(el, "values", ""))
                var max_v = 1
                var vi = 0
                while vi < len(vals) {
                    let pv = parse_positive_int_prefix(vals[vi])
                    if pv > max_v { max_v = pv }
                    vi += 1
                }
                let bar_max = if w > 18 { w - 18 } else { 4 }
                var rows = 0
                var bi = 0
                while bi < len(labels) && bi < len(vals) && rows < h {
                    let pv = parse_positive_int_prefix(vals[bi])
                    let blen = if max_v > 0 { (pv * bar_max) / max_v } else { 0 }
                    var bar = TextBuilder.new()
                    var k = 0
                    while k < blen {
                        bar.push_byte(35) // '#'
                        k += 1
                    }
                    let line = labels[bi] ++ " |" ++ bar.finish() ++ " " ++ vals[bi]
                    tui_draw_text(buf, x, y + rows, line, 94, false, w)
                    rows += 1
                    bi += 1
                }
                rows
            } else if ui_kind == "Button" {
                var lbl = "Button"
                if len(el.children) >= 1 {
                    match el.children[0] {
                        VText(t) => { lbl = t }
                        VEl(_) => {}
                    }
                }
                tui_draw_text(buf, x, y, "[ " ++ lbl ++ " ]", 93, true, w)
                1
            } else {
                var cy = y
                var ci = 0
                while ci < len(el.children) && cy < y + h {
                    let used = render_vnode_tui_rec(buf, el.children[ci], x, cy, w, (y + h) - cy, depth - 1)
                    cy += if used > 0 { used } else { 1 }
                    ci += 1
                }
                cy - y
            }
        }
    }
}

/// Renders a unified `VNode` tree into a `TuiBuffer` of size `w x h`.
pub pure fn render_vdom_to_tui(node VNode, w Int where 1 <= self && self <= 512, h Int where 1 <= self && self <= 256) TuiBuffer {
    var buf = tui_buffer_new(w, h)
    let _ = render_vnode_tui_rec(buf, node, 0, 0, w, h, 32)
    buf
}
