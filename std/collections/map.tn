// Tenon Standard Library — Layer 1: std/collections/map.tn
// High-performance generic O(1) amortized Compact Open-Addressing Hash Map `Map[K Hash + Eq, V]`:
//   - Monomorphized per concrete `(K, V)` pair with exact Perceus `rc_mask` (zero boxing, zero dispatch overhead)
//   - Power-of-2 bucket index table (`& mask`, zero modulo), max 70% load factor
//   - Dense SoA storage (`keys: List[K]`, `vals: List[V]`, `hashes: List[Int]`) with O(1) swap-remove
//   - Zero entry copying on `rehash`, O(1) COW `keys()` / `values()`, O(1) in-place `set` / `remove` via Perceus `rc == 1`
//   - Z3-verified `NonNegative` `count` / `used` invariants!

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"

pub record Map[K Hash + Eq, V] {
    /// Open-addressing power-of-2 hash index table: -1 = empty, -2 = tombstone, >= 0 = dense slot index
    buckets List[Int]
    /// Dense SoA key storage (always `keys.len() == count`)
    keys    List[K]
    /// Dense SoA value storage parallel to `keys`
    vals    List[V]
    /// Cached 63-bit hashes parallel to `keys` / `vals`
    hashes  List[Int]
    /// Number of live key/value pairs
    count   NonNegative
    /// Number of occupied buckets (live + tombstones)
    used    NonNegative
}

@no_heap_alloc
pub pure fn map_next_pow2_cap(min_cap NonNegative) Positive
    ensures result >= 8
{
    var cap = 8
    while cap < min_cap {
        cap = cap * 2
    }
    if cap < 8 {
        return 8
    }
    cap
}

impl[K Hash + Eq, V] Map[K, V] {
    pub pure fn new() Map[K, V] {
        let empty_buckets List[Int] = []
        let empty_keys List[K] = []
        let empty_vals List[V] = []
        let empty_hashes List[Int] = []
        Map {
            buckets = empty_buckets,
            keys = empty_keys,
            vals = empty_vals,
            hashes = empty_hashes,
            count = 0,
            used = 0
        }
    }

    /// Pre-allocates enough power-of-2 buckets for `expected_items` at <= 70% load factor (zero rehashes).
    pub pure fn with_capacity(expected_items NonNegative) Map[K, V] {
        let needed = clamp_non_neg((expected_items * 10) / 7 + 1)
        let cap = map_next_pow2_cap(needed)
        let empty_keys List[K] = []
        let empty_vals List[V] = []
        let empty_hashes List[Int] = []
        Map {
            buckets = List.filled(cap, -1),
            keys = empty_keys,
            vals = empty_vals,
            hashes = empty_hashes,
            count = 0,
            used = 0
        }
    }

    pub pure fn len(self) NonNegative {
        self.count
    }

    pub pure fn is_empty(self) Bool {
        self.count == 0
    }

    pub pure fn capacity(self) NonNegative {
        self.buckets.len()
    }

    pub pure fn get(self, key K) Option[V] {
        let cap = self.buckets.len()
        if self.count == 0 || cap == 0 {
            return None
        }
        let mask = cap - 1
        let h = key.hash()
        var slot = h & mask
        var probes = 0
        while probes < cap {
            let idx = self.buckets[slot]
            if idx == -1 {
                return None
            }
            if idx >= 0 && self.hashes[idx] == h && self.keys[idx] == key {
                return Some(self.vals[idx])
            }
            slot = (slot + 1) & mask
            probes += 1
        }
        None
    }

    pub pure fn has(self, key K) Bool {
        self.get(key).is_some()
    }

    pub pure fn rehash(inout self, target_cap NonNegative) {
        let cap = map_next_pow2_cap(target_cap)
        let mask = cap - 1
        var new_buckets = List.filled(cap, -1)
        let total = self.hashes.len()
        var i = 0
        while i < total {
            var slot = self.hashes[i] & mask
            while new_buckets[slot] != -1 {
                slot = (slot + 1) & mask
            }
            new_buckets[slot] = i
            i += 1
        }
        let live_ok = clamp_non_neg(total)
        mutate self {
            self.buckets = new_buckets
            self.count = live_ok
            self.used = live_ok
        }
    }

    pub pure fn set(inout self, key K, val V) {
        let cur_cap = self.buckets.len()
        if cur_cap == 0 {
            self.rehash(8)
        } else if (self.used + 1) * 10 >= cur_cap * 7 {
            if (self.count + 1) * 2 >= cur_cap {
                self.rehash(clamp_non_neg(cur_cap * 2))
            } else {
                self.rehash(cur_cap)
            }
        }
        let cap = self.buckets.len()
        let mask = cap - 1
        let h = key.hash()
        var slot = h & mask
        var first_tombstone = -1
        var probes = 0
        while probes < cap {
            let idx = self.buckets[slot]
            if idx == -1 {
                let target = if first_tombstone >= 0 { first_tombstone } else { slot }
                let new_idx = self.keys.len()
                self.keys.push(key)
                self.vals.push(val)
                self.hashes.push(h)
                self.buckets[target] = new_idx
                if first_tombstone >= 0 {
                    mutate self {
                        self.count += 1
                    }
                } else {
                    mutate self {
                        self.count += 1
                        self.used += 1
                    }
                }
                return
            }
            if idx == -2 {
                if first_tombstone < 0 {
                    first_tombstone = slot
                }
            } else if self.hashes[idx] == h && self.keys[idx] == key {
                self.vals[idx] = val
                return
            }
            slot = (slot + 1) & mask
            probes += 1
        }
    }

    pub pure fn with(self, key K, val V) Map[K, V] {
        var next = self
        next.set(key, val)
        next
    }

    /// O(1) swap-remove: moves the last dense entry into the freed slot, updates its bucket, and pops the tail.
    pub pure fn remove(inout self, key K) Option[V] {
        let cap = self.buckets.len()
        if self.count == 0 || cap == 0 {
            return None
        }
        let mask = cap - 1
        let h = key.hash()
        var slot = h & mask
        var probes = 0
        while probes < cap {
            let idx = self.buckets[slot]
            if idx == -1 {
                return None
            }
            if idx >= 0 && self.hashes[idx] == h && self.keys[idx] == key {
                let old_val = self.vals[idx]
                let last_idx = self.keys.len() - 1
                self.buckets[slot] = -2
                if idx != last_idx {
                    let last_h = self.hashes[last_idx]
                    self.keys[idx] = self.keys[last_idx]
                    self.vals[idx] = self.vals[last_idx]
                    self.hashes[idx] = last_h
                    var b = last_h & mask
                    var bp = 0
                    while bp < cap {
                        if self.buckets[b] == last_idx {
                            self.buckets[b] = idx
                            break
                        }
                        b = (b + 1) & mask
                        bp += 1
                    }
                }
                let _ = self.keys.pop()
                let _ = self.vals.pop()
                let _ = self.hashes.pop()
                if self.count > 0 {
                    mutate self {
                        self.count -= 1
                    }
                }
                return Some(old_val)
            }
            slot = (slot + 1) & mask
            probes += 1
        }
        None
    }

    pub pure fn keys(self) List[K] {
        self.keys
    }

    pub pure fn values(self) List[V] {
        self.vals
    }

    pub pure fn clear(inout self) {
        let empty_buckets List[Int] = []
        let empty_keys List[K] = []
        let empty_vals List[V] = []
        let empty_hashes List[Int] = []
        mutate self {
            self.buckets = empty_buckets
            self.keys = empty_keys
            self.vals = empty_vals
            self.hashes = empty_hashes
            self.count = 0
            self.used = 0
        }
    }
}
