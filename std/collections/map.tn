// Tenon Standard Library — Layer 1: std/collections/map.tn
// Value-semantic `TextMap` (MVS + Perceus COW) with OOP mutating (`set`/`clear`) & fluent (`with`) methods.

import "std/core/types.tn"
import "std/core/ops.tn"

pub record TextMapEntry {
    key Text
    val Text
}

pub record TextMap {
    entries List[TextMapEntry]
}

impl TextMap {
    pub pure fn new() TextMap {
        let empty List[TextMapEntry] = []
        TextMap { entries = empty }
    }

    pub pure fn len(self) NonNegative {
        self.entries.len()
    }

    pub pure fn is_empty(self) Bool {
        self.entries.is_empty()
    }

    pub pure fn get(self, key Text) Option[Text] {
        var i = 0
        while i < self.entries.len() {
            let e = self.entries[i]
            if e.key == key {
                return Some(e.val)
            }
            i += 1
        }
        None
    }

    pub pure fn has(self, key Text) Bool {
        self.get(key).is_some()
    }

    pub pure fn with(self, key Text, val Text) TextMap {
        var next List[TextMapEntry] = []
        var replaced = false
        var i = 0
        while i < self.entries.len() {
            let e = self.entries[i]
            if e.key == key {
                next.push(TextMapEntry { key = key, val = val })
                replaced = true
            } else {
                next.push(e)
            }
            i += 1
        }
        if !replaced {
            next.push(TextMapEntry { key = key, val = val })
        }
        TextMap { entries = next }
    }

    pub pure fn set(inout self, key Text, val Text) {
        self = self.with(key, val)
    }

    pub pure fn clear(inout self) {
        self.entries.clear()
    }
}
