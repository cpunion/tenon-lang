// Tenon Standard Library — Layer 1: std/collections/map.tn
// Value-semantic `TextMap` (MVS + Perceus COW) with fluent `impl TextMap` methods.

import "std/core/types.tn"

pub record TextMapEntry {
    key Text
    val Text
}

pub record TextMap {
    entries List[TextMapEntry]
}

pub pure fn text_map_new() TextMap {
    let empty List[TextMapEntry] = []
    TextMap { entries = empty }
}

impl TextMap {
    pub pure fn size(self) NonNegative {
        len(self.entries)
    }

    pub pure fn get(self, key Text) Option[Text] {
        var i = 0
        while i < len(self.entries) {
            let e = self.entries[i]
            if e.key == key {
                return Some(e.val)
            }
            i += 1
        }
        None
    }

    pub pure fn has(self, key Text) Bool {
        match self.get(key) {
            Some(_) => true
            None => false
        }
    }

    pub pure fn set(self, key Text, val Text) TextMap {
        var next List[TextMapEntry] = []
        var replaced = false
        var i = 0
        while i < len(self.entries) {
            let e = self.entries[i]
            if e.key == key {
                next = push(next, TextMapEntry { key = key, val = val })
                replaced = true
            } else {
                next = push(next, e)
            }
            i += 1
        }
        if !replaced {
            next = push(next, TextMapEntry { key = key, val = val })
        }
        TextMap { entries = next }
    }
}
