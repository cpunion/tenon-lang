// Tenon Standard Library: std/tools.tn
// Workspace-guarded file & shell tools returning structured `Result[Text, Text]`
// with refined bounds (`MaxBytes >= 64`) and pure path guards!

import "std/text.tn"
import "std/fs.tn"

pub type MaxBytes = Int where self >= 64

pub pure fn is_safe_rel_path(path Text) Bool {
    if len(path) == 0 {
        return false
    }
    if str_starts_with(path, "/") {
        return false
    }
    if str_contains(path, "..") {
        return false
    }
    true
}

pub pure fn resolve_ws_path(workspace Text, path Text) Text {
    if len(path) == 0 || path == "." {
        return workspace
    }
    workspace ++ "/" ++ path
}

pub pure fn shell_quote(s Text) Text {
    "'" ++ str_replace_all(s, "'", "'\\''") ++ "'"
}

pub pure fn truncate_output(s Text, max_bytes MaxBytes) Text {
    if len(s) <= max_bytes {
        return s
    }
    str_slice_checked(s, 0, max_bytes) ++ "\n... (truncated, total " ++ int_to_text(len(s)) ++ " bytes)"
}

pub fn tool_read_file(workspace Text, path Text) Result[Text, Text] {
    if !is_safe_rel_path(path) {
        return Err("path `" ++ path ++ "` escapes workspace or is empty")
    }
    let full = resolve_ws_path(workspace, path)
    match fs_read(full) {
        Err(reason) => Err("cannot read `" ++ path ++ "`: " ++ reason)
        Ok(raw) => {
            let n = len(raw)
            if n == 0 {
                return Ok("(empty file)")
            }
            var out = ""
            var pos = 0
            var line_no = 1
            while pos < n {
                let p_ok = clamp_non_neg(pos)
                let nl = match str_index_of_from(raw, "\n", p_ok) {
                    Some(idx) => idx
                    None => n
                }
                let line = str_slice(raw, p_ok, nl)
                out = out ++ int_to_text(line_no) ++ ": " ++ line ++ "\n"
                pos = nl + 1
                line_no += 1
                if len(out) > 16000 {
                    out = out ++ "... (truncated at line " ++ int_to_text(line_no) ++ ")\n"
                    break
                }
            }
            Ok(out)
        }
    }
}

pub fn tool_write_file(workspace Text, path Text, content Text) Result[Text, Text] {
    if !is_safe_rel_path(path) {
        return Err("path `" ++ path ++ "` escapes workspace or is empty")
    }
    let full = resolve_ws_path(workspace, path)
    match fs_write(full, content) {
        Ok(bytes) => Ok("wrote " ++ int_to_text(bytes) ++ " bytes to " ++ path)
        Err(reason) => Err(reason)
    }
}

pub fn tool_edit_file(workspace Text, path Text, target Text, replacement Text) Result[Text, Text] {
    if !is_safe_rel_path(path) {
        return Err("path `" ++ path ++ "` escapes workspace or is empty")
    }
    if len(target) == 0 {
        return Err("target must be non-empty")
    }
    let full = resolve_ws_path(workspace, path)
    match fs_read(full) {
        Err(reason) => Err("cannot read `" ++ path ++ "`: " ++ reason)
        Ok(raw) => {
            if !str_contains(raw, target) {
                return Err("target snippet not found in " ++ path)
            }
            let updated = str_replace_first(raw, target, replacement)
            match fs_write(full, updated) {
                Ok(bytes) => Ok("edited " ++ path ++ " (" ++ int_to_text(bytes) ++ " bytes)")
                Err(reason) => Err(reason)
            }
        }
    }
}

pub fn tool_list_dir(workspace Text, path Text) Result[Text, Text] {
    if len(path) > 0 && path != "." && !is_safe_rel_path(path) {
        return Err("path `" ++ path ++ "` escapes workspace")
    }
    let full = resolve_ws_path(workspace, path)
    let cmd = "cd " ++ shell_quote(full) ++ " && find . -maxdepth 3 -not -path '*/.git*' -not -path '*/target*' -not -path '*/node_modules*' | sort | head -n 200"
    let res = exec_sh(cmd)
    if res.exit_code != 0 {
        return Err("exit " ++ int_to_text(res.exit_code) ++ ": " ++ res.output)
    }
    if len(str_trim(res.output)) == 0 {
        return Ok("(empty directory)")
    }
    Ok(truncate_output(res.output, 12000))
}

pub fn tool_grep(workspace Text, query Text, path Text) Result[Text, Text] {
    if len(query) == 0 {
        return Err("empty grep query")
    }
    if len(path) > 0 && path != "." && !is_safe_rel_path(path) {
        return Err("path `" ++ path ++ "` escapes workspace")
    }
    let full = resolve_ws_path(workspace, path)
    let cmd = "cd " ++ shell_quote(full) ++ " && grep -rn --exclude-dir=.git --exclude-dir=target --exclude-dir=node_modules -- " ++ shell_quote(query) ++ " . | head -n 80"
    let res = exec_sh(cmd)
    if len(str_trim(res.output)) == 0 {
        return Ok("(no matches)")
    }
    Ok(truncate_output(res.output, 12000))
}

pub fn tool_shell(workspace Text, command Text) Result[Text, Text] {
    if len(str_trim(command)) == 0 {
        return Err("empty command")
    }
    let cmd = "cd " ++ shell_quote(workspace) ++ " && " ++ command
    let res = exec_sh(cmd)
    Ok("exit_code=" ++ int_to_text(res.exit_code) ++ "\n" ++ truncate_output(res.output, 14000))
}
