// std/nn/gpu/transformer_cuda.tn — Ultra-Fused Multi-Architecture Quantized LLM Engine on NVIDIA CUDA!
//
// Mirrors `transformer_ultra.tn` (Apple Metal) 1-for-1 on NVIDIA GPUs (RTX 4090 / 5090 / L40S / A100 / H100 / B200):
//   - Dynamic-SMEM Fused `RMSNorm + GEMV` & Fused `RMSNorm + Gate+Up+SwiGLU/GeGLU` (5 kernels/layer!)
//   - Race-Free Single-Pass `RoPE + KV Cache Append + FlashDecoding GQA Attention`
//   - Native **CUDA Graphs** (`decode_steps_graphed`) -> ONE `cuGraphLaunch` per token with ZERO host launch jitter!
//   - Zero-leak `@linear CudaBuffer` & `@linear CudaGraph` VRAM management + exact FP32 parity!

import "std/core/types.tn"
import "std/gpu/cuda/cuda.tn"
import "std/gpu/cuda/cuda_ultra.tn"

pub const CU_ARCH_LLAMA3 Int = 0
pub const CU_ARCH_QWEN2  Int = 1
pub const CU_ARCH_GEMMA2 Int = 2

pub record CudaLlmConfig {
    arch          Int
    quant_mode    Int
    vocab_size    Int
    d_model       Int
    n_layers      Int
    n_heads       Int
    n_kv_heads    Int
    d_head        Int
    d_ff          Int
    max_seq_len   Int
    has_qkv_bias  Bool
    is_geglu      Bool
    gemma_norm    Bool
    attn_softcap  Float
}

pub fn cuda_llama3_cfg(vocab Int, d Int, layers Int, nh Int where self > 0, nkv Int where self > 0, dff Int, max_seq Int, qm Int) CudaLlmConfig {
    CudaLlmConfig {
        arch = CU_ARCH_LLAMA3, quant_mode = qm,
        vocab_size = vocab, d_model = d, n_layers = layers,
        n_heads = nh, n_kv_heads = nkv, d_head = d / nh,
        d_ff = dff, max_seq_len = max_seq,
        has_qkv_bias = false, is_geglu = false, gemma_norm = false, attn_softcap = 0.0,
    }
}

pub fn cuda_qwen2_cfg(vocab Int, d Int, layers Int, nh Int where self > 0, nkv Int where self > 0, dff Int, max_seq Int, qm Int) CudaLlmConfig {
    CudaLlmConfig {
        arch = CU_ARCH_QWEN2, quant_mode = qm,
        vocab_size = vocab, d_model = d, n_layers = layers,
        n_heads = nh, n_kv_heads = nkv, d_head = d / nh,
        d_ff = dff, max_seq_len = max_seq,
        has_qkv_bias = true, is_geglu = false, gemma_norm = false, attn_softcap = 0.0,
    }
}

pub fn cuda_gemma2_cfg(vocab Int, d Int, layers Int, nh Int where self > 0, nkv Int where self > 0, dff Int, max_seq Int, qm Int) CudaLlmConfig {
    CudaLlmConfig {
        arch = CU_ARCH_GEMMA2, quant_mode = qm,
        vocab_size = vocab, d_model = d, n_layers = layers,
        n_heads = nh, n_kv_heads = nkv, d_head = d / nh,
        d_ff = dff, max_seq_len = max_seq,
        has_qkv_bias = false, is_geglu = true, gemma_norm = true, attn_softcap = 50.0,
    }
}

pub fn cuda_synth_f16(n Int, seed Int, scale Float) List[Float16] {
    var out List[Float16] = list_filled(n, 0.0 as Float16)
    var s = seed
    var i = 0
    while i < n {
        s = (s * 1103515245 + 12345) % 2147483647
        let u Float = int_to_float((s % 2001) - 1000) / 1000.0
        out[i] = (u * scale) as Float16
        i += 1
    }
    out
}

pub fn cuda_synth_ones_f16(n Int, val Float) List[Float16] {
    list_filled(n, val as Float16)
}

@linear
pub record CudaTransformer {
    cfg        CudaLlmConfig
    tok_emb_b  CudaBuffer
    norm1_b    CudaBuffer
    wqkv_b     CudaBuffer
    bqkv_b     CudaBuffer
    wo_b       CudaBuffer
    norm2_b    CudaBuffer
    wgate_b    CudaBuffer
    wup_b      CudaBuffer
    wdown_b    CudaBuffer
    fnorm_b    CudaBuffer
    lmhead_b   CudaBuffer
    // Persistent activations + KV cache + GPU-resident [tok_id, pos] buffer
    tok_pos_b  CudaBuffer
    x_b        CudaBuffer
    x_norm_b   CudaBuffer
    qkv_b      CudaBuffer
    k_cache_b  CudaBuffer
    v_cache_b  CudaBuffer
    ctx_b      CudaBuffer
    ffn_act_b  CudaBuffer
    logits_b   CudaBuffer
}

impl CudaTransformer {
    pub fn from_f16_weights(
        cfg CudaLlmConfig,
        tok_emb List[Float16],
        norm1 List[Float16],
        wqkv List[Float16],
        bqkv List[Float16],
        wo List[Float16],
        norm2 List[Float16],
        wgate List[Float16],
        wup List[Float16],
        wdown List[Float16],
        fnorm List[Float16],
        lmhead List[Float16],
    ) CudaTransformer {
        let d = cfg.d_model
        let kv_dim = cfg.n_kv_heads * cfg.d_head
        let qkv_dim = d + kv_dim * 2
        let ms = cfg.max_seq_len
        let qm = cfg.quant_mode
        CudaTransformer {
            cfg = cfg,
            tok_emb_b = CudaBuffer.from_f16_list(tok_emb),
            norm1_b = CudaBuffer.from_f16_list(norm1),
            wqkv_b = cuda_upload_quantized_f16(wqkv, qm),
            bqkv_b = CudaBuffer.from_f16_list(bqkv),
            wo_b = cuda_upload_quantized_f16(wo, qm),
            norm2_b = CudaBuffer.from_f16_list(norm2),
            wgate_b = cuda_upload_quantized_f16(wgate, qm),
            wup_b = cuda_upload_quantized_f16(wup, qm),
            wdown_b = cuda_upload_quantized_f16(wdown, qm),
            fnorm_b = CudaBuffer.from_f16_list(fnorm),
            lmhead_b = cuda_upload_quantized_f16(lmhead, qm),
            tok_pos_b = CudaBuffer.uninit(16),
            x_b = CudaBuffer.uninit(ms * d * 2),
            x_norm_b = CudaBuffer.uninit(ms * d * 2),
            qkv_b = CudaBuffer.uninit(ms * qkv_dim * 2),
            k_cache_b = CudaBuffer.uninit(cfg.n_layers * kv_dim * ms * 2),
            v_cache_b = CudaBuffer.uninit(cfg.n_layers * kv_dim * ms * 2),
            ctx_b = CudaBuffer.uninit(ms * d * 2),
            ffn_act_b = CudaBuffer.uninit(ms * cfg.d_ff * 2),
            logits_b = CudaBuffer.uninit(cfg.vocab_size * 2),
        }
    }

    /// Fast uninitialized weight allocation for large-scale 1.1B+ CUDA memory roofline & end-to-end latency benchmarks.
    pub fn synthetic_vram(cfg CudaLlmConfig) CudaTransformer {
        let d = cfg.d_model
        let kv_dim = cfg.n_kv_heads * cfg.d_head
        let qkv_dim = d + kv_dim * 2
        let ms = cfg.max_seq_len
        let qm = cfg.quant_mode
        let nl = cfg.n_layers
        let qkv_bytes = nl * cuda_weight_stride_bytes(qkv_dim * d, qm)
        let wo_bytes = nl * cuda_weight_stride_bytes(d * d, qm)
        let ff_bytes = nl * cuda_weight_stride_bytes(cfg.d_ff * d, qm)
        let lm_bytes = cuda_weight_stride_bytes(cfg.vocab_size * d, qm)
        CudaTransformer {
            cfg = cfg,
            tok_emb_b = CudaBuffer.uninit(cfg.vocab_size * d * 2),
            norm1_b = CudaBuffer.from_f16_list(cuda_synth_ones_f16(nl * d, 1.0)),
            wqkv_b = CudaBuffer.uninit(qkv_bytes),
            bqkv_b = CudaBuffer.uninit(nl * qkv_dim * 2),
            wo_b = CudaBuffer.uninit(wo_bytes),
            norm2_b = CudaBuffer.from_f16_list(cuda_synth_ones_f16(nl * d, 1.0)),
            wgate_b = CudaBuffer.uninit(ff_bytes),
            wup_b = CudaBuffer.uninit(ff_bytes),
            wdown_b = CudaBuffer.uninit(ff_bytes),
            fnorm_b = CudaBuffer.from_f16_list(cuda_synth_ones_f16(d, 1.0)),
            lmhead_b = CudaBuffer.uninit(lm_bytes),
            tok_pos_b = CudaBuffer.uninit(16),
            x_b = CudaBuffer.uninit(ms * d * 2),
            x_norm_b = CudaBuffer.uninit(ms * d * 2),
            qkv_b = CudaBuffer.uninit(ms * qkv_dim * 2),
            k_cache_b = CudaBuffer.uninit(nl * kv_dim * ms * 2),
            v_cache_b = CudaBuffer.uninit(nl * kv_dim * ms * 2),
            ctx_b = CudaBuffer.uninit(ms * d * 2),
            ffn_act_b = CudaBuffer.uninit(ms * cfg.d_ff * 2),
            logits_b = CudaBuffer.uninit(cfg.vocab_size * 2),
        }
    }

    pub fn weight_bytes(inout self) Int {
        let c = self.cfg
        let d = c.d_model
        let kv_dim = c.n_kv_heads * c.d_head
        let qkv_dim = d + kv_dim * 2
        let qm = c.quant_mode
        let nl = c.n_layers
        let qkv_b = nl * cuda_weight_stride_bytes(qkv_dim * d, qm)
        let wo_b = nl * cuda_weight_stride_bytes(d * d, qm)
        let ff_b = nl * cuda_weight_stride_bytes(c.d_ff * d, qm) * 3
        let lm_b = cuda_weight_stride_bytes(c.vocab_size * d, qm)
        let norm_b = (nl * 2 + 1) * d * 2
        qkv_b + wo_b + ff_b + lm_b + norm_b
    }

    /// Enqueues ONE complete ultra-fused Transformer decode step (5 kernels/layer + embed + fnorm + lmhead + argmax).
    /// Safe to execute either directly on the CUDA stream OR inside a `cuda_graph_begin()..cuda_graph_end()` capture!
    pub fn enqueue_decode_step(inout self, inc_pos Bool) Int {
        let c = self.cfg
        let d = c.d_model
        let kv_dim = c.n_kv_heads * c.d_head
        let qkv_dim = d + kv_dim * 2
        let ms = c.max_seq_len
        let qm = c.quant_mode
        let qkv_stride = cuda_weight_stride_bytes(qkv_dim * d, qm)
        let wo_stride = cuda_weight_stride_bytes(d * d, qm)
        let ff_stride = cuda_weight_stride_bytes(c.d_ff * d, qm)
        let kv_layer_bytes = kv_dim * ms * 2

        let _ = cuda_embed_ss(self.tok_pos_b.handle, self.tok_emb_b.handle, 0, self.x_b.handle, d, c.vocab_size)

        var l = 0
        while l < c.n_layers {
            let norm_off = l * d * 2
            let kv_off = l * kv_layer_bytes
            let _ = cuda_epinorm_gemv(
                self.x_b.handle, self.norm1_b.handle, norm_off,
                self.wqkv_b.handle, l * qkv_stride,
                self.qkv_b.handle,
                self.bqkv_b.handle, l * qkv_dim * 2,
                qkv_dim, d, qm, c.gemma_norm, c.has_qkv_bias, 0,
            )
            let _ = cuda_rope_flash_decode(
                self.qkv_b.handle,
                self.k_cache_b.handle, kv_off,
                self.v_cache_b.handle, kv_off,
                self.ctx_b.handle,
                self.tok_pos_b.handle,
                c.n_heads, c.n_kv_heads, c.d_head, ms, c.attn_softcap,
            )
            let _ = cuda_gemv_ss(
                self.ctx_b.handle,
                self.wo_b.handle, l * wo_stride,
                self.x_b.handle,
                self.bqkv_b.handle, 0,
                d, d, qm, true, false, 1,
            )
            let _ = cuda_epinorm_ffn(
                self.x_b.handle, self.norm2_b.handle, norm_off,
                self.wgate_b.handle, l * ff_stride,
                self.wup_b.handle, l * ff_stride,
                self.ffn_act_b.handle,
                c.d_ff, d, qm, c.is_geglu, c.gemma_norm, 1,
            )
            let _ = cuda_gemv_ss(
                self.ffn_act_b.handle,
                self.wdown_b.handle, l * ff_stride,
                self.x_b.handle,
                self.bqkv_b.handle, 0,
                d, c.d_ff, qm, true, false, 0,
            )
            l += 1
        }
        let _ = cuda_rmsnorm(self.x_b.handle, self.fnorm_b.handle, 0, self.x_norm_b.handle, 1, d, c.gemma_norm)
        let _ = cuda_gemv(
            self.x_norm_b.handle,
            self.lmhead_b.handle, 0,
            self.logits_b.handle,
            self.bqkv_b.handle, 0,
            c.vocab_size, d, qm, false, false,
        )
        let _ = cuda_argmax(self.logits_b.handle, self.tok_pos_b.handle, c.vocab_size, inc_pos)
        0
    }

    pub fn decode_step_logits(inout self, tok_id Int, pos Int) List[Float16] {
        let _ = cuda_write_tok_pos(self.tok_pos_b.handle, tok_id, pos)
        let _ = self.enqueue_decode_step(false)
        let _ = cuda_sync()
        var logits List[Float16] = list_filled(self.cfg.vocab_size, 0.0 as Float16)
        let _ = self.logits_b.read_f16(logits)
        logits
    }

    pub fn decode_step_greedy(inout self, tok_id Int, pos Int) Int {
        let _ = cuda_write_tok_pos(self.tok_pos_b.handle, tok_id, pos)
        let _ = self.enqueue_decode_step(false)
        let _ = cuda_sync()
        cuda_read_tok(self.tok_pos_b.handle)
    }

    /// Captures the entire Transformer decode pass into a single native CUDA Graph (`cuGraphExec`)!
    pub fn capture_decode_graph(inout self) CudaGraph {
        let _ = cuda_sync()
        let _ = cuda_graph_begin()
        let _ = self.enqueue_decode_step(true)
        cuda_graph_end()
    }

    pub fn free(self) Int {
        let _ = self.tok_emb_b.free()
        let _ = self.norm1_b.free()
        let _ = self.wqkv_b.free()
        let _ = self.bqkv_b.free()
        let _ = self.wo_b.free()
        let _ = self.norm2_b.free()
        let _ = self.wgate_b.free()
        let _ = self.wup_b.free()
        let _ = self.wdown_b.free()
        let _ = self.fnorm_b.free()
        let _ = self.lmhead_b.free()
        let _ = self.tok_pos_b.free()
        let _ = self.x_b.free()
        let _ = self.x_norm_b.free()
        let _ = self.qkv_b.free()
        let _ = self.k_cache_b.free()
        let _ = self.v_cache_b.free()
        let _ = self.ctx_b.free()
        let _ = self.ffn_act_b.free()
        let _ = self.logits_b.free()
        0
    }
}
