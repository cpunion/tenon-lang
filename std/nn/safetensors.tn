// std/nn/safetensors.tn — Pure Tenon HuggingFace `.safetensors` Binary Writer & Zero-Copy Parser
//
// Wire format (100% compatible with HuggingFace `safetensors` v0.4):
//   [0..8]            : uint64 little-endian `header_len`
//   [8..8+header_len] : UTF-8 JSON header `{ "<name>": { "dtype": "F16", "shape": [...], "data_offsets": [s, e] } }`
//   [8+header_len..]  : contiguous 2-byte IEEE-754 little-endian `Float16` tensor payload!

import "std/core/types.tn"
import "std/text/text.tn"

pub record SafeTensorEntry {
    name       Text
    dtype      Text
    shape      List[Int]
    byte_start Int
    byte_end   Int
}

pub record SafeTensorsFile {
    data_base Int
    entries   List[SafeTensorEntry]
    raw       Bytes
}

pure fn format_int_list(xs List[Int]) Text {
    var out = "["
    var i = 0
    while i < len(xs) {
        if i > 0 { out = out ++ "," }
        out = out ++ int_to_text(xs[i])
        i += 1
    }
    out ++ "]"
}

/// Serializes named 2-byte `Float16` tensors into a standards-compliant `.safetensors` `Bytes` buffer.
pub fn safetensors_encode_f16(
    names List[Text],
    shapes List[List[Int]],
    tensors List[List[Float16]],
) Bytes {
    var header = "{"
    var cur_off = 0
    var i = 0
    while i < len(names) && i < len(shapes) && i < len(tensors) {
        if i > 0 { header = header ++ "," }
        let nbytes = len(tensors[i]) * 2
        let end_off = cur_off + nbytes
        header = header ++ "\"" ++ names[i] ++ "\":{\"dtype\":\"F16\",\"shape\":" ++ format_int_list(shapes[i]) ++ ",\"data_offsets\":[" ++ int_to_text(cur_off) ++ "," ++ int_to_text(end_off) ++ "]}"
        cur_off = end_off
        i += 1
    }
    header = header ++ "}"
    let hbytes = text_to_bytes(header)
    let hlen = bytes_len(hbytes)
    let total = 8 + hlen + cur_off
    var out = bytes_filled(total, 0)
    out = bytes_write_u64_le(out, 0, hlen)
    let _ = unsafe { raw_memcpy(ptr_add(bytes_ptr(out), 8), bytes_ptr(hbytes), hlen) }
    var pos = 8 + hlen
    var k = 0
    while k < len(tensors) {
        let nb = len(tensors[k]) * 2
        if nb > 0 {
            let _ = unsafe { raw_memcpy(ptr_add(bytes_ptr(out), pos), list_data_ptr(tensors[k]), nb) }
        }
        pos += nb
        k += 1
    }
    out
}

pure fn parse_uint_from(s Text, start Int) (Int, Int) {
    let n = len(s)
    var i = start
    while i < n && (byte_at(s, i) < 48 || byte_at(s, i) > 57) {
        i += 1
    }
    var val = 0
    while i < n {
        let b = byte_at(s, i)
        if b >= 48 && b <= 57 {
            val = val * 10 + (b - 48)
            i += 1
        } else {
            break
        }
    }
    (val, i)
}

pure fn find_substr_from(hay Text, needle Text, start Int) Int {
    let hn = len(hay)
    let nn = len(needle)
    if nn == 0 || start < 0 || start + nn > hn { return -1 }
    var i = start
    while i <= hn - nn {
        var matched = true
        var j = 0
        while j < nn {
            if byte_at(hay, i + j) != byte_at(needle, j) {
                matched = false
                break
            }
            j += 1
        }
        if matched { return i }
        i += 1
    }
    -1
}

/// Zero-copy parses a `.safetensors` binary buffer and validates header & data offset bounds!
pub fn safetensors_parse(raw Bytes) Result[SafeTensorsFile, Text] {
    let total = bytes_len(raw)
    if total < 10 { return Err("safetensors buffer too short") }
    let hlen = bytes_read_u64_le(raw, 0) as Int
    let base = 8 + hlen
    if hlen <= 0 || base > total {
        return Err("invalid safetensors header length")
    }
    var hbuf = bytes_filled(hlen, 0)
    let _ = unsafe { raw_memcpy(bytes_ptr(hbuf), ptr_add(bytes_ptr(raw), 8), hlen) }
    let hdr = bytes_to_text(hbuf)

    var entries List[SafeTensorEntry] = []
    var pos = 0
    let hn = len(hdr)
    while pos < hn {
        let off_tag = find_substr_from(hdr, "\"data_offsets\":[", pos)
        if off_tag < 0 { break }
        // Backtrack to find tensor key `"<name>":{"dtype"`
        let dtype_tag = find_substr_from(hdr, "\"dtype\":\"", pos)
        var tname = "tensor"
        if dtype_tag > pos && dtype_tag < off_tag {
            // Find opening quote of key just before `:{`
            var q2 = dtype_tag - 1
            while q2 > pos && byte_at(hdr, q2) != 34 { q2 -= 1 }
            var q1 = q2 - 1
            while q1 >= pos && byte_at(hdr, q1) != 34 { q1 -= 1 }
            if q1 >= pos && q2 > q1 + 1 {
                tname = str_slice(hdr, q1 + 1, q2)
            }
        }
        let (bstart, p1) = parse_uint_from(hdr, off_tag + 16)
        let (bend, p2) = parse_uint_from(hdr, p1 + 1)
        if bstart < 0 || bend < bstart || base + bend > total {
            return Err("safetensors tensor offset out of bounds")
        }
        entries = push(entries, SafeTensorEntry {
            name = tname,
            dtype = "F16",
            shape = [],
            byte_start = bstart,
            byte_end = bend,
        })
        pos = p2
    }
    Ok(SafeTensorsFile { data_base = base, entries = entries, raw = raw })
}

/// Extracts a 2-byte `List[Float16]` tensor directly from a parsed `.safetensors` file by name.
pub fn safetensors_get_f16(sf SafeTensorsFile, name Text) Result[List[Float16], Text] {
    var i = 0
    while i < len(sf.entries) {
        let e = sf.entries[i]
        if e.name == name {
            let nbytes = e.byte_end - e.byte_start
            let count = nbytes / 2
            var out List[Float16] = list_filled(count, 0.0 as Float16)
            if nbytes > 0 {
                let _ = unsafe {
                    raw_memcpy(
                        list_data_ptr(out),
                        ptr_add(bytes_ptr(sf.raw), sf.data_base + e.byte_start),
                        nbytes,
                    )
                }
            }
            return Ok(out)
        }
        i += 1
    }
    Err("tensor not found in safetensors: " ++ name)
}
