// std/nn/tensor.tn — Tenon-Torch: Verified Shape Tensors & Dynamic Reverse-Mode Autograd Tape
//
// PyTorch-inspired deep learning core leveraging Tenon's unique language superpowers:
//   1. Compile-time shape verification (`Matrix[R, C]` / `requires a.cols == b.rows`) — catches matmul
//      dimension bugs at COMPILE TIME instead of crashing hours into a training run!
//   2. Zero-NaN / strictly-positive numeric types (`PosFloat`, `UnitInterval`, `NonNegFloat`)
//   3. Pure MVS Value-Semantic Autograd Tape (`inout tape AutogradTape`) — zero `Rc<RefCell<...>>`
//      reference cycles, deterministic Perceus `live_objects == 0`!
//   4. Full analytical reverse-mode backprop: MatMul, Add, AddBias, Scale, Transpose, ReLU, GELU,
//      Softmax, LayerNorm, CrossEntropyLoss, MSELoss!

import "std/core/types.tn"
import "std/text/text.tn"
import "std/gpu/tensor.tn"

pub type Dim          = Int   where self >= 1
pub type PosFloat     = Float where is_finite(self) && self > 0.0
pub type UnitInterval = Float where is_finite(self) && self >= 0.0 && self <= 1.0

// =========================================================================
// 1. Pure-Tenon Deterministic IEEE-754 Elementary Math (Zero libm, Zero NaN)
// =========================================================================

pub pure fn nn_abs(x Float) Float {
    if x < 0.0 { 0.0 - x } else { x }
}

pub pure fn nn_min(a Float, b Float) Float {
    if a < b { a } else { b }
}

pub pure fn nn_max(a Float, b Float) Float {
    if a > b { a } else { b }
}

pub pure fn nn_sqrt(x Float) Float {
    if x <= 0.0 { return 0.0 }
    var s = x
    var scale = 1.0
    while s > 4.0 {
        s = s * 0.25
        scale = scale * 2.0
    }
    while s < 0.25 {
        s = s * 4.0
        scale = scale * 0.5
    }
    var g = 0.5 * (s + 1.0)
    var it = 0
    while it < 8 {
        if g > 0.000000000001 {
            g = 0.5 * (g + s / g)
        }
        it += 1
    }
    g * scale
}

pub pure fn nn_exp(x Float) Float {
    let xc = if x > 40.0 { 40.0 } else if x < -40.0 { -40.0 } else { x }
    let ln2 = 0.6931471805599453
    let inv_ln2 = 1.4426950408889634
    let kf = xc * inv_ln2
    let k = if kf >= 0.0 { float_to_int(kf + 0.5) } else { float_to_int(kf - 0.5) }
    let r = xc - int_to_float(k) * ln2
    // Degree-10 Horner Taylor polynomial on |r| <= 0.347 (accuracy < 1e-13)
    var p = 1.0 + r / 10.0
    p = 1.0 + r * p / 9.0
    p = 1.0 + r * p / 8.0
    p = 1.0 + r * p / 7.0
    p = 1.0 + r * p / 6.0
    p = 1.0 + r * p / 5.0
    p = 1.0 + r * p / 4.0
    p = 1.0 + r * p / 3.0
    p = 1.0 + r * p / 2.0
    p = 1.0 + r * p
    var out = p
    var kk = k
    while kk > 0 {
        out = out * 2.0
        kk -= 1
    }
    while kk < 0 {
        out = out * 0.5
        kk += 1
    }
    out
}

pub pure fn nn_ln(x Float) Float {
    let xc = if x < 0.000000000001 { 0.000000000001 } else { x }
    var m = xc
    var k = 0
    while m > 1.4142135623730951 {
        m = m * 0.5
        k += 1
    }
    while m < 0.7071067811865476 {
        m = m * 2.0
        k -= 1
    }
    let y = (m - 1.0) / (m + 1.0)
    let y2 = y * y
    var term = y
    var sum = y
    term = term * y2
    sum += term / 3.0
    term = term * y2
    sum += term / 5.0
    term = term * y2
    sum += term / 7.0
    term = term * y2
    sum += term / 9.0
    term = term * y2
    sum += term / 11.0
    2.0 * sum + int_to_float(k) * 0.6931471805599453
}

pub pure fn nn_tanh(x Float) Float {
    if x >= 15.0 { return 1.0 }
    if x <= -15.0 { return -1.0 }
    if x >= 0.0 {
        let e = nn_exp(0.0 - 2.0 * x)
        (1.0 - e) / (1.0 + e)
    } else {
        let e = nn_exp(2.0 * x)
        (e - 1.0) / (e + 1.0)
    }
}

// =========================================================================
// 2. Compile-Time Shape-Verified Matrix Operations (`Matrix[R, C]`)
// =========================================================================

/// Statically verified matrix multiplication:
/// Tenon proves `a.cols == b.rows` AT COMPILE TIME (e.g. `Matrix[4, 8] @ Matrix[8, 2] -> Matrix[4, 2]`).
/// Passing incompatible dimensions (e.g. `Matrix[4, 8] @ Matrix[6, 2]`) is rejected by L0/Z3 before compilation!
pub pure fn nn_matmul_verified(a Tensor2D, b Tensor2D) Tensor2D
    requires a.rows <= 4096 && a.cols <= 4096 && b.cols <= 4096
    requires a.cols == b.rows
    requires len(a.data) == a.rows * a.cols && len(b.data) == b.rows * b.cols
    ensures result.rows == a.rows && result.cols == b.cols && len(result.data) == a.rows * b.cols
{
    let c = tensor2d_matmul(a, b)
    Tensor2D { rows = a.rows, cols = b.cols, data = c.data }
}

// =========================================================================
// 3. PyTorch-Style Dynamic Reverse-Mode Autograd Computation Tape
// =========================================================================

pub enum OpKind {
    OpLeaf
    OpMatMul
    OpAdd
    OpAddBias
    OpScale
    OpTranspose
    OpReLU
    OpGELU
    OpSoftmax
    OpLayerNorm
    OpCrossEntropy
    OpMSE
}

pub record TapeNode {
    op      OpKind
    rows    Int
    cols    Int
    lhs     Int
    rhs     Int
    aux     Float
    data    List[Float]
    grad    List[Float]
    targets List[Int]
}

pub record AutogradTape {
    nodes List[TapeNode]
}

pub pure fn tape_new() AutogradTape {
    AutogradTape { nodes = [] }
}

pure fn zeros_f64(n Int) List[Float] {
    var out List[Float] = []
    var i = 0
    while i < n {
        out = push(out, 0.0)
        i += 1
    }
    out
}

pub pure fn tape_leaf(inout tape AutogradTape, rows Int, cols Int, data List[Float]) Int {
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpLeaf,
        rows = rows,
        cols = cols,
        lhs = -1,
        rhs = -1,
        aux = 0.0,
        data = data,
        grad = zeros_f64(len(data)),
        targets = [],
    })
    id
}

pub pure fn tape_data(tape AutogradTape, id Int) List[Float] {
    if id >= 0 && id < len(tape.nodes) { tape.nodes[id].data } else { [] }
}

pub pure fn tape_grad(tape AutogradTape, id Int) List[Float] {
    if id >= 0 && id < len(tape.nodes) { tape.nodes[id].grad } else { [] }
}

pub pure fn tape_scalar(tape AutogradTape, id Int) Float {
    if id >= 0 && id < len(tape.nodes) && len(tape.nodes[id].data) > 0 {
        tape.nodes[id].data[0]
    } else {
        0.0
    }
}

/// Forward `C = A @ B` (`[M, K] @ [K, N] -> [M, N]`)
pub pure fn tape_matmul(inout tape AutogradTape, a_id Int, b_id Int) Int {
    if a_id < 0 || a_id >= len(tape.nodes) || b_id < 0 || b_id >= len(tape.nodes) { return -1 }
    let a = tape.nodes[a_id]
    let b = tape.nodes[b_id]
    let m = a.rows
    let k_dim = a.cols
    let n = b.cols
    var out = zeros_f64(m * n)
    var r = 0
    while r < m {
        var c = 0
        while c < n {
            var acc = 0.0
            var k = 0
            while k < k_dim {
                let ia = r * k_dim + k
                let ib = k * n + c
                if ia < len(a.data) && ib < len(b.data) {
                    acc += a.data[ia] * b.data[ib]
                }
                k += 1
            }
            let io = r * n + c
            if io < len(out) { out[io] = acc }
            c += 1
        }
        r += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpMatMul,
        rows = m,
        cols = n,
        lhs = a_id,
        rhs = b_id,
        aux = 0.0,
        data = out,
        grad = zeros_f64(m * n),
        targets = [],
    })
    id
}

/// Elementwise residual addition `A + B`
pub pure fn tape_add(inout tape AutogradTape, a_id Int, b_id Int) Int {
    if a_id < 0 || a_id >= len(tape.nodes) || b_id < 0 || b_id >= len(tape.nodes) { return -1 }
    let a = tape.nodes[a_id]
    let b = tape.nodes[b_id]
    let sz = len(a.data)
    var out = zeros_f64(sz)
    var i = 0
    while i < sz && i < len(b.data) {
        out[i] = a.data[i] + b.data[i]
        i += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpAdd,
        rows = a.rows,
        cols = a.cols,
        lhs = a_id,
        rhs = b_id,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// Broadcast row bias addition `[B, D] + [1, D]`
pub pure fn tape_add_bias(inout tape AutogradTape, x_id Int, bias_id Int) Int {
    if x_id < 0 || x_id >= len(tape.nodes) || bias_id < 0 || bias_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let b = tape.nodes[bias_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    var r = 0
    while r < x.rows {
        var c = 0
        while c < x.cols {
            let idx = r * x.cols + c
            if idx < sz && c < len(b.data) {
                out[idx] = x.data[idx] + b.data[c]
            }
            c += 1
        }
        r += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpAddBias,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = bias_id,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// Scalar multiplication `x * factor` (e.g. `1 / sqrt(d_k)` in Scaled Dot-Product Attention)
pub pure fn tape_scale(inout tape AutogradTape, x_id Int, factor Float) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    var i = 0
    while i < sz {
        out[i] = x.data[i] * factor
        i += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpScale,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = -1,
        aux = factor,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// 2D Matrix transpose `[R, C] -> [C, R]`
pub pure fn tape_transpose(inout tape AutogradTape, x_id Int) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = x.rows * x.cols
    var out = zeros_f64(sz)
    var r = 0
    while r < x.rows {
        var c = 0
        while c < x.cols {
            let src = r * x.cols + c
            let dst = c * x.rows + r
            if src < len(x.data) && dst < len(out) {
                out[dst] = x.data[src]
            }
            c += 1
        }
        r += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpTranspose,
        rows = x.cols,
        cols = x.rows,
        lhs = x_id,
        rhs = -1,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// ReLU activation `max(0, x)`
pub pure fn tape_relu(inout tape AutogradTape, x_id Int) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    var i = 0
    while i < sz {
        let v = x.data[i]
        out[i] = if v > 0.0 { v } else { 0.0 }
        i += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpReLU,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = -1,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// PyTorch-compatible GELU activation: `0.5 * x * (1 + tanh(sqrt(2/pi) * (x + 0.044715 * x^3)))`
pub pure fn tape_gelu(inout tape AutogradTape, x_id Int) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    let k = 0.7978845608028654 // sqrt(2 / pi)
    var i = 0
    while i < sz {
        let v = x.data[i]
        let inner = k * (v + 0.044715 * v * v * v)
        out[i] = 0.5 * v * (1.0 + nn_tanh(inner))
        i += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpGELU,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = -1,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// Numerically stabilized row-wise Softmax (`exp(x - max) / sum`, proved divisor > 0)
pub pure fn tape_softmax(inout tape AutogradTape, x_id Int) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    var r = 0
    while r < x.rows {
        var mx = -1000000000.0
        var c = 0
        while c < x.cols {
            let idx = r * x.cols + c
            if idx < sz && x.data[idx] > mx { mx = x.data[idx] }
            c += 1
        }
        var sum_e = 0.0
        var c2 = 0
        while c2 < x.cols {
            let idx = r * x.cols + c2
            if idx < sz {
                let e = nn_exp(x.data[idx] - mx)
                out[idx] = e
                sum_e += e
            }
            c2 += 1
        }
        let inv = if sum_e > 0.000000000001 { 1.0 / sum_e } else { 0.0 }
        var c3 = 0
        while c3 < x.cols {
            let idx = r * x.cols + c3
            if idx < sz { out[idx] = out[idx] * inv }
            c3 += 1
        }
        r += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpSoftmax,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = -1,
        aux = 0.0,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// Row-wise LayerNorm with statically verified strictly positive `eps: PosFloat` (zero NaN / div-by-zero!)
pub pure fn tape_layer_norm(inout tape AutogradTape, x_id Int, eps PosFloat) Int {
    if x_id < 0 || x_id >= len(tape.nodes) { return -1 }
    let x = tape.nodes[x_id]
    let sz = len(x.data)
    var out = zeros_f64(sz)
    let d_f = if x.cols > 0 { int_to_float(x.cols) } else { 1.0 }
    var r = 0
    while r < x.rows {
        var mean = 0.0
        var c = 0
        while c < x.cols {
            let idx = r * x.cols + c
            if idx < sz { mean += x.data[idx] }
            c += 1
        }
        mean = mean / d_f
        var var_acc = 0.0
        var c2 = 0
        while c2 < x.cols {
            let idx = r * x.cols + c2
            if idx < sz {
                let d = x.data[idx] - mean
                var_acc += d * d
            }
            c2 += 1
        }
        let inv_std = 1.0 / nn_sqrt(var_acc / d_f + eps)
        var c3 = 0
        while c3 < x.cols {
            let idx = r * x.cols + c3
            if idx < sz {
                out[idx] = (x.data[idx] - mean) * inv_std
            }
            c3 += 1
        }
        r += 1
    }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpLayerNorm,
        rows = x.rows,
        cols = x.cols,
        lhs = x_id,
        rhs = -1,
        aux = eps,
        data = out,
        grad = zeros_f64(sz),
        targets = [],
    })
    id
}

/// PyTorch `F.cross_entropy(logits, targets)`: mean log-sum-exp cross-entropy loss across batch rows.
pub pure fn tape_cross_entropy(inout tape AutogradTape, logits_id Int, targets List[Int]) Int {
    if logits_id < 0 || logits_id >= len(tape.nodes) { return -1 }
    let lg = tape.nodes[logits_id]
    let rows = lg.rows
    let cols = lg.cols
    let sz = len(lg.data)
    var loss_sum = 0.0
    var r = 0
    while r < rows && r < len(targets) {
        var mx = -1000000000.0
        var c = 0
        while c < cols {
            let idx = r * cols + c
            if idx < sz && lg.data[idx] > mx { mx = lg.data[idx] }
            c += 1
        }
        var sum_e = 0.0
        var c2 = 0
        while c2 < cols {
            let idx = r * cols + c2
            if idx < sz { sum_e += nn_exp(lg.data[idx] - mx) }
            c2 += 1
        }
        let log_z = mx + nn_ln(sum_e)
        let tgt = targets[r]
        if tgt >= 0 && tgt < cols {
            let tidx = r * cols + tgt
            if tidx < sz {
                loss_sum += log_z - lg.data[tidx]
            }
        }
        r += 1
    }
    let denom = if rows > 0 { int_to_float(rows) } else { 1.0 }
    let loss = loss_sum / denom
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpCrossEntropy,
        rows = 1,
        cols = 1,
        lhs = logits_id,
        rhs = -1,
        aux = 0.0,
        data = [loss],
        grad = [0.0],
        targets = targets,
    })
    id
}

/// PyTorch `F.mse_loss(pred, target)`
pub pure fn tape_mse_loss(inout tape AutogradTape, pred_id Int, target_id Int) Int {
    if pred_id < 0 || pred_id >= len(tape.nodes) || target_id < 0 || target_id >= len(tape.nodes) { return -1 }
    let p = tape.nodes[pred_id]
    let t = tape.nodes[target_id]
    let sz = len(p.data)
    var acc = 0.0
    var i = 0
    while i < sz && i < len(t.data) {
        let d = p.data[i] - t.data[i]
        acc += d * d
        i += 1
    }
    let denom = if sz > 0 { int_to_float(sz) } else { 1.0 }
    let id = len(tape.nodes)
    tape.nodes = push(tape.nodes, TapeNode {
        op = OpMSE,
        rows = 1,
        cols = 1,
        lhs = pred_id,
        rhs = target_id,
        aux = 0.0,
        data = [acc / denom],
        grad = [0.0],
        targets = [],
    })
    id
}

/// Helper: accumulate `delta` into `tape.nodes[nid].grad`
pure fn accum_grad(inout tape AutogradTape, nid Int, delta List[Float]) {
    if nid < 0 || nid >= len(tape.nodes) { return }
    var nd = tape.nodes[nid]
    var i = 0
    while i < len(nd.grad) && i < len(delta) {
        nd.grad[i] = nd.grad[i] + delta[i]
        i += 1
    }
    tape.nodes[nid] = nd
}

/// Full PyTorch-compatible reverse-mode automatic differentiation (`loss.backward()`).
/// Traverses the computation tape in reverse topological order, accumulating exact analytical gradients
/// into every ancestor node with zero reference cycles and zero memory leaks!
pub pure fn tape_backward(inout tape AutogradTape, loss_id Int) {
    if loss_id < 0 || loss_id >= len(tape.nodes) { return }
    var root = tape.nodes[loss_id]
    if len(root.grad) > 0 {
        root.grad[0] = 1.0
    }
    tape.nodes[loss_id] = root

    var idx = loss_id
    while idx >= 0 {
        let nd = tape.nodes[idx]
        let dout = nd.grad
        match nd.op {
            OpLeaf => {}
            OpMatMul => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) && nd.rhs >= 0 && nd.rhs < len(tape.nodes) {
                    let a = tape.nodes[nd.lhs]
                    let b = tape.nodes[nd.rhs]
                    let m = a.rows
                    let k_dim = a.cols
                    let n = b.cols
                    // dA = dOut @ B^T
                    var da = zeros_f64(m * k_dim)
                    var r = 0
                    while r < m {
                        var k = 0
                        while k < k_dim {
                            var s = 0.0
                            var c = 0
                            while c < n {
                                let io = r * n + c
                                let ib = k * n + c
                                if io < len(dout) && ib < len(b.data) {
                                    s += dout[io] * b.data[ib]
                                }
                                c += 1
                            }
                            let ia = r * k_dim + k
                            if ia < len(da) { da[ia] = s }
                            k += 1
                        }
                        r += 1
                    }
                    // dB = A^T @ dOut
                    var db = zeros_f64(k_dim * n)
                    var k2 = 0
                    while k2 < k_dim {
                        var c2 = 0
                        while c2 < n {
                            var s2 = 0.0
                            var r2 = 0
                            while r2 < m {
                                let ia2 = r2 * k_dim + k2
                                let io2 = r2 * n + c2
                                if ia2 < len(a.data) && io2 < len(dout) {
                                    s2 += a.data[ia2] * dout[io2]
                                }
                                r2 += 1
                            }
                            let ib2 = k2 * n + c2
                            if ib2 < len(db) { db[ib2] = s2 }
                            c2 += 1
                        }
                        k2 += 1
                    }
                    accum_grad(tape, nd.lhs, da)
                    accum_grad(tape, nd.rhs, db)
                }
            }
            OpAdd => {
                accum_grad(tape, nd.lhs, dout)
                accum_grad(tape, nd.rhs, dout)
            }
            OpAddBias => {
                accum_grad(tape, nd.lhs, dout)
                var db = zeros_f64(nd.cols)
                var r = 0
                while r < nd.rows {
                    var c = 0
                    while c < nd.cols {
                        let io = r * nd.cols + c
                        if io < len(dout) && c < len(db) {
                            db[c] = db[c] + dout[io]
                        }
                        c += 1
                    }
                    r += 1
                }
                accum_grad(tape, nd.rhs, db)
            }
            OpScale => {
                var dx = zeros_f64(len(dout))
                var i = 0
                while i < len(dout) {
                    dx[i] = dout[i] * nd.aux
                    i += 1
                }
                accum_grad(tape, nd.lhs, dx)
            }
            OpTranspose => {
                let orig_r = nd.cols
                let orig_c = nd.rows
                var dx = zeros_f64(orig_r * orig_c)
                var r = 0
                while r < orig_r {
                    var c = 0
                    while c < orig_c {
                        let io = c * orig_r + r
                        let id_x = r * orig_c + c
                        if io < len(dout) && id_x < len(dx) {
                            dx[id_x] = dout[io]
                        }
                        c += 1
                    }
                    r += 1
                }
                accum_grad(tape, nd.lhs, dx)
            }
            OpReLU => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) {
                    let x = tape.nodes[nd.lhs]
                    var dx = zeros_f64(len(dout))
                    var i = 0
                    while i < len(dout) && i < len(x.data) {
                        dx[i] = if x.data[i] > 0.0 { dout[i] } else { 0.0 }
                        i += 1
                    }
                    accum_grad(tape, nd.lhs, dx)
                }
            }
            OpGELU => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) {
                    let x = tape.nodes[nd.lhs]
                    let k = 0.7978845608028654
                    var dx = zeros_f64(len(dout))
                    var i = 0
                    while i < len(dout) && i < len(x.data) {
                        let v = x.data[i]
                        let inner = k * (v + 0.044715 * v * v * v)
                        let th = nn_tanh(inner)
                        let sech2 = 1.0 - th * th
                        let d_inner = k * (1.0 + 3.0 * 0.044715 * v * v)
                        let dgelu = 0.5 * (1.0 + th) + 0.5 * v * sech2 * d_inner
                        dx[i] = dout[i] * dgelu
                        i += 1
                    }
                    accum_grad(tape, nd.lhs, dx)
                }
            }
            OpSoftmax => {
                // Full row Jacobian: dx_i = y_i * (dout_i - sum_j(dout_j * y_j))
                var dx = zeros_f64(len(dout))
                var r = 0
                while r < nd.rows {
                    var dot = 0.0
                    var c = 0
                    while c < nd.cols {
                        let io = r * nd.cols + c
                        if io < len(dout) && io < len(nd.data) {
                            dot += dout[io] * nd.data[io]
                        }
                        c += 1
                    }
                    var c2 = 0
                    while c2 < nd.cols {
                        let io = r * nd.cols + c2
                        if io < len(dout) && io < len(nd.data) && io < len(dx) {
                            dx[io] = nd.data[io] * (dout[io] - dot)
                        }
                        c2 += 1
                    }
                    r += 1
                }
                accum_grad(tape, nd.lhs, dx)
            }
            OpLayerNorm => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) {
                    let x = tape.nodes[nd.lhs]
                    let d_f = if nd.cols > 0 { int_to_float(nd.cols) } else { 1.0 }
                    let eps = nd.aux
                    var dx = zeros_f64(len(dout))
                    var r = 0
                    while r < nd.rows {
                        var mean = 0.0
                        var c = 0
                        while c < nd.cols {
                            let io = r * nd.cols + c
                            if io < len(x.data) { mean += x.data[io] }
                            c += 1
                        }
                        mean = mean / d_f
                        var var_acc = 0.0
                        var c2 = 0
                        while c2 < nd.cols {
                            let io = r * nd.cols + c2
                            if io < len(x.data) {
                                let dv = x.data[io] - mean
                                var_acc += dv * dv
                            }
                            c2 += 1
                        }
                        let inv_std = 1.0 / nn_sqrt(var_acc / d_f + eps)
                        var sum_dy = 0.0
                        var sum_dy_xh = 0.0
                        var c3 = 0
                        while c3 < nd.cols {
                            let io = r * nd.cols + c3
                            if io < len(dout) && io < len(nd.data) {
                                sum_dy += dout[io]
                                sum_dy_xh += dout[io] * nd.data[io]
                            }
                            c3 += 1
                        }
                        var c4 = 0
                        while c4 < nd.cols {
                            let io = r * nd.cols + c4
                            if io < len(dout) && io < len(nd.data) && io < len(dx) {
                                dx[io] = (inv_std / d_f) * (d_f * dout[io] - sum_dy - nd.data[io] * sum_dy_xh)
                            }
                            c4 += 1
                        }
                        r += 1
                    }
                    accum_grad(tape, nd.lhs, dx)
                }
            }
            OpCrossEntropy => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) {
                    let lg = tape.nodes[nd.lhs]
                    let rows = lg.rows
                    let cols = lg.cols
                    let sz = len(lg.data)
                    let scale = if rows > 0 && len(dout) > 0 { dout[0] / int_to_float(rows) } else { 0.0 }
                    var dx = zeros_f64(sz)
                    var r = 0
                    while r < rows && r < len(nd.targets) {
                        var mx = -1000000000.0
                        var c = 0
                        while c < cols {
                            let io = r * cols + c
                            if io < sz && lg.data[io] > mx { mx = lg.data[io] }
                            c += 1
                        }
                        var sum_e = 0.0
                        var c2 = 0
                        while c2 < cols {
                            let io = r * cols + c2
                            if io < sz {
                                let e = nn_exp(lg.data[io] - mx)
                                dx[io] = e
                                sum_e += e
                            }
                            c2 += 1
                        }
                        let inv = if sum_e > 0.000000000001 { 1.0 / sum_e } else { 0.0 }
                        let tgt = nd.targets[r]
                        var c3 = 0
                        while c3 < cols {
                            let io = r * cols + c3
                            if io < sz {
                                let prob = dx[io] * inv
                                let one = if c3 == tgt { 1.0 } else { 0.0 }
                                dx[io] = (prob - one) * scale
                            }
                            c3 += 1
                        }
                        r += 1
                    }
                    accum_grad(tape, nd.lhs, dx)
                }
            }
            OpMSE => {
                if nd.lhs >= 0 && nd.lhs < len(tape.nodes) && nd.rhs >= 0 && nd.rhs < len(tape.nodes) {
                    let p = tape.nodes[nd.lhs]
                    let t = tape.nodes[nd.rhs]
                    let sz = len(p.data)
                    let scale = if sz > 0 && len(dout) > 0 { (2.0 * dout[0]) / int_to_float(sz) } else { 0.0 }
                    var dp = zeros_f64(sz)
                    var i = 0
                    while i < sz && i < len(t.data) {
                        dp[i] = (p.data[i] - t.data[i]) * scale
                        i += 1
                    }
                    accum_grad(tape, nd.lhs, dp)
                }
            }
        }
        idx -= 1
    }
}
