// std/interop/python.tn — Mojo-Grade Seamless Python 3 Ecosystem Interop + Native Class Extension!
//
// Zero linker flags needed: `python_shim.c` dynamically loads `libpython3` / `Python.framework` at runtime!
// Supports:
//   - Seamless `py_import("math" | "json" | "numpy" | "torch" | ...)`
//   - Dynamic attribute/method calls (`PyObj.attr`, `PyObj.call1..3`, `PyObj.method1..3`)
//   - Zero-copy `memoryview` sharing of Tenon `Bytes` / `List[Float32]` buffers directly with Python/NumPy/PyTorch
//   - Subclassing ANY Python class inside Tenon and injecting native LLVM-compiled Tenon methods!

import "std/core/types.tn"

@c_src("python_shim.c")
extern "C" {
    fn tn_py_init() Int
    fn tn_py_decref(h Int)
    fn tn_py_incref(h Int) Int
    fn tn_py_import(name CStr) Int
    fn tn_py_exec(code CStr) Int
    fn tn_py_eval(expr CStr) Int
    fn tn_py_none() Int
    fn tn_py_int(v Int) Int
    fn tn_py_float(v Float) Int
    fn tn_py_bool(v Int) Int
    fn tn_py_str(s CStr, n Int) Int
    fn tn_py_list_new() Int
    fn tn_py_list_append(lst Int, item Int) Int
    fn tn_py_dict_new() Int
    fn tn_py_to_int(h Int) Int
    fn tn_py_to_float(h Int) Float
    fn tn_py_to_text(h Int) Text
    fn tn_py_len(h Int) Int
    fn tn_py_getattr(obj Int, attr CStr) Int
    fn tn_py_setattr(obj Int, attr CStr, val Int) Int
    fn tn_py_getitem(obj Int, key Int) Int
    fn tn_py_setitem(obj Int, key Int, val Int) Int
    fn tn_py_call0(f Int) Int
    fn tn_py_call1(f Int, a0 Int) Int
    fn tn_py_call2(f Int, a0 Int, a1 Int) Int
    fn tn_py_call3(f Int, a0 Int, a1 Int, a2 Int) Int
    fn tn_py_memoryview_from_ptr(ptr Ptr[UInt8], nbytes Int, writable Int) Int
    fn tn_py_subclass_new(base_cls Int, class_name CStr) Int
    fn tn_py_attach_native_method(py_cls Int, method_name CStr, fn_addr Int, arity Int) Int
    fn tn_py_attach_exported_method(py_cls Int, method_name CStr, c_sym CStr, arity Int) Int
    fn tn_py_attach_exported_float_method(py_cls Int, method_name CStr, c_sym CStr, arity Int) Int
    fn tn_py_isinstance(obj Int, cls Int) Int
    fn tn_py_set_global(var_name CStr, obj Int) Int
}

pub record PyObj {
    handle Int
}

pub fn py_init() Bool { unsafe { tn_py_init() != 0 } }
pub fn py_import(name Text) PyObj { PyObj { handle = unsafe { tn_py_import(text_cstr_ptr(name)) } } }
pub fn py_exec(code Text) Bool { unsafe { tn_py_exec(text_cstr_ptr(code)) != 0 } }
pub fn py_eval(expr Text) PyObj { PyObj { handle = unsafe { tn_py_eval(text_cstr_ptr(expr)) } } }
pub fn py_none() PyObj { PyObj { handle = unsafe { tn_py_none() } } }
pub fn py_int(v Int) PyObj { PyObj { handle = unsafe { tn_py_int(v) } } }
pub fn py_float(v Float) PyObj { PyObj { handle = unsafe { tn_py_float(v) } } }
pub fn py_bool(v Bool) PyObj { PyObj { handle = unsafe { tn_py_bool(if v { 1 } else { 0 }) } } }
pub fn py_str(s Text) PyObj { PyObj { handle = unsafe { tn_py_str(text_cstr_ptr(s), len(s)) } } }
pub fn py_list_new() PyObj { PyObj { handle = unsafe { tn_py_list_new() } } }
pub fn py_dict_new() PyObj { PyObj { handle = unsafe { tn_py_dict_new() } } }

pub fn py_memoryview_from_f32_list(xs List[Float32], writable Bool) PyObj {
    PyObj { handle = unsafe { tn_py_memoryview_from_ptr(list_data_ptr(xs), len(xs) * 4, if writable { 1 } else { 0 }) } }
}

pub fn py_subclass(base PyObj, class_name Text) PyObj {
    PyObj { handle = unsafe { tn_py_subclass_new(base.handle, text_cstr_ptr(class_name)) } }
}

pub fn py_set_global(name Text, obj PyObj) Bool {
    unsafe { tn_py_set_global(text_cstr_ptr(name), obj.handle) != 0 }
}

impl PyObj {
    pub fn is_valid(self) Bool { self.handle != 0 }
    pub fn drop(self) { unsafe { tn_py_decref(self.handle) } }
    pub fn to_int(self) Int { unsafe { tn_py_to_int(self.handle) } }
    pub fn to_float(self) Float { unsafe { tn_py_to_float(self.handle) } }
    pub fn to_text(self) Text { unsafe { tn_py_to_text(self.handle) } }
    pub fn py_len(self) Int { unsafe { tn_py_len(self.handle) } }

    pub fn attr(self, name Text) PyObj {
        PyObj { handle = unsafe { tn_py_getattr(self.handle, text_cstr_ptr(name)) } }
    }
    pub fn set_attr(self, name Text, val PyObj) Bool {
        unsafe { tn_py_setattr(self.handle, text_cstr_ptr(name), val.handle) != 0 }
    }
    pub fn get_item(self, key PyObj) PyObj {
        PyObj { handle = unsafe { tn_py_getitem(self.handle, key.handle) } }
    }
    pub fn set_item(self, key PyObj, val PyObj) Bool {
        unsafe { tn_py_setitem(self.handle, key.handle, val.handle) != 0 }
    }
    pub fn append(self, item PyObj) Bool {
        unsafe { tn_py_list_append(self.handle, item.handle) != 0 }
    }

    pub fn call0(self) PyObj { PyObj { handle = unsafe { tn_py_call0(self.handle) } } }
    pub fn call1(self, a0 PyObj) PyObj { PyObj { handle = unsafe { tn_py_call1(self.handle, a0.handle) } } }
    pub fn call2(self, a0 PyObj, a1 PyObj) PyObj { PyObj { handle = unsafe { tn_py_call2(self.handle, a0.handle, a1.handle) } } }
    pub fn call3(self, a0 PyObj, a1 PyObj, a2 PyObj) PyObj { PyObj { handle = unsafe { tn_py_call3(self.handle, a0.handle, a1.handle, a2.handle) } } }

    pub fn method0(self, name Text) PyObj {
        let m = self.attr(name)
        let r = m.call0()
        m.drop()
        r
    }
    pub fn method1(self, name Text, a0 PyObj) PyObj {
        let m = self.attr(name)
        let r = m.call1(a0)
        m.drop()
        r
    }
    pub fn method2(self, name Text, a0 PyObj, a1 PyObj) PyObj {
        let m = self.attr(name)
        let r = m.call2(a0, a1)
        m.drop()
        r
    }
    pub fn attach_native_method(self, name Text, fn_addr Int, arity Int) Bool {
        unsafe { tn_py_attach_native_method(self.handle, text_cstr_ptr(name), fn_addr, arity) != 0 }
    }
    pub fn attach_exported_method(self, name Text, export_sym Text, arity Int) Bool {
        unsafe { tn_py_attach_exported_method(self.handle, text_cstr_ptr(name), text_cstr_ptr(export_sym), arity) != 0 }
    }
    pub fn attach_exported_float_method(self, name Text, export_sym Text, arity Int) Bool {
        unsafe { tn_py_attach_exported_float_method(self.handle, text_cstr_ptr(name), text_cstr_ptr(export_sym), arity) != 0 }
    }
    pub fn is_instance(self, cls PyObj) Bool {
        unsafe { tn_py_isinstance(self.handle, cls.handle) != 0 }
    }
}
