// Tenon Standard Library — Layer 3: std/os/env.tn
// Typed OS environment & `.env` lookup (`Env.get`, `Env.cwd`, `Env.get_or_dotenv`).

import "std/text/text.tn"
import "std/encoding/dotenv.tn"
import "std/os/fs.tn"

pub record Env {
    scope Int
}

impl Env {
    pub fn get(key Text) Option[Text] {
        let v = sys_env(key)
        if v.is_empty() {
            return None
        }
        Some(v)
    }

    pub fn cwd() Text {
        sys_cwd()
    }

    pub fn from_dotenv_file(path Text, key Text) Option[Text] {
        match OsFs.read(path) {
            Err(_) => None
            Ok(content) => Dotenv.lookup(content, key)
        }
    }

    pub fn get_or_dotenv(key Text) Option[Text] {
        match Env.get(key) {
            Some(v) => { return Some(v) }
            None => {}
        }
        match Env.get("TENON_ENV_FILE") {
            Some(custom) => match Env.from_dotenv_file(custom, key) {
                Some(v0) => { return Some(v0) }
                None => {}
            }
            None => {}
        }
        match Env.from_dotenv_file(".env", key) {
            Some(v1) => { return Some(v1) }
            None => {}
        }
        match Env.from_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.env", key) {
            Some(v2) => { return Some(v2) }
            None => {}
        }
        Env.from_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.data/secrets/local.env", key)
    }
}
