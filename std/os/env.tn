// Tenon Standard Library — Layer 3: std/os/env.tn
// Typed OS environment & `.env` lookup returning `Option[Text]`.

import "std/encoding/dotenv.tn"
import "std/os/fs.tn"

pub fn env_get(key Text) Option[Text] {
    let v = sys_env(key)
    if len(v) == 0 {
        return None
    }
    Some(v)
}

pub fn env_cwd() Text {
    sys_cwd()
}

pub fn env_from_dotenv_file(path Text, key Text) Option[Text] {
    match fs_read(path) {
        Err(_) => None
        Ok(content) => dotenv_lookup(content, key)
    }
}

pub fn env_or_dotenv(key Text) Option[Text] {
    match env_get(key) {
        Some(v) => { return Some(v) }
        None => {}
    }
    match env_get("TENON_ENV_FILE") {
        Some(custom) => match env_from_dotenv_file(custom, key) {
            Some(v0) => { return Some(v0) }
            None => {}
        }
        None => {}
    }
    match env_from_dotenv_file(".env", key) {
        Some(v1) => { return Some(v1) }
        None => {}
    }
    match env_from_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.env", key) {
        Some(v2) => { return Some(v2) }
        None => {}
    }
    env_from_dotenv_file("/Users/lijie/source/dast.ai/dast-os/.data/secrets/local.env", key)
}
