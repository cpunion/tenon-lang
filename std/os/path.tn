// Tenon Standard Library — Layer 3: std/os/path.tn
// Refined `SafeRelPath` domain type (`SafeRelPath.parse`) & OOP `Path` utilities.

import "std/core/types.tn"
import "std/text/text.tn"

pub pure fn is_safe_rel_path(path Text) Bool {
    if path.is_empty() {
        return false
    }
    if path.starts_with("/") {
        return false
    }
    if path.contains("..") {
        return false
    }
    true
}

pub type SafeRelPath = Text where is_safe_rel_path(self)

impl SafeRelPath {
    pub pure fn is_valid(raw Text) Bool {
        is_safe_rel_path(raw)
    }

    pub pure fn parse(raw Text) Result[SafeRelPath, Text] {
        if !is_safe_rel_path(raw) {
            return Err("unsafe or empty relative path `" ++ raw ++ "`")
        }
        Ok(raw)
    }
}

pub record Path {
    raw Text
}

impl Path {
    pub pure fn join(base Text, rel Text) Text {
        if rel.is_empty() || rel == "." {
            return base
        }
        if base.ends_with("/") {
            return base ++ rel
        }
        base ++ "/" ++ rel
    }

    pub pure fn shell_quote(s Text) Text {
        "'" ++ s.replace_all("'", "'\\''") ++ "'"
    }
}
