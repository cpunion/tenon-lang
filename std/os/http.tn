// Tenon Standard Library — Layer 3: std/os/http.tn
// Generic vendor-neutral HTTP/SSE streaming client (`HttpStream.open` / `next_line` / `close`).

import "std/core/types.tn"
import "std/text/text.tn"

pub record HttpStream {
    handle Int
}

impl HttpStream {
    pub fn open(method Text, url Text, headers Text, body Text) HttpStream {
        HttpStream {
            handle = sys_http_open(method, url, headers, body)
        }
    }

    pub fn next_line(self) Option[Text] {
        if sys_http_sse_eof(self.handle) {
            return None
        }
        let line = sys_http_sse_next_line(self.handle)
        if sys_http_sse_eof(self.handle) {
            return None
        }
        Some(line)
    }

    pub fn close(self) Result[Int, Text] {
        let err = sys_http_sse_error(self.handle)
        let _ = sys_http_sse_close(self.handle)
        if !err.is_empty() {
            return Err(err)
        }
        Ok(0)
    }
}
