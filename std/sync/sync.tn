// Tenon Standard Library — OS Multi-Threading, Explicit-Ordering Atomics, Mutex & Channel

pub const ORDER_RELAXED Int = 0
pub const ORDER_ACQUIRE Int = 1
pub const ORDER_RELEASE Int = 2
pub const ORDER_ACQ_REL Int = 3
pub const ORDER_SEQ_CST Int = 4

pub record Thread {
    handle Int
}

pub fn thread_start(f fn() Int) Thread {
    Thread { handle = thread_spawn(f) }
}

impl Thread {
    pub fn join(self) Int {
        thread_join(self.handle)
    }
}

pub fn sleep_ms(ms Int) {
    thread_sleep_ms(ms)
}

pub fn hw_concurrency() Int {
    thread_hw_concurrency()
}

impl AtomicInt {
    pub fn load(self, ord Int) Int {
        atomic_load(self, ord)
    }

    pub fn store(self, val Int, ord Int) {
        atomic_store(self, val, ord)
    }

    pub fn fetch_add(self, delta Int, ord Int) Int {
        atomic_fetch_add(self, delta, ord)
    }

    pub fn fetch_sub(self, delta Int, ord Int) Int {
        atomic_fetch_sub(self, delta, ord)
    }

    pub fn cas(self, expected Int, desired Int, ord Int) Bool {
        atomic_cas(self, expected, desired, ord)
    }

    pub fn swap(self, val Int, ord Int) Int {
        atomic_swap(self, val, ord)
    }
}

impl[T] Mutex[T] {
    pub fn lock(self) {
        mutex_lock(self)
    }

    pub fn unlock(self) {
        mutex_unlock(self)
    }

    pub fn get(self) T {
        mutex_get(self)
    }

    pub fn set(self, val T) {
        mutex_set(self, val)
    }
}

impl[T] Channel[T] {
    pub fn send(self, val T) Bool {
        chan_send(self, val)
    }

    pub fn recv(self) Option[T] {
        chan_recv(self)
    }

    pub fn try_recv(self) Option[T] {
        chan_try_recv(self)
    }

    pub fn close(self) {
        chan_close(self)
    }
}

// Structured Concurrency: TaskScope guarantees every spawned worker thread is joined
// deterministically before scope exit, with lock-free cooperative cancellation.
pub record TaskScope {
    handles List[Int]
    cancelled AtomicInt
}

pub fn task_scope_new() TaskScope {
    let hs List[Int] = []
    TaskScope { handles = hs, cancelled = atomic_new(0) }
}

impl TaskScope {
    pub fn spawn(inout self, f fn() Int) {
        let h = thread_spawn(f)
        self.handles = push(self.handles, h)
    }

    pub fn cancel(self) {
        atomic_store(self.cancelled, 1, ORDER_RELEASE)
    }

    pub fn is_cancelled(self) Bool {
        atomic_load(self.cancelled, ORDER_ACQUIRE) != 0
    }

    pub fn len(self) Int {
        len(self.handles)
    }

    pub fn join_all(inout self) List[Int] {
        var results List[Int] = []
        var i = 0
        let n = len(self.handles)
        while i < n {
            let rv = thread_join(self.handles[i])
            results = push(results, rv)
            i += 1
        }
        let empty List[Int] = []
        self.handles = empty
        results
    }
}
