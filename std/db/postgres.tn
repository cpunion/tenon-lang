// std/db/postgres.tn — Production Pure-Tenon PostgreSQL v3.0 Driver
// Features:
//   1. FIPS 180-4 SHA-256, RFC 2104 HMAC-SHA-256, PBKDF2-HMAC-SHA-256, Base64 encode/decode
//   2. RFC 5802 SCRAM-SHA-256 Authentication (`pg_scram_client_first`, `pg_scram_client_final`)
//   3. Wire Protocol v3.0 Simple + Extended Query (`Parse`, `Bind`, `Describe`, `Execute`, `Sync`)
//   4. Live TCP `PgClient` with parameterized SQL-injection-safe queries & `with_tx` transactions

import "std/text/text.tn"
import "std/text/builder.tn"

pub record PgFrame {
    tag      Int
    length   Int
    payload  Bytes
    consumed Int
}

pub record PgClient {
    fd    Int
    rxbuf Bytes
}

// =========================================================================
// 1. Pure Tenon Crypto Primitives (SHA-256, HMAC-SHA-256, PBKDF2, Base64)
// =========================================================================

pure fn u32m(x Int) Int {
    x & 4294967295
}

pure fn rotr32(x Int, n Int) Int {
    let v = u32m(x)
    u32m((v >> n) | (v << (32 - n)))
}

/// FIPS 180-4 SHA-256 over arbitrary `Bytes`, returning 32-byte digest.
pub pure fn sha256_bytes(raw Bytes) Bytes {
    let k List[Int] = [
        1116352408, 1899447441, 3049323471, 3921009573, 961987163, 1508970993, 2453635748, 2870763221,
        3624381080, 310598401, 607225278, 1426881987, 1925078388, 2162078206, 2614888103, 3248222580,
        3835390401, 4022224774, 264347078, 604807628, 770255983, 1249150122, 1555081692, 1996064986,
        2554220882, 2821834349, 2952996808, 3210313671, 3336571891, 3584528711, 113926993, 338241895,
        666307205, 773529912, 1294757372, 1396182291, 1695183700, 1986661051, 2177026350, 2456956037,
        2730485921, 2820302411, 3259730800, 3345764771, 3516065817, 3600352804, 4094571909, 275423344,
        430227734, 506948616, 659060556, 883997877, 958139571, 1322822218, 1537002063, 1747873779,
        1955562222, 2024104815, 2227730452, 2361852424, 2428436474, 2756734187, 3204031479, 3329325298
    ]
    let orig_len = bytes_len(raw)
    let bit_len = orig_len * 8
    var padded = bytes_new(orig_len + 72)
    var i = 0
    while i < orig_len {
        padded = bytes_push(padded, bytes_get(raw, i) as Int)
        i += 1
    }
    padded = bytes_push(padded, 128)
    while (bytes_len(padded) % 64) != 56 {
        padded = bytes_push(padded, 0)
    }
    var sh = 56
    while sh >= 0 {
        padded = bytes_push(padded, (bit_len >> sh) & 255)
        sh -= 8
    }

    var h0 = 1779033703
    var h1 = 3144134277
    var h2 = 1013904242
    var h3 = 2773480762
    var h4 = 1359893119
    var h5 = 2600822924
    var h6 = 528734635
    var h7 = 1541459225

    var w List[Int] = list_filled(64, 0)
    let total_len = bytes_len(padded)
    var off = 0
    while off < total_len {
        var t = 0
        while t < 16 {
            let b0 = bytes_get(padded, off + t * 4) as Int
            let b1 = bytes_get(padded, off + t * 4 + 1) as Int
            let b2 = bytes_get(padded, off + t * 4 + 2) as Int
            let b3 = bytes_get(padded, off + t * 4 + 3) as Int
            w[t] = u32m((b0 << 24) | (b1 << 16) | (b2 << 8) | b3)
            t += 1
        }
        while t < 64 {
            let s0 = rotr32(w[t - 15], 7) ^ rotr32(w[t - 15], 18) ^ (w[t - 15] >> 3)
            let s1 = rotr32(w[t - 2], 17) ^ rotr32(w[t - 2], 19) ^ (w[t - 2] >> 10)
            w[t] = u32m(w[t - 16] + s0 + w[t - 7] + s1)
            t += 1
        }

        var a = h0
        var b = h1
        var c = h2
        var d = h3
        var e = h4
        var f = h5
        var g = h6
        var hh = h7

        var r = 0
        while r < 64 {
            let big_s1 = rotr32(e, 6) ^ rotr32(e, 11) ^ rotr32(e, 25)
            let ch = (e & f) ^ (u32m(~e) & g)
            let t1 = u32m(hh + big_s1 + ch + k[r] + w[r])
            let big_s0 = rotr32(a, 2) ^ rotr32(a, 13) ^ rotr32(a, 22)
            let maj = (a & b) ^ (a & c) ^ (b & c)
            let t2 = u32m(big_s0 + maj)
            hh = g
            g = f
            f = e
            e = u32m(d + t1)
            d = c
            c = b
            b = a
            a = u32m(t1 + t2)
            r += 1
        }

        h0 = u32m(h0 + a)
        h1 = u32m(h1 + b)
        h2 = u32m(h2 + c)
        h3 = u32m(h3 + d)
        h4 = u32m(h4 + e)
        h5 = u32m(h5 + f)
        h6 = u32m(h6 + g)
        h7 = u32m(h7 + hh)
        off += 64
    }

    var out = bytes_new(32)
    let hs = [h0, h1, h2, h3, h4, h5, h6, h7]
    var hi = 0
    while hi < 8 {
        let word = hs[hi]
        out = bytes_push(out, (word >> 24) & 255)
        out = bytes_push(out, (word >> 16) & 255)
        out = bytes_push(out, (word >> 8) & 255)
        out = bytes_push(out, word & 255)
        hi += 1
    }
    out
}

pub pure fn bytes_to_hex(data Bytes) Text {
    let hex = "0123456789abcdef"
    let n = bytes_len(data)
    var tb = TextBuilder.new()
    var i = 0
    while i < n {
        let b = bytes_get(data, i) as Int
        tb.push_byte(byte_at(hex, (b >> 4) & 15) & 255)
        tb.push_byte(byte_at(hex, b & 15) & 255)
        i += 1
    }
    tb.finish()
}

pub pure fn sha256_hex(msg Text) Text {
    bytes_to_hex(sha256_bytes(text_to_bytes(msg)))
}

/// RFC 2104 HMAC-SHA-256 returning 32-byte `Bytes`.
pub pure fn hmac_sha256(key Bytes, msg Bytes) Bytes {
    let k0 = if bytes_len(key) > 64 { sha256_bytes(key) } else { key }
    let klen = bytes_len(k0)
    var ipad = bytes_new(64 + bytes_len(msg))
    var opad = bytes_new(96)
    var i = 0
    while i < 64 {
        let kb = if i < klen { bytes_get(k0, i) as Int } else { 0 }
        ipad = bytes_push(ipad, kb ^ 54)
        opad = bytes_push(opad, kb ^ 92)
        i += 1
    }
    var mi = 0
    while mi < bytes_len(msg) {
        ipad = bytes_push(ipad, bytes_get(msg, mi) as Int)
        mi += 1
    }
    let inner = sha256_bytes(ipad)
    var ii = 0
    while ii < 32 {
        opad = bytes_push(opad, bytes_get(inner, ii) as Int)
        ii += 1
    }
    sha256_bytes(opad)
}

/// PBKDF2-HMAC-SHA-256 (32-byte derived key, RFC 2898) used by SCRAM-SHA-256.
pub pure fn pbkdf2_hmac_sha256(password Text, salt Bytes, iterations Int) Bytes {
    let pwd_b = text_to_bytes(password)
    var salt_block = bytes_new(bytes_len(salt) + 4)
    var i = 0
    while i < bytes_len(salt) {
        salt_block = bytes_push(salt_block, bytes_get(salt, i) as Int)
        i += 1
    }
    salt_block = bytes_push(salt_block, 0)
    salt_block = bytes_push(salt_block, 0)
    salt_block = bytes_push(salt_block, 0)
    salt_block = bytes_push(salt_block, 1)

    var u = hmac_sha256(pwd_b, salt_block)
    var acc = bytes_new(32)
    var j = 0
    while j < 32 {
        acc = bytes_push(acc, bytes_get(u, j) as Int)
        j += 1
    }
    var iter = 1
    while iter < iterations {
        u = hmac_sha256(pwd_b, u)
        var k = 0
        while k < 32 {
            let cur = bytes_get(acc, k) as Int
            let nxt = bytes_get(u, k) as Int
            acc = bytes_set(acc, k, cur ^ nxt)
            k += 1
        }
        iter += 1
    }
    acc
}

pub pure fn pg_base64_encode(data Bytes) Text {
    let alpha = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789+/"
    let n = bytes_len(data)
    var tb = TextBuilder.new()
    var i = 0
    while i < n {
        let b0 = bytes_get(data, i) as Int
        let has1 = i + 1 < n
        let has2 = i + 2 < n
        let b1 = if has1 { bytes_get(data, i + 1) as Int } else { 0 }
        let b2 = if has2 { bytes_get(data, i + 2) as Int } else { 0 }
        let t = (b0 << 16) | (b1 << 8) | b2
        tb.push_byte(byte_at(alpha, (t >> 18) & 63) & 255)
        tb.push_byte(byte_at(alpha, (t >> 12) & 63) & 255)
        if has1 { tb.push_byte(byte_at(alpha, (t >> 6) & 63) & 255) } else { tb.push_byte(61) }
        if has2 { tb.push_byte(byte_at(alpha, t & 63) & 255) } else { tb.push_byte(61) }
        i += 3
    }
    tb.finish()
}

pure fn b64_val(c Int) Int {
    if c >= 65 && c <= 90 { c - 65 }
    else if c >= 97 && c <= 122 { c - 71 }
    else if c >= 48 && c <= 57 { c + 4 }
    else if c == 43 { 62 }
    else if c == 47 { 63 }
    else { -1 }
}

pub pure fn pg_base64_decode(s Text) Bytes {
    let n = len(s)
    var out = bytes_new((n * 3) / 4 + 4)
    var buf = 0
    var bits = 0
    var i = 0
    while i < n {
        let c = byte_at(s, i)
        if c == 61 {
            break
        }
        let v = b64_val(c)
        if v >= 0 {
            buf = (buf << 6) | v
            bits += 6
            if bits >= 8 {
                bits -= 8
                out = bytes_push(out, (buf >> bits) & 255)
            }
        }
        i += 1
    }
    out
}

// =========================================================================
// 2. RFC 5802 SCRAM-SHA-256 Client State Machine
// =========================================================================

pub pure fn pg_scram_client_first(user Text, client_nonce Text) Text {
    "n,,n=" ++ user ++ ",r=" ++ client_nonce
}

pure fn scram_find_attr(msg Text, key_byte Int) Text {
    let n = len(msg)
    var i = 0
    while i + 1 < n {
        let at_start = (i == 0 || byte_at(msg, i - 1) == 44)
        if at_start && byte_at(msg, i) == key_byte && byte_at(msg, i + 1) == 61 {
            var j = i + 2
            while j < n && byte_at(msg, j) != 44 {
                j += 1
            }
            return str_slice(msg, i + 2, j)
        }
        i += 1
    }
    ""
}

pure fn parse_pos_int(s Text) Int {
    var acc = 0
    var i = 0
    while i < len(s) {
        let b = byte_at(s, i)
        if b >= 48 && b <= 57 {
            acc = acc * 10 + (b - 48)
        }
        i += 1
    }
    acc
}

/// Computes SCRAM-SHA-256 `client-final-message` with cryptographic `ClientProof`.
pub pure fn pg_scram_client_final(password Text, client_first_bare Text, server_first Text) Result[Text, Text] {
    let r_nonce = scram_find_attr(server_first, 114) // 'r'
    let salt_b64 = scram_find_attr(server_first, 115) // 's'
    let iter_s = scram_find_attr(server_first, 105) // 'i'
    let iters = parse_pos_int(iter_s)
    if len(r_nonce) == 0 || len(salt_b64) == 0 || iters < 1 {
        return Err("invalid SCRAM server-first-message")
    }
    let salt = pg_base64_decode(salt_b64)
    let salted = pbkdf2_hmac_sha256(password, salt, iters)
    let client_key = hmac_sha256(salted, text_to_bytes("Client Key"))
    let stored_key = sha256_bytes(client_key)
    let cf_no_proof = "c=biws,r=" ++ r_nonce
    let auth_msg = client_first_bare ++ "," ++ server_first ++ "," ++ cf_no_proof
    let client_sig = hmac_sha256(stored_key, text_to_bytes(auth_msg))
    var proof = bytes_new(32)
    var k = 0
    while k < 32 {
        let a = bytes_get(client_key, k) as Int
        let b = bytes_get(client_sig, k) as Int
        proof = bytes_push(proof, a ^ b)
        k += 1
    }
    Ok(cf_no_proof ++ ",p=" ++ pg_base64_encode(proof))
}

// =========================================================================
// 3. PostgreSQL Wire Protocol v3.0 Codecs (Simple + Extended Query)
// =========================================================================

pure fn push_u16_be(buf Bytes, v Int) Bytes {
    var out = bytes_push(buf, (v >> 8) & 255)
    bytes_push(out, v & 255)
}

pure fn push_u32_be(buf Bytes, v Int) Bytes {
    var out = bytes_push(buf, (v >> 24) & 255)
    out = bytes_push(out, (v >> 16) & 255)
    out = bytes_push(out, (v >> 8) & 255)
    bytes_push(out, v & 255)
}

pure fn push_bytes_all(buf Bytes, src Bytes) Bytes {
    let n = bytes_len(src)
    var out = buf
    var i = 0
    while i < n {
        out = bytes_push(out, bytes_get(src, i) as Int)
        i += 1
    }
    out
}

pure fn push_cstr(buf Bytes, s Text) Bytes {
    let out = push_bytes_all(buf, text_to_bytes(s))
    bytes_push(out, 0)
}

pure fn wrap_tagged_frame(tag Int, body Bytes) Bytes {
    let msg_len = bytes_len(body) + 4
    var out = bytes_new(msg_len + 1)
    out = bytes_push(out, tag)
    out = push_u32_be(out, msg_len)
    push_bytes_all(out, body)
}

pub pure fn pg_encode_startup(user Text, database Text) Bytes {
    var body = bytes_new(64)
    body = push_u32_be(body, 196608)
    body = push_cstr(body, "user")
    body = push_cstr(body, user)
    body = push_cstr(body, "database")
    body = push_cstr(body, database)
    body = bytes_push(body, 0)
    let total = bytes_len(body) + 4
    var msg = bytes_new(total)
    msg = push_u32_be(msg, total)
    push_bytes_all(msg, body)
}

pub pure fn pg_encode_query(sql Text) Bytes {
    wrap_tagged_frame(81, push_cstr(bytes_new(len(sql) + 1), sql))
}

pub pure fn pg_encode_password(pwd Text) Bytes {
    wrap_tagged_frame(112, push_cstr(bytes_new(len(pwd) + 1), pwd))
}

pub pure fn pg_encode_sasl_initial(mech Text, initial_data Text) Bytes {
    var body = bytes_new(len(mech) + len(initial_data) + 8)
    body = push_cstr(body, mech)
    let db = text_to_bytes(initial_data)
    body = push_u32_be(body, bytes_len(db))
    body = push_bytes_all(body, db)
    wrap_tagged_frame(112, body)
}

pub pure fn pg_encode_sasl_response(data Text) Bytes {
    wrap_tagged_frame(112, text_to_bytes(data))
}

/// Extended Query `Parse` (`'P'` = 80): prepares parameterized SQL `$1, $2, ...`.
pub pure fn pg_encode_parse(stmt_name Text, sql Text) Bytes {
    var body = bytes_new(len(stmt_name) + len(sql) + 8)
    body = push_cstr(body, stmt_name)
    body = push_cstr(body, sql)
    body = push_u16_be(body, 0)
    wrap_tagged_frame(80, body)
}

/// Extended Query `Bind` (`'B'` = 66): safely binds text parameters (SQL-injection proof).
pub pure fn pg_encode_bind(portal Text, stmt_name Text, params List[Text]) Bytes {
    var body = bytes_new(64)
    body = push_cstr(body, portal)
    body = push_cstr(body, stmt_name)
    body = push_u16_be(body, 0) // default text format for all params
    body = push_u16_be(body, len(params))
    var i = 0
    while i < len(params) {
        let pb = text_to_bytes(params[i])
        body = push_u32_be(body, bytes_len(pb))
        body = push_bytes_all(body, pb)
        i += 1
    }
    body = push_u16_be(body, 0) // default text format for result columns
    wrap_tagged_frame(66, body)
}

/// Extended Query `Describe` portal (`'D'` = 68).
pub pure fn pg_encode_describe_portal(portal Text) Bytes {
    var body = bytes_new(len(portal) + 4)
    body = bytes_push(body, 80) // 'P'
    body = push_cstr(body, portal)
    wrap_tagged_frame(68, body)
}

/// Extended Query `Execute` (`'E'` = 69).
pub pure fn pg_encode_execute(portal Text, max_rows Int) Bytes {
    var body = bytes_new(len(portal) + 8)
    body = push_cstr(body, portal)
    body = push_u32_be(body, max_rows)
    wrap_tagged_frame(69, body)
}

/// Extended Query `Sync` (`'S'` = 83).
pub pure fn pg_encode_sync() Bytes {
    wrap_tagged_frame(83, bytes_new(0))
}

pub pure fn pg_encode_terminate() Bytes {
    wrap_tagged_frame(88, bytes_new(0))
}

pub pure fn pg_encode_ready_for_query(status_byte Int) Bytes {
    var b = bytes_new(1)
    b = bytes_push(b, status_byte)
    wrap_tagged_frame(90, b)
}

/// Encodes a PostgreSQL Backend `DataRow` (`'D'` = 68) frame from text columns.
pub pure fn pg_encode_data_row(cols List[Option[Text]]) Bytes {
    var body = bytes_new(64)
    body = push_u16_be(body, len(cols))
    var i = 0
    while i < len(cols) {
        match cols[i] {
            Some(v) => {
                let vb = text_to_bytes(v)
                body = push_u32_be(body, bytes_len(vb))
                body = push_bytes_all(body, vb)
            }
            None => {
                body = push_u32_be(body, 4294967295) // -1 = SQL NULL
            }
        }
        i += 1
    }
    wrap_tagged_frame(68, body)
}

/// Decodes one PostgreSQL wire frame starting at byte offset `start`.
pub pure fn pg_decode_frame(buf Bytes, start Int) Result[PgFrame, Text] {
    let blen = bytes_len(buf)
    if blen - start < 5 {
        return Err("incomplete postgres frame header")
    }
    let tag = bytes_get(buf, start) as Int
    let msg_len = bytes_read_u32_be(buf, start + 1) as Int
    if msg_len < 4 || blen - start < 1 + msg_len {
        return Err("incomplete postgres frame body")
    }
    let plen = msg_len - 4
    var payload = bytes_new(plen)
    var i = 0
    while i < plen {
        payload = bytes_push(payload, bytes_get(buf, start + 5 + i) as Int)
        i += 1
    }
    Ok(PgFrame {
        tag = tag
        length = msg_len
        payload = payload
        consumed = 1 + msg_len
    })
}

/// Decodes a backend `DataRow` (`'D'`) payload into `List[Option[Text]]`.
pub pure fn pg_decode_data_row(payload Bytes) List[Option[Text]] {
    let plen = bytes_len(payload)
    if plen < 2 {
        return []
    }
    let ncols = ((bytes_get(payload, 0) as Int) << 8) | (bytes_get(payload, 1) as Int)
    var out List[Option[Text]] = []
    var pos = 2
    var c = 0
    while c < ncols && pos + 4 <= plen {
        let clen_u = bytes_read_u32_be(payload, pos) as Int
        pos += 4
        if clen_u == 4294967295 || clen_u < 0 {
            out = push(out, None)
        } else if pos + clen_u <= plen {
            var cb = bytes_new(clen_u)
            var j = 0
            while j < clen_u {
                cb = bytes_push(cb, bytes_get(payload, pos + j) as Int)
                j += 1
            }
            out = push(out, Some(bytes_to_text(cb)))
            pos += clen_u
        }
        c += 1
    }
    out
}

// =========================================================================
// 4. Live TCP `PgClient` (SCRAM-SHA-256 Auth, Extended Query, Transactions)
// =========================================================================

fn pg_send_bytes(fd Int, data Bytes) Result[Int, Text] {
    let n = net_write(fd, data)
    if n < 0 { Err("postgres socket write failed") } else { Ok(n) }
}

fn pg_slice_from(buf Bytes, start Int) Bytes {
    let n = bytes_len(buf)
    if start >= n {
        return bytes_new(0)
    }
    var out = bytes_new(n - start)
    var i = start
    while i < n {
        out = bytes_push(out, bytes_get(buf, i) as Int)
        i += 1
    }
    out
}

fn pg_read_next_frame(inout cli PgClient) Result[PgFrame, Text] {
    while true {
        match pg_decode_frame(cli.rxbuf, 0) {
            Ok(f) => {
                cli.rxbuf = pg_slice_from(cli.rxbuf, f.consumed)
                return Ok(f)
            }
            Err(_) => {
                let chunk = net_read(cli.fd, 8192)
                if bytes_len(chunk) == 0 {
                    return Err("postgres server closed connection")
                }
                cli.rxbuf = push_bytes_all(cli.rxbuf, chunk)
            }
        }
    }
    Err("unreachable")
}

/// Connects to a PostgreSQL v3.0 server over TCP and completes Startup + Auth (Ok / Cleartext / SCRAM-SHA-256).
pub fn pg_connect(host_port Text, user Text, password Text, database Text) Result[PgClient, Text] {
    let fd = net_tcp_connect(host_port)
    if fd < 0 {
        return Err("failed to connect to postgres at " ++ host_port)
    }
    let _ = net_set_nodelay(fd, true)
    var cli = PgClient { fd = fd, rxbuf = bytes_new(0) }
    let startup = pg_encode_startup(user, database)
    match pg_send_bytes(cli.fd, startup) {
        Ok(_) => {}
        Err(e) => {
            let _ = net_close(cli.fd)
            return Err(e)
        }
    }
    let nonce = "tenon_scram_nonce_2026"
    let cf_bare = "n=" ++ user ++ ",r=" ++ nonce
    while true {
        let frame = match pg_read_next_frame(cli) {
            Ok(f) => f
            Err(e) => {
                let _ = net_close(cli.fd)
                return Err(e)
            }
        }
        if frame.tag == 82 { // 'R' Authentication
            let auth_code = if bytes_len(frame.payload) >= 4 {
                bytes_read_u32_be(frame.payload, 0) as Int
            } else { -1 }
            if auth_code == 0 {
                // AuthenticationOk
            } else if auth_code == 3 {
                // CleartextPassword
                let _ = pg_send_bytes(cli.fd, pg_encode_password(password))
            } else if auth_code == 10 {
                // AuthenticationSASL (SCRAM-SHA-256)
                let cf = pg_scram_client_first(user, nonce)
                let _ = pg_send_bytes(cli.fd, pg_encode_sasl_initial("SCRAM-SHA-256", cf))
            } else if auth_code == 11 {
                // AuthenticationSASLContinue (server-first)
                let sf = bytes_to_text(pg_slice_from(frame.payload, 4))
                let cf_final = match pg_scram_client_final(password, cf_bare, sf) {
                    Ok(m) => m
                    Err(e) => {
                        let _ = net_close(cli.fd)
                        return Err(e)
                    }
                }
                let _ = pg_send_bytes(cli.fd, pg_encode_sasl_response(cf_final))
            } else if auth_code == 12 {
                // AuthenticationSASLFinal
            }
        } else if frame.tag == 90 { // 'Z' ReadyForQuery
            return Ok(cli)
        } else if frame.tag == 69 { // 'E' ErrorResponse
            let _ = net_close(cli.fd)
            return Err("postgres authentication error: " ++ bytes_to_text(frame.payload))
        }
    }
    Err("unreachable")
}

impl PgClient {
    fn drain_until_ready(inout self) Result[List[List[Option[Text]]], Text] {
        var rows List[List[Option[Text]]] = []
        while true {
            let f = pg_read_next_frame(self)?
            if f.tag == 68 { // 'D' DataRow
                rows = push(rows, pg_decode_data_row(f.payload))
            } else if f.tag == 90 { // 'Z' ReadyForQuery
                return Ok(rows)
            } else if f.tag == 69 { // 'E' ErrorResponse
                return Err("postgres query error: " ++ bytes_to_text(f.payload))
            }
        }
        Ok(rows)
    }

    /// Executes a simple query (`'Q'`) and returns decoded rows.
    pub fn query(inout self, sql Text) Result[List[List[Option[Text]]], Text] {
        let _ = pg_send_bytes(self.fd, pg_encode_query(sql))?
        self.drain_until_ready()
    }

    /// Executes a parameterized Extended Query (`Parse` + `Bind` + `Execute` + `Sync`).
    pub fn query_params(inout self, sql Text, params List[Text]) Result[List[List[Option[Text]]], Text] {
        var batch = bytes_new(128)
        batch = push_bytes_all(batch, pg_encode_parse("", sql))
        batch = push_bytes_all(batch, pg_encode_bind("", "", params))
        batch = push_bytes_all(batch, pg_encode_execute("", 0))
        batch = push_bytes_all(batch, pg_encode_sync())
        let _ = pg_send_bytes(self.fd, batch)?
        self.drain_until_ready()
    }

    pub fn begin(inout self) Result[Bool, Text] {
        let _ = self.query("BEGIN")?
        Ok(true)
    }

    pub fn commit(inout self) Result[Bool, Text] {
        let _ = self.query("COMMIT")?
        Ok(true)
    }

    pub fn rollback(inout self) Result[Bool, Text] {
        let _ = self.query("ROLLBACK")?
        Ok(true)
    }

    pub fn close(self) {
        let _ = net_write(self.fd, pg_encode_terminate())
        let _ = net_close(self.fd)
    }
}
