        n_heads Int, n_kv Int, d_head Int, pos Int, max_seq Int, softcap Float,
    ) Int
    fn tn_ultra_argmax_f16(logits_h Int, out_tok_h Int, n_elems Int) Int
    fn tn_ultra_argmax_step_f16(logits_h Int, cur_tok_h Int, hist_tok_h Int, step_idx Int, n_elems Int) Int
    fn tn_ultra_read_u32_0(buf_h Int) Int
    fn tn_ultra_read_u32_at(buf_h Int, idx Int) Int
