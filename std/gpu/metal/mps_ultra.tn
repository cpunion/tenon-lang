pub fn ultra_init() Bool {
    unsafe { tn_ultra_init() != 0 }
}

/// Uploads a flat `List[Float16]` into a `@linear GpuBuffer` quantized as FP16 (0), Q8_0 (1), or Q4_0 (2)!
pub fn ultra_upload_weights(xs List[Float16], quant_mode Int) GpuBuffer {
    let n = len(xs)
    if quant_mode == QUANT_Q4_0 {
        let h = unsafe { tn_ultra_quantize_q4_0_buf(list_data_ptr(xs), n) }
        return GpuBuffer { handle = h, byte_len = (n / 32) * 18 }
    }
    if quant_mode == QUANT_Q8_0 {
        let h = unsafe { tn_ultra_quantize_q8_0_buf(list_data_ptr(xs), n) }
        return GpuBuffer { handle = h, byte_len = (n / 32) * 34 }
    }
    GpuBuffer.from_f16_list(xs)
}

pub pure fn ultra_weight_stride_bytes(n_elems Int, quant_mode Int) Int {
    if quant_mode == QUANT_Q4_0 { return (n_elems / 32) * 18 }
    if quant_mode == QUANT_Q8_0 { return (n_elems / 32) * 34 }
    n_elems * 2
}

pub fn ultra_embed(tok_h Int, emb_h Int, out_h Int, seq_len Int, d_model Int, vocab Int) Bool {
    unsafe { tn_ultra_embed(tok_h, emb_h, out_h, seq_len, d_model, vocab) != 0 }
}

pub fn ultra_embed_off(tok_h Int, emb_h Int, emb_off Int, out_h Int, seq_len Int, d_model Int, vocab Int) Bool {
    unsafe { tn_ultra_embed_off(tok_h, emb_h, emb_off, out_h, seq_len, d_model, vocab) != 0 }
}

pub fn ultra_write_gguf_v3(
    path Text, arch Int, qm Int,
    vocab Int, d_model Int, n_layers Int,
    n_heads Int, n_kv Int, d_head Int, d_ff Int,
    max_seq Int, n_experts Int,
) Int {
    unsafe {
        tn_ultra_write_gguf_v3(
            text_cstr_ptr(path), arch, qm,
            vocab, d_model, n_layers, n_heads, n_kv, d_head, d_ff,
            max_seq, n_experts, null_ptr(),
        )
    }
}

pub fn ultra_export_gguf_v3_from_handles(
    path Text, arch Int, qm Int,
    vocab Int, d_model Int, n_layers Int,
    n_heads Int, n_kv Int, d_head Int, d_ff Int,
    max_seq Int, n_experts Int, handles List[Int],
) Int {
    unsafe {
        tn_ultra_write_gguf_v3(
            text_cstr_ptr(path), arch, qm,
            vocab, d_model, n_layers, n_heads, n_kv, d_head, d_ff,
            max_seq, n_experts, list_data_ptr(handles),
        )
    }
}

pub fn ultra_mmap_gguf_v3(path Text) List[Int] {
    var meta List[Int] = list_filled(25, 0)
    let _ = unsafe { tn_ultra_mmap_gguf_file(text_cstr_ptr(path), list_data_ptr(meta)) }
    meta
}

