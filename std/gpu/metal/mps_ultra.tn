// std/gpu/metal/mps_ultra.tn — Tenon Ultra-Fused Quantized (Q4_0 / Q8_0 / FP16) + Apple MPS Engine
//
// Exposes GGUF/MLX-compatible Q4_0 (4-bit) & Q8_0 (8-bit) quantization, 16-lane half-SIMD GEMV,
// Fused Gate+Up+SwiGLU/GeGLU, Single-Pass FlashDecoding GQA Attention, Gemma-2 Softcap, and
// 100% GPU-resident Mixtral/DeepSeek Sparse MoE Top-2 Routing — all inside ONE `@linear MpsBatch`!

import "std/core/types.tn"
import "std/gpu/metal/gpu.tn"
import "std/gpu/metal/mps.tn"

pub const QUANT_FP16 Int = 0
pub const QUANT_Q8_0 Int = 1
pub const QUANT_Q4_0 Int = 2

@c_src("mps_ultra_shim.m")
extern "C" {
    fn tn_ultra_init() Int
    fn tn_ultra_quantize_q4_0_buf(f16_ptr Ptr[UInt8], n_elems Int) Int
