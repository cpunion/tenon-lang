pub pure fn tg_scale[DType](x Tensor2D[DType], factor Float) Tensor2D[DType]
    requires len(x.data) == x.rows * x.cols
    ensures result.rows == x.rows && result.cols == x.cols && len(result.data) == x.rows * x.cols
{
    let _ = factor
    Tensor2D { rows = x.rows, cols = x.cols, data = x.data }
}

pub pure fn tg_layernorm[DType](x Tensor2D[DType], nw Tensor2D[DType]) Tensor2D[DType]
    requires nw.rows == 1 && nw.cols == x.cols && len(x.data) == x.rows * x.cols
    ensures result.rows == x.rows && result.cols == x.cols && len(result.data) == x.rows * x.cols
{
    Tensor2D { rows = x.rows, cols = x.cols, data = x.data }
