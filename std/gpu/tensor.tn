// std/gpu/tensor.tn — Dependent-Shape Tensor Primitives, Optional DType & Variadic Shape Packs
//
// Supports:
//   - Optional & keyword-named element DType:
//       `Matrix[4, 8]`                   (defaults to Float32)
//       `Matrix[4, 8, Float16]`          (positional IEEE-754 half precision, 2B/elem)
//       `Matrix[4, 8, DType = Float16]`  (keyword-named DType)
//       `Matrix[4, 8, DType = BFloat16]` (keyword-named brain-float16, 2B/elem)
//   - Variadic N-dimensional compile-time shape packs:
//       `Tensor[4]`
//       `Tensor[4, 8]`
//       `Tensor[2, 16, 64, DType = Float16]`
//       `Tensor[1, 1, 2, 3, 4]`          (rank = 5, numel = 1*1*2*3*4 = 24 proved at compile time!)
//       `Shape[1, 1, 2, 3, 4]`
//
// All shape dimensions, backing lengths (`len(data) == R * C` / `prod(Shape)`), and element DTypes
// are verified at compile time via L0/Z3 contracts before execution.

import "std/core/types.tn"

/// Quantized & low-precision dependent element DType markers for declarative `@gpu_graph` tensors.
/// The compiler automatically lowers these to hardware-optimal packed layouts per target:
///   - NVIDIA CUDA (`sm_89+`): 128-bit aligned superblocks (`Q4_0_SB8` / `Q8_0_SB8`) or `e4m3fn` FP8 Tensor Cores
///   - Apple Silicon Metal: 128-bit aligned `Q4_0_SB8` / `Q8_0_SB8` + `simdgroup_half8x8` batch MMA
///   - Google Cloud TPU: native hardware sub-byte `tensor<...xi4>` (`PJRT_Buffer_Type_S4`) + 394 TOPS INT8 MXU (`W4A8`)
pub type Int4  = Int8
pub type FP8   = UInt8
pub type Q4_0  = UInt8
pub type Q8_0  = UInt8
pub type Q4_K  = UInt8
pub type Q5_K  = UInt8
pub type Q6_K  = UInt8
/// OCP Microscaling FP4 (32 E2M1 4-bit elements + 1 shared E8M0 exponent = 17 B / 32 weights = 0.531 B/wt).
pub type MXFP4 = UInt8

@gpu_struct("std430")
pub record MatMulParams {
    m UInt32
    n UInt32
    k UInt32
    _pad UInt32
}

/// 2D dense tensor parameterized by optional element `DType` (defaults to `Float32`).
/// Backwards-compatible: bare `Tensor2D` resolves directly to `Tensor2D[Float32]`.
pub record Tensor2D[DType = Float32] {
    rows Positive
    cols Positive
    data List[DType]
}

/// Const-Generic Dependent-Shape Matrix Type Alias (`Matrix[R, C]` / `Matrix[R, C, DType = Float16]`):
/// Encodes exact row/column dimensions, backing length, and element DType right in the type signature!
pub type Matrix[R Int, C Int, DType = Float32] =
    Tensor2D[DType] where self.rows == R && self.cols == C && len(self.data) == R * C

/// General N-dimensional dense tensor parameterized by optional element `DType` (defaults to `Float32`).
pub record NdTensor[DType = Float32] {
    shape List[Positive]
    data  List[DType]
}

/// Variadic Dependent-Shape Tensor (`Tensor[4]`, `Tensor[4, 8]`, `Tensor[1, 1, 2, 3, 4, DType = Float16]`):
/// Statically verifies rank (`len(self.shape) == len(Shape)`), exact element count
/// (`len(self.data) == prod(Shape)`), and element `DType` at compile time!
pub type Tensor[...Shape Int, DType = Float32] =
    NdTensor[DType] where len(self.shape) == len(Shape) && len(self.data) == prod(Shape)

/// Variadic Dependent-Rank Shape descriptor (`Shape[4]`, `Shape[1, 1, 2, 3, 4]`).
pub type Shape[...Dims Int] = List[Positive] where len(self) == len(Dims)

/// 3D Batched Matrix / Sequence Tensor (`[B, M, N]`, optional `DType = Float32`).
pub type Tensor3D[B Int, M Int, N Int, DType = Float32] =
    NdTensor[DType] where len(self.shape) == 3 && len(self.data) == B * M * N

/// 4D Multi-Head Attention Tensor (`[B, Heads, Seq, HeadDim]`, optional `DType = Float32`).
pub type Tensor4D[B Int, H Int, S Int, D Int, DType = Float32] =
    NdTensor[DType] where len(self.shape) == 4 && len(self.data) == B * H * S * D

/// Compile-time verified 2D Matrix transpose (`[R, C]` -> `[C, R]`, preserves element count `R * C`).
pub pure fn nd_transpose_2d[DType](
    t NdTensor[DType],
    rows Int where 1 <= self && self <= 4096,
    cols Int where 1 <= self && self <= 4096,
) NdTensor[DType]
    requires len(t.shape) == 2 && len(t.data) == rows * cols
    ensures len(result.shape) == 2 && len(result.data) == cols * rows
{
    let total = rows * cols
    var out List[DType] = list_filled(total, t.data[0])
    var r = 0
    while r < rows invariant len(out) == total {
        var c = 0
        while c < cols invariant len(out) == total {
            out[c * rows + r] = t.data[r * cols + c]
            c += 1
        }
        r += 1
    }
    let out_shape List[Positive] = [cols, rows]
    NdTensor { shape = out_shape, data = out }
}

/// Compile-time verified Batched Matrix Multiplication:
/// `A: Tensor3D[B, M, K]`, `B: Tensor3D[B, K, N]` -> `Tensor3D[B, M, N]` (proves `len(result.data) == b * m * n`!).
pub pure fn nd_batch_matmul(
    a NdTensor[Float32],
    b NdTensor[Float32],
    batch Int where 1 <= self && self <= 256,
    m Int where 1 <= self && self <= 1024,
    k Int where 1 <= self && self <= 1024,
    n Int where 1 <= self && self <= 1024,
) NdTensor[Float32]
    requires len(a.shape) == 3 && len(b.shape) == 3
    requires len(a.data) == batch * m * k && len(b.data) == batch * k * n
    ensures len(result.shape) == 3 && len(result.data) == batch * m * n
{
    let total = batch * m * n
    let zero Float32 = 0.0 as Float32
    var out List[Float32] = list_filled(total, zero)
    var bi = 0
    while bi < batch invariant len(out) == total {
        let a_off = bi * m * k
        let b_off = bi * k * n
        let o_off = bi * m * n
        var i = 0
        while i < m invariant len(out) == total {
            var j = 0
            while j < n invariant len(out) == total {
                var acc Float32 = zero
                var p = 0
                while p < k {
                    acc = acc + a.data[a_off + i * k + p] * b.data[b_off + p * n + j]
                    p += 1
                }
                out[o_off + i * n + j] = acc
                j += 1
            }
            i += 1
        }
        bi += 1
    }
    let out_shape List[Positive] = [batch, m, n]
    NdTensor { shape = out_shape, data = out }
}

/// Compile-time verified Last-Axis Broadcast Add (`Tensor[...Leading, D] + Tensor[D] -> Tensor[...Leading, D]`).
pub pure fn nd_broadcast_add_last(
    x NdTensor[Float32],
    bias NdTensor[Float32],
    leading Int where 1 <= self && self <= 65536,
    dim Int where 1 <= self && self <= 8192,
) NdTensor[Float32]
    requires len(x.data) == leading * dim && len(bias.data) == dim
    ensures len(result.shape) == len(x.shape) && len(result.data) == leading * dim
{
    let total = leading * dim
    let zero Float32 = 0.0 as Float32
    var out List[Float32] = list_filled(total, zero)
    var row = 0
    while row < leading invariant len(out) == total {
        let base = row * dim
        var d = 0
        while d < dim invariant len(out) == total {
            out[base + d] = x.data[base + d] + bias.data[d]
            d += 1
        }
        row += 1
    }
    NdTensor { shape = x.shape, data = out }
}

pub pure fn tensor2d_zeros(
    r Int where 1 <= self && self <= 4096,
    c Int where 1 <= self && self <= 4096,
) Tensor2D
    ensures result.rows == r && result.cols == c && len(result.data) == r * c
{
    let n = r * c
    let zero Float32 = 0.0 as Float32
    let data List[Float32] = list_filled(n, zero)
    Tensor2D { rows = r, cols = c, data = data }
}

pub pure fn tensor2d_from_data(
    r Int where 1 <= self && self <= 4096,
    c Int where 1 <= self && self <= 4096,
    data List[Float32],
) Tensor2D
    requires len(data) == r * c
    ensures result.rows == r && result.cols == c && len(result.data) == r * c
{
    Tensor2D { rows = r, cols = c, data = data }
}

/// Polymorphic 2D tensor constructor for any element DType (`Float16`, `BFloat16`, `Float32`, `Float64`).
pub pure fn tensor2d_of[DType](
    r Int where 1 <= self && self <= 4096,
    c Int where 1 <= self && self <= 4096,
    data List[DType],
) Tensor2D[DType]
    requires len(data) == r * c
    ensures result.rows == r && result.cols == c && len(result.data) == r * c
{
    Tensor2D { rows = r, cols = c, data = data }
}

pub pure fn tensor2d_zeros_f16(
    r Int where 1 <= self && self <= 4096,
    c Int where 1 <= self && self <= 4096,
) Tensor2D[DType = Float16]
    ensures result.rows == r && result.cols == c && len(result.data) == r * c
{
    let n = r * c
    let zero Float16 = 0.0 as Float16
    let data List[Float16] = list_filled(n, zero)
    Tensor2D { rows = r, cols = c, data = data }
}

pub pure fn tensor2d_zeros_bf16(
    r Int where 1 <= self && self <= 4096,
    c Int where 1 <= self && self <= 4096,
) Tensor2D[DType = BFloat16]
    ensures result.rows == r && result.cols == c && len(result.data) == r * c
{
    let n = r * c
    let zero BFloat16 = 0.0 as BFloat16
    let data List[BFloat16] = list_filled(n, zero)
    Tensor2D { rows = r, cols = c, data = data }
}

/// Converts a `Tensor2D[Float32]` to compact 2-byte `Tensor2D[Float16]` (half RAM/VRAM!).
pub pure fn tensor2d_to_f16(a Tensor2D) Tensor2D[DType = Float16]
    requires a.rows <= 4096 && a.cols <= 4096
    requires len(a.data) == a.rows * a.cols
    ensures result.rows == a.rows && result.cols == a.cols && len(result.data) == a.rows * a.cols
{
    let total = a.rows * a.cols
    let z Float16 = 0.0 as Float16
    var out List[Float16] = list_filled(total, z)
    var i = 0
    while i < total invariant len(out) == total {
        out[i] = a.data[i] as Float16
        i += 1
    }
    Tensor2D { rows = a.rows, cols = a.cols, data = out }
}

/// Upcasts a `Tensor2D[Float16]` back to `Tensor2D[Float32]`.
pub pure fn tensor2d_f16_to_f32(a Tensor2D[DType = Float16]) Tensor2D
    requires a.rows <= 4096 && a.cols <= 4096
    requires len(a.data) == a.rows * a.cols
    ensures result.rows == a.rows && result.cols == a.cols && len(result.data) == a.rows * a.cols
{
    let total = a.rows * a.cols
    let z Float32 = 0.0 as Float32
    var out List[Float32] = list_filled(total, z)
    var i = 0
    while i < total invariant len(out) == total {
        out[i] = a.data[i] as Float32
        i += 1
    }
    Tensor2D { rows = a.rows, cols = a.cols, data = out }
}

/// Verified N-dimensional tensor constructor preserving exact rank and element count.
pub pure fn nd_tensor_from_data[DType](
    shape List[Positive],
    data List[DType],
) NdTensor[DType]
    ensures len(result.shape) == len(shape) && len(result.data) == len(data)
{
    NdTensor { shape = shape, data = data }
}

/// Zero-initialized N-dimensional `Float32` tensor with verified rank & element count.
pub pure fn nd_tensor_zeros(
    shape List[Positive],
    total Int where 1 <= self && self <= 16777216,
) NdTensor
    ensures len(result.shape) == len(shape) && len(result.data) == total
{
    let z Float32 = 0.0 as Float32
    let data List[Float32] = list_filled(total, z)
    NdTensor { shape = shape, data = data }
}

/// Zero-initialized N-dimensional `Float16` tensor (2 bytes/elem) with verified rank & element count.
pub pure fn nd_tensor_zeros_f16(
    shape List[Positive],
    total Int where 1 <= self && self <= 16777216,
) NdTensor[DType = Float16]
    ensures len(result.shape) == len(shape) && len(result.data) == total
{
    let z Float16 = 0.0 as Float16
    let data List[Float16] = list_filled(total, z)
    NdTensor { shape = shape, data = data }
}

/// Zero-copy-friendly verified N-D reshape: preserves backing element count (`len(result.data) == len(t.data)`),
/// so `let r Tensor[6, 4] = nd_reshape(t, [6, 4])` proves `prod([1,1,2,3,4]) == prod([6,4])` (`24 == 24`)
/// at compile time and rejects `Tensor[5, 5]` (`24 != 25`) with a Z3 counterexample!
pub pure fn nd_reshape[DType](
    t NdTensor[DType],
    new_shape List[Positive],
) NdTensor[DType]
    ensures len(result.shape) == len(new_shape) && len(result.data) == len(t.data)
{
    NdTensor { shape = new_shape, data = t.data }
}

/// Verified Matrix Multiplication `C[M, N] = A[M, K] * B[K, N]`.
/// Statically enforces `a.cols == b.rows` and proves every 2D index access in bounds!
pub pure fn tensor2d_matmul(a Tensor2D, b Tensor2D) Tensor2D
    requires a.rows <= 4096 && a.cols <= 4096 && b.cols <= 4096
    requires a.cols == b.rows
    requires len(a.data) == a.rows * a.cols && len(b.data) == b.rows * b.cols
    ensures result.rows == a.rows && result.cols == b.cols && len(result.data) == a.rows * b.cols
{
    let total = a.rows * b.cols
    let m = a.rows
    let k = a.cols
    let n = b.cols
    let zero Float32 = 0.0 as Float32
    var out List[Float32] = list_filled(total, zero)
    var i = 0
    while i < m invariant len(out) == total {
        var j = 0
        while j < n invariant len(out) == total {
            var acc Float32 = zero
            var p = 0
            while p < k {
                let av = a.data[i * k + p]
                let bv = b.data[p * n + j]
                acc = acc + av * bv
                p += 1
            }
            out[i * n + j] = acc
            j += 1
        }
        i += 1
    }
    Tensor2D { rows = a.rows, cols = b.cols, data = out }
}

/// Verified elementwise fused `ReLU(A + B)` with exact shape equality proof.
pub pure fn tensor2d_add_relu(a Tensor2D, b Tensor2D) Tensor2D
    requires a.rows <= 4096 && a.cols <= 4096
    requires a.rows == b.rows && a.cols == b.cols
    requires len(a.data) == a.rows * a.cols && len(b.data) == b.rows * b.cols
    ensures result.rows == a.rows && result.cols == a.cols && len(result.data) == a.rows * a.cols
{
    let total = a.rows * a.cols
    let zero Float32 = 0.0 as Float32
    var out List[Float32] = list_filled(total, zero)
    var i = 0
    while i < total invariant len(out) == total {
        let s = a.data[i] + b.data[i]
        out[i] = if s > zero { s } else { zero }
        i += 1
    }
    Tensor2D { rows = a.rows, cols = a.cols, data = out }
}

// ===== Declarative Dependent-Typed Tensor Dataflow Graph Primitives (`@gpu_graph`) =====
// Pure shape-carrying ops verified by Z3 at compile time and lowered by Tenon's Tensor Dataflow
// Compiler (`tensor_graph.rs`) into auto-fused StableHLO (TPU), CUDA (NVIDIA), and Metal (Apple)
// with zero manual thread indices, zero manual SMEM, and automatic silicon-roofline scheduling!

pub pure fn tg_rmsnorm[DType](x Tensor2D[DType], nw Tensor2D[DType]) Tensor2D[DType]
    requires nw.rows == 1 && nw.cols == x.cols && len(x.data) == x.rows * x.cols
    ensures result.rows == x.rows && result.cols == x.cols && len(result.data) == x.rows * x.cols
{
    Tensor2D { rows = x.rows, cols = x.cols, data = x.data }
}

pub pure fn tg_matmul[DType](a Tensor2D[DType], b Tensor2D[DType]) Tensor2D[DType]
    requires a.cols == b.rows && len(a.data) == a.rows * a.cols && len(b.data) == b.rows * b.cols
    ensures result.rows == a.rows && result.cols == b.cols && len(result.data) == a.rows * b.cols
{
    let out List[DType] = list_filled(a.rows * b.cols, a.data[0])
    Tensor2D { rows = a.rows, cols = b.cols, data = out }
}

/// Mixed-precision quantized matrix multiply (`Act[M, K, Float16/BFloat16] @ Weight[K, N, Int4/Q4_0/Q8_0/FP8] -> Act[M, N]`).
/// Z3 statically proves inner contraction dimension equality (`a.cols == b.rows`); the `@gpu_graph` compiler
/// automatically selects hardware-optimal packed superblocks (`SB8 uint4`), native TPU `i4`/`W4A8`, or FP8 TC!
pub pure fn tg_qmatmul[ActDType, WeightDType](a Tensor2D[ActDType], b Tensor2D[WeightDType]) Tensor2D[ActDType]
    requires a.cols == b.rows && len(a.data) == a.rows * a.cols && len(b.data) == b.rows * b.cols
    ensures result.rows == a.rows && result.cols == b.cols && len(result.data) == a.rows * b.cols
{
    let out List[ActDType] = list_filled(a.rows * b.cols, a.data[0])
    Tensor2D { rows = a.rows, cols = b.cols, data = out }
}

/// Declarative Rotary Position Embedding (RoPE) shape-preserving transform inside `@gpu_graph`.
pub pure fn tg_rope[DType](x Tensor2D[DType]) Tensor2D[DType]
    requires len(x.data) == x.rows * x.cols
    ensures result.rows == x.rows && result.cols == x.cols && len(result.data) == x.rows * x.cols
{
    Tensor2D { rows = x.rows, cols = x.cols, data = x.data }
}

/// Declarative Grouped-Query Attention (GQA) inside `@gpu_graph`:
/// Z3 statically proves `q.rows == k.rows == v.rows`, `k.cols == v.cols`, and exact GQA head divisibility `q.cols % k.cols == 0`!
/// Lowered automatically to Register FlashDecoding (CUDA), 4-SG Split-K FlashDecoding (Metal), or VMEM GQA (TPU StableHLO)!
pub pure fn tg_gqa_attention[DType](q Tensor2D[DType], k Tensor2D[DType], v Tensor2D[DType]) Tensor2D[DType]
    requires q.rows == k.rows && k.rows == v.rows && k.cols == v.cols && q.cols % k.cols == 0
    requires len(q.data) == q.rows * q.cols
    ensures result.rows == q.rows && result.cols == q.cols && len(result.data) == q.rows * q.cols
{
    Tensor2D { rows = q.rows, cols = q.cols, data = q.data }
}

pub pure fn tg_swiglu[DType](gate Tensor2D[DType], up Tensor2D[DType]) Tensor2D[DType]
    requires gate.rows == up.rows && gate.cols == up.cols && len(gate.data) == gate.rows * gate.cols
    ensures result.rows == gate.rows && result.cols == gate.cols && len(result.data) == gate.rows * gate.cols
{
    Tensor2D { rows = gate.rows, cols = gate.cols, data = gate.data }
}

pub pure fn tg_add[DType](a Tensor2D[DType], b Tensor2D[DType]) Tensor2D[DType]
    requires a.rows == b.rows && a.cols == b.cols && len(a.data) == a.rows * a.cols
    ensures result.rows == a.rows && result.cols == a.cols && len(result.data) == a.rows * a.cols
{
    Tensor2D { rows = a.rows, cols = a.cols, data = a.data }
}

pub pure fn tg_mul[DType](a Tensor2D[DType], b Tensor2D[DType]) Tensor2D[DType]
    requires a.rows == b.rows && a.cols == b.cols && len(a.data) == a.rows * a.cols
    ensures result.rows == a.rows && result.cols == a.cols && len(result.data) == a.rows * a.cols
{
    Tensor2D { rows = a.rows, cols = a.cols, data = a.data }
}

pub pure fn tg_silu[DType](x Tensor2D[DType]) Tensor2D[DType]
    requires len(x.data) == x.rows * x.cols
    ensures result.rows == x.rows && result.cols == x.cols && len(result.data) == x.rows * x.cols
