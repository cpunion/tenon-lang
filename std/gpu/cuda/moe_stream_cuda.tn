// std/gpu/cuda/moe_stream_cuda.tn — Universal Hard-VRAM-Capped NVIDIA CUDA Multi-Shard Streaming Engine (`@linear`)
//
// Zero-Link-Flag Dynamic CUDA Driver (`dlopen("libcuda.so.1")` + `nvcc`/`nvrtc`) GGUF v3 Streaming Engine:
//   - Multi-Shard GGUF v3 (`-00001-of-0000N.gguf` auto-discovery) + All 8 GGML quant formats (F32/F16/Q4_0/Q4_1/Q8_0/Q4_K/Q5_K/Q6_K)
//   - Architectures: GLM-4.5-Air (`glm4moe`), Llama-3.3-70B (YaRN `rope_freqs`), OLMoE, Qwen3-MoE, Mixtral
//   - 3-Tier Memory Hierarchy: VRAM LRU Pool (1,008 GB/s GDDR6X) <-> Pinned Host Staging Ring (`cuMemHostAlloc`) <->
//     Host RAM `mmap` (`use_nocache=false`) OR Direct NVMe `pread`+`POSIX_FADV_DONTNEED` (`use_nocache=true`)
//   - Hardware Dual-Stream Overlap: `compute_stream` (SharedExp + VRAM Hits) || `dma_stream` (`cuMemcpyHtoDAsync` PCIe 4.0)
//     synchronized directly on GPU via `cuStreamWaitEvent` + Fused `MoE(L) + Attn/Router(L+1)` pipeline!
//   - Dense 70B Mode: Pins All-80-Layer Attention + Prefix FFNs in VRAM + 4-Slot Async PCIe DMA FFN Ring!

import "std/core/types.tn"

@c_src("moe_stream_cuda_shim.c")
extern "C" {
    fn tn_cumoe_init() Int
    fn tn_cumoe_device_name() Ptr[UInt8]
    fn tn_cumoe_vram_bytes() Int

    fn tn_cumoe_load_gguf(
        path_cstr Ptr[UInt8],
        cache_slots_per_layer Int,
        use_nocache Int,
        enable_overlap Int,
    ) Int

    /// Metadata fields (same schema as Metal `tn_moe_info`):
    ///   0=n_layers, 1=d_model, 2=d_ff, 3=n_heads, 4=n_kv, 5=n_experts, 6=top_k, 7=vocab,
    ///   8=core_vram_bytes, 9=cache_vram_bytes, 10=total_streamable_bytes,
    ///   11=bos_id, 12=eos_id, 13=cache_hits, 14=cache_misses, 15=prefetch_hits, 16=io_bytes_read,
    ///   17=os_rss_bytes, 18=os_peak_rss_bytes, 19=total_model_disk_bytes, 20=num_shards,
    ///   21=pcie_h2d_bytes
    fn tn_cumoe_info(handle Int, field_id Int) Int
    fn tn_cumoe_reset(handle Int) Int
    fn tn_cumoe_step(handle Int, tok_id Int, pos Int) Int
    fn tn_cumoe_token_cstr(handle Int, tok_id Int) Ptr[UInt8]
    fn tn_cumoe_last_timing_ms(handle Int, which Int) Float
    fn tn_cumoe_now_ms() Float
    fn tn_cumoe_free(handle Int) Int
}

pub fn cumoe_init() Bool {
    unsafe { tn_cumoe_init() != 0 }
}

pub fn cumoe_device_name() Text {
    unsafe { cstr_to_text(tn_cumoe_device_name()) }
}

pub fn cumoe_vram_bytes() Int {
    unsafe { tn_cumoe_vram_bytes() }
}

pub fn cumoe_now_ms() Float {
    unsafe { tn_cumoe_now_ms() }
}

@linear
pub record CudaStreamingMoeModel {
    handle Int
}

impl CudaStreamingMoeModel {
    pub fn open_gguf(
        path Text,
        cache_slots_per_layer Int,
        use_nocache Bool,
        enable_overlap Bool,
    ) CudaStreamingMoeModel {
        let nc = if use_nocache { 1 } else { 0 }
        let ov = if enable_overlap { 1 } else { 0 }
        let h = unsafe { tn_cumoe_load_gguf(text_cstr_ptr(path), cache_slots_per_layer, nc, ov) }
        CudaStreamingMoeModel { handle = h }
    }

    pub fn is_valid(inout self) Bool { self.handle > 0 }
    pub fn n_layers(inout self) Int { unsafe { tn_cumoe_info(self.handle, 0) } }
    pub fn d_model(inout self) Int { unsafe { tn_cumoe_info(self.handle, 1) } }
    pub fn d_ff(inout self) Int { unsafe { tn_cumoe_info(self.handle, 2) } }
    pub fn n_heads(inout self) Int { unsafe { tn_cumoe_info(self.handle, 3) } }
    pub fn n_kv(inout self) Int { unsafe { tn_cumoe_info(self.handle, 4) } }
    pub fn n_experts(inout self) Int { unsafe { tn_cumoe_info(self.handle, 5) } }
    pub fn top_k(inout self) Int { unsafe { tn_cumoe_info(self.handle, 6) } }
    pub fn vocab_size(inout self) Int { unsafe { tn_cumoe_info(self.handle, 7) } }
    pub fn core_vram_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 8) } }
    pub fn cache_vram_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 9) } }
    pub fn total_streamable_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 10) } }
    pub fn cache_hits(inout self) Int { unsafe { tn_cumoe_info(self.handle, 13) } }
    pub fn cache_misses(inout self) Int { unsafe { tn_cumoe_info(self.handle, 14) } }
    pub fn prefetch_hits(inout self) Int { unsafe { tn_cumoe_info(self.handle, 15) } }
    pub fn io_bytes_read(inout self) Int { unsafe { tn_cumoe_info(self.handle, 16) } }
    pub fn os_rss_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 17) } }
    pub fn os_peak_rss_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 18) } }
    pub fn total_disk_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 19) } }
    pub fn num_shards(inout self) Int { unsafe { tn_cumoe_info(self.handle, 20) } }
    pub fn pcie_h2d_bytes(inout self) Int { unsafe { tn_cumoe_info(self.handle, 21) } }

    pub fn reset(inout self) {
        let _ = unsafe { tn_cumoe_reset(self.handle) }
    }

    pub fn step(inout self, tok_id Int, pos Int) Int {
        unsafe { tn_cumoe_step(self.handle, tok_id, pos) }
    }

    pub fn token_text(inout self, tok_id Int) Text {
        unsafe { cstr_to_text(tn_cumoe_token_cstr(self.handle, tok_id)) }
    }

    pub fn destroy(self) {
        let _ = unsafe { tn_cumoe_free(self.handle) }
    }
}
