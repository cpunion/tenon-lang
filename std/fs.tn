// Tenon Standard Library: std/fs.tn
// Typed filesystem & process wrappers returning structured `Result[T, Text]` and `ExecOutput`.

import "std/text.tn"

pub record ExecOutput {
    exit_code Int
    output    Text
}

pub fn fs_read(path Text) Result[Text, Text] {
    let data = sys_read_file(path)
    if !sys_file_ok() {
        return Err(data)
    }
    Ok(data)
}

pub fn fs_write(path Text, content Text) Result[NonNegative, Text] {
    let ok = sys_write_file(path, content)
    if !ok {
        return Err("failed to write file `" ++ path ++ "`")
    }
    Ok(len(content))
}

pub fn exec_sh(cmd Text) ExecOutput {
    let out = sys_exec(cmd)
    let code = sys_exec_exit_code()
    ExecOutput {
        exit_code = code,
        output = out
    }
}
