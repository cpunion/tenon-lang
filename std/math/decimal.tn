// std/math/decimal.tn — Exact Fixed-Point `Decimal64` (Scale = 10^8 = 100,000,000)
// Eliminates IEEE-754 binary floating-point rounding drift for financial / crypto / orderbook math.
// Zero external dependencies; Perceus RC leak-free (`live_objects == 0`).

import "std/text/text.tn"
import "std/text/builder.tn"

pub const DEC_SCALE Int = 100000000
pub const DEC_HALF_SCALE Int = 10000

pub record Decimal64 {
    raw Int
}

pub pure fn dec_zero() Decimal64 {
    Decimal64 { raw = 0 }
}

pub pure fn dec_from_int(n Int) Decimal64 {
    Decimal64 { raw = n * DEC_SCALE }
}

pub pure fn dec_from_scaled(raw Int) Decimal64 {
    Decimal64 { raw = raw }
}

pub pure fn dec_from_cents(cents Int) Decimal64 {
    Decimal64 { raw = cents * 1000000 }
}

pub pure fn dec_add(a Decimal64, b Decimal64) Decimal64 {
    Decimal64 { raw = a.raw + b.raw }
}

pub pure fn dec_sub(a Decimal64, b Decimal64) Decimal64 {
    Decimal64 { raw = a.raw - b.raw }
}

pub pure fn dec_neg(a Decimal64) Decimal64 {
    Decimal64 { raw = -a.raw }
}

pub pure fn dec_abs(a Decimal64) Decimal64 {
    if a.raw < 0 { Decimal64 { raw = -a.raw } } else { a }
}

/// Overflow-resistant exact fixed-point multiplication `(a * b) / 10^8` using base-10^8 split:
/// `a = qa * S + ra`, `b = qb * S + rb` => `(a*b)/S = qa*qb*S + qa*rb + qb*ra + (ra*rb)/S`.
pub pure fn dec_mul(a Decimal64, b Decimal64) Decimal64 {
    let neg = (a.raw < 0) != (b.raw < 0)
    let ua = if a.raw < 0 { -a.raw } else { a.raw }
    let ub = if b.raw < 0 { -b.raw } else { b.raw }
    let qa = ua / DEC_SCALE
    let ra = ua % DEC_SCALE
    let qb = ub / DEC_SCALE
    let rb = ub % DEC_SCALE
    let term1 = qa * qb * DEC_SCALE
    let term2 = qa * rb + qb * ra
    let term3 = (ra * rb) / DEC_SCALE
    let mag = term1 + term2 + term3
    if neg { Decimal64 { raw = -mag } } else { Decimal64 { raw = mag } }
}

/// Exact fixed-point division `(a * 10^8) / b` with safe non-zero check and split remainder scaling.
pub pure fn dec_div(a Decimal64, b Decimal64) Result[Decimal64, Text] {
    if b.raw == 0 {
        return Err("Decimal64 division by zero")
    }
    let neg = (a.raw < 0) != (b.raw < 0)
    let ua = if a.raw < 0 { -a.raw } else { a.raw }
    let ub = if b.raw < 0 { -b.raw } else { b.raw }
    if ub == 0 {
        return Err("Decimal64 division by zero")
    }
    let q_int = ua / ub
    let rem = ua % ub
    // Scale remainder in two 10^4 steps to prevent 64-bit overflow while keeping full 8-digit precision
    let r1 = rem * DEC_HALF_SCALE
    let q1 = r1 / ub
    let rem1 = r1 % ub
    let r2 = rem1 * DEC_HALF_SCALE
    let q2 = r2 / ub
    let mag = q_int * DEC_SCALE + q1 * DEC_HALF_SCALE + q2
    if neg { Ok(Decimal64 { raw = -mag }) } else { Ok(Decimal64 { raw = mag }) }
}

pub pure fn dec_cmp(a Decimal64, b Decimal64) Int {
    if a.raw < b.raw { -1 } else if a.raw > b.raw { 1 } else { 0 }
}

pub pure fn dec_eq(a Decimal64, b Decimal64) Bool {
    a.raw == b.raw
}

/// Parses decimal string like `"-12345.6789"` or `"0.0005"` into exact `Decimal64`.
pub pure fn dec_parse(s Text) Result[Decimal64, Text] {
    let n = len(s)
    if n == 0 {
        return Err("empty Decimal64 string")
    }
    var i = 0
    var neg = false
    if byte_at(s, i) == 45 {
        neg = true
        i += 1
    } else if byte_at(s, i) == 43 {
        i += 1
    }
    if i >= n {
        return Err("missing digits in Decimal64")
    }
    var whole = 0
    var saw_digit = false
    while i < n {
        let c = byte_at(s, i)
        if c >= 48 && c <= 57 {
            whole = whole * 10 + (c - 48)
            saw_digit = true
            i += 1
        } else if c == 46 {
            i += 1
            break
        } else {
            return Err("invalid character in Decimal64 integer part")
        }
    }
    var frac = 0
    var frac_digits = 0
    while i < n {
        let c = byte_at(s, i)
        if c < 48 || c > 57 {
            return Err("invalid character in Decimal64 fractional part")
        }
        saw_digit = true
        if frac_digits < 8 {
            frac = frac * 10 + (c - 48)
            frac_digits += 1
        }
        i += 1
    }
    if !saw_digit {
        return Err("no digits found in Decimal64")
    }
    while frac_digits < 8 {
        frac = frac * 10
        frac_digits += 1
    }
    let mag = whole * DEC_SCALE + frac
    if neg { Ok(Decimal64 { raw = -mag }) } else { Ok(Decimal64 { raw = mag }) }
}

/// Formats `Decimal64` with stripped trailing fractional zeros (e.g. `12.5`, `-0.0001`, `42`).
pub pure fn dec_to_text(d Decimal64) Text {
    var tb = TextBuilder.new()
    var mag = d.raw
    if mag < 0 {
        tb.push_byte(45)
        mag = -mag
    }
    let whole = mag / DEC_SCALE
    let frac = mag % DEC_SCALE
    tb.push_str(int_to_text(whole))
    if frac > 0 {
        tb.push_byte(46)
        var digs List[Int] = list_filled(8, 0)
        var f = frac
        var k = 7
        while k >= 0 {
            digs[k] = f % 10
            f = f / 10
            k -= 1
        }
        var last = 7
        while last > 0 && digs[last] == 0 {
            last -= 1
        }
        var j = 0
        while j <= last {
            tb.push_byte((48 + digs[j]) & 255)
            j += 1
        }
    }
    tb.finish()
}
