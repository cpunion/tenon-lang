// Tenon Standard Library — Layer 2: std/encoding/json.tn
// First-class `JsonValue` ADT with OOP constructors/methods, O(n) `TextBuilder` serializer,
// `ToJson` / `FromJson` / `JsonSchema` interfaces (powering `@derive(...)`),
// and static generic `json.encode[T]` / `json.decode[T]`.

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"
import "std/text/builder.tn"

pub record JsonEntry {
    key Text
    val JsonValue
}

pub record JsonError {
    pos     NonNegative
    message Text
}

pub enum JsonValue {
    JNull
    JBool(Bool)
    JInt(Int)
    JStr(Text)
    JArr(List[JsonValue])
    JObj(List[JsonEntry])
}

pub record JsonParsed {
    value JsonValue
    next  NonNegative
}

// =========================================================================
// 1. Serialization / Deserialization / Schema Interfaces (for `@derive`)
// =========================================================================

pub interface ToJson {
    pure fn to_json(self) JsonValue
}

pub interface FromJson {
    pure fn from_json(v JsonValue) Result[Self, JsonError]
}

pub interface JsonSchema {
    pure fn json_schema() JsonValue
}

pub pure fn json_encode[T ToJson](val T) Text {
    val.to_json().stringify()
}

pub pure fn json_decode[T FromJson](src Text) Result[T, JsonError] {
    match JsonValue.parse(src) {
        Err(e) => Err(e)
        Ok(v) => T.from_json(v)
    }
}

// =========================================================================
// 2. Constructors & Accessors (backing helpers for `@derive` & module alias)
// =========================================================================

pub pure fn json_arr_new() JsonValue {
    let empty List[JsonValue] = []
    JArr(empty)
}

pub pure fn json_obj_new() JsonValue {
    let empty List[JsonEntry] = []
    JObj(empty)
}

pub pure fn json_arr_push(arr JsonValue, item JsonValue) JsonValue {
    match arr {
        JArr(items) => {
            var next List[JsonValue] = items
            next.push(item)
            JArr(next)
        }
        JNull => {
            var next List[JsonValue] = []
            next.push(item)
            JArr(next)
        }
        JBool(_) => arr
        JInt(_) => arr
        JStr(_) => arr
        JObj(_) => arr
    }
}

pub pure fn json_obj_set(obj JsonValue, key Text, val JsonValue) JsonValue {
    match obj {
        JObj(entries) => {
            var next List[JsonEntry] = entries
            var i = 0
            while i < next.len() {
                if next[i].key == key {
                    next[i] = JsonEntry { key = key, val = val }
                    return JObj(next)
                }
                i += 1
            }
            next.push(JsonEntry { key = key, val = val })
            JObj(next)
        }
        JNull => {
            var next List[JsonEntry] = []
            next.push(JsonEntry { key = key, val = val })
            JObj(next)
        }
        JBool(_) => obj
        JInt(_) => obj
        JStr(_) => obj
        JArr(_) => obj
    }
}

pub pure fn json_get(v JsonValue, key Text) Option[JsonValue] {
    match v {
        JObj(entries) => {
            var i = 0
            while i < entries.len() {
                let e = entries[i]
                if e.key == key {
                    return Some(e.val)
                }
                i += 1
            }
            None
        }
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JStr(_) => None
        JArr(_) => None
    }
}

pub pure fn json_at(v JsonValue, idx NonNegative) Option[JsonValue] {
    match v {
        JArr(items) => items.get(idx)
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JStr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_len(v JsonValue) NonNegative {
    match v {
        JArr(items) => items.len()
        JObj(entries) => entries.len()
        JStr(s) => s.len()
        JNull => 0
        JBool(_) => 0
        JInt(_) => 0
    }
}

pub pure fn json_as_str(v JsonValue) Option[Text] {
    match v {
        JStr(s) => Some(s)
        JNull => None
        JBool(_) => None
        JInt(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_as_int(v JsonValue) Option[Int] {
    match v {
        JInt(n) => Some(n)
        JNull => None
        JBool(_) => None
        JStr(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_as_bool(v JsonValue) Option[Bool] {
    match v {
        JBool(b) => Some(b)
        JNull => None
        JInt(_) => None
        JStr(_) => None
        JArr(_) => None
        JObj(_) => None
    }
}

pub pure fn json_get_str(v JsonValue, key Text) Option[Text] {
    match json_get(v, key) {
        Some(inner) => json_as_str(inner)
        None => None
    }
}

pub pure fn json_get_int(v JsonValue, key Text) Option[Int] {
    match json_get(v, key) {
        Some(inner) => json_as_int(inner)
        None => None
    }
}

pub pure fn json_get_bool(v JsonValue, key Text) Option[Bool] {
    match json_get(v, key) {
        Some(inner) => json_as_bool(inner)
        None => None
    }
}

// =========================================================================
// 3. OOP `impl JsonValue` (Static Constructors + Fluent Methods)
// =========================================================================

impl JsonValue {
    pub pure fn null() JsonValue { JNull }
    pub pure fn object() JsonValue { json_obj_new() }
    pub pure fn array() JsonValue { json_arr_new() }
    pub pure fn parse(src Text) Result[JsonValue, JsonError] { json_parse(src) }

    pub pure fn get(self, key Text) Option[JsonValue] { json_get(self, key) }
    pub pure fn at(self, idx NonNegative) Option[JsonValue] { json_at(self, idx) }
    pub pure fn len(self) NonNegative { json_len(self) }
    pub pure fn is_empty(self) Bool { json_len(self) == 0 }
    pub pure fn as_str(self) Option[Text] { json_as_str(self) }
    pub pure fn as_int(self) Option[Int] { json_as_int(self) }
    pub pure fn as_bool(self) Option[Bool] { json_as_bool(self) }
    pub pure fn get_str(self, key Text) Option[Text] { json_get_str(self, key) }
    pub pure fn get_int(self, key Text) Option[Int] { json_get_int(self, key) }
    pub pure fn get_bool(self, key Text) Option[Bool] { json_get_bool(self, key) }
    pub pure fn set(self, key Text, val JsonValue) JsonValue { json_obj_set(self, key, val) }
    pub pure fn put(inout self, key Text, val JsonValue) {
        match self {
            JObj(entries) => {
                var next List[JsonEntry] = entries
                self = JNull
                var i = 0
                while i < next.len() {
                    if next[i].key == key {
                        next[i] = JsonEntry { key = key, val = val }
                        self = JObj(next)
                        return
                    }
                    i += 1
                }
                next.push(JsonEntry { key = key, val = val })
                self = JObj(next)
            }
            JNull => {
                var next List[JsonEntry] = []
                next.push(JsonEntry { key = key, val = val })
                self = JObj(next)
            }
            JBool(_) => {}
            JInt(_) => {}
            JStr(_) => {}
            JArr(_) => {}
        }
    }
    pub pure fn push(self, item JsonValue) JsonValue { json_arr_push(self, item) }
    pub pure fn append(inout self, item JsonValue) {
        match self {
            JArr(items) => {
                var next List[JsonValue] = items
                self = JNull
                next.push(item)
                self = JArr(next)
            }
            JNull => {
                var next List[JsonValue] = []
                next.push(item)
                self = JArr(next)
            }
            JBool(_) => {}
            JInt(_) => {}
            JStr(_) => {}
            JObj(_) => {}
        }
    }
    pub pure fn stringify(self) Text { json_stringify(self) }
}

impl ToJson for JsonValue {
    pub pure fn to_json(self) JsonValue { self }
}

impl Display for JsonValue {
    pub pure fn display(self) Text { self.stringify() }
}

// =========================================================================
// 4. O(n) Buffered JSON Serializer (`TextBuilder`)
// =========================================================================

pub pure fn json_write_escaped(b TextBuilder, s Text) {
    let n = s.len()
    var run_start = 0
    var i = 0
    while i < n {
        let ch = byte_at(s, i)
        if ch == 34 || ch == 92 || ch == 10 || ch == 13 || ch == 9 || (ch >= 0 && ch < 32) {
            if i > run_start {
                b.push(str_slice(s, run_start, i))
            }
            if ch == 34 {
                b.push("\\\"")
            } else if ch == 92 {
                b.push("\\\\")
            } else if ch == 10 {
                b.push("\\n")
            } else if ch == 13 {
                b.push("\\r")
            } else if ch == 9 {
                b.push("\\t")
            } else {
                let hi = (ch / 16) % 16
                let lo = ch % 16
                if hi >= 0 && hi <= 15 && lo >= 0 && lo <= 15 {
                    b.push("\\u00" ++ hex_nibble(hi) ++ hex_nibble(lo))
                }
            }
            run_start = i + 1
        }
        i += 1
    }
    if run_start == 0 {
        if n > 0 {
            b.push(s)
        }
    } else if n > run_start {
        b.push(str_slice(s, run_start, n))
    }
}

pub pure fn json_write_value(b TextBuilder, v JsonValue) {
    match v {
        JNull => {
            b.push("null")
        }
        JBool(flag) => {
            if flag {
                b.push("true")
            } else {
                b.push("false")
            }
        }
        JInt(n) => {
            b.push(n.to_text())
        }
        JStr(s) => {
            b.push_byte(34)
            json_write_escaped(b, s)
            b.push_byte(34)
        }
        JArr(items) => {
            b.push_byte(91)
            var i = 0
            while i < items.len() {
                if i > 0 {
                    b.push_byte(44)
                }
                json_write_value(b, items[i])
                i += 1
            }
            b.push_byte(93)
        }
        JObj(entries) => {
            b.push_byte(123)
            var i = 0
            while i < entries.len() {
                if i > 0 {
                    b.push_byte(44)
                }
                let e = entries[i]
                b.push_byte(34)
                json_write_escaped(b, e.key)
                b.push("\":")
                json_write_value(b, e.val)
                i += 1
            }
            b.push_byte(125)
        }
    }
}

pub pure fn json_stringify(v JsonValue) Text {
    let b = TextBuilder.new()
    json_write_value(b, v)
    b.finish()
}

// =========================================================================
// 5. Full Recursive-Descent Parser (`JsonValue.parse` / `json.parse`)
// =========================================================================

pub pure fn codepoint_to_utf8(cp NonNegative) Text {
    let b = TextBuilder.new()
    json_push_codepoint_utf8(b, cp)
    b.finish()
}

pure fn json_push_codepoint_utf8(b TextBuilder, cp NonNegative) {
    if cp < 128 {
        b.push_byte(cp)
        return
    }
    if cp < 2048 {
        b.push_byte(192 + (cp / 64))
        b.push_byte(128 + (cp % 64))
        return
    }
    if cp < 65536 {
        b.push_byte(224 + (cp / 4096))
        b.push_byte(128 + ((cp / 64) % 64))
        b.push_byte(128 + (cp % 64))
    }
}

pure fn json_unescape_known(raw Text) Text {
    let n = raw.len()
    let b = TextBuilder.new()
    var run_start = 0
    var i = 0
    while i < n {
        if byte_at(raw, i) == 92 && i + 1 < n {
            if i > run_start {
                b.push(str_slice(raw, run_start, i))
            }
            let esc = byte_at(raw, i + 1)
            if esc == 110 {
                b.push_byte(10)
                i += 2
            } else if esc == 114 {
                b.push_byte(13)
                i += 2
            } else if esc == 116 {
                b.push_byte(9)
                i += 2
            } else if esc == 34 {
                b.push_byte(34)
                i += 2
            } else if esc == 92 {
                b.push_byte(92)
                i += 2
            } else if esc == 47 {
                b.push_byte(47)
                i += 2
            } else if esc == 98 {
                b.push_byte(8)
                i += 2
            } else if esc == 102 {
                b.push_byte(12)
                i += 2
            } else if esc == 117 && i + 5 < n {
                let h0 = parse_hex_digit_raw(byte_at(raw, i + 2))
                let h1 = parse_hex_digit_raw(byte_at(raw, i + 3))
                let h2 = parse_hex_digit_raw(byte_at(raw, i + 4))
                let h3 = parse_hex_digit_raw(byte_at(raw, i + 5))
                if h0 >= 0 && h1 >= 0 && h2 >= 0 && h3 >= 0 {
                    let cp = clamp_non_neg((h0 << 12) | (h1 << 8) | (h2 << 4) | h3)
                    json_push_codepoint_utf8(b, cp)
                    i += 6
                } else {
                    if esc >= 0 && esc <= 255 {
                        b.push_byte(esc)
                    }
                    i += 2
                }
            } else {
                if esc >= 0 && esc <= 255 {
                    b.push_byte(esc)
                }
                i += 2
            }
            run_start = i
        } else {
            i += 1
        }
    }
    if n > run_start {
        b.push(str_slice(raw, run_start, n))
    }
    b.finish()
}

pub pure fn json_unescape(raw Text) Text {
    let n = raw.len()
    var k = 0
    while k < n {
        if byte_at(raw, k) == 92 {
            return json_unescape_known(raw)
        }
        k += 1
    }
    raw
}

pure fn json_skip_ws_cursor(src Text, n Int, inout pos Int) {
    while pos < n {
        let b = byte_at(src, pos)
        if b == 32 || b == 9 || b == 10 || b == 13 {
            pos += 1
        } else {
            break
        }
    }
}

pure fn json_parse_string_cursor(src Text, n Int, inout pos Int, inout err_pos Int, inout err_msg Text) Text {
    if pos >= n || byte_at(src, pos) != 34 {
        err_pos = pos
        err_msg = "expected opening '\"'"
        return ""
    }
    let start = pos + 1
    var i = start
    var has_esc = false
    while i < n {
        let b = byte_at(src, i)
        if b == 92 {
            if i + 1 >= n {
                err_pos = i
                err_msg = "unterminated escape in JSON string"
                return ""
            }
            has_esc = true
            i += 2
            continue
        }
        if b == 34 {
            pos = i + 1
            let raw = str_slice(src, start, i)
            if has_esc {
                return json_unescape_known(raw)
            }
            return raw
        }
        i += 1
    }
    err_pos = pos
    err_msg = "unterminated JSON string"
    ""
}

pure fn json_parse_number_cursor(src Text, n Int, inout pos Int, inout err_pos Int, inout err_msg Text) JsonValue {
    let start = pos
    var i = start
    var neg = false
    if i < n && byte_at(src, i) == 45 {
        neg = true
        i += 1
    }
    if i >= n || !is_digit_byte(byte_at(src, i)) {
        err_pos = start
        err_msg = "invalid JSON number"
        return JNull
    }
    var acc = 0
    while i < n {
        let b = byte_at(src, i)
        if b >= 48 && b <= 57 {
            acc = acc * 10 + (b - 48)
            i += 1
        } else {
            break
        }
    }
    if i < n && byte_at(src, i) == 46 {
        i += 1
        while i < n && is_digit_byte(byte_at(src, i)) {
            i += 1
        }
    }
    if i < n && (byte_at(src, i) == 101 || byte_at(src, i) == 69) {
        i += 1
        if i < n && (byte_at(src, i) == 43 || byte_at(src, i) == 45) {
            i += 1
        }
        while i < n && is_digit_byte(byte_at(src, i)) {
            i += 1
        }
    }
    pos = i
    if neg { JInt(-acc) } else { JInt(acc) }
}

pure fn json_parse_array_cursor(src Text, n Int, inout pos Int, inout err_pos Int, inout err_msg Text) JsonValue {
    let start = pos
    pos += 1
    json_skip_ws_cursor(src, n, pos)
    var items List[JsonValue] = []
    if pos < n && byte_at(src, pos) == 93 {
        pos += 1
        return JArr(items)
    }
    while pos < n {
        let item = json_parse_value_cursor(src, n, pos, err_pos, err_msg)
        if err_pos >= 0 {
            return JNull
        }
        items.push(item)
        json_skip_ws_cursor(src, n, pos)
        if pos < n && byte_at(src, pos) == 44 {
            pos += 1
            json_skip_ws_cursor(src, n, pos)
            continue
        }
        if pos < n && byte_at(src, pos) == 93 {
            pos += 1
            return JArr(items)
        }
        err_pos = pos
        err_msg = "expected ',' or ']' in JSON array"
        return JNull
    }
    err_pos = start
    err_msg = "unterminated JSON array"
    JNull
}

pure fn json_parse_object_cursor(src Text, n Int, inout pos Int, inout err_pos Int, inout err_msg Text) JsonValue {
    let start = pos
    pos += 1
    json_skip_ws_cursor(src, n, pos)
    var entries List[JsonEntry] = []
    if pos < n && byte_at(src, pos) == 125 {
        pos += 1
        return JObj(entries)
    }
    while pos < n {
        let key_text = json_parse_string_cursor(src, n, pos, err_pos, err_msg)
        if err_pos >= 0 {
            return JNull
        }
        json_skip_ws_cursor(src, n, pos)
        if pos >= n || byte_at(src, pos) != 58 {
            err_pos = pos
            err_msg = "expected ':' after JSON object key"
            return JNull
        }
        pos += 1
        let val = json_parse_value_cursor(src, n, pos, err_pos, err_msg)
        if err_pos >= 0 {
            return JNull
        }
        entries.push(JsonEntry { key = key_text, val = val })
        json_skip_ws_cursor(src, n, pos)
        if pos < n && byte_at(src, pos) == 44 {
            pos += 1
            json_skip_ws_cursor(src, n, pos)
            continue
        }
        if pos < n && byte_at(src, pos) == 125 {
            pos += 1
            return JObj(entries)
        }
        err_pos = pos
        err_msg = "expected ',' or '}' in JSON object"
        return JNull
    }
    err_pos = start
    err_msg = "unterminated JSON object"
    JNull
}

pure fn json_parse_value_cursor(src Text, n Int, inout pos Int, inout err_pos Int, inout err_msg Text) JsonValue {
    json_skip_ws_cursor(src, n, pos)
    if pos >= n {
        err_pos = pos
        err_msg = "unexpected end of JSON input"
        return JNull
    }
    let b = byte_at(src, pos)
    if b == 34 {
        let s = json_parse_string_cursor(src, n, pos, err_pos, err_msg)
        if err_pos >= 0 {
            return JNull
        }
        return JStr(s)
    }
    if b == 123 {
        return json_parse_object_cursor(src, n, pos, err_pos, err_msg)
    }
    if b == 91 {
        return json_parse_array_cursor(src, n, pos, err_pos, err_msg)
    }
    if b == 45 || (b >= 48 && b <= 57) {
        return json_parse_number_cursor(src, n, pos, err_pos, err_msg)
    }
    if b == 116 && pos + 4 <= n && byte_at(src, pos + 1) == 114 && byte_at(src, pos + 2) == 117 && byte_at(src, pos + 3) == 101 {
        pos += 4
        return JBool(true)
    }
    if b == 102 && pos + 5 <= n && byte_at(src, pos + 1) == 97 && byte_at(src, pos + 2) == 108 && byte_at(src, pos + 3) == 115 && byte_at(src, pos + 4) == 101 {
        pos += 5
        return JBool(false)
    }
    if b == 110 && pos + 4 <= n && byte_at(src, pos + 1) == 117 && byte_at(src, pos + 2) == 108 && byte_at(src, pos + 3) == 108 {
        pos += 4
        return JNull
    }
    err_pos = pos
    err_msg = "unexpected token in JSON input"
    JNull
}

pub pure fn json_skip_ws(src Text, pos NonNegative) NonNegative {
    var p = pos
    json_skip_ws_cursor(src, src.len(), p)
    clamp_non_neg(p)
}

pub pure fn json_parse_value_at(src Text, pos NonNegative) Result[JsonParsed, JsonError] {
    var p = pos
    var err_pos = -1
    var err_msg = ""
    let v = json_parse_value_cursor(src, src.len(), p, err_pos, err_msg)
    if err_pos >= 0 {
        return Err(JsonError { pos = clamp_non_neg(err_pos), message = err_msg })
    }
    Ok(JsonParsed { value = v, next = clamp_non_neg(p) })
}

pub pure fn json_parse(src Text) Result[JsonValue, JsonError] {
    let n = src.len()
    var pos = 0
    var err_pos = -1
    var err_msg = ""
    let val = json_parse_value_cursor(src, n, pos, err_pos, err_msg)
    if err_pos >= 0 {
        return Err(JsonError { pos = clamp_non_neg(err_pos), message = err_msg })
    }
    json_skip_ws_cursor(src, n, pos)
    if pos < n {
        return Err(JsonError { pos = clamp_non_neg(pos), message = "trailing characters after JSON value" })
    }
    Ok(val)
}
