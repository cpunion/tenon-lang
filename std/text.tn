// Tenon Standard Library: std/text.tn
// Pure-Tenon string utilities utilizing refined types, `@no_heap_alloc`, `pure fn`,
// `requires`/`ensures` contracts, and structured `Option[T]` / `Result[T, E]`!

pub type NonNegative = Int where self >= 0
pub type Positive    = Int where self >= 1
pub type ByteVal     = Int where 0 <= self && self <= 255
pub type HexNibble   = Int where 0 <= self && self <= 15

pub record SliceRange {
    start NonNegative
    end   NonNegative
    where start <= end
}

@no_heap_alloc
pub pure fn is_space_byte(b Int) Bool {
    b == 32 || b == 9 || b == 10 || b == 13
}

@no_heap_alloc
pub pure fn is_digit_byte(b Int) Bool {
    b >= 48 && b <= 57
}

@no_heap_alloc
pub pure fn clamp_non_neg(n Int) NonNegative
    ensures result >= 0
{
    if n < 0 {
        return 0
    }
    n
}

@no_heap_alloc
pub pure fn min_int(a Int, b Int) Int
    ensures result <= a && result <= b
{
    if a <= b {
        return a
    }
    b
}

@no_heap_alloc
pub pure fn max_int(a Int, b Int) Int
    ensures result >= a && result >= b
{
    if a >= b {
        return a
    }
    b
}

@no_heap_alloc
pub pure fn parse_hex_digit_raw(b Int) Int
    ensures -1 <= result && result <= 15
{
    if b >= 48 && b <= 57 {
        return b - 48
    }
    if b >= 65 && b <= 70 {
        return 10 + (b - 65)
    }
    if b >= 97 && b <= 102 {
        return 10 + (b - 97)
    }
    -1
}

pub pure fn parse_hex_digit(b Int) Option[HexNibble] {
    let v = parse_hex_digit_raw(b)
    if v < 0 {
        return None
    }
    Some(v)
}

pub pure fn hex_nibble(n HexNibble) Text {
    if n < 10 {
        return byte_to_text(48 + n)
    }
    byte_to_text(97 + (n - 10))
}

pub pure fn str_slice_checked(s Text, start NonNegative, end NonNegative) Text
    requires start <= end
{
    str_slice(s, start, end)
}

pub pure fn str_slice_range(s Text, r SliceRange) Text {
    str_slice_checked(s, r.start, r.end)
}

pub pure fn str_starts_with(s Text, prefix Text) Bool {
    let plen = len(prefix)
    if plen > len(s) {
        return false
    }
    if plen == 0 {
        return true
    }
    str_slice_checked(s, 0, plen) == prefix
}

pub pure fn str_ends_with(s Text, suffix Text) Bool {
    let slen = len(s)
    let xlen = len(suffix)
    if xlen > slen {
        return false
    }
    if xlen == 0 {
        return true
    }
    let start = slen - xlen
    str_slice_checked(s, start, slen) == suffix
}

pub pure fn str_strip_prefix(s Text, prefix Text) Option[Text] {
    if !str_starts_with(s, prefix) {
        return None
    }
    let plen = len(prefix)
    let slen = len(s)
    if plen > slen {
        return None
    }
    Some(str_slice_checked(s, plen, slen))
}

pub pure fn str_trim(s Text) Text {
    let n = len(s)
    var start = 0
    while start < n && is_space_byte(byte_at(s, start)) {
        start += 1
    }
    var end = n
    while end > start && is_space_byte(byte_at(s, end - 1)) {
        end -= 1
    }
    let s_ok = clamp_non_neg(start)
    let e_ok = clamp_non_neg(end)
    if s_ok > e_ok {
        return ""
    }
    str_slice_checked(s, s_ok, e_ok)
}

pub pure fn str_index_of_from(s Text, needle Text, start NonNegative) Option[NonNegative] {
    let slen = len(s)
    let nlen = len(needle)
    if nlen == 0 {
        if start > slen {
            return Some(slen)
        }
        return Some(start)
    }
    if nlen > slen {
        return None
    }
    let first = byte_at(needle, 0)
    var i = start
    let limit = slen - nlen
    while i <= limit {
        if byte_at(s, i) == first {
            var matched = true
            var j = 1
            while j < nlen {
                if byte_at(s, i + j) != byte_at(needle, j) {
                    matched = false
                    break
                }
                j += 1
            }
            if matched {
                return Some(clamp_non_neg(i))
            }
        }
        i += 1
    }
    None
}

pub pure fn str_index_of(s Text, needle Text) Option[NonNegative] {
    str_index_of_from(s, needle, 0)
}

pub pure fn str_contains(s Text, needle Text) Bool {
    match str_index_of(s, needle) {
        Some(_) => true
        None => false
    }
}

pub pure fn str_replace_first(s Text, target Text, replacement Text) Text {
    let tlen = len(target)
    if tlen == 0 {
        return s
    }
    match str_index_of(s, target) {
        None => s
        Some(pos) => {
            let left = str_slice(s, 0, pos)
            let right = str_slice(s, pos + tlen, len(s))
            left ++ replacement ++ right
        }
    }
}

pub pure fn str_replace_all(s Text, target Text, replacement Text) Text {
    let tlen = len(target)
    if tlen == 0 {
        return s
    }
    let slen = len(s)
    var out = ""
    var pos = 0
    while pos <= slen {
        let p_ok = clamp_non_neg(pos)
        match str_index_of_from(s, target, p_ok) {
            None => {
                out = out ++ str_slice(s, p_ok, slen)
                break
            }
            Some(idx) => {
                out = out ++ str_slice(s, p_ok, idx) ++ replacement
                pos = idx + tlen
            }
        }
    }
    out
}

pub pure fn int_to_text(n Int) Text {
    if n == 0 {
        return "0"
    }
    var neg = false
    var v = n
    if v < 0 {
        neg = true
        v = -v
    }
    var rev = ""
    while v > 0 {
        let d = v % 10
        rev = byte_to_text(48 + d) ++ rev
        v = v / 10
    }
    if neg {
        return "-" ++ rev
    }
    rev
}

pub pure fn text_parse_int(s Text) Result[Int, Text] {
    let trimmed = str_trim(s)
    let n = len(trimmed)
    if n == 0 {
        return Err("empty integer string")
    }
    var i = 0
    var neg = false
    if byte_at(trimmed, 0) == 45 {
        neg = true
        i = 1
    }
    if i >= n {
        return Err("missing digits after '-'")
    }
    var acc = 0
    while i < n {
        let b = byte_at(trimmed, i)
        if !is_digit_byte(b) {
            return Err("invalid digit in integer `" ++ trimmed ++ "`")
        }
        acc = acc * 10 + (b - 48)
        i += 1
    }
    if neg {
        return Ok(-acc)
    }
    Ok(acc)
}
