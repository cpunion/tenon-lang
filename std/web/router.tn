// std/web/router.tn — Radix / Segment Trie HTTP Router & Typed Request Context
// Supports O(depth) dispatch for static segments (`/health`), named params (`/users/:id`),
// and wildcards (`/files/*path`), plus zero-dependency typed JSON/param extraction.

import "std/core/types.tn"
import "std/text/text.tn"
import "std/encoding/json.tn"
import "std/net/http.tn"

pub record RouteParam {
    name  Text
    value Text
}

pub record RouteMatch {
    matched Bool
    params  List[RouteParam]
}

pub record RadixEdge {
    segment Text
    child   Int
}

pub record RadixMethodSlot {
    method    Text
    route_idx Int
}

pub record RadixNode {
    edges       List[RadixEdge]
    param_child Int
    param_name  Text
    wild_child  Int
    wild_name   Text
    handlers    List[RadixMethodSlot]
}

pub record RadixRouter {
    nodes List[RadixNode]
}

pub record RadixLookup {
    route_idx        Int
    matched_other_m  Bool
    params           List[RouteParam]
}

pure fn empty_radix_node() RadixNode {
    RadixNode {
        edges = []
        param_child = -1
        param_name = ""
        wild_child = -1
        wild_name = ""
        handlers = []
    }
}

pub pure fn radix_router_new() RadixRouter {
    RadixRouter { nodes = [empty_radix_node()] }
}

pure fn split_path_segments(path Text) List[Text] {
    var segs List[Text] = []
    let n = len(path)
    var i = 0
    while i < n {
        while i < n && byte_at(path, i) == 47 {
            i += 1
        }
        if i >= n {
            break
        }
        var j = i
        while j < n && byte_at(path, j) != 47 {
            j += 1
        }
        segs = push(segs, str_slice(path, i, j))
        i = j
    }
    segs
}

pure fn join_from(segs List[Text], start Int) Text {
    var out = ""
    var i = start
    while i < len(segs) {
        if i > start {
            out = out ++ "/"
        }
        out = out ++ segs[i]
        i += 1
    }
    out
}

pure fn find_static_edge(edges List[RadixEdge], seg Text) Int {
    var i = 0
    while i < len(edges) {
        let e = edges[i]
        if e.segment == seg {
            return e.child
        }
        i += 1
    }
    -1
}

impl RadixRouter {
    /// Inserts `(method, pattern, route_idx)` into the segment radix trie.
    pub pure fn insert(self, method Text, pattern Text, route_idx Int) RadixRouter {
        let segs = split_path_segments(pattern)
        var nodes = self.nodes
        var cur = 0
        var i = 0
        while i < len(segs) {
            let s = segs[i]
            let node = nodes[cur]
            if len(s) > 0 && byte_at(s, 0) == 42 {
                // Wildcard `*name`
                let wname = str_slice(s, 1, len(s))
                if node.wild_child >= 0 {
                    cur = node.wild_child
                } else {
                    let nid = len(nodes)
                    nodes = push(nodes, empty_radix_node())
                    nodes[cur] = RadixNode {
                        edges = node.edges
                        param_child = node.param_child
                        param_name = node.param_name
                        wild_child = nid
                        wild_name = wname
                        handlers = node.handlers
                    }
                    cur = nid
                }
                break
            } else if len(s) > 0 && byte_at(s, 0) == 58 {
                // Param `:name`
                let pname = str_slice(s, 1, len(s))
                if node.param_child >= 0 {
                    cur = node.param_child
                } else {
                    let nid = len(nodes)
                    nodes = push(nodes, empty_radix_node())
                    nodes[cur] = RadixNode {
                        edges = node.edges
                        param_child = nid
                        param_name = pname
                        wild_child = node.wild_child
                        wild_name = node.wild_name
                        handlers = node.handlers
                    }
                    cur = nid
                }
            } else {
                let existing = find_static_edge(node.edges, s)
                if existing >= 0 {
                    cur = existing
                } else {
                    let nid = len(nodes)
                    nodes = push(nodes, empty_radix_node())
                    var new_edges = node.edges
                    new_edges = push(new_edges, RadixEdge { segment = s, child = nid })
                    nodes[cur] = RadixNode {
                        edges = new_edges
                        param_child = node.param_child
                        param_name = node.param_name
                        wild_child = node.wild_child
                        wild_name = node.wild_name
                        handlers = node.handlers
                    }
                    cur = nid
                }
            }
            i += 1
        }
        let leaf = nodes[cur]
        var hs = leaf.handlers
        hs = push(hs, RadixMethodSlot { method = method, route_idx = route_idx })
        nodes[cur] = RadixNode {
            edges = leaf.edges
            param_child = leaf.param_child
            param_name = leaf.param_name
            wild_child = leaf.wild_child
            wild_name = leaf.wild_name
            handlers = hs
        }
        RadixRouter { nodes = nodes }
    }

    /// O(path depth) lookup: static edges take priority over `:param`, which takes priority over `*wildcard`.
    pub pure fn lookup(self, method Text, path Text) RadixLookup {
        let segs = split_path_segments(path)
        var params List[RouteParam] = []
        var cur = 0
        var i = 0
        while i < len(segs) {
            let s = segs[i]
            let node = self.nodes[cur]
            let st_child = find_static_edge(node.edges, s)
            if st_child >= 0 {
                cur = st_child
            } else if node.param_child >= 0 {
                params = push(params, RouteParam { name = node.param_name, value = s })
                cur = node.param_child
            } else if node.wild_child >= 0 {
                let rest = join_from(segs, i)
                params = push(params, RouteParam { name = node.wild_name, value = rest })
                cur = node.wild_child
                break
            } else {
                return RadixLookup { route_idx = -1, matched_other_m = false, params = [] }
            }
            i += 1
        }
        let leaf = self.nodes[cur]
        var matched_other = false
        var hi = 0
        while hi < len(leaf.handlers) {
            let slot = leaf.handlers[hi]
            if slot.method == method {
                return RadixLookup { route_idx = slot.route_idx, matched_other_m = false, params = params }
            }
            matched_other = true
            hi += 1
        }
        RadixLookup { route_idx = -1, matched_other_m = matched_other, params = [] }
    }
}

pub pure fn match_route_pattern(pattern Text, path Text) RouteMatch {
    let psegs = split_path_segments(pattern)
    let tsegs = split_path_segments(path)
    var params List[RouteParam] = []
    var i = 0
    while i < len(psegs) {
        let ps = psegs[i]
        if len(ps) > 0 && byte_at(ps, 0) == 42 {
            let pname = str_slice(ps, 1, len(ps))
            let rest = join_from(tsegs, i)
            params = push(params, RouteParam { name = pname, value = rest })
            return RouteMatch { matched = true, params = params }
        }
        if i >= len(tsegs) {
            return RouteMatch { matched = false, params = [] }
        }
        let ts = tsegs[i]
        if len(ps) > 0 && byte_at(ps, 0) == 58 {
            let pname = str_slice(ps, 1, len(ps))
            params = push(params, RouteParam { name = pname, value = ts })
        } else if ps != ts {
            return RouteMatch { matched = false, params = [] }
        }
        i += 1
    }
    if len(tsegs) != len(psegs) {
        return RouteMatch { matched = false, params = [] }
    }
    RouteMatch { matched = true, params = params }
}

pub record Context {
    req    HttpRequest
    params List[RouteParam]
}

pure fn parse_signed_int_opt(s Text) Option[Int] {
    let n = len(s)
    if n == 0 {
        return None
    }
    var i = 0
    var neg = false
    if byte_at(s, 0) == 45 {
        neg = true
        i = 1
        if n == 1 {
            return None
        }
    }
    var acc = 0
    while i < n {
        let b = byte_at(s, i)
        if b < 48 || b > 57 {
            return None
        }
        acc = acc * 10 + (b - 48)
        i += 1
    }
    if neg { Some(-acc) } else { Some(acc) }
}

impl Context {
    pub pure fn param(self, name Text) Option[Text] {
        var i = 0
        while i < len(self.params) {
            let p = self.params[i]
            if p.name == name {
                return Some(p.value)
            }
            i += 1
        }
        None
    }

    pub pure fn param_int(self, name Text) Option[Int] {
        match self.param(name) {
            Some(s) => parse_signed_int_opt(s)
            None => None
        }
    }

    pub pure fn query(self, key Text) Option[Text] {
        self.req.query_param(key)
    }

    pub pure fn header(self, name Text) Option[Text] {
        self.req.header(name)
    }

    pub pure fn body(self) Text {
        self.req.body
    }

    pub pure fn json_body[T FromJson](self) Result[T, JsonError] {
        let jv = json_parse(self.req.body)?
        T.from_json(jv)
    }

    pub pure fn ok(self, body Text) HttpResponse {
        http_ok(body)
    }

    pub pure fn text(self, status Int, body Text) HttpResponse {
        http_text(status, body)
    }

    pub pure fn json_raw(self, status Int, raw Text) HttpResponse {
        http_json(status, raw)
    }

    pub pure fn json[T ToJson](self, status Int, val T) HttpResponse {
        http_json(status, json_stringify(val.to_json()))
    }

    pub pure fn bad_request(self, msg Text) HttpResponse {
        http_bad_request(msg)
    }

    pub pure fn not_found(self, msg Text) HttpResponse {
        http_not_found(msg)
    }
}
