// std/web/app.tn — Metaprogramming-Powered High-Performance Tenon Web Framework
// Combines compile-time route scanning (`@get`, `@post`, `@put`, `@delete`, `@patch`, `@ws`, `@sse`),
// O(depth) Radix Trie Router, automatic OpenAPI 3.1 spec generation, composable middleware,
// path-traversal-safe static file serving, refined-type JSON extraction,
// and the multi-worker `kqueue`/`epoll` Keep-Alive HTTP/1.1 engine.

import "std/net/http.tn"
import "std/web/router.tn"
import "std/web/middleware.tn"

// First-class typed HTTP/WebSocket/SSE route attributes (scanned at compile time by `routes_of()`).
pub attr get(path Text)
pub attr post(path Text)
pub attr put(path Text)
pub attr delete(path Text)
pub attr patch(path Text)
pub attr ws(path Text)
pub attr sse(path Text)

pub record RouteEntry {
    method  Text
    path    Text
    handler Handler
}

pub record WebApp {
    routes       List[RouteEntry]
    radix        RadixRouter
    middlewares  List[Middleware]
    openapi_json Text
}

pub pure fn web_app_new() WebApp {
    WebApp {
        routes = []
        radix = radix_router_new()
        middlewares = []
        openapi_json = ""
    }
}

pub pure fn infer_mime_type(path Text) Text {
    if path.ends_with(".html") || path.ends_with(".htm") { "text/html; charset=utf-8" }
    else if path.ends_with(".js") || path.ends_with(".mjs") { "application/javascript; charset=utf-8" }
    else if path.ends_with(".css") { "text/css; charset=utf-8" }
    else if path.ends_with(".json") { "application/json" }
    else if path.ends_with(".wasm") { "application/wasm" }
    else if path.ends_with(".svg") { "image/svg+xml" }
    else { "text/plain; charset=utf-8" }
}

/// Validates that a relative static asset path cannot escape its root directory (blocks `..` & leading `/`).
pub pure fn static_path_is_safe(rel_path Text) Bool {
    len(rel_path) > 0 && !rel_path.contains("..") && byte_at(rel_path, 0) != 47
}

/// Path-traversal-safe static asset response builder using an injectable file loader (`loader(full_path)`).
pub pure fn serve_static_with(root_dir Text, rel_path Text, loader fn(Text) Option[Text]) HttpResponse {
    if !static_path_is_safe(rel_path) {
        return http_bad_request("invalid static file path")
    }
    match loader(root_dir ++ "/" ++ rel_path) {
        Some(content) => http_response(200, infer_mime_type(rel_path), content)
        None => http_not_found("static file not found")
    }
}

impl WebApp {
    pub pure fn route(self, method Text, path Text, handler Handler) WebApp {
        let idx = len(self.routes)
        var rs = self.routes
        rs = push(rs, RouteEntry { method = method, path = path, handler = handler })
        let rx = self.radix.insert(method, path, idx)
        WebApp {
            routes = rs
            radix = rx
            middlewares = self.middlewares
            openapi_json = self.openapi_json
        }
    }

    pub pure fn get(self, path Text, handler Handler) WebApp {
        self.route("GET", path, handler)
    }

    pub pure fn post(self, path Text, handler Handler) WebApp {
        self.route("POST", path, handler)
    }

    pub pure fn put(self, path Text, handler Handler) WebApp {
        self.route("PUT", path, handler)
    }

    pub pure fn delete(self, path Text, handler Handler) WebApp {
        self.route("DELETE", path, handler)
    }

    /// Mounts a path-traversal-safe static handler at `prefix/*file` using an injectable loader.
    pub pure fn static_dir_with(self, prefix Text, root_dir Text, loader fn(Text) Option[Text]) WebApp {
        let dir = root_dir
        let pat = prefix ++ "/*file"
        self.get(pat, |ctx| {
            match ctx.param("file") {
                Some(rel) => serve_static_with(dir, rel, loader)
                None => http_not_found("missing file path")
            }
        })
    }

    pub pure fn use_mw(self, mw Middleware) WebApp {
        var mws = self.middlewares
        mws = push(mws, mw)
        WebApp {
            routes = self.routes
            radix = self.radix
            middlewares = mws
            openapi_json = self.openapi_json
        }
    }

    pub pure fn with_openapi(self, spec_json Text) WebApp {
        WebApp {
            routes = self.routes
            radix = self.radix
            middlewares = self.middlewares
            openapi_json = spec_json
        }
    }

    /// O(depth) Radix Trie dispatch with OpenAPI auto-mount and RFC-compliant 405 Method Not Allowed.
    pub pure fn dispatch_core(self, ctx Context) HttpResponse {
        if len(self.openapi_json) > 0 && ctx.req.method == "GET" && ctx.req.path == "/openapi.json" {
            return http_json(200, self.openapi_json)
        }
        let hit = self.radix.lookup(ctx.req.method, ctx.req.path)
        if hit.route_idx >= 0 && hit.route_idx < len(self.routes) {
            let rt = self.routes[hit.route_idx]
            let bound = Context { req = ctx.req, params = hit.params }
            let h = rt.handler
            return h(bound)
        }
        if hit.matched_other_m {
            http_json(405, "{\"error\":\"method not allowed\"}")
        } else {
            http_not_found("route not found")
        }
    }

    pub pure fn into_handler(self) fn(HttpRequest) HttpResponse {
        let app = self
        let core Handler = |ctx| app.dispatch_core(ctx)
        let pipeline = compose_middlewares(app.middlewares, core)
        |req| {
            let ctx = Context { req = req, params = [] }
            pipeline(ctx)
        }
    }

    pub fn serve(self, addr Text, workers Int, port_out AtomicInt, stop AtomicInt) Int {
        let h = self.into_handler()
        http_serve_reactor(addr, workers, port_out, stop, h)
    }
}

/// Compile-time metaprogramming generator macro!
/// Scans ALL `@get`/`@post`/`@put`/`@delete`/`@patch`/`@ws`/`@sse` annotated handler functions
/// via `routes_of()` and generates:
///   1. `pub pure fn mount_routes(app WebApp) WebApp` (zero-reflection compiled Radix router wiring)
///   2. `pub pure fn generated_openapi_json() Text` (compile-time OpenAPI 3.1 specification!)
pub comptime fn mount_annotated_routes() Text {
    let rs = routes_of()
    var mount_body = "    var out = app\n"
    var spec = "{\\\"openapi\\\":\\\"3.1.0\\\",\\\"info\\\":{\\\"title\\\":\\\"Tenon Web API\\\",\\\"version\\\":\\\"1.0.0\\\"},\\\"paths\\\":{"
    var i = 0
    while i < len(rs) {
        let r = rs[i]
        mount_body = mount_body ++ "    out = out.route(\"" ++ r.method ++ "\", \"" ++ r.path ++ "\", |ctx| " ++ r.handler ++ "(ctx))\n"
        if i > 0 {
            spec = spec ++ ","
        }
        spec = spec ++ "\\\"" ++ r.method ++ " " ++ r.path ++ "\\\":{\\\"operationId\\\":\\\"" ++ r.handler ++ "\\\"}"
        i += 1
    }
    spec = spec ++ "}}"
    let fn_openapi = "pub pure fn generated_openapi_json() Text {\n    \"" ++ spec ++ "\"\n}\n\n"
    let fn_mount = "pub fn mount_routes(app WebApp) WebApp {\n" ++ mount_body ++ "    out.with_openapi(generated_openapi_json())\n}\n"
    fn_openapi ++ fn_mount
}
