// Benchmark 04: 50,000-key String HashMap (insert, overwrite, lookup, delete 25k, re-lookup)
// Pure-Tenon `std/collections/map.tn` (Compact Open-Addressing HashMap + Perceus COW)

import "std/core/types.tn"
import "std/core/ops.tn"
import "std/text/text.tn"
import "std/collections/map.tn"

pub fn main() Int {
    let n = 50000
    var m = TextMap.new()
    var i = 0
    while i < n {
        let k = "key_" ++ i.to_text()
        let v = "val_" ++ (i * 3).to_text()
        m.set(k, v)
        i += 1
    }
    // Overwrite 10,000 keys in-place
    var u = 0
    while u < 10000 {
        m.set("key_" ++ u.to_text(), "upd_" ++ u.to_text())
        u += 1
    }
    // Lookup all 50,000 keys
    var checksum = 0
    var q = 0
    while q < n {
        match m.get("key_" ++ q.to_text()) {
            Some(v) => { checksum += v.len() }
            None => {}
        }
        q += 1
    }
    // Delete 25,000 even keys
    var d = 0
    while d < n {
        let _ = m.remove("key_" ++ d.to_text())
        d += 2
    }
    // Lookup all 50,000 keys after deletions
    var q2 = 0
    while q2 < n {
        match m.get("key_" ++ q2.to_text()) {
            Some(v) => { checksum += v.len() }
            None => {}
        }
        q2 += 1
    }
    checksum += m.len()
    let _ = print_int(checksum)
    0
}
